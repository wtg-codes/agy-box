# tint2 config for agy-box VDI Desktop
# Bottom panel with launchers and taskbar

# Panel
panel_items = LTS
panel_size = 100% 40
panel_margin = 0 0
panel_padding = 4 0 4
panel_background_id = 1
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
autohide = 0

# Backgrounds
# ID 1 — panel background (dark translucent)
rounded = 0
border_width = 0
border_sides = T
background_color = #1a1b2e 90
border_color = #4fc3f7 60

# ID 2 — active task background
rounded = 4
border_width = 1
background_color = #4fc3f7 30
border_color = #4fc3f7 60

# ID 3 — launcher icon background on hover
rounded = 4
border_width = 0
background_color = #ffffff 15
border_color = #000000 0

# Taskbar
taskbar_mode = single_desktop
taskbar_padding = 2 2 4
taskbar_background_id = 0
taskbar_active_background_id = 0
taskbar_name = 0

# Task (window buttons in taskbar)
task_text = 1
task_icon = 1
task_centered = 0
task_maximum_size = 200 35
task_padding = 6 3 6
task_font = sans 10
task_font_color = #e0e0e0 100
task_active_font_color = #ffffff 100
task_background_id = 0
task_active_background_id = 2

# Launcher
launcher_padding = 4 4 4
launcher_background_id = 0
launcher_icon_background_id = 3
launcher_icon_size = 28
launcher_icon_theme = hicolor
launcher_item_app = /usr/share/applications/agy-terminal.desktop
launcher_item_app = /usr/share/applications/agy-browser.desktop
launcher_item_app = /usr/share/applications/agy-antigravity.desktop

# System tray
systray_padding = 4 2 4
systray_background_id = 0
systray_icon_size = 22
