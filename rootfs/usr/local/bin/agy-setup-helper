#!/bin/bash
# ==============================================================================
# agy-setup-helper
#
# First-time launch setup assistant for the agy-box workspace container.
# Validates keyring, API keys, browser health, and git configuration.
# Writes a flag file to ~/.config/agy-box/.setup_done on success/skip.
# ==============================================================================

set -Eeuo pipefail

VERSION="2.1.0"

# Colors for log prefixes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Helper logging functions
log_info() {
    printf "${BLUE}[INFO]${NC} %s\n" "$1"
}

log_success() {
    printf "${GREEN}[SUCCESS]${NC} %s\n" "$1"
}

log_warn() {
    printf "${YELLOW}[WARN]${NC} %s\n" "$1"
}

log_error() {
    printf "${RED}[ERROR]${NC} %s\n" "$1" >&2
}

mask_key() {
    local key="$1"
    if [[ -z "$key" ]]; then
        echo "not set"
    elif [[ ${#key} -le 8 ]]; then
        echo "****"
    else
        echo "${key:0:6}...${key: -4}"
    fi
}

check_dbus() {
    local status=0
    if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
        status=1
    fi
    if command -v dbus-send &>/dev/null; then
        if ! dbus-send --session --dest=org.freedesktop.DBus --type=method_call --print-reply /org/freedesktop/DBus org.freedesktop.DBus.ListNames >/dev/null 2>&1; then
            status=2
        fi
    else
        status=3
    fi
    return "$status"
}
export -f check_dbus

check_chrome() {
    if ! command -v google-chrome-stable &>/dev/null; then
        return 1
    fi
    if ! google-chrome-stable --version &>/dev/null; then
        return 2
    fi
    return 0
}
export -f check_chrome

check_git() {
    local name
    local email
    name=$(git config --global user.name 2>/dev/null || true)
    email=$(git config --global user.email 2>/dev/null || true)
    if [[ -z "$name" && -z "$email" ]]; then
        return 3
    elif [[ -z "$name" ]]; then
        return 1
    elif [[ -z "$email" ]]; then
        return 2
    fi
    return 0
}
export -f check_git

check_api_keys() {
    local gemini_key="${GEMINI_API_KEY:-}"
    local anti_key="${ANTIGRAVITY_API_KEY:-}"
    local config_file="$HOME/.config/environment.d/agy-box.conf"

    if [[ -f "$config_file" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            line=$(echo "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/#.*//')
            [[ -z "$line" ]] && continue
            if [[ "$line" =~ ^([^=]+)=(.*)$ ]]; then
                local key="${BASH_REMATCH[1]}"
                local val="${BASH_REMATCH[2]}"
                val="${val%\"}"
                val="${val#\"}"
                val="${val%\'}"
                val="${val#\'}"
                if [[ "$key" == "GEMINI_API_KEY" && -z "$gemini_key" ]]; then
                    gemini_key="$val"
                elif [[ "$key" == "ANTIGRAVITY_API_KEY" && -z "$anti_key" ]]; then
                    anti_key="$val"
                fi
            fi
        done < "$config_file"
    fi

    if [[ -z "$gemini_key" && -z "$anti_key" ]]; then
        return 1
    elif [[ -z "$gemini_key" ]]; then
        return 2
    elif [[ -z "$anti_key" ]]; then
        return 3
    fi
    return 0
}
export -f check_api_keys

run_audit_checks() {
    local log_file="$1"
    local config_file="$HOME/.config/environment.d/agy-box.conf"
    {
        # A. Container Boundary & Access Auditing
        echo "Boundary Check:"
        if [[ "$EUID" -eq 0 ]]; then
            echo "WARN:Running as root! It is highly recommended to run the container shell as a non-root user to avoid host escape vulnerabilities."
        else
            echo "OK:Running securely as non-root user (EUID: $EUID)."
        fi

        # D-Bus Socket Owner Check
        if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" && "$DBUS_SESSION_BUS_ADDRESS" =~ unix:path=([^,]+) ]]; then
            local socket_path="${BASH_REMATCH[1]}"
            if [[ -S "$socket_path" ]]; then
                local socket_owner
                socket_owner=$(stat -c "%U" "$socket_path" 2>/dev/null || stat -f "%Su" "$socket_path" 2>/dev/null)
                if [[ "$socket_owner" != "$USER" && "$socket_owner" != "root" ]]; then
                    echo "WARN:D-Bus session socket at $socket_path is owned by $socket_owner, not current user ($USER)."
                else
                    echo "OK:D-Bus socket owner matches session user securely ($socket_owner)."
                fi
            fi
        fi

        # B. Insecure Permissions Hardening
        echo "Permissions Check:"
        check_perm() {
            local target="$1"
            local expected_perm="$2"
            local label="$3"
            if [[ -e "$target" ]]; then
                local current_perm
                current_perm=$(stat -c "%a" "$target" 2>/dev/null || stat -f "%Lp" "$target" 2>/dev/null)
                if [[ "$current_perm" -ne "$expected_perm" ]]; then
                    echo "WARN:Insecure permissions on $label $target: $current_perm (expected $expected_perm)."
                else
                    echo "OK:Permissions on $target are secure ($current_perm)."
                fi
            else
                echo "SKIP:Path $target ($label) does not exist."
            fi
        }
        check_perm "$config_file" 600 "API config file"
        check_perm "$HOME/.ssh" 700 "SSH directory"
        check_perm "$HOME/.config/gcloud/application_default_credentials.json" 600 "GCP Credentials file"

        # C. Sockets / Wildcard Ports Binding Scan
        echo "Network Check:"
        local insecure_listeners=0
        if [[ -f /proc/net/tcp ]]; then
            while read -r _ local_addr _ _ _ _ _ _ _ _ _ || [[ -n "$local_addr" ]]; do
                if [[ "$local_addr" =~ ^00000000:([0-9A-F]+)$ ]]; then
                    local port_hex="${BASH_REMATCH[1]}"
                    local port_dec=$((16#$port_hex))
                    echo "WARN:Exposed port listener: Port $port_dec is bound to 0.0.0.0 (exposed outside sandbox!)."
                    insecure_listeners=$((insecure_listeners + 1))
                fi
            done < <(tail -n +2 /proc/net/tcp)
        fi
        if [[ "$insecure_listeners" -eq 0 ]]; then
            echo "OK:No wildcard listeners detected. All port bindings are secure."
        fi

        # D. Developer Skills Pack Checks
        echo "Skills Check:"
        
        # Android Pack
        if command -v adb &>/dev/null; then
            echo "OK:Android adb CLI tool is installed."
        else
            echo "WARN:Android adb CLI tool not found."
        fi
        if [[ -d /dev/bus/usb ]]; then
            echo "OK:USB bus mounts are present (/dev/bus/usb)."
        else
            echo "WARN:USB bus (/dev/bus/usb) not found. Android hardware debugging is unavailable."
        fi

        # Cloud Pack
        if command -v gcloud &>/dev/null; then
            echo "OK:gcloud CLI tool is installed."
        else
            echo "WARN:gcloud CLI tool not found."
        fi

        # Web/noVNC VDI Pack
        local missing_vdi=0
        for cmd in Xvfb x11vnc openbox websockify; do
            if command -v "$cmd" &>/dev/null; then
                echo "OK:VDI component '$cmd' is available."
            else
                echo "WARN:VDI component '$cmd' is missing."
                missing_vdi=$((missing_vdi + 1))
            fi
        done
        if [[ "$missing_vdi" -eq 0 ]]; then
            echo "OK:VDI virtual desktop capabilities are fully configured."
        else
            echo "WARN:Optional VDI desktop components are incomplete (missing $missing_vdi components)."
        fi
    } > "$log_file"
}
export -f run_audit_checks

main() {
    # Check if the shell is interactive before displaying interactive setup options
    local is_interactive=false
    if [[ -t 0 && -t 1 ]]; then
        is_interactive=true
    fi

    if [[ "$is_interactive" != "true" ]]; then
        log_info "Non-interactive session. Skipping setup assistant."
        exit 0
    fi

    # Welcome Splash Screen
    local welcome_text
    welcome_text=$(printf "Welcome to the agy-box Workspace Setup Assistant v%s!\n\nThis utility will validate your container environment and configure key components:\n  • D-Bus & Keyring validation\n  • API Key configurations\n  • Browser health checks\n  • Git configuration checks\n  • Developer toolchain audit & permissions hardening" "$VERSION")
    gum style --foreground 99 --border double --border-foreground 99 --padding "1 2" --margin "1 1" "$welcome_text"

    if ! gum confirm "Would you like to run the first-time setup assistant now?"; then
        gum style --foreground 214 "Skipping setup. A completion flag will be written to prevent future prompts."
        mkdir -p "$HOME/.config/agy-box"
        touch "$HOME/.config/agy-box/.setup_done"
        exit 0
    fi

    # Setup Steps using gum spin
    local dbus_code=0
    gum spin --spinner dot --title "Checking D-Bus & Keyring environment..." -- bash -c check_dbus || dbus_code=$?

    local chrome_code=0
    gum spin --spinner dot --title "Verifying Google Chrome execution..." -- bash -c check_chrome || chrome_code=$?

    local git_code=0
    gum spin --spinner dot --title "Checking Git configuration..." -- bash -c check_git || git_code=$?

    local api_code=0
    gum spin --spinner dot --title "Checking API credentials..." -- bash -c check_api_keys || api_code=$?

    # Show a styled check outcome card
    local card=""
    card+="System Status Check Results:\n\n"
    
    case "$dbus_code" in
        0) card+="  [✓] D-Bus session communication is healthy.\n" ;;
        1) card+="  [!] DBUS_SESSION_BUS_ADDRESS is not set (Keyring may fail).\n" ;;
        2) card+="  [!] D-Bus session bus is unreachable (Keyring may fail).\n" ;;
        *) card+="  [!] dbus-send tool not found; unable to verify D-Bus.\n" ;;
    esac

    case "$chrome_code" in
        0) card+="  [✓] Google Chrome is healthy.\n" ;;
        1) card+="  [!] google-chrome-stable command not found.\n" ;;
        *) card+="  [!] Google Chrome exists but failed to execute.\n" ;;
    esac

    case "$git_code" in
        0) card+="  [✓] Git user.name and user.email are configured.\n" ;;
        1) card+="  [!] Git user.name is not set.\n" ;;
        2) card+="  [!] Git user.email is not set.\n" ;;
        *) card+="  [!] Git configuration is missing.\n" ;;
    esac

    case "$api_code" in
        0) card+="  [✓] API Keys: GEMINI_API_KEY & ANTIGRAVITY_API_KEY are configured.\n" ;;
        2) card+="  [✓] API Keys: ANTIGRAVITY_API_KEY is configured (GEMINI is missing).\n" ;;
        3) card+="  [✓] API Keys: GEMINI_API_KEY is configured (ANTIGRAVITY is missing).\n" ;;
        *) card+="  [!] API Keys: Both GEMINI and ANTIGRAVITY API keys are missing.\n" ;;
    esac

    gum style --border normal --padding "1 2" --border-foreground 120 --foreground 255 "$(printf "%b" "$card")"

    # User input collection for API Keys
    local config_file="$HOME/.config/environment.d/agy-box.conf"
    if [[ "$api_code" -eq 1 ]]; then
        if gum confirm "API keys are missing. Would you like to configure them now?"; then
            local input_gemini
            input_gemini=$(gum input --password --placeholder "Enter GEMINI_API_KEY (leave blank to skip)")
            
            local input_anti
            input_anti=$(gum input --password --placeholder "Enter ANTIGRAVITY_API_KEY (leave blank to skip)")

            if [[ -n "$input_gemini" || -n "$input_anti" ]]; then
                mkdir -p "$(dirname "$config_file")"
                {
                    echo "# Environment variables for agy-box"
                    echo "# Generated by agy-setup-helper on $(date)"
                    if [[ -n "$input_gemini" ]]; then
                        echo "GEMINI_API_KEY=\"$input_gemini\""
                        export GEMINI_API_KEY="$input_gemini"
                    fi
                    if [[ -n "$input_anti" ]]; then
                        echo "ANTIGRAVITY_API_KEY=\"$input_anti\""
                        export ANTIGRAVITY_API_KEY="$input_anti"
                    fi
                } > "$config_file"
                gum style --foreground 46 "✓ API Keys successfully saved to $config_file"
            else
                gum style --foreground 214 "No API keys entered. Skipping."
            fi
        else
            gum style --foreground 214 "Skipping API key configuration."
        fi
    fi

    # User input collection for Git
    if [[ "$git_code" -ne 0 ]]; then
        if gum confirm "Git profile configuration is missing or incomplete. Configure now?"; then
            local git_name
            local git_email
            git_name=$(git config --global user.name 2>/dev/null || true)
            git_email=$(git config --global user.email 2>/dev/null || true)

            if [[ -z "$git_name" ]]; then
                local input_name
                input_name=$(gum input --placeholder "Enter Git user.name (e.g. John Doe)")
                if [[ -n "$input_name" ]]; then
                    git config --global user.name "$input_name"
                    gum style --foreground 46 "✓ Git user.name set to: $input_name"
                fi
            fi

            if [[ -z "$git_email" ]]; then
                local input_email
                input_email=$(gum input --placeholder "Enter Git user.email (e.g. john@example.com)")
                if [[ -n "$input_email" ]]; then
                    git config --global user.email "$input_email"
                    gum style --foreground 46 "✓ Git user.email set to: $input_email"
                fi
            fi
        fi
    fi

    # Optional Skills Pack & Security Auditing
    if gum confirm "Would you like to run the optional Developer Skills Pack & Security Audit?"; then
        local audit_log
        audit_log=$(mktemp)
        
        gum spin --spinner dot --title "Running Security Audit & Skills Pack checks..." -- bash -c "run_audit_checks '$audit_log'"

        local formatted_results=""
        formatted_results+="Security Audit & Skills Pack Results:\n\n"
        
        while IFS= read -r line || [[ -n "$line" ]]; do
            if [[ "$line" =~ ^(OK|WARN|SKIP):(.*)$ ]]; then
                local type="${BASH_REMATCH[1]}"
                local msg="${BASH_REMATCH[2]}"
                case "$type" in
                    OK) formatted_results+="  [✓] $msg\n" ;;
                    WARN) formatted_results+="  [!] $msg\n" ;;
                    SKIP) formatted_results+="  [-] $msg\n" ;;
                esac
            else
                formatted_results+="\n$line\n"
            fi
        done < "$audit_log"
        rm -f "$audit_log"

        gum style --border double --padding "1 2" --border-foreground 212 --foreground 255 "$(printf "%b" "$formatted_results")"

        # Permissions Hardening Checks
        harden_if_needed() {
            local target="$1"
            local expected_perm="$2"
            local label="$3"
            if [[ -e "$target" ]]; then
                local current_perm
                current_perm=$(stat -c "%a" "$target" 2>/dev/null || stat -f "%Lp" "$target" 2>/dev/null)
                if [[ "$current_perm" -ne "$expected_perm" ]]; then
                    if gum confirm "Insecure permissions on $label ($target): $current_perm. Auto-harden to $expected_perm?"; then
                        chmod "$expected_perm" "$target"
                        gum style --foreground 46 "✓ Hardened permissions of $target to $expected_perm."
                    fi
                fi
            fi
        }
        harden_if_needed "$config_file" 600 "API config file"
        harden_if_needed "$HOME/.ssh" 700 "SSH directory"
        harden_if_needed "$HOME/.config/gcloud/application_default_credentials.json" 600 "GCP Credentials file"
    fi

    # End Screen Success Card
    local success_msg
    success_msg=$(printf "Setup Assistant Complete!\n\nAll baseline services and keys are verified.\nYour environment is ready for Cloud-Native Laboratory development.\n\nEnjoy using agy-box!")
    gum style --border double --padding "1 2" --border-foreground 46 --foreground 46 "$success_msg"

    # Flag File writing
    local flag_dir="$HOME/.config/agy-box"
    local flag_file="$flag_dir/.setup_done"
    mkdir -p "$flag_dir"
    touch "$flag_file"
}

main "$@"
