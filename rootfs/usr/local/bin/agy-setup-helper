#!/bin/bash
# ==============================================================================
# agy-setup-helper
#
# First-time launch setup assistant for the agy-box workspace container.
# Validates keyring, API keys, browser health, and git configuration.
# Writes a flag file to ~/.config/agy-box/.setup_done on success/skip.
# ==============================================================================

set -Eeuo pipefail

# Colors for log prefixes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Helper logging functions
log_info() {
    printf "${BLUE}[INFO]${NC} %s\n" "$1"
}

log_success() {
    printf "${GREEN}[SUCCESS]${NC} %s\n" "$1"
}

log_warn() {
    printf "${YELLOW}[WARN]${NC} %s\n" "$1"
}

log_error() {
    printf "${RED}[ERROR]${NC} %s\n" "$1" >&2
}

mask_key() {
    local key="$1"
    if [[ -z "$key" ]]; then
        echo "not set"
    elif [[ ${#key} -le 8 ]]; then
        echo "****"
    else
        echo "${key:0:6}...${key: -4}"
    fi
}

main() {
    # Check if the shell is interactive before displaying interactive setup options
    local is_interactive=false
    if [[ -t 0 && -t 1 ]]; then
        is_interactive=true
    fi

    if [[ "$is_interactive" == "true" ]]; then
        echo -e "${BLUE}==================================================${NC}"
        echo -e "${BLUE}      agy-box Workspace First-Time Setup          ${NC}"
        echo -e "${BLUE}==================================================${NC}"
        printf "Would you like to run the first-time setup assistant now? [Y/n]: "
        read -r run_setup
        run_setup="${run_setup:-Y}"
        if [[ ! "$run_setup" =~ ^[Yy]$ ]]; then
            log_info "Skipping setup. A completion flag will be written to prevent future prompts."
            mkdir -p "$HOME/.config/agy-box"
            touch "$HOME/.config/agy-box/.setup_done"
            exit 0
        fi
    fi

    # 1. Keyring/D-Bus validation
    log_info "Validating D-Bus and Keyring environment..."
    if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
        log_warn "DBUS_SESSION_BUS_ADDRESS is not set. D-Bus keyring communication might be unavailable."
    else
        log_info "DBUS_SESSION_BUS_ADDRESS is active: $DBUS_SESSION_BUS_ADDRESS"
    fi

    if command -v dbus-send &>/dev/null; then
        # Check if we can communicate with DBus
        if dbus-send --session --dest=org.freedesktop.DBus --type=method_call --print-reply /org/freedesktop/DBus org.freedesktop.DBus.ListNames >/dev/null 2>&1; then
            log_success "D-Bus session communication is healthy."
        else
            log_warn "D-Bus communication test failed (session bus is unreachable)."
        fi
    else
        log_warn "dbus-send command not found. Cannot verify D-Bus communication."
    fi

    if command -v secret-tool &>/dev/null; then
        log_info "Keyring CLI (secret-tool) is available."
    else
        log_info "Keyring CLI (secret-tool) is not installed."
    fi

    # 2. API Key validation
    log_info "Validating API Keys (GEMINI_API_KEY / ANTIGRAVITY_API_KEY)..."
    local gemini_key="${GEMINI_API_KEY:-}"
    local anti_key="${ANTIGRAVITY_API_KEY:-}"
    local config_file="$HOME/.config/environment.d/agy-box.conf"

    # Read from config file if present and variables are not already in environment
    if [[ -f "$config_file" ]]; then
        log_info "Found environment config file at $config_file"
        while IFS= read -r line || [[ -n "$line" ]]; do
            # Strip leading/trailing whitespace, comments
            line=$(echo "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/#.*//')
            [[ -z "$line" ]] && continue
            if [[ "$line" =~ ^([^=]+)=(.*)$ ]]; then
                local key="${BASH_REMATCH[1]}"
                local val="${BASH_REMATCH[2]}"
                # Strip quotes
                val="${val%\"}"
                val="${val#\"}"
                val="${val%\'}"
                val="${val#\'}"
                if [[ "$key" == "GEMINI_API_KEY" && -z "$gemini_key" ]]; then
                    gemini_key="$val"
                elif [[ "$key" == "ANTIGRAVITY_API_KEY" && -z "$anti_key" ]]; then
                    anti_key="$val"
                fi
            fi
        done < "$config_file"
    fi

    log_info "Current API Key status:"
    log_info "  GEMINI_API_KEY: $(mask_key "$gemini_key")"
    log_info "  ANTIGRAVITY_API_KEY: $(mask_key "$anti_key")"

    if [[ -z "$gemini_key" && -z "$anti_key" ]]; then
        if [[ "$is_interactive" == "true" ]]; then
            log_warn "Both GEMINI_API_KEY and ANTIGRAVITY_API_KEY are missing."
            printf "Would you like to configure API keys now? [Y/n]: "
            read -r prompt_keys
            prompt_keys="${prompt_keys:-Y}"
            if [[ "$prompt_keys" =~ ^[Yy]$ ]]; then
                printf "Enter GEMINI_API_KEY (leave blank to skip): "
                read -r input_gemini
                printf "Enter ANTIGRAVITY_API_KEY (leave blank to skip): "
                read -r input_anti

                if [[ -n "$input_gemini" || -n "$input_anti" ]]; then
                    mkdir -p "$(dirname "$config_file")"
                    {
                        echo "# Environment variables for agy-box"
                        echo "# Generated by agy-setup-helper on $(date)"
                        if [[ -n "$input_gemini" ]]; then
                            echo "GEMINI_API_KEY=\"$input_gemini\""
                            gemini_key="$input_gemini"
                            export GEMINI_API_KEY="$input_gemini"
                        fi
                        if [[ -n "$input_anti" ]]; then
                            echo "ANTIGRAVITY_API_KEY=\"$input_anti\""
                            anti_key="$input_anti"
                            export ANTIGRAVITY_API_KEY="$input_anti"
                        fi
                    } > "$config_file"
                    log_success "API Keys saved to $config_file"
                else
                    log_info "No API keys provided. Skipping."
                fi
            else
                log_info "Skipping API key configuration."
            fi
        else
            log_warn "Non-interactive shell. GEMINI_API_KEY and ANTIGRAVITY_API_KEY are not configured."
            log_warn "You can configure them manually in $config_file"
        fi
    else
        log_success "API Key validation passed (at least one key is configured)."
    fi

    # 3. Chrome/Browser health
    log_info "Checking Chrome browser health..."
    if command -v google-chrome-stable &>/dev/null; then
        local chrome_version
        if chrome_version=$(google-chrome-stable --version 2>&1); then
            log_success "Chrome is healthy: $chrome_version"
        else
            log_error "google-chrome-stable exists but failed to execute. Error: $chrome_version"
        fi
    else
        log_warn "google-chrome-stable command not found."
    fi

    # 4. Git verification
    log_info "Verifying Git configuration..."
    local git_name
    local git_email
    git_name=$(git config --global user.name 2>/dev/null || true)
    git_email=$(git config --global user.email 2>/dev/null || true)

    if [[ -z "$git_name" || -z "$git_email" ]]; then
        if [[ "$is_interactive" == "true" ]]; then
            log_warn "Git user.name or user.email is not set."
            if [[ -z "$git_name" ]]; then
                printf "Enter Git user.name: "
                read -r input_name
                if [[ -n "$input_name" ]]; then
                    git config --global user.name "$input_name"
                    git_name="$input_name"
                    log_success "Git user.name configured."
                fi
            fi
            if [[ -z "$git_email" ]]; then
                printf "Enter Git user.email: "
                read -r input_email
                if [[ -n "$input_email" ]]; then
                    git config --global user.email "$input_email"
                    git_email="$input_email"
                    log_success "Git user.email configured."
                fi
            fi
        else
            log_warn "Non-interactive shell. Git user.name/user.email not configured."
            log_warn "Please run 'git config --global user.name/user.email' to configure them."
        fi
    else
        log_success "Git configured (Name: $git_name, Email: $git_email)."
    fi

    # 4.5. Optional Skills Pack & Security Auditing
    if [[ "$is_interactive" == "true" ]]; then
        echo -e "\n${BLUE}==================================================${NC}"
        echo -e "${BLUE}    Optional Skills Pack & Security Auditing     ${NC}"
        echo -e "${BLUE}==================================================${NC}"
        printf "Would you like to run the optional Developer Skills Pack & Security Audit? [y/N]: "
        read -r run_audit
        run_audit="${run_audit:-N}"
        if [[ "$run_audit" =~ ^[Yy]$ ]]; then
            # A. Container Boundary & Access Auditing
            log_info "Auditing container privilege boundaries..."
            if [[ "$EUID" -eq 0 ]]; then
                log_warn "Running as root! It is highly recommended to run the container shell as a non-root user to avoid host escape vulnerabilities."
            else
                log_success "Running securely as non-root user (EUID: $EUID)."
            fi

            # D-Bus Socket Owner Check
            if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" && "$DBUS_SESSION_BUS_ADDRESS" =~ unix:path=([^,]+) ]]; then
                local socket_path="${BASH_REMATCH[1]}"
                if [[ -S "$socket_path" ]]; then
                    local socket_owner
                    socket_owner=$(stat -c "%U" "$socket_path" 2>/dev/null || stat -f "%Su" "$socket_path" 2>/dev/null)
                    if [[ "$socket_owner" != "$USER" && "$socket_owner" != "root" ]]; then
                        log_warn "D-Bus session socket at $socket_path is owned by $socket_owner, not current user ($USER)."
                    else
                        log_success "D-Bus socket owner matches session user securely ($socket_owner)."
                    fi
                fi
            fi

            # B. Insecure Permissions Hardening
            log_info "Auditing critical file permissions..."
            audit_and_harden() {
                local target="$1"
                local expected_perm="$2"
                local label="$3"
                if [[ -e "$target" ]]; then
                    local current_perm
                    current_perm=$(stat -c "%a" "$target" 2>/dev/null || stat -f "%Lp" "$target" 2>/dev/null)
                    if [[ "$current_perm" -ne "$expected_perm" ]]; then
                        log_warn "Insecure permissions on $label $target: $current_perm (expected $expected_perm)."
                        printf "Would you like to auto-harden permissions to %s? [Y/n]: " "$expected_perm"
                        read -r harden_input
                        harden_input="${harden_input:-Y}"
                        if [[ "$harden_input" =~ ^[Yy]$ ]]; then
                            chmod "$expected_perm" "$target"
                            log_success "Hardened permissions of $target to $expected_perm."
                        fi
                    else
                        log_success "Permissions on $target are secure ($current_perm)."
                    fi
                fi
            }
            audit_and_harden "$config_file" 600 "API config file"
            audit_and_harden "$HOME/.ssh" 700 "SSH directory"
            audit_and_harden "$HOME/.config/gcloud/application_default_credentials.json" 600 "GCP Credentials file"

            # C. Sockets / Wildcard Ports Binding Scan
            log_info "Auditing active wildcard network port listeners..."
            local insecure_listeners=0
            if [[ -f /proc/net/tcp ]]; then
                while read -r line || [[ -n "$line" ]]; do
                    # shellcheck disable=SC2206
                    local fields=($line)
                    local local_addr="${fields[1]:-}"
                    # 00000000 translates to wildcard 0.0.0.0
                    if [[ "$local_addr" =~ ^00000000:([0-9A-F]+)$ ]]; then
                        local port_hex="${BASH_REMATCH[1]}"
                        local port_dec=$((16#$port_hex))
                        log_warn "Exposed port listener: Port $port_dec is bound to 0.0.0.0 (exposed outside sandbox!)."
                        insecure_listeners=$((insecure_listeners + 1))
                    fi
                done < <(tail -n +2 /proc/net/tcp)
            fi
            if [[ "$insecure_listeners" -eq 0 ]]; then
                log_success "No wildcard listeners detected. All port bindings are secure."
            else
                log_warn "Exposed listeners detected ($insecure_listeners). Please ensure container servers bind strictly to 127.0.0.1."
            fi

            # D. Developer Skills Pack Checks
            log_info "Auditing Developer Skills Pack toolchains..."
            
            # Android Pack
            log_info "--- Android Developer Skills Pack ---"
            if command -v adb &>/dev/null; then
                log_success "adb CLI tool is installed."
            else
                log_warn "adb CLI tool not found."
            fi
            if [[ -d /dev/bus/usb ]]; then
                log_success "USB bus mounts are present (/dev/bus/usb)."
            else
                log_warn "USB bus (/dev/bus/usb) not found. Android hardware debugging is unavailable."
            fi

            # Cloud Pack
            log_info "--- GCP / Cloud Developer Skills Pack ---"
            if command -v gcloud &>/dev/null; then
                log_success "gcloud CLI tool is installed."
            else
                log_warn "gcloud CLI tool not found."
            fi

            # Web/noVNC VDI Pack
            log_info "--- VDI Virtual Desktop Skills Pack ---"
            local missing_vdi=0
            for cmd in Xvfb x11vnc openbox websockify; do
                if command -v "$cmd" &>/dev/null; then
                    log_success "VDI component '$cmd' is available."
                else
                    log_warn "VDI component '$cmd' is missing."
                    missing_vdi=$((missing_vdi + 1))
                fi
            done
            if [[ "$missing_vdi" -eq 0 ]]; then
                log_success "VDI virtual desktop capabilities are fully configured."
            else
                log_info "Optional VDI desktop components are incomplete."
            fi
        else
            log_info "Skipping optional Skills Pack & Security Audit."
        fi
    fi

    # 5. Flag File writing
    local flag_dir="$HOME/.config/agy-box"
    local flag_file="$flag_dir/.setup_done"
    log_info "Writing setup completion flag to $flag_file..."
    mkdir -p "$flag_dir"
    touch "$flag_file"
    log_success "Setup check and configuration complete!"
}

main "$@"
