#!/bin/bash
# ==============================================================================
# agy-install-ide
#
# On-demand installer helper for JetBrains IDEs (IntelliJ IDEA Community and
# PyCharm Community) inside the agy-box workspace container.
#
# Installs into $HOME/.local/share/JetBrains/, creates Desktop shortcuts in
# $HOME/Desktop/, symlinks binaries into $HOME/.local/bin/, and installs the
# Antigravity plugin.
# ==============================================================================
set -Eeuo pipefail

PROG="agy-install-ide"
VERSION="0.6.0"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log_info() {
    printf "${BLUE}[INFO]${NC} %s\n" "$1"
}

log_success() {
    printf "${GREEN}[SUCCESS]${NC} %s\n" "$1"
}

log_warn() {
    printf "${YELLOW}[WARN]${NC} %s\n" "$1"
}

log_error() {
    printf "${RED}[ERROR]${NC} %s\n" "$1" >&2
}

usage() {
    cat <<EOF
Usage: ${PROG} [COMMAND] [OPTIONS]

Install JetBrains IDEs on demand into \$HOME/.local/share/JetBrains/ with
Antigravity plugin integration.

Commands:
  idea        Install IntelliJ IDEA Community Edition
  pycharm     Install PyCharm Community Edition
  all         Install both IntelliJ IDEA and PyCharm Community
  (none)      Interactive prompt to choose an IDE to install

Options:
  -h, --help  Display this help message and exit
  -v, --version Display version and exit

EOF
}

# Ensure HOME is valid
if [ -z "${HOME:-}" ] || [ ! -d "$HOME" ] || [ ! -w "$HOME" ]; then
    log_error "HOME ('${HOME:-}') is not set or not a writable directory."
    exit 1
fi

JB_SHARE_DIR="$HOME/.local/share/JetBrains"
BIN_DIR="$HOME/.local/bin"
DESKTOP_DIR="$HOME/Desktop"

mkdir -p "$JB_SHARE_DIR" "$BIN_DIR" "$DESKTOP_DIR"

# Architecture detection
arch="$(uname -m)"
case "$arch" in
    x86_64)
        DL_KEY="linux"
        ;;
    aarch64|arm64)
        DL_KEY="linuxARM64"
        ;;
    *)
        log_error "Unsupported architecture: $arch. Only x86_64 and aarch64 are supported."
        exit 1
        ;;
esac

get_download_info() {
    local code="$1" # IIC or PCC
    local api_url="https://data.services.jetbrains.com/products/releases?code=${code}&latest=true&type=release"
    local json=""
    local link=""
    local checksum_link=""

    if command -v curl &>/dev/null; then
        json=$(curl -fsSL --connect-timeout 5 --retry 3 "$api_url" 2>/dev/null || true)
    fi

    if [ -n "$json" ] && command -v jq &>/dev/null; then
        link=$(echo "$json" | jq -r ".${code}[0].downloads.${DL_KEY}.link // empty")
        checksum_link=$(echo "$json" | jq -r ".${code}[0].downloads.${DL_KEY}.checksumLink // empty")
    fi

    # Fallbacks if API query fails
    if [ -z "$link" ]; then
        if [ "$code" = "IIC" ]; then
            if [ "$DL_KEY" = "linuxARM64" ]; then
                link="https://download.jetbrains.com/idea/idea-2025.3-aarch64.tar.gz"
            else
                link="https://download.jetbrains.com/idea/idea-2025.3.tar.gz"
            fi
        elif [ "$code" = "PCC" ]; then
            if [ "$DL_KEY" = "linuxARM64" ]; then
                link="https://download.jetbrains.com/python/pycharm-2025.3-aarch64.tar.gz"
            else
                link="https://download.jetbrains.com/python/pycharm-2025.3.tar.gz"
            fi
        fi
        checksum_link="${link}.sha256"
    fi

    echo "$link $checksum_link"
}

install_jetbrains_ide() {
    local product_code="$1" # IIC or PCC
    local name="$2"         # "IntelliJ IDEA Community" or "PyCharm Community"
    local target_sub="$3"   # ideaIC or pycharm-community
    local bin_name="$4"     # idea or pycharm
    local script_sub="$5"   # bin/idea.sh or bin/pycharm.sh

    log_info "Fetching latest download details for ${name} (${arch})..."
    read -r download_url checksum_url <<< "$(get_download_info "$product_code")"

    if [ -z "$download_url" ]; then
        log_error "Could not determine download URL for ${name}."
        return 1
    fi

    local dest_dir="$JB_SHARE_DIR/$target_sub"
    local work_dir
    work_dir=$(mktemp -d "${TMPDIR:-/tmp}/jb-install.XXXXXX")
    # shellcheck disable=SC2064
    trap "rm -rf '$work_dir'" RETURN

    local tarball="$work_dir/archive.tar.gz"

    log_info "Downloading ${name} from ${download_url}..."
    if command -v gum &>/dev/null && [ -t 1 ]; then
        gum spin --spinner dot --title "Downloading ${name}..." -- curl -fL --retry 5 --retry-delay 2 --connect-timeout 5 "$download_url" -o "$tarball"
    else
        curl -fL --retry 5 --retry-delay 2 --connect-timeout 5 "$download_url" -o "$tarball"
    fi

    # Checksum verification (optional / best-effort)
    if [ -n "$checksum_url" ] && command -v sha256sum &>/dev/null; then
        local checksum_file="$work_dir/checksum.sha256"
        if curl -fsSL --connect-timeout 5 --retry 2 "$checksum_url" -o "$checksum_file" 2>/dev/null; then
            local expected_hash
            expected_hash=$(awk '{print $1}' "$checksum_file" | head -n 1)
            if [ -n "$expected_hash" ]; then
                local actual_hash
                actual_hash=$(sha256sum "$tarball" | awk '{print $1}')
                if [ "$expected_hash" = "$actual_hash" ]; then
                    log_success "Checksum verified: ${actual_hash:0:16}..."
                else
                    log_warn "Checksum mismatch (expected $expected_hash, got $actual_hash); proceeding with caution."
                fi
            fi
        fi
    fi

    log_info "Extracting ${name} to ${dest_dir}..."
    local staging_dir="$JB_SHARE_DIR/${target_sub}.new"
    rm -rf "$staging_dir"
    mkdir -p "$staging_dir"
    tar -xzf "$tarball" -C "$staging_dir" --strip-components=1

    rm -rf "$dest_dir"
    mv "$staging_dir" "$dest_dir"
    chmod -R u+rwX "$dest_dir"

    # Link binary into $HOME/.local/bin
    local exec_path="$dest_dir/$script_sub"
    if [ -f "$exec_path" ]; then
        chmod +x "$exec_path"
        ln -sf "$exec_path" "$BIN_DIR/$bin_name"
        log_success "Created symlink: $BIN_DIR/$bin_name -> $exec_path"
    else
        log_error "Executable not found at expected path: $exec_path"
        return 1
    fi

    # Find icon
    local icon_path=""
    if [ -f "$dest_dir/bin/${bin_name}.svg" ]; then
        icon_path="$dest_dir/bin/${bin_name}.svg"
    elif [ -f "$dest_dir/bin/${bin_name}.png" ]; then
        icon_path="$dest_dir/bin/${bin_name}.png"
    fi

    # Create Desktop shortcut
    local desktop_file="$DESKTOP_DIR/${target_sub}.desktop"
    local categories="Development;IDE;"
    if [ "$bin_name" = "idea" ]; then
        desktop_file="$DESKTOP_DIR/IntelliJ-IDEA.desktop"
        categories="Development;IDE;Java;"
    elif [ "$bin_name" = "pycharm" ]; then
        desktop_file="$DESKTOP_DIR/PyCharm.desktop"
        categories="Development;IDE;Python;"
    fi

    cat <<EOF > "$desktop_file"
[Desktop Entry]
Type=Application
Name=${name}
Exec="${exec_path}" %f
Icon=${icon_path}
Terminal=false
Categories=${categories}
EOF
    chmod +x "$desktop_file"
    log_success "Created Desktop shortcut: $desktop_file"

    # Install Antigravity plugin
    log_info "Installing Antigravity plugin for ${name}..."
    if [ -x "$exec_path" ]; then
        if "$exec_path" installPlugins com.google.antigravity 2>&1; then
            log_success "Antigravity plugin installed successfully."
        else
            log_warn "Plugin CLI installation could not complete automatically. You can install Antigravity via IDE Settings -> Plugins."
        fi
    fi

    log_success "${name} installation completed!"
}

install_idea() {
    install_jetbrains_ide "IIC" "IntelliJ IDEA Community" "ideaIC" "idea" "bin/idea.sh"
}

install_pycharm() {
    install_jetbrains_ide "PCC" "PyCharm Community" "pycharm-community" "pycharm" "bin/pycharm.sh"
}

main() {
    local target="${1:-}"

    case "$target" in
        -h|--help)
            usage
            exit 0
            ;;
        -v|--version)
            echo "${PROG} v${VERSION}"
            exit 0
            ;;
        idea|intellij)
            install_idea
            ;;
        pycharm)
            install_pycharm
            ;;
        all|both)
            install_idea
            install_pycharm
            ;;
        "")
            if [ -t 0 ] && [ -t 1 ] && command -v gum &>/dev/null; then
                gum style --foreground 99 --border double --padding "1 2" \
                    "JetBrains On-Demand IDE Installer v${VERSION}" \
                    "Choose an IDE to install into your agy-box workspace:"
                local choice
                choice=$(gum choose "IntelliJ IDEA Community" "PyCharm Community" "Both (IntelliJ IDEA & PyCharm)" "Cancel / Exit")
                case "$choice" in
                    "IntelliJ IDEA Community")
                        install_idea
                        ;;
                    "PyCharm Community")
                        install_pycharm
                        ;;
                    "Both (IntelliJ IDEA & PyCharm)")
                        install_idea
                        install_pycharm
                        ;;
                    *)
                        log_info "No installation chosen. Exiting."
                        exit 0
                        ;;
                esac
            else
                usage
                exit 1
            fi
            ;;
        *)
            log_error "Unknown option: $target"
            usage >&2
            exit 1
            ;;
    esac
}

main "$@"
