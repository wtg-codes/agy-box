#!/bin/bash
# ==============================================================================
# agy-vdi
#
# Launches a virtual X11 display (Xvfb) and bridges it to a VNC server (x11vnc)
# and a browser-accessible HTML5 VNC viewer (noVNC / websockify).
# ==============================================================================

set -Eeuo pipefail

# Force Mesa to use software rendering to suppress hardware GPU device probing errors inside the container
export LIBGL_ALWAYS_SOFTWARE=1
export GALLIUM_DRIVER=llvmpipe

# Unset Wayland environment to prevent x11vnc and other X11 tools from
# attempting to connect to a Wayland host display exported by Distrobox
unset WAYLAND_DISPLAY
unset XDG_SESSION_TYPE

# Load and export environment variables defined in environment.d
# Helper to source all .conf files from a directory
_load_env_dir() {
    local dir="$1"
    if [ -d "$dir" ]; then
        for conf in "$dir"/*.conf; do
            if [ -f "$conf" ]; then
                while IFS= read -r line || [ -n "$line" ]; do
                    # Ignore comments, empty lines, and lines without =
                    if [[ ! "$line" =~ ^[[:space:]]*# ]] && [[ "$line" =~ = ]]; then
                        key=$(echo "$line" | cut -d= -f1 | xargs)
                        val=$(echo "$line" | cut -d= -f2- | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/^"//' -e 's/"$//')
                        export "$key"="$val"
                    fi
                done < "$conf"
            fi
        done
    fi
}

# Source the host home's environment.d first (Distrobox bind-mounts the host home)
_load_env_dir "${DISTROBOX_HOST_HOME:+${DISTROBOX_HOST_HOME}/.config/environment.d}"
# Then source the container's isolated home environment.d (overrides host values)
_load_env_dir "${HOME}/.config/environment.d"

DISPLAY_PORT=99
VNC_PORT=5900
WEB_PORT=6080
HEALTH_CHECK_RETRIES=5
HEALTH_CHECK_INTERVAL=1

# Colors for log prefixes
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m'

# Health-check helper: wait for a TCP port to be listening
wait_for_port() {
    local port="$1" label="$2" retries="$HEALTH_CHECK_RETRIES"
    for ((i=1; i<=retries; i++)); do
        if ss -tlnp 2>/dev/null | grep -q ":${port} "; then
            echo -e "${GREEN}[OK] ${label} is listening on port ${port}.${NC}"
            return 0
        fi
        sleep "$HEALTH_CHECK_INTERVAL"
    done
    echo -e "${RED}[ERROR] ${label} failed to start — port ${port} is not listening after ${retries}s.${NC}"
    echo -e "${YELLOW}[TIP] Check if WAYLAND_DISPLAY or XDG_SESSION_TYPE leaked into the container.${NC}"
    exit 1
}

RESOLUTION="1920x1080"

usage() {
    echo -e "Usage: $0 [options]"
    echo -e "Options:"
    echo -e "  -r, --resolution WxH    Set VDI resolution (default: 1920x1080)"
    echo -e "  -h, --help              Show this help message"
    exit 0
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -r|--resolution)
            if [[ $# -lt 2 ]]; then
                echo -e "${RED}[ERROR] --resolution requires an argument.${NC}" >&2
                exit 1
            fi
            RESOLUTION="$2"
            shift 2
            ;;
        -h|--help)
            usage
            ;;
        *)
            echo -e "${RED}[ERROR] Unknown option: $1${NC}" >&2
            usage
            ;;
    esac
done

# Validate and extract width and height
if [[ "$RESOLUTION" =~ ^([0-9]+)x([0-9]+)$ ]]; then
    WIDTH="${BASH_REMATCH[1]}"
    HEIGHT="${BASH_REMATCH[2]}"
else
    echo -e "${YELLOW}[WARN] Invalid resolution '$RESOLUTION'. Defaulting to 1920x1080.${NC}" >&2
    WIDTH=1920
    HEIGHT=1080
fi

cleanup() {
    echo -e "\n${YELLOW}[INFO] Cleaning up VDI session services...${NC}"
    
    # Terminate background jobs in the current process group
    local jobs_to_kill
    jobs_to_kill=$(jobs -p)
    if [[ -n "$jobs_to_kill" ]]; then
        # Kill the child processes gently, then forcefully if needed
        # shellcheck disable=SC2086
        kill $jobs_to_kill 2>/dev/null || true
        sleep 1
        # shellcheck disable=SC2086
        kill -9 $jobs_to_kill 2>/dev/null || true
    fi

    # Clean up lock files
    rm -f "/tmp/.X${DISPLAY_PORT}-lock" || true
    rm -f "/tmp/.X11-unix/X${DISPLAY_PORT}" || true
    
    echo -e "${GREEN}[SUCCESS] VDI cleanup complete. Bye!${NC}"
}

trap cleanup EXIT

echo -e "${BLUE}==================================================${NC}"
echo -e "${BLUE}        agy-box VDI Virtual Desktop Session       ${NC}"
echo -e "${BLUE}==================================================${NC}"

# Check dependencies
for cmd in Xvfb x11vnc icewm-session websockify; do
    if ! command -v "$cmd" &>/dev/null; then
        echo -e "${RED}[ERROR] Dependency '$cmd' is not installed in the container.${NC}"
        echo -e "${YELLOW}[TIP] Make sure the container was rebuilt with the latest VDI packages.${NC}"
        exit 1
    fi
done

# Clean up stale Chrome/Electron singleton lock files from previous sessions.
# When a container is destroyed or renamed, Chrome's profile lock (a symlink
# pointing to "hostname-pid") becomes stale. Chrome sees the hostname mismatch
# and refuses to start, believing "another computer" holds the lock.
_cleanup_stale_chrome_locks() {
    local profile_dir="$1"
    local lock_file="${profile_dir}/SingletonLock"
    if [[ -L "$lock_file" ]]; then
        local lock_target
        lock_target=$(readlink "$lock_file" 2>/dev/null || true)
        local lock_host="${lock_target%%-*}"
        local current_host
        current_host=$(hostname)
        if [[ "$lock_host" != "$current_host" ]]; then
            echo -e "${YELLOW}[WARN] Removing stale Chrome lock from previous session (${lock_host}).${NC}"
            rm -f "${profile_dir}/SingletonLock" "${profile_dir}/SingletonCookie" "${profile_dir}/SingletonSocket" 2>/dev/null || true
        fi
    fi
}

# Clean locks for Chrome and Electron-based apps (Antigravity, Antigravity IDE)
for chrome_profile in \
    "${HOME}/.config/google-chrome" \
    "${HOME}/.config/Antigravity-box" \
    "${HOME}/.config/Antigravity-ide-box" \
    "${HOME}/.config/Antigravity"; do
    _cleanup_stale_chrome_locks "$chrome_profile"
done

# Check if Xvfb is already running on :99
if [[ -f "/tmp/.X${DISPLAY_PORT}-lock" ]] || [[ -S "/tmp/.X11-unix/X${DISPLAY_PORT}" ]]; then
    echo -e "${YELLOW}[WARN] Port :${DISPLAY_PORT} lock file or socket exists. Cleaning up...${NC}"
    rm -f "/tmp/.X${DISPLAY_PORT}-lock" || true
    rm -f "/tmp/.X11-unix/X${DISPLAY_PORT}" || true
fi


# 1. Start Xvfb (Virtual Framebuffer)
echo -e "${BLUE}[INFO] Starting Xvfb virtual display :${DISPLAY_PORT} with resolution ${WIDTH}x${HEIGHT}...${NC}"
Xvfb :${DISPLAY_PORT} -screen 0 "${WIDTH}x${HEIGHT}x24" &
sleep 1.5

# Export display for subsequent tools
export DISPLAY=:${DISPLAY_PORT}

# 2. Start IceWM Session Manager
echo -e "${BLUE}[INFO] Starting IceWM Session Manager...${NC}"
icewm-session &
sleep 1

# 3. Start x11vnc server
echo -e "${BLUE}[INFO] Starting x11vnc server (listening on localhost)...${NC}"
x11vnc -display :${DISPLAY_PORT} \
       -listen 127.0.0.1 \
       -rfbport ${VNC_PORT} \
       -nopw \
       -forever \
       -shared \
       -quiet &
sleep 1.5
wait_for_port "${VNC_PORT}" "x11vnc"

# 4. Start noVNC/websockify bridge
echo -e "${BLUE}[INFO] Starting noVNC WebSocket bridge...${NC}"
if [[ -d "/usr/share/novnc" ]]; then
    websockify --web /usr/share/novnc/ 0.0.0.0:${WEB_PORT} 127.0.0.1:${VNC_PORT} &
else
    echo -e "${RED}[ERROR] noVNC directory /usr/share/novnc not found.${NC}"
    exit 1
fi
sleep 1.5
wait_for_port "${WEB_PORT}" "websockify"

# Detect host/container primary LAN IP address
local_ip=""
if command -v ip &>/dev/null; then
    local_ip=$(ip route get 1.1.1.1 2>/dev/null | awk '{print $7; exit}' || hostname -I | awk '{print $1}')
elif command -v hostname &>/dev/null; then
    local_ip=$(hostname -I | awk '{print $1}')
fi
local_ip=$(echo "${local_ip:-}" | xargs)

echo -e "\n${GREEN}==================================================${NC}"
echo -e "${GREEN}  agy-box VDI virtual desktop is running!         ${NC}"
echo -e "${GREEN}==================================================${NC}"
echo -e "${BLUE}Access the desktop inside your web browser at:${NC}"
echo -e "👉 ${GREEN}http://localhost:${WEB_PORT}/vnc.html?autoconnect=true&resize=scale${NC}"

if [[ -n "$local_ip" && "$local_ip" != "127.0.0.1" ]]; then
    echo -e "👉 ${GREEN}http://${local_ip}:${WEB_PORT}/vnc.html?autoconnect=true&resize=scale${NC} (LAN Access)"
fi
echo ""
echo -e "${YELLOW}[WARNING] Security Notice: VDI is listening on all interfaces (0.0.0.0) without a password.${NC}"
echo -e "${YELLOW}Ensure you are on a trusted local network.${NC}"
echo ""
echo -e "${YELLOW}Press [Ctrl+C] to stop the virtual desktop session.${NC}"

# 5. Set up the desktop environment
# 5a. Launch a terminal on the desktop
if command -v xterm &>/dev/null; then
    echo -e "${BLUE}[INFO] Launching terminal...${NC}"
    xterm -fa 'Monospace' -fs 12 -bg '#1a1b2e' -fg '#e0e0e0' -geometry 100x35+50+50 -T 'agy-box Terminal' &
fi

# 5b. Launch default desktop applications inside the VDI display
if command -v antigravity-ide &>/dev/null; then
    echo -e "${BLUE}[INFO] Automatically starting Antigravity IDE...${NC}"
    antigravity-ide &
elif command -v antigravity &>/dev/null; then
    echo -e "${BLUE}[INFO] Automatically starting Google Antigravity...${NC}"
    antigravity &
fi

# Block and keep shell open while monitoring all critical services
while true; do
    if ! kill -0 %1 2>/dev/null; then
        echo -e "${RED}[ERROR] Xvfb crashed unexpectedly.${NC}"
        exit 1
    fi
    if ! kill -0 %2 2>/dev/null; then
        echo -e "${RED}[ERROR] icewm-session crashed or exited unexpectedly.${NC}"
        exit 1
    fi
    if ! kill -0 %3 2>/dev/null; then
        echo -e "${RED}[ERROR] x11vnc crashed unexpectedly.${NC}"
        exit 1
    fi
    if ! kill -0 %4 2>/dev/null; then
        echo -e "${RED}[ERROR] websockify crashed unexpectedly.${NC}"
        exit 1
    fi
    sleep 2
done
