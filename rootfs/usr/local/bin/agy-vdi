#!/bin/bash
# ==============================================================================
# agy-vdi
#
# Launches a virtual X11 display (Xvfb) and bridges it to a VNC server (x11vnc)
# and a browser-accessible HTML5 VNC viewer (noVNC / websockify).
# ==============================================================================

set -Eeuo pipefail

# Force Mesa to use software rendering to suppress hardware GPU device probing errors inside the container
export LIBGL_ALWAYS_SOFTWARE=1
export GALLIUM_DRIVER=llvmpipe

# Unset Wayland environment to prevent x11vnc and other X11 tools from
# attempting to connect to a Wayland host display exported by Distrobox
unset WAYLAND_DISPLAY
unset XDG_SESSION_TYPE

if [[ -z "${HOME:-}" ]]; then
    HOME="$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6 || echo "/tmp")"
    export HOME
fi

LOCAL_DBUS_PID=""

# The Antigravity toolchain (antigravity, agy, gemini, adk) is
# installed per user into ~/.local/bin by agy-install-toolchain. agy-vdi is
# started via `distrobox enter -- agy-vdi` (non-login shell, host PATH), so add
# it here; IceWM, its menu/toolbar, desktop icons and xterms inherit this PATH.
case ":${PATH}:" in
    *":${HOME}/.local/bin:"*) ;;
    *) export PATH="${HOME}/.local/bin:${PATH}" ;;
esac

# Load and export environment variables defined in environment.d
_load_env_dir() {
    local dir="$1"
    if [ -d "$dir" ]; then
        for conf in "$dir"/*.conf; do
            if [ -f "$conf" ]; then
                while IFS= read -r line || [ -n "$line" ]; do
                    # Ignore comments, empty lines, and lines without =
                    if [[ ! "$line" =~ ^[[:space:]]*# ]] && [[ "$line" =~ = ]]; then
                        key=$(echo "$line" | cut -d= -f1 | xargs)
                        val=$(echo "$line" | cut -d= -f2- | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/^"//' -e 's/"$//')
                        export "$key"="$val"
                    fi
                done < "$conf"
            fi
        done
    fi
}

# Source the host home's environment.d first (Distrobox bind-mounts the host home)
_load_env_dir "${DISTROBOX_HOST_HOME:+${DISTROBOX_HOST_HOME}/.config/environment.d}"
# Then source the container's isolated home environment.d (overrides host values)
_load_env_dir "${HOME}/.config/environment.d"

DISPLAY_PORT="${DISPLAY_PORT:-99}"
VNC_PORT="${VNC_PORT:-5900}"
WEB_PORT="${VDI_PORT:-${WEB_PORT:-6080}}"
HEALTH_CHECK_RETRIES=5
HEALTH_CHECK_INTERVAL=1

# Colors for log prefixes
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m'

VDI_STATE_DIR="${AGY_BOX_STATE_DIR:-${HOME}/.local/state/agy-box}"
VDI_LOG_FILE="${VDI_STATE_DIR}/vdi.log"
VDI_COMPAT_LOG="${AGY_VDI_COMPAT_LOG:-/tmp/agy-vdi.log}"

vdi_log() {
    local tag="$1"
    shift
    [[ "${AGY_LOG_DISABLED:-0}" == "1" ]] && return 0
    if [[ -w "$VDI_LOG_FILE" ]] && ! [[ /dev/fd/1 -ef "$VDI_LOG_FILE" ]]; then
        printf '[%s] [agy-vdi] [%s] %s\n' "$(date -Iseconds)" "$tag" "$*" >> "$VDI_LOG_FILE" 2>/dev/null || true
    elif [[ /dev/fd/1 -ef "$VDI_LOG_FILE" ]]; then
        printf '[%s] [agy-vdi] [%s] %s\n' "$(date -Iseconds)" "$tag" "$*"
    fi
}

# Health-check helper: wait for a TCP port to be listening
wait_for_port() {
    local port="$1" label="$2" retries="$HEALTH_CHECK_RETRIES"
    for ((i=1; i<=retries; i++)); do
        if ss -tlnp 2>/dev/null | grep -q ":${port} "; then
            echo -e "${GREEN}[OK] ${label} is listening on port ${port}.${NC}"
            vdi_log "EXIT" "rc=0 ${label} listening on port ${port} (attempt ${i}/${retries})"
            return 0
        fi
        sleep "$HEALTH_CHECK_INTERVAL"
    done
    echo -e "${RED}[ERROR] ${label} failed to start — port ${port} is not listening after ${retries}s.${NC}"
    echo -e "${YELLOW}[TIP] Check if WAYLAND_DISPLAY or XDG_SESSION_TYPE leaked into the container.${NC}"
    vdi_log "EXIT" "rc=1 ${label} failed to listen on port ${port} after ${retries}s"
    exit 1
}

RESOLUTION="1920x1080"

usage() {
    echo -e "Usage: $0 [options]"
    echo -e "Options:"
    echo -e "  -p, --port PORT         Set VDI web port (default: 6080)"
    echo -e "  -r, --resolution WxH    Set VDI resolution (default: 1920x1080)"
    echo -e "  -h, --help              Show this help message"
    exit 0
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -p|--port)
            if [[ $# -lt 2 ]]; then
                echo -e "${RED}[ERROR] --port requires an argument.${NC}" >&2
                exit 1
            fi
            WEB_PORT="$2"
            shift 2
            ;;
        -r|--resolution)
            if [[ $# -lt 2 ]]; then
                echo -e "${RED}[ERROR] --resolution requires an argument.${NC}" >&2
                exit 1
            fi
            RESOLUTION="$2"
            shift 2
            ;;
        -h|--help)
            usage
            ;;
        *)
            echo -e "${RED}[ERROR] Unknown option: $1${NC}" >&2
            usage
            ;;
    esac
done

# Initialize container-side structured log file & /tmp/agy-vdi.log symlink
if [[ "${AGY_LOG_DISABLED:-0}" != "1" ]]; then
    mkdir -p "$VDI_STATE_DIR" 2>/dev/null || true
    touch "$VDI_LOG_FILE" 2>/dev/null || true
    if [[ -f "$VDI_LOG_FILE" ]]; then
        ln -sf "$VDI_LOG_FILE" "$VDI_COMPAT_LOG" 2>/dev/null || true
    fi
fi

# Compute port offsets to avoid X11 and VNC collisions when running multiple instances
if [[ "$WEB_PORT" =~ ^[0-9]+$ ]] && [[ "$WEB_PORT" -ne 6080 ]]; then
    PORT_OFFSET=$((WEB_PORT - 6080))
    DISPLAY_PORT=$((99 + PORT_OFFSET))
    VNC_PORT=$((5900 + PORT_OFFSET))
fi

# Validate and extract width and height
if [[ "$RESOLUTION" =~ ^([0-9]+)x([0-9]+)$ ]]; then
    WIDTH="${BASH_REMATCH[1]}"
    HEIGHT="${BASH_REMATCH[2]}"
else
    echo -e "${YELLOW}[WARN] Invalid resolution '$RESOLUTION'. Defaulting to 1920x1080.${NC}" >&2
    vdi_log "WARN" "Invalid resolution '${RESOLUTION}'; defaulting to 1920x1080"
    WIDTH=1920
    HEIGHT=1080
fi

vdi_log "INFO" "Starting VDI session (display=:${DISPLAY_PORT}, vnc_port=${VNC_PORT}, web_port=${WEB_PORT}, resolution=${WIDTH}x${HEIGHT})"

# shellcheck disable=SC2329
cleanup() {
    echo -e "\n${YELLOW}[INFO] Cleaning up VDI session services...${NC}"
    vdi_log "INFO" "Cleaning up VDI session services on display :${DISPLAY_PORT}"

    # Terminate background jobs in the current process group
    local jobs_to_kill
    jobs_to_kill=$(jobs -p)
    if [[ -n "$jobs_to_kill" ]]; then
        # Kill the child processes gently, then forcefully if needed
        # shellcheck disable=SC2086
        kill $jobs_to_kill 2>/dev/null || true
        sleep 1
        # shellcheck disable=SC2086
        kill -9 $jobs_to_kill 2>/dev/null || true
    fi

    if [[ -n "${LOCAL_DBUS_PID:-}" ]]; then
        kill "$LOCAL_DBUS_PID" 2>/dev/null || true
    fi

    # Clean up lock files
    rm -f "/tmp/.X${DISPLAY_PORT}-lock" || true
    rm -f "/tmp/.X11-unix/X${DISPLAY_PORT}" || true

    echo -e "${GREEN}[SUCCESS] VDI cleanup complete. Bye!${NC}"
    vdi_log "INFO" "VDI session cleanup complete"
}

trap cleanup EXIT INT TERM HUP

echo -e "${BLUE}==================================================${NC}"
echo -e "${BLUE}        agy-box VDI Virtual Desktop Session       ${NC}"
echo -e "${BLUE}==================================================${NC}"

# Check dependencies
for cmd in Xvfb x11vnc icewm-session websockify; do
    if ! command -v "$cmd" &>/dev/null; then
        echo -e "${RED}[ERROR] Dependency '$cmd' is not installed in the container.${NC}"
        echo -e "${YELLOW}[TIP] Make sure the container was rebuilt with the latest VDI packages.${NC}"
        vdi_log "ERROR" "Dependency '${cmd}' missing; aborting VDI startup"
        vdi_log "EXIT" "rc=1 missing dependency ${cmd}"
        exit 1
    fi
done

# Clean up stale Chrome/Electron singleton lock files from previous sessions.
_cleanup_stale_chrome_locks() {
    local profile_dir="$1"
    local lock_file="${profile_dir}/SingletonLock"
    if [[ -L "$lock_file" ]]; then
        local lock_target
        lock_target=$(readlink "$lock_file" 2>/dev/null || true)
        local lock_host="${lock_target%%-*}"
        local current_host
        current_host=$(hostname)
        if [[ "$lock_host" != "$current_host" ]]; then
            echo -e "${YELLOW}[WARN] Removing stale Chrome lock from previous session (${lock_host}).${NC}"
            vdi_log "WARN" "Removed stale Chrome lock in ${profile_dir} (lock_host=${lock_host}, current_host=${current_host})"
            rm -f "${profile_dir}/SingletonLock" "${profile_dir}/SingletonCookie" "${profile_dir}/SingletonSocket" 2>/dev/null || true
        fi
    fi
}

# Clean locks for Chrome and Electron-based apps (Antigravity)
for chrome_profile in \
    "${HOME}/.config/google-chrome" \
    "${HOME}/.config/Antigravity-box" \
    "${HOME}/.config/Antigravity"; do
    _cleanup_stale_chrome_locks "$chrome_profile"
done

# Clean up any stale VDI processes or lock files on our target ports/display
pkill -f "Xvfb :${DISPLAY_PORT}" 2>/dev/null || true
pkill -f "x11vnc.*${VNC_PORT}" 2>/dev/null || true
pkill -f "websockify.*${WEB_PORT}" 2>/dev/null || true
rm -f "/tmp/.X${DISPLAY_PORT}-lock" "/tmp/.X11-unix/X${DISPLAY_PORT}" 2>/dev/null || true

# Ensure PCManFM (libfm) executes .desktop icons directly without "Execute File" modal prompt
mkdir -p "${HOME}/.config/libfm"
if [[ ! -f "${HOME}/.config/libfm/libfm.conf" ]]; then
    printf '[config]\nquick_exec=1\n' > "${HOME}/.config/libfm/libfm.conf"
elif grep -q '^[#[:space:]]*quick_exec=' "${HOME}/.config/libfm/libfm.conf"; then
    sed -i 's/^[#[:space:]]*quick_exec=.*/quick_exec=1/' "${HOME}/.config/libfm/libfm.conf"
elif grep -q '^\[config\]' "${HOME}/.config/libfm/libfm.conf"; then
    sed -i '/^\[config\]/a quick_exec=1' "${HOME}/.config/libfm/libfm.conf"
else
    printf '\n[config]\nquick_exec=1\n' >> "${HOME}/.config/libfm/libfm.conf"
fi
vdi_log "INFO" "Configured PCManFM quick_exec=1 in ${HOME}/.config/libfm/libfm.conf"

# Deduplicate legacy desktop shortcuts and seed missing launchers from /etc/skel/Desktop
mkdir -p "${HOME}/Desktop"
rm -f "${HOME}/Desktop/Antigravity2.desktop" \
      "${HOME}/Desktop/AntigravityIDE.desktop" \
      "${HOME}/Desktop/google-antigravity.desktop" \
      "${HOME}/Desktop/SetupAssistant.desktop" \
      "${HOME}/Desktop/Setup.desktop" 2>/dev/null || true
if [[ -f "${HOME}/Desktop/AntigravitySDK.desktop" && -f /etc/skel/Desktop/AntigravitySDK.desktop ]] && \
   grep -q '^Name=Google Antigravity (SDK)$' "${HOME}/Desktop/AntigravitySDK.desktop" 2>/dev/null; then
    cp -f /etc/skel/Desktop/AntigravitySDK.desktop "${HOME}/Desktop/AntigravitySDK.desktop" 2>/dev/null || true
fi
if [[ -d /etc/skel/Desktop ]]; then
    cp -rn /etc/skel/Desktop/. "${HOME}/Desktop/" 2>/dev/null || true
fi
chmod +x "${HOME}"/Desktop/*.desktop 2>/dev/null || true

# Upgrade any outdated user-level ~/.local/bin/antigravity wrapper lacking --password-store=basic
if [[ -f "${HOME}/.local/bin/antigravity" && -f /usr/local/bin/antigravity ]] && \
   head -n 1 "${HOME}/.local/bin/antigravity" 2>/dev/null | grep -q '^#!' && \
   ! grep -q -- '--password-store=basic' "${HOME}/.local/bin/antigravity" 2>/dev/null; then
    cp -f /usr/local/bin/antigravity "${HOME}/.local/bin/antigravity" 2>/dev/null || true
    chmod 0755 "${HOME}/.local/bin/antigravity" 2>/dev/null || true
    vdi_log "INFO" "Upgraded user ~/.local/bin/antigravity wrapper with --password-store=basic fallback"
fi

# Configure session D-Bus & SecretService / persistent basic password-store fallback
_dbus_bus_reachable() {
    [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]] || return 1
    if [[ "$DBUS_SESSION_BUS_ADDRESS" =~ unix:path=([^,;]+) ]]; then
        [[ -S "${BASH_REMATCH[1]}" ]] || return 1
    fi
    if command -v dbus-send &>/dev/null; then
        dbus-send --session --reply-timeout=1500 --dest=org.freedesktop.DBus --type=method_call --print-reply \
            /org/freedesktop/DBus org.freedesktop.DBus.ListNames >/dev/null 2>&1 || return 1
    fi
    return 0
}

_dbus_has_secrets_service() {
    command -v dbus-send &>/dev/null || return 1
    if dbus-send --session --reply-timeout=1500 --dest=org.freedesktop.DBus --type=method_call --print-reply \
        /org/freedesktop/DBus org.freedesktop.DBus.ListNames 2>/dev/null | grep -q 'org\.freedesktop\.secrets'; then
        return 0
    fi
    if dbus-send --session --reply-timeout=1500 --dest=org.freedesktop.DBus --type=method_call --print-reply \
        /org/freedesktop/DBus org.freedesktop.DBus.ListActivatableNames 2>/dev/null | grep -q 'org\.freedesktop\.secrets'; then
        return 0
    fi
    return 1
}

if [[ "${AGY_KEYRING_MODE:-host}" == "isolated" ]]; then
    unset DBUS_SESSION_BUS_ADDRESS
fi

if ! _dbus_bus_reachable; then
    if [[ -z "${XDG_RUNTIME_DIR:-}" || ! -d "${XDG_RUNTIME_DIR}" || ! -w "${XDG_RUNTIME_DIR}" ]]; then
        XDG_RUNTIME_DIR="/tmp/agy-runtime-$(id -u)"
        mkdir -p "$XDG_RUNTIME_DIR"
        chmod 700 "$XDG_RUNTIME_DIR"
        export XDG_RUNTIME_DIR
    fi
    if command -v dbus-daemon >/dev/null 2>&1; then
        vdi_log "CMD" "dbus-daemon --session --fork --print-address=1 --print-pid=1"
        dbus_out=$(dbus-daemon --session --fork --print-address=1 --print-pid=1 2>/dev/null || true)
        if [[ -n "$dbus_out" ]]; then
            DBUS_SESSION_BUS_ADDRESS=$(printf '%s\n' "$dbus_out" | sed -n '1p')
            LOCAL_DBUS_PID=$(printf '%s\n' "$dbus_out" | sed -n '2p')
            export DBUS_SESSION_BUS_ADDRESS
            vdi_log "INFO" "Spawned local session dbus-daemon (pid=${LOCAL_DBUS_PID}, bus=${DBUS_SESSION_BUS_ADDRESS})"
        fi
    fi
    export AGY_PASSWORD_STORE=basic
    vdi_log "INFO" "Keyring mode: AGY_PASSWORD_STORE=basic (session bus started locally)"
elif [[ "${AGY_KEYRING_MODE:-host}" == "isolated" ]] || ! _dbus_has_secrets_service; then
    export AGY_PASSWORD_STORE=basic
    vdi_log "INFO" "Keyring mode: AGY_PASSWORD_STORE=basic (isolated or org.freedesktop.secrets absent)"
else
    vdi_log "INFO" "Keyring mode: host SecretService active over ${DBUS_SESSION_BUS_ADDRESS:-session-bus}"
fi

# 1. Start Xvfb (Virtual Framebuffer)
echo -e "${BLUE}[INFO] Starting Xvfb virtual display :${DISPLAY_PORT} with resolution ${WIDTH}x${HEIGHT}...${NC}"
vdi_log "CMD" "Xvfb :${DISPLAY_PORT} -screen 0 ${WIDTH}x${HEIGHT}x24"
Xvfb ":${DISPLAY_PORT}" -screen 0 "${WIDTH}x${HEIGHT}x24" &
XVFB_PID=$!
vdi_log "INFO" "Xvfb started (pid=${XVFB_PID})"
sleep 1.5

# Export display for subsequent tools
export DISPLAY=":${DISPLAY_PORT}"

# 2. Start IceWM Session Manager (launches PCManFM desktop icons via /etc/X11/icewm/startup)
echo -e "${BLUE}[INFO] Starting IceWM Session Manager...${NC}"
vdi_log "CMD" "icewm-session (DISPLAY=${DISPLAY}, PCManFM desktop enabled)"
icewm-session &
ICEWM_PID=$!
vdi_log "INFO" "icewm-session started (pid=${ICEWM_PID})"
sleep 1

# 3. Start x11vnc server
echo -e "${BLUE}[INFO] Starting x11vnc server (listening on localhost)...${NC}"
vdi_log "CMD" "x11vnc -display :${DISPLAY_PORT} -listen 127.0.0.1 -rfbport ${VNC_PORT} -nopw -forever -shared -quiet"
x11vnc -display ":${DISPLAY_PORT}" \
       -listen 127.0.0.1 \
       -rfbport "${VNC_PORT}" \
       -nopw \
       -forever \
       -shared \
       -quiet &
X11VNC_PID=$!
vdi_log "INFO" "x11vnc started (pid=${X11VNC_PID})"
sleep 1.5
wait_for_port "${VNC_PORT}" "x11vnc"

# 4. Start noVNC/websockify bridge
echo -e "${BLUE}[INFO] Starting noVNC WebSocket bridge...${NC}"
if [[ -d "/usr/share/novnc" ]]; then
    vdi_log "CMD" "websockify --web /usr/share/novnc/ ${WEB_PORT} 127.0.0.1:${VNC_PORT}"
    websockify --web /usr/share/novnc/ "${WEB_PORT}" "127.0.0.1:${VNC_PORT}" &
    WEBSOCKIFY_PID=$!
    vdi_log "INFO" "websockify started (pid=${WEBSOCKIFY_PID})"
else
    echo -e "${RED}[ERROR] noVNC directory /usr/share/novnc not found.${NC}"
    vdi_log "ERROR" "noVNC directory /usr/share/novnc not found"
    vdi_log "EXIT" "rc=1 /usr/share/novnc missing"
    exit 1
fi
sleep 1.5
wait_for_port "${WEB_PORT}" "websockify"

# Detect host/container primary LAN IP address
local_ip=""
if command -v ip &>/dev/null; then
    local_ip=$(ip route get 1.1.1.1 2>/dev/null | awk '{print $7; exit}' || true)
    if [[ -z "$local_ip" ]] && command -v hostname &>/dev/null; then
        local_ip=$(hostname -I 2>/dev/null | awk '{print $1}' || true)
    fi
elif command -v hostname &>/dev/null; then
    local_ip=$(hostname -I 2>/dev/null | awk '{print $1}' || true)
fi
local_ip=$(echo "${local_ip:-}" | xargs 2>/dev/null || true)

vdi_log "INFO" "VDI ready at http://127.0.0.1:${WEB_PORT}/vnc.html?autoconnect=true&resize=scale&path=websockify"

echo -e "\n${GREEN}==================================================${NC}"
echo -e "${GREEN}  agy-box VDI virtual desktop is running!         ${NC}"
echo -e "${GREEN}==================================================${NC}"
echo -e "${BLUE}Access the desktop inside your web browser at:${NC}"
echo -e "👉 ${GREEN}http://127.0.0.1:${WEB_PORT}/vnc.html?autoconnect=true&resize=scale&path=websockify${NC}"

if [[ -n "$local_ip" && "$local_ip" != "127.0.0.1" ]]; then
    echo -e "👉 ${GREEN}http://${local_ip}:${WEB_PORT}/vnc.html?autoconnect=true&resize=scale&path=websockify${NC} (LAN Access)"
fi
echo ""
echo -e "${YELLOW}[WARNING] Security Notice: VDI is listening on all interfaces (0.0.0.0) without a password.${NC}"
echo -e "${YELLOW}Ensure you are on a trusted local network.${NC}"
echo ""
echo -e "${YELLOW}Press [q] or [Ctrl+C] to stop the virtual desktop session.${NC}"

# 5. Set up the desktop environment
if command -v xterm &>/dev/null; then
    echo -e "${BLUE}[INFO] Launching terminal...${NC}"
    vdi_log "CMD" "xterm -T 'agy-box Terminal'"
    xterm -fa 'Monospace' -fs 12 -bg '#1a1b2e' -fg '#e0e0e0' -geometry 100x35+50+50 -T 'agy-box Terminal' &
fi

# Block and keep shell open while monitoring all critical services
while true; do
    if [ -t 0 ]; then
        if read -r -s -n 1 -t 2 key; then
            if [[ "$key" == "q" || "$key" == "Q" ]]; then
                echo -e "\n${BLUE}[INFO] Ending VDI session...${NC}"
                vdi_log "INFO" "User requested VDI shutdown"
                exit 0
            fi
        fi
    else
        sleep 2
    fi
    if ! kill -0 "$XVFB_PID" 2>/dev/null; then
        echo -e "${RED}[ERROR] Xvfb crashed unexpectedly.${NC}"
        vdi_log "ERROR" "Xvfb (pid=${XVFB_PID}) crashed unexpectedly"
        vdi_log "EXIT" "rc=1 Xvfb crash"
        exit 1
    fi
    if ! kill -0 "$ICEWM_PID" 2>/dev/null; then
        echo -e "${RED}[ERROR] icewm-session crashed or exited unexpectedly.${NC}"
        vdi_log "ERROR" "icewm-session (pid=${ICEWM_PID}) crashed unexpectedly"
        vdi_log "EXIT" "rc=1 icewm-session crash"
        exit 1
    fi
    if ! kill -0 "$X11VNC_PID" 2>/dev/null; then
        echo -e "${RED}[ERROR] x11vnc crashed unexpectedly.${NC}"
        vdi_log "ERROR" "x11vnc (pid=${X11VNC_PID}) crashed unexpectedly"
        vdi_log "EXIT" "rc=1 x11vnc crash"
        exit 1
    fi
    if ! kill -0 "$WEBSOCKIFY_PID" 2>/dev/null; then
        echo -e "${RED}[ERROR] websockify crashed unexpectedly.${NC}"
        vdi_log "ERROR" "websockify (pid=${WEBSOCKIFY_PID}) crashed unexpectedly"
        vdi_log "EXIT" "rc=1 websockify crash"
        exit 1
    fi
done
