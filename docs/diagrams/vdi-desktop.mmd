        Websockify["fa:fa-network-wired websockify <br> (0.0.0.0:6080)"]
        X11VNC["fa:fa-desktop x11vnc <br> (Port 5900, 127.0.0.1)"]
        IceWM["fa:fa-window-restore IceWM Window Manager + PCManFM desktop <br> (DISPLAY=:99)"]
