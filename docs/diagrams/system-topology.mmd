graph TD
    subgraph Host ["Host OS (Immutable/Atomic e.g., Bluefin, Silverblue)"]
        UserHome["fa:fa-home User Home (~/) <br> stores .config/environment.d/agy-box.conf"]
        Display["fa:fa-desktop Display Server (Wayland / X11)"]
        DBus["fa:fa-circle-nodes D-Bus Session Bus <br> (Secret Service / GNOME Keyring)"]
        FlatpakChrome["fa:fa-chrome Un-sandboxed Chrome Binary <br> (/var/lib/flatpak/.../chrome)"]
    end

    subgraph Bridge ["Distrobox Bridge"]
        MountHome["fa:fa-folder-open Home Volume Mount"]
        ForwardSockets["fa:fa-link Socket Forwarding (X11/Wayland/DBUS)"]
    end

    subgraph Sandbox ["agy-box Sandbox Container (Ubuntu Toolbox Base)"]
        BaseOS["fa:fa-linux Base OS Layer (Ubuntu)"]
        KeyringClient["fa:fa-key Keyring integration (libsecret-1-0)"]
        
        subgraph Setup ["First-Time Setup Assistant"]
            SetupHelper["fa:fa-wand-magic-sparkles agy-setup-helper <br> (checks API Keys, Keyring, Git, Chrome)"]
            ProfileHook["fa:fa-terminal /etc/profile.d/agy-setup-check.sh"]
        end

        subgraph Suite ["Antigravity Developer Suite"]
            AgentUI["fa:fa-window-restore Google Antigravity (Agent UI) <br> (canvas workspace, terminal, course labs)"]
            IDE["fa:fa-code Antigravity IDE <br> (VS Code-based developer environment)"]
            CLI["fa:fa-terminal Antigravity CLI (agy) <br> (WebSocket loops, lab submission)"]
            SDK["fa:fa-cubes Antigravity Python SDK (google-antigravity) <br> (GCS auth, local Port 8080 API)"]
            ChromeWrapper["fa:fa-chrome Google Chrome <br> (google-chrome-stable wrapper)"]
        end
    end

    UserHome <-->|"Mounts to /var/home/wtg"| MountHome
    MountHome <--> BaseOS
    
    DBus -->|"Forward D-Bus Socket"| ForwardSockets
    ForwardSockets --> KeyringClient
    KeyringClient -->|"Decrypt tokens"| ChromeWrapper
    KeyringClient -->|"Decrypt tokens"| AgentUI
    KeyringClient -->|"Decrypt tokens"| IDE
    
    Display -->|"X11 / Wayland Socket Forwarding"| ForwardSockets
    ForwardSockets --> AgentUI
    ForwardSockets --> IDE
    ForwardSockets --> ChromeWrapper
    
    AgentUI <-->|"WebSocket Loop"| CLI
    IDE <-->|"WebSocket Loop"| CLI
    SDK -->|"Local API calls (Port 8080)"| AgentUI
    AgentUI -->|"Chrome DevTools Protocol (CDP)"| ChromeWrapper
    IDE -->|"Chrome DevTools Protocol (CDP)"| ChromeWrapper
    ChromeWrapper -->|"Launch un-sandboxed"| FlatpakChrome
    
    ProfileHook -->|"Trigger on first bash login"| SetupHelper
    SetupHelper -->|"Verify & write keys"| UserHome

    %% Modern Theme Styling
    classDef host host;
    classDef bridge bridge;
    classDef sandbox sandbox;
    classDef setup setup;

    class UserHome,Display,DBus,FlatpakChrome host;
    class MountHome,ForwardSockets bridge;
    class BaseOS,KeyringClient,IDE,CLI,SDK,ChromeWrapper,AgentUI sandbox;
    class SetupHelper,ProfileHook setup;
