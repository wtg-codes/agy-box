    { "id": "keyring_selection", "lane": "credential_setup", "col": 3, "type": "security", "label": "Keyring Mode Selection", "sublabel": "Host D-Bus vs Isolated file keyring", "width": 160 },
    { "id": "write_config", "lane": "credential_setup", "col": 4, "type": "database", "label": "Write config.env", "sublabel": "~/.config/agy-box/environment.d", "width": 150 },
    { "id": "shell_handoff", "lane": "shell_hook", "col": 5, "type": "backend", "label": "Handoff to Shell", "sublabel": "Create .setup_done & launch", "width": 150 },
