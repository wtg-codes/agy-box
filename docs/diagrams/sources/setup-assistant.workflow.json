  "cards": [
    {
      "dot": "cyan",
      "title": "First-Run Lifecycle",
      "items": [
        "Triggered automatically on first interactive terminal login via /etc/profile.d",
        "Skips instantly if ~/.config/agy-box/.setup_done marker exists",
        "Zero-configuration fallback allows non-interactive CI/CD runs"
      ]
    },
    {
      "dot": "rose",
      "title": "Security & Credentials",
      "items": [
        "Interactive Gum TUI prompts for GEMINI_API_KEY and Git identity",
        "Keyring mode configures either host D-Bus forwarding or isolated file keyring",
        "Keys written securely to environment.d/agy-box.conf with restricted permissions"
      ]
    },
    {
      "dot": "emerald",
      "title": "Developer Handoff",
      "items": [
        "Verifies Chrome, CNCF tools, and Antigravity toolchain health",
        "Creates completion sentinel file to prevent repeated prompts",
        "Hands off seamlessly to user's interactive shell session"
      ]
    }
  ]
