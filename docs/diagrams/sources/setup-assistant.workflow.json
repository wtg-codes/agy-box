    { "id": "keyring-to-write", "from": "keyring_selection", "to": "write_config", "label": "persist settings", "variant": "security" },
    { "id": "write-to-handoff", "from": "write_config", "to": "shell_handoff", "label": "done flag", "variant": "emphasis" },
