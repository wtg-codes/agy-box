    mkdir -p "$fish_func_dir"

    cat << 'EOF' > "$fish_func_dir/ujust.fish"
function ujust
    if not set -q argv[1]
        if test -f /usr/bin/ujust
            /usr/bin/ujust
        end
        if test -f "$HOME/.config/agy-box/justfile"
            echo ""
            echo "Antigravity Dev Box commands (run with ujust <command>):"
            just --justfile "$HOME/.config/agy-box/justfile" --list --list-heading "" --list-prefix " - "
