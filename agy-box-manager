#!/bin/bash
# agy-box-manager - A modern CLI for managing the agy-box Distrobox environment

set -euo pipefail

# --- Configuration ---
VERSION="2.1.0"
IMAGE_NAME="ghcr.io/wtg-codes/agy-box:latest"
DEV_IMAGE_NAME="agy-box:dev"
CONTAINER_NAME="agy-box"
DEV_CONTAINER_NAME="agy-box-dev"
REMOTE_SCRIPT_URL="https://raw.githubusercontent.com/wtg-codes/agy-box/main/agy-box-manager"

# --- Colors for ASCII Art ---
RED=$'\e[0;31m'
GREEN=$'\e[0;32m'
YELLOW=$'\e[1;33m'
BLUE=$'\e[0;34m'
CYAN=$'\e[0;36m'
WHITE=$'\e[1;37m'
NC=$'\e[0m' # No Color

# --- Helper Functions ---
get_os_name() {
    if [ -f /etc/os-release ]; then
        # shellcheck disable=SC1091
        . /etc/os-release
        echo "${PRETTY_NAME:-Linux}"
    else
        echo "Linux"
    fi
}

probe_host_capabilities() {
    local mode=${1:-}
    if command -v podman >/dev/null 2>&1; then
        export DBX_CONTAINER_MANAGER="podman"
    elif command -v docker >/dev/null 2>&1; then
        export DBX_CONTAINER_MANAGER="docker"
        
        if [ "$mode" != "menu" ]; then
            # Check if Docker daemon is running and user has access
            if ! docker info >/dev/null 2>&1; then
                gum style --foreground 196 --border rounded --padding "0 2" --margin "1 0" \
                    "❌ ERROR: Docker daemon is unreachable!" \
                    "Please check if the Docker service is active, or add your user" \
                    "to the 'docker' Unix group:" \
                    "  sudo usermod -aG docker $USER" \
                    "You may need to log out and log back in for changes to apply."
            elif ! docker info 2>/dev/null | grep -q "rootless"; then
                gum style --foreground 214 --border rounded --padding "0 2" --margin "1 0" \
                    "⚠️ CAUTION: Rootful Docker detected!" \
                    "Since standard Docker runs as a root daemon, files written to" \
                    "your mounted home directory may be saved with root ownership." \
                    "Consider setting up rootless Docker or installing Podman."
            fi
        fi
    elif [ "$mode" != "menu" ]; then
        gum style --foreground 196 --border rounded --padding "0 2" --margin "1 0" \
            "❌ ERROR: No container runtime found!" \
            "Please install either Podman (Highly Recommended) or Docker."
        exit 1
    fi
}

# --- Dependency Management ---
install_gum() {
    echo -e "${CYAN}Gum is required for the UI but is not installed.${NC}"
    # When piped via curl, read needs to be forced to /dev/tty
    exec < /dev/tty
    read -r -p "Would you like to attempt to install it now? (y/N): " choice
    if [[ "$choice" =~ ^[Yy]$ ]]; then
        if command -v brew &> /dev/null; then
            echo "Installing via Homebrew (Recommended for immutable systems)..."
            brew install gum
        elif command -v apt-get &> /dev/null; then
            echo "Installing via APT (Debian/Ubuntu)..."
            sudo mkdir -p /etc/apt/keyrings
            curl -fsSL https://repo.charm.sh/apt/gpg.key | sudo gpg --dearmor -o /etc/apt/keyrings/charm.gpg
            echo "deb [signed-by=/etc/apt/keyrings/charm.gpg] https://repo.charm.sh/apt/ * *" | sudo tee /etc/apt/sources.list.d/charm.list
            sudo apt update && sudo apt install -y gum
        elif command -v dnf &> /dev/null; then
            echo "Installing via DNF (Fedora/RHEL)..."
            echo '[charm]
name=Charm
baseurl=https://repo.charm.sh/yum/
enabled=1
gpgcheck=1
gpgkey=https://repo.charm.sh/yum/gpg.key' | sudo tee /etc/yum.repos.d/charm.repo
            sudo dnf install -y gum
        elif command -v pacman &> /dev/null; then
            echo "Installing via Pacman (Arch/Manjaro)..."
            sudo pacman -S --noconfirm gum
        elif command -v zypper &> /dev/null; then
            echo "Installing via Zypper (openSUSE)..."
            echo '[charm]
name=Charm
baseurl=https://repo.charm.sh/yum/
enabled=1
gpgcheck=1
gpgkey=https://repo.charm.sh/yum/gpg.key' | sudo tee /etc/zypp/repos.d/charm.repo
            sudo zypper install -y gum
        else
            echo -e "${RED}Could not detect supported package manager (brew, apt, dnf, pacman, zypper).${NC}"
            echo "Please install manually: https://github.com/charmbracelet/gum#installation"
            exit 1
        fi
    else
        echo "Gum is required to run this script interactively. Exiting."
        exit 1
    fi
}

check_deps() {
    local mode=${1:-}
    if ! command -v gum &> /dev/null; then
        install_gum
    fi

    # Initialize container engine binding
    probe_host_capabilities "$mode"

    if [ "$mode" = "menu" ]; then
        return 0
    fi

    local missing=0
    if ! command -v distrobox &> /dev/null; then
        echo -e "${RED}✗ Error: distrobox is not installed on the host system.${NC}" >&2
        missing=1
    fi
    if ! command -v podman &> /dev/null && ! command -v docker &> /dev/null; then
        echo -e "${RED}✗ Error: Neither podman nor docker is installed on the host system.${NC}" >&2
        missing=1
    fi
    if [ $missing -eq 1 ]; then
        echo -e "\n${CYAN}Would you like to try installing the missing container dependencies now?${NC}"
        exec < /dev/tty
        if gum confirm "Install missing dependencies?"; then
            if command -v apt-get &> /dev/null; then
                sudo apt update && sudo apt install -y podman distrobox
            elif command -v dnf &> /dev/null; then
                sudo dnf install -y podman distrobox
            elif command -v pacman &> /dev/null; then
                sudo pacman -S --noconfirm podman distrobox
            elif command -v zypper &> /dev/null; then
                sudo zypper install -y podman distrobox
            elif command -v brew &> /dev/null; then
                brew install podman distrobox
            else
                echo -e "${RED}Could not detect a supported package manager. Please install manually.${NC}"
                exit 1
            fi

            # Re-check dependencies
            if ! command -v distrobox &> /dev/null || (! command -v podman &> /dev/null && ! command -v docker &> /dev/null); then
                echo -e "${RED}Dependencies still missing after installation attempt. Please install manually.${NC}"
                exit 1
            else
                echo -e "${CYAN}Dependencies installed successfully!${NC}"
            fi
        else
            echo -e "\nPlease install the missing container dependencies and try again."
            exit 1
        fi
    fi

}

get_runtime() {
    if command -v podman &> /dev/null; then echo "podman"; else echo "docker"; fi
}

check_container_exists() {
    local name=$1
    if distrobox list --no-color | grep -qw "$name"; then return 0; else return 1; fi
}

cmd_autocomplete() {
    local shell=${1:-bash}
    case "$shell" in
        bash)
            cat << 'EOF'
_agy_box_manager() {
    local cur opts prev
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    opts="install dev enter desktop clean status install-global uninstall-global test autocomplete ports doctor"
    
    case "$prev" in
        enter|desktop|clean)
            COMPREPLY=( $(compgen -W "dev prod" -- "$cur") )
            return 0
            ;;
        autocomplete)
            COMPREPLY=( $(compgen -W "bash zsh fish" -- "$cur") )
            return 0
            ;;
    esac

    COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
    return 0
}
complete -F _agy_box_manager agy-box-manager

_agy() {
    local cur opts prev
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    opts="changelog help install plugin plugins update --add-dir -c --continue --conversation --dangerously-skip-permissions -i --log-file -p --print --print-timeout --prompt --prompt-interactive --sandbox"
    
    case "$prev" in
        plugin|plugins)
            COMPREPLY=( $(compgen -W "install uninstall list enable disable" -- "$cur") )
            return 0
            ;;
    esac

    COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
    return 0
}
complete -F _agy agy
EOF
            ;;
        zsh)
            cat << 'EOF'
#compdef _agy_box_manager agy-box-manager agy

_agy_box_manager() {
    local -a commands
    commands=(
        'install:Pull official image'
        'dev:Build dev image'
        'enter:Enter workspace'
        'desktop:Launch VDI Web Desktop'
        'clean:Remove workspace'
        'status:Show status'
        'install-global:Install globally'
        'uninstall-global:Remove global install'
        'test:Run local integration tests'
        'autocomplete:Generate shell completion'
        'ports:Show active container port mappings'
        'doctor:Run system diagnostics'
    )
    _describe 'command' commands
}

_agy() {
    local -a commands
    commands=(
        'changelog:Show changelog and release notes'
        'help:Show help for subcommands'
        'install:Configure environment paths'
        'plugin:Manage plugins'
        'plugins:Alias for plugin'
        'update:Update CLI'
    )
    _describe 'command' commands
}

if [[ "$service" == "agy" ]]; then
    _agy
else
    _agy_box_manager
fi
EOF
            ;;
        fish)
            cat << 'EOF'
complete -c agy-box-manager -f
complete -c agy-box-manager -a "install dev enter desktop clean status install-global uninstall-global test autocomplete ports doctor"
complete -c agy -f
complete -c agy -a "changelog help install plugin plugins update"
EOF
            ;;
        *)
            echo "Unsupported shell: $shell" >&2
            exit 1
            ;;
    esac
}

setup_completions() {
    # Bash Auto-Completions
    local bash_comp_dir="$HOME/.local/share/bash-completion/completions"
    mkdir -p "$bash_comp_dir"
    cmd_autocomplete bash > "$bash_comp_dir/agy-box-manager"
    cmd_autocomplete bash > "$bash_comp_dir/agy"

    # Zsh Auto-Completions
    local zsh_comp_dir="$HOME/.zfunc"
    mkdir -p "$zsh_comp_dir"
    cmd_autocomplete zsh > "$zsh_comp_dir/_agy-box-manager"
    cmd_autocomplete zsh > "$zsh_comp_dir/_agy"

    # Fish Auto-Completions
    local fish_comp_dir="$HOME/.config/fish/completions"
    mkdir -p "$fish_comp_dir"
    cmd_autocomplete fish > "$fish_comp_dir/agy-box-manager.fish"
    cmd_autocomplete fish > "$fish_comp_dir/agy.fish"

    if [ -f "$HOME/.zshrc" ] && ! grep -q "fpath=(~/.zfunc \$fpath)" "$HOME/.zshrc"; then
        # shellcheck disable=SC2016
        echo -e '\n# Added by agy-box-manager\nfpath=(~/.zfunc \$fpath)' >> "$HOME/.zshrc"
    fi
}

# --- Core Commands ---
cmd_install_official() {
    local systemd=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -s|--systemd)
                systemd=true
                shift
                ;;
            *)
                shift
                ;;
        esac
    done

    if check_container_exists "$CONTAINER_NAME"; then
        if gum confirm "Container '$CONTAINER_NAME' already exists. Recreate it?"; then
            cmd_clean "$CONTAINER_NAME"
        else
            gum style --foreground 212 "Skipping creation."
            return
        fi
    fi

    local dbx_flags=()
    if [ "$(get_runtime)" = "docker" ]; then
        dbx_flags+=("--additional-flags" "--user $(id -u):$(id -g)")
    fi
    if [[ -n "${SSH_AUTH_SOCK:-}" && -S "$SSH_AUTH_SOCK" ]]; then
        dbx_flags+=("--additional-flags" "-v $SSH_AUTH_SOCK:/run/ssh-agent -e SSH_AUTH_SOCK=/run/ssh-agent")
    fi
    if [ "$systemd" = "true" ]; then
        dbx_flags+=("--init")
    fi

    # Resource limits
    local limits_conf="$HOME/.config/agy-box/limits.conf"
    local cpu_limit=""
    local memory_limit=""
    if [[ -f "$limits_conf" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            line=$(echo "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/#.*//')
            [[ -z "$line" ]] && continue
            if [[ "$line" =~ ^CPU_LIMIT=(.*)$ ]]; then
                cpu_limit="${BASH_REMATCH[1]}"
                cpu_limit="${cpu_limit%\"}"
                cpu_limit="${cpu_limit#\"}"
                cpu_limit="${cpu_limit%\'}"
                cpu_limit="${cpu_limit#\'}"
            elif [[ "$line" =~ ^MEMORY_LIMIT=(.*)$ ]]; then
                memory_limit="${BASH_REMATCH[1]}"
                memory_limit="${memory_limit%\"}"
                memory_limit="${memory_limit#\"}"
                memory_limit="${memory_limit%\'}"
                memory_limit="${memory_limit#\'}"
            fi
        done < "$limits_conf"
    fi
    if [[ -n "$cpu_limit" ]]; then
        dbx_flags+=("--additional-flags" "--cpus=$cpu_limit")
    fi
    if [[ -n "$memory_limit" ]]; then
        dbx_flags+=("--additional-flags" "-m $memory_limit")
    fi

    gum style --foreground 39 "🚀 Pulling official image and creating Distrobox environment..."
    distrobox create -i "$IMAGE_NAME" -n "$CONTAINER_NAME" "${dbx_flags[@]}"

    # Export CLI tools to host ~/.local/bin
    if distrobox enter "$CONTAINER_NAME" -- command -v distrobox-export &>/dev/null; then
        gum style --foreground 39 "🔗 Exporting toolchain CLI 'agy' to host (~/.local/bin)..."
        distrobox enter "$CONTAINER_NAME" -- distrobox-export --bin /usr/bin/agy --export-path "$HOME/.local/bin"
    fi

    gum style --foreground 46 --margin "1 0" "✓ Created successfully! Run 'agy-box-manager enter' to start."
}

cmd_build_dev() {
    local systemd=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -s|--systemd)
                systemd=true
                shift
                ;;
            *)
                shift
                ;;
        esac
    done

    if [ ! -f "Containerfile" ]; then
        gum style --foreground 196 "✗ Error: Containerfile not found in current directory. Please clone the repository first to build from source."
        exit 1
    fi

    if check_container_exists "$DEV_CONTAINER_NAME"; then
        if gum confirm "Container '$DEV_CONTAINER_NAME' already exists. Recreate it?"; then
            cmd_clean "$DEV_CONTAINER_NAME"
        else
            gum style --foreground 212 "Skipping build."
            return
        fi
    fi

    local runtime
    runtime=$(get_runtime)

    gum style --foreground 39 "🛠️  Building development image with $runtime (this may take a while)..."
    "$runtime" build -t "$DEV_IMAGE_NAME" -f Containerfile .

    local dbx_flags=()
    if [ "$runtime" = "docker" ]; then
        dbx_flags+=("--additional-flags" "--user $(id -u):$(id -g)")
    fi
    if [[ -n "${SSH_AUTH_SOCK:-}" && -S "$SSH_AUTH_SOCK" ]]; then
        dbx_flags+=("--additional-flags" "-v $SSH_AUTH_SOCK:/run/ssh-agent -e SSH_AUTH_SOCK=/run/ssh-agent")
    fi
    if [ "$systemd" = "true" ]; then
        dbx_flags+=("--init")
    fi

    # Resource limits
    local limits_conf="$HOME/.config/agy-box/limits.conf"
    local cpu_limit=""
    local memory_limit=""
    if [[ -f "$limits_conf" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            line=$(echo "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/#.*//')
            [[ -z "$line" ]] && continue
            if [[ "$line" =~ ^CPU_LIMIT=(.*)$ ]]; then
                cpu_limit="${BASH_REMATCH[1]}"
                cpu_limit="${cpu_limit%\"}"
                cpu_limit="${cpu_limit#\"}"
                cpu_limit="${cpu_limit%\'}"
                cpu_limit="${cpu_limit#\'}"
            elif [[ "$line" =~ ^MEMORY_LIMIT=(.*)$ ]]; then
                memory_limit="${BASH_REMATCH[1]}"
                memory_limit="${memory_limit%\"}"
                memory_limit="${memory_limit#\"}"
                memory_limit="${memory_limit%\'}"
                memory_limit="${memory_limit#\'}"
            fi
        done < "$limits_conf"
    fi
    if [[ -n "$cpu_limit" ]]; then
        dbx_flags+=("--additional-flags" "--cpus=$cpu_limit")
    fi
    if [[ -n "$memory_limit" ]]; then
        dbx_flags+=("--additional-flags" "-m $memory_limit")
    fi

    gum style --foreground 39 "📦 Creating development Distrobox environment..."
    distrobox create -i "$DEV_IMAGE_NAME" -n "$DEV_CONTAINER_NAME" "${dbx_flags[@]}"

    # Export CLI tools to host ~/.local/bin
    if distrobox enter "$DEV_CONTAINER_NAME" -- command -v distrobox-export &>/dev/null; then
        gum style --foreground 39 "🔗 Exporting toolchain CLI 'agy' to host (~/.local/bin)..."
        distrobox enter "$DEV_CONTAINER_NAME" -- distrobox-export --bin /usr/bin/agy --export-path "$HOME/.local/bin"
    fi

    gum style --foreground 46 --margin "1 0" "✓ Dev environment ready! Run 'agy-box-manager enter dev' to start."
}

cmd_desktop() {
    local env_type=${1:-prod}
    local target_name=$CONTAINER_NAME
    [ "$env_type" = "dev" ] && target_name=$DEV_CONTAINER_NAME

    if ! check_container_exists "$target_name"; then
        gum style --foreground 196 "Environment '$target_name' does not exist. Please install or build it first."
        exit 1
    fi

    echo -e "Starting VDI Virtual Desktop inside ${CYAN}$target_name${NC}..."
    distrobox enter "$target_name" -- /usr/local/bin/agy-vdi
}

cmd_enter() {
    local env_type=${1:-prod}
    local target_name=$CONTAINER_NAME
    [ "$env_type" = "dev" ] && target_name=$DEV_CONTAINER_NAME

    if ! check_container_exists "$target_name"; then
        gum style --foreground 196 "Environment '$target_name' does not exist. Please install or build it first."
        exit 1
    fi

    echo -e "Entering ${CYAN}$target_name${NC}..."
    distrobox enter "$target_name"
}

cmd_clean() {
    local target_name=${1:-$CONTAINER_NAME}
    if check_container_exists "$target_name"; then
        # Clean up exported host wrapper scripts if they exist
        if distrobox enter "$target_name" -- command -v distrobox-export &>/dev/null; then
            gum style --foreground 214 "Cleaning up exported binaries..."
            distrobox enter "$target_name" -- distrobox-export --delete --bin /usr/bin/agy || true
        fi
        gum spin --spinner dot --title "Removing environment: $target_name..." -- distrobox rm --yes "$target_name"
        gum style --foreground 46 "✓ Removed $target_name"
    else
        gum style --foreground 214 "! Warning: $target_name does not exist."
    fi
}

cmd_status() {
    echo ""
    gum style --foreground 212 --border normal --padding "0 1" "Distrobox Status"
    distrobox list | grep -E "NAME|$CONTAINER_NAME|$DEV_CONTAINER_NAME" || gum style --foreground 214 "No AGY Boxes found."
    echo ""
}

cmd_install_global() {
    local target_dir="$HOME/.local/bin"
    local target_file="$target_dir/agy-box-manager"

    gum spin --spinner dot --title "Installing globally to $target_dir..." -- sleep 1
    mkdir -p "$target_dir"

    # Check if executed locally or via curl pipe
    if [ -f "$0" ] && [[ "$0" != *"bash"* ]] && [[ "$0" != *"sh"* ]]; then
        cp "$0" "$target_file"
    else
        # If curled directly to bash, download from remote URL
        curl -fsSL "$REMOTE_SCRIPT_URL" -o "$target_file"
    fi

    chmod +x "$target_file"

    gum style --foreground 46 --margin "1 0" "✓ Installed globally! You can now run 'agy-box-manager' from anywhere."

    if command -v ujust &> /dev/null; then
        gum style --foreground 39 "🟦 Universal Blue detected: $target_dir is in your PATH by default."
    else
        gum style --foreground 214 "Make sure $target_dir is added to your \$PATH variable."
    fi
}

cmd_uninstall_global() {
    local target_file="$HOME/.local/bin/agy-box-manager"

    if gum confirm "Are you sure you want to remove the global CLI installation?"; then
        gum spin --spinner dot --title "Removing globally installed CLI..." -- rm -f "$target_file"

        # Clean up auto-completions
        rm -f "$HOME/.local/share/bash-completion/completions/agy-box-manager"
        rm -f "$HOME/.zfunc/_agy-box-manager"
        rm -f "$HOME/.config/agy-box-manager/.completions_installed"

        gum style --foreground 46 --margin "1 0" "✓ Removed globally installed CLI and auto-completions."
    else
        gum style --foreground 212 "Skipping uninstall."
    fi
}

