# --- Core Commands ---
post_install_ready() {
  local target="$1" enter="$2" auto_yes="${3:-false}" vdi_port="${4:-6080}" is_dev="${5:-false}"
  echo ""
  cmd_status
  local enter_cmd="just agy-enter" desktop_cmd="just agy-desktop" clean_cmd="just agy-clean" title="🚀 Environment '$target' is running and ready!"
  if [ "$is_dev" = "true" ]; then
    enter_cmd="just agy-enter dev"
    desktop_cmd="just agy-desktop dev"
    clean_cmd="just agy-clean dev"
    title="🚀 Dev Environment '$target' is running and ready!"
  elif [ "$target" != "$CONTAINER_NAME" ]; then
    enter_cmd="just agy-enter $target"
    desktop_cmd="just agy-desktop $target -p $vdi_port"
    clean_cmd="just agy-clean $target"
  fi
  local msg="$title\n\nNext Steps:\n  • Enter Shell:  $enter_cmd\n  • Desktop VDI:  $desktop_cmd\n  • View Status:  just agy-status\n  • Clean Up:     $clean_cmd"
  echo ""
  if command -v gum >/dev/null 2>&1; then
    gum style --border rounded --padding "0 2" --border-foreground 46 "$msg"
  else
    echo -e "${GREEN}${msg}${NC}\n"
  fi
  if [ "$enter" = "true" ]; then
    cmd_enter "$target"
  elif [ "$enter" != "false" ] && [ "$auto_yes" != "true" ] && [ -t 0 ]; then
    echo ""
    local should=false
    if command -v gum >/dev/null 2>&1; then
      gum confirm "🚀 Enter '$target' environment now?" && should=true
    else
      read -r -p "🚀 Enter '$target' environment now? [Y/n] " c
      [[ -z "$c" || "$c" =~ ^[Yy]$ ]] && should=true
    fi
    [ "$should" = "true" ] && cmd_enter "$target"
  fi
}

cmd_install_official() {
  load_config
  apply_keyring_configuration
  local systemd=false
  local target_name="$CONTAINER_NAME"
  local target_image="$IMAGE_NAME"
  local custom_home=""
  local auto_yes=false
  local enter_after_install=""
  local custom_mode=""
  local custom_engine=""
  local seed_ssh=false
  local seed_git=false
  local seed_gcloud=false
  local fresh_home=false
  local reuse_home=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n|--name)
        target_name="$2"
        shift 2
        ;;
      -i|--image)
        target_image="$2"
        shift 2
        ;;
      --home)
        custom_home="$2"
        shift 2
        ;;
      --mode|-m)
        custom_mode="$2"
        shift 2
        ;;
      --engine)
        custom_engine="$2"
        shift 2
        ;;
      --seed-ssh)
        seed_ssh=true
        shift
        ;;
      --seed-git)
        seed_git=true
        shift
        ;;
      --seed-gcloud)
        seed_gcloud=true
        shift
        ;;
      --fresh|--clean-home)
        fresh_home=true
        shift
        ;;
      --reuse-home)
        reuse_home=true
        shift
        ;;
      -s|--systemd)
        systemd=true
        shift
        ;;
      -y|--yes)
        auto_yes=true
        shift
        ;;
      --new)
        target_name=$(generate_box_name "$CONTAINER_NAME")
        shift
        ;;
      --enter)
        enter_after_install=true
        shift
        ;;
      --no-enter)
        enter_after_install=false
        shift
        ;;
      *)
        if [[ "$1" != -* ]] && [ "$target_name" = "$CONTAINER_NAME" ]; then
          target_name="$1"
        fi
        shift
        ;;
    esac
  done

  local runtime
  if [ -n "$custom_engine" ] && [ "$custom_engine" != "distrobox" ]; then
    runtime="$custom_engine"
  else
    runtime=$(get_runtime)
  fi

  # --- Container Name Collision Check ---
  if check_container_exists "$target_name"; then
    if [ "$auto_yes" = "true" ]; then
      cmd_clean "$target_name" --purge
    elif [ -t 0 ] && command -v gum >/dev/null 2>&1; then
      echo ""
      gum style --foreground 214 "⚠️  Container '$target_name' already exists!"
      local candidate
      candidate=$(generate_box_name "$CONTAINER_NAME")
      local collision_action
      collision_action=$(gum choose --header "How would you like to proceed?" \
        "🔄 Update apps & OS inside '$target_name'" \
        "➕ Create new box '$candidate' instead" \
        "Cancel")
      case "$collision_action" in
        "🔄 Update"*)
          cmd_update "$target_name" --all
          return 0
          ;;
        "➕ Create"*)
          target_name="$candidate"
          ui_ok "Creating new box: $target_name"
          ;;
        *)
          ui_warn "Installation cancelled."
          return 0
          ;;
      esac
    else
      ui_error "❌ Error: Container '$target_name' already exists. Use --new to create a new unique box, or run 'agy-box-manager update $target_name'."
      exit 1
    fi
  fi

  local isolated_home
  if [ -n "$custom_home" ]; then
    isolated_home="$custom_home"
  else
    isolated_home=$(get_box_home "$target_name")
  fi

    # --- Isolated Home Directory Collision Check ---
  if [ "$target_name" != "$CONTAINER_NAME" ] && [ -d "$isolated_home" ] && [ -n "$(ls -A "$isolated_home" 2>/dev/null)" ]; then
    if [ "$fresh_home" = "true" ]; then
      purge_box_home "$isolated_home"
      mkdir -p "$isolated_home"
      ui_ok "Wiped existing home directory for fresh start: $isolated_home"
    elif [ "$reuse_home" = "true" ]; then
      ui_ok "Reusing existing home directory: $isolated_home"
    elif [ "$auto_yes" = "true" ]; then
      purge_box_home "$isolated_home"
      mkdir -p "$isolated_home"
      ui_ok "Wiped existing home directory for fresh start: $isolated_home"
    elif [ -t 0 ] && command -v gum >/dev/null 2>&1; then
      echo ""
      gum style --foreground 214 "⚠️  Existing data directory found at: $isolated_home"
      local home_action
      home_action=$(gum choose --header "How would you like to handle existing data?" \
        "Fresh Start / Wipe (Pristine clean slate - Recommended)" \
        "Reuse Data (Attach to existing home directory files)" \
        "Cancel")
      case "$home_action" in
        "Fresh Start"*)
          purge_box_home "$isolated_home"
          mkdir -p "$isolated_home"
          ui_ok "Wiped existing home directory: $isolated_home"
          ;;
        "Reuse Data"*)
          ui_ok "Preserving and reusing existing home directory: $isolated_home"
          ;;
        *)
          ui_warn "Installation cancelled."
          return 0
          ;;
      esac
    else
      ui_error "❌ Error: Existing data directory found at $isolated_home. Pass --fresh to wipe or --reuse-home to reuse."
      exit 1
    fi
  else
    mkdir -p "$isolated_home"
  fi

  local mode=""
  local explicit_workstation=false
  if [ -n "$custom_mode" ]; then
    mode="$custom_mode"
    if [ "$custom_mode" = "workstation" ] || [ "$custom_mode" = "distrobox" ]; then
      mode="workstation"
      explicit_workstation=true
    fi
  elif [ -n "$custom_engine" ]; then
    if [ "$custom_engine" = "distrobox" ]; then
      mode="workstation"
      explicit_workstation=true
    else
      mode="sandbox"
    fi
  else
    if [ "$target_name" = "$CONTAINER_NAME" ]; then
      mode="${AGY_PRIMARY_ENGINE:-distrobox}"
      if [ "$mode" != "sandbox" ] && [ "$mode" != "workstation" ]; then
        if [ "$mode" = "distrobox" ]; then mode="workstation"; else mode="sandbox"; fi
      fi
    else
      mode="${AGY_NAMED_ENGINE:-podman}"
      if [ "$mode" != "sandbox" ] && [ "$mode" != "workstation" ]; then
        if [ "$mode" = "distrobox" ]; then mode="workstation"; else mode="sandbox"; fi
      fi
    fi
  fi

  if [ "$mode" = "workstation" ]; then
    if [ "$explicit_workstation" = "true" ]; then
      require_distrobox
    elif ! command -v distrobox >/dev/null 2>&1; then
      ui_warn "⚠️  distrobox is not installed on the host; falling back to sandbox mode."
      mode="sandbox"
    fi
  fi

  local cpu_limit="" memory_limit=""
  load_resource_limits

  local vdi_port=6080
  if [ "$target_name" != "$CONTAINER_NAME" ]; then
    local port_offset
    port_offset=$(calculate_box_port_offset "$target_name")
    vdi_port=$((6080 + port_offset))
  fi

  if [ "$mode" = "sandbox" ]; then
        # --- Mode B: Isolated Sandbox (Pure Podman / Docker Runner) ---
    if [[ "$target_image" == localhost/* ]] && "$runtime" image inspect "$target_image" >/dev/null 2>&1; then
      if [ -t 1 ]; then
        echo -e "${WHITE}==> [1/4] Using local container image '$target_image'...${NC}"
        echo -e "${GREEN}✓ [1/4] Using local container image '$target_image'... (0s)${NC}"
      else
        echo "==> [1/4] Using local container image '$target_image'..."
        echo "✓ [1/4] Using local container image '$target_image'... (0s)"
      fi
    elif ! run_step_live "[1/4] Pulling container image '$target_image'..." "$runtime" pull "$target_image"; then
      ui_error "❌ Error: Failed to pull container image."
      exit 1
    fi

    apply_keyring_configuration "$isolated_home"
    if [ "$runtime" = "podman" ]; then
      podman unshare chown -R 9000:9000 "$isolated_home" 2>/dev/null || true
    fi

    local run_flags=(
      "-d"
      "--name" "$target_name"
      "--hostname" "$target_name"
      "--label" "manager=agy-box-${runtime}"
      "--label" "agy-box.mode=sandbox"
      "-p" "${vdi_port}:6080"
    )

    if [ "$runtime" = "podman" ]; then
      run_flags+=("-v" "$isolated_home:/home/agyuser:Z")
    else
      run_flags+=("-v" "$isolated_home:/home/agyuser" "-e" "PUID=$(id -u)" "-e" "PGID=$(id -g)")
    fi

    if [ "$seed_ssh" = "true" ] || { [ "${AGY_PROFILE_SEEDING:-false}" = "true" ] && [ "$target_name" = "$CONTAINER_NAME" ]; }; then
      if [ -d "$HOME/.ssh" ]; then
        run_flags+=("-v" "$HOME/.ssh:/home/agyuser/.ssh:ro")
      fi
    fi
    if [ "$seed_git" = "true" ] || { [ "${AGY_PROFILE_SEEDING:-false}" = "true" ] && [ "$target_name" = "$CONTAINER_NAME" ]; }; then
      if [ -f "$HOME/.gitconfig" ]; then
        run_flags+=("-v" "$HOME/.gitconfig:/home/agyuser/.gitconfig:ro")
      fi
    fi
    if [ "$seed_gcloud" = "true" ] || { [ "${AGY_PROFILE_SEEDING:-false}" = "true" ] && [ "$target_name" = "$CONTAINER_NAME" ]; }; then
      if [ -d "$HOME/.config/gcloud" ]; then
        run_flags+=("-v" "$HOME/.config/gcloud:/home/agyuser/.config/gcloud:ro")
      fi
    fi

    if [[ -n "$cpu_limit" ]]; then
      run_flags+=("--cpus=$cpu_limit")
    fi
    if [[ -n "$memory_limit" ]]; then
      run_flags+=("-m" "$memory_limit")
    fi
    if command -v nvidia-smi &>/dev/null && { [ -e /dev/nvidiactl ] || [ -e /dev/nvhost-ctrl ] || [ -e /dev/nvidia0 ]; }; then
      run_flags+=("--gpus" "all")
    fi

    if ! run_step_live "[2/4] Creating $mode environment '$target_name'..." \
      "$runtime" run "${run_flags[@]}" "$target_image" sleep infinity; then
      ui_error "❌ Error: Failed to create sandbox container."
      exit 1
    fi

    if ! run_step_live "[3/4] Verifying sandbox container '$target_name' (VDI port $vdi_port)..." \
      "$runtime" ps -f "name=^${target_name}$"; then
      ui_error "❌ Error: Sandbox container '$target_name' is not running."
      exit 1
    fi
  else
        # --- Mode A: Integrated Workstation (Distrobox) ---
    local dbx_flags=()
    dbx_flags+=("--home" "$isolated_home")

    if [ "${AGY_PROFILE_SEEDING:-false}" = "true" ] || [ "$seed_ssh" = "true" ] || [ "$seed_git" = "true" ]; then
      if [ -d "$HOME/.ssh" ]; then
        dbx_flags+=("--volume" "$HOME/.ssh:$isolated_home/.ssh:ro")
      fi
      if [ -d "$HOME/.config/gcloud" ]; then
        dbx_flags+=("--volume" "$HOME/.config/gcloud:$isolated_home/.config/gcloud:ro")
      fi
      if [ -f "$HOME/.gitconfig" ]; then
        dbx_flags+=("--volume" "$HOME/.gitconfig:$isolated_home/.gitconfig:ro")
      fi
    fi

    if [ "${AGY_KEYRING_MODE:-host}" = "isolated" ]; then
      dbx_flags+=("--additional-flags" "--unsetenv=DBUS_SESSION_BUS_ADDRESS")
    fi

    if [ "$runtime" = "docker" ]; then
      dbx_flags+=("--additional-flags" "--user $(id -u):$(id -g)")
    fi
    if [[ -n "${SSH_AUTH_SOCK:-}" && -S "$SSH_AUTH_SOCK" ]]; then
      dbx_flags+=("--additional-flags" "-v $SSH_AUTH_SOCK:/run/ssh-agent -e SSH_AUTH_SOCK=/run/ssh-agent")
    fi
    if [ "$systemd" = "true" ]; then
      dbx_flags+=("--init")
    fi

    if [[ -n "$cpu_limit" ]]; then
      dbx_flags+=("--additional-flags" "--cpus=$cpu_limit")
    fi
    if [[ -n "$memory_limit" ]]; then
      dbx_flags+=("--additional-flags" "-m $memory_limit")
    fi
    if command -v nvidia-smi &>/dev/null && { [ -e /dev/nvidiactl ] || [ -e /dev/nvhost-ctrl ] || [ -e /dev/nvidia0 ]; }; then
      dbx_flags+=("--nvidia")
    fi

    if [[ "$target_image" == localhost/* ]] && "$runtime" image inspect "$target_image" >/dev/null 2>&1; then
      if [ -t 1 ]; then
        echo -e "${WHITE}==> [1/4] Using local container image '$target_image'...${NC}"
        echo -e "${GREEN}✓ [1/4] Using local container image '$target_image'... (0s)${NC}"
      else
        echo "==> [1/4] Using local container image '$target_image'..."
        echo "✓ [1/4] Using local container image '$target_image'... (0s)"
      fi
    elif ! run_step_live "[1/4] Pulling container image '$target_image'..." "$runtime" pull "$target_image"; then
      ui_error "❌ Error: Failed to pull container image."
      exit 1
    fi

    if ! run_step_live "[2/4] Creating $mode environment '$target_name'..." \
      distrobox create -i "$target_image" -n "$target_name" --hostname "$target_name" "${dbx_flags[@]}" --yes; then
      ui_error "❌ Error: Failed to create Distrobox environment."
      exit 1
    fi

    if [ "$runtime" = "podman" ] && [ -d "$isolated_home" ]; then
      podman unshare chown -R 0:0 "$isolated_home" 2>/dev/null || true
    fi

    if ! run_step_live "[3/4] Initializing '$target_name' container & CLI integration (first boot takes ~15-45s)..." \
      distrobox enter "$target_name" -- true; then
      ui_error "❌ Error: Failed to initialize Distrobox container '$target_name'."
      exit 1
    fi

    if [ "$runtime" = "podman" ] && [ -d "$isolated_home" ]; then
      podman unshare chown -R 0:0 "$isolated_home" 2>/dev/null || true
    fi
    apply_keyring_configuration "$isolated_home"

    install_toolchain_in_box "$target_name" "$isolated_home" || true
  fi

  rm -f "$HOME/.config/agy-box/.setup_done"

  run_step_live "[4/4] Configuring host shell integration & completions..." setup_shell_integration
  echo "✓ Host shell integration ready"

  post_install_ready "$target_name" "$enter_after_install" "$auto_yes" "$vdi_port" false
}

cmd_build_dev() {
  load_config
  apply_keyring_configuration
  local systemd=false
  local enter_after_install=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -s|--systemd)
        systemd=true
        shift
        ;;
      --enter)
        enter_after_install=true
        shift
        ;;
      --no-enter)
        enter_after_install=false
        shift
        ;;
      *)
        shift
        ;;
    esac
  done

  require_distrobox

  if [ ! -f "Containerfile" ]; then
    ui_error "✗ Error: Containerfile not found in current directory. Please clone the repository first to build from source."
    exit 1
  fi

  if check_container_exists "$DEV_CONTAINER_NAME"; then
    local recreate_dev=false
    if [ -t 0 ]; then
      if command -v gum >/dev/null 2>&1; then
        if gum confirm "Container '$DEV_CONTAINER_NAME' already exists. Recreate it?"; then
          recreate_dev=true
        fi
      else
        local recreate_choice=""
        read -r -p "Container '$DEV_CONTAINER_NAME' already exists. Recreate it? [y/N] " recreate_choice
        if [[ "$recreate_choice" =~ ^[Yy]$ ]]; then
          recreate_dev=true
        fi
      fi
    fi
    if [ "$recreate_dev" = "true" ]; then
      cmd_clean "$DEV_CONTAINER_NAME"
    else
      ui_warn "Skipping build."
      return
    fi
  fi

  local runtime
  runtime=$(get_runtime)

  if ! run_step_live "Building development image with $runtime (this may take a while)..." \
    "$runtime" build -t "$DEV_IMAGE_NAME" -f Containerfile .; then
    ui_error "❌ Error: Failed to build development image."
    exit 1
  fi

  local dbx_flags=()
  local isolated_home
  isolated_home=$(get_box_home "$DEV_CONTAINER_NAME")
  mkdir -p "$isolated_home"
  dbx_flags+=("--home" "$isolated_home")

  if [ "${AGY_PROFILE_SEEDING:-false}" = "true" ]; then
    if [ -d "$HOME/.ssh" ]; then
      dbx_flags+=("--volume" "$HOME/.ssh:$isolated_home/.ssh:ro")
    fi
    if [ -d "$HOME/.config/gcloud" ]; then
      dbx_flags+=("--volume" "$HOME/.config/gcloud:$isolated_home/.config/gcloud:ro")
    fi
    if [ -f "$HOME/.gitconfig" ]; then
      dbx_flags+=("--volume" "$HOME/.gitconfig:$isolated_home/.gitconfig:ro")
    fi
  fi

  if [ "${AGY_KEYRING_MODE:-host}" = "isolated" ]; then
    dbx_flags+=("--additional-flags" "--unsetenv=DBUS_SESSION_BUS_ADDRESS")
  fi

  if [ "$runtime" = "docker" ]; then
    dbx_flags+=("--additional-flags" "--user $(id -u):$(id -g)")
  fi
  if [[ -n "${SSH_AUTH_SOCK:-}" && -S "$SSH_AUTH_SOCK" ]]; then
    dbx_flags+=("--additional-flags" "-v $SSH_AUTH_SOCK:/run/ssh-agent -e SSH_AUTH_SOCK=/run/ssh-agent")
  fi
  if [ "$systemd" = "true" ]; then
    dbx_flags+=("--init")
  fi

  local cpu_limit="" memory_limit=""
  load_resource_limits
  if [[ -n "$cpu_limit" ]]; then
    dbx_flags+=("--additional-flags" "--cpus=$cpu_limit")
  fi
  if [[ -n "$memory_limit" ]]; then
    dbx_flags+=("--additional-flags" "-m $memory_limit")
  fi
  if command -v nvidia-smi &>/dev/null && { [ -e /dev/nvidiactl ] || [ -e /dev/nvhost-ctrl ] || [ -e /dev/nvidia0 ]; }; then
    dbx_flags+=("--nvidia")
  fi

  if ! run_step_live "Creating development Distrobox environment '$DEV_CONTAINER_NAME'..." \
    distrobox create -i "$DEV_IMAGE_NAME" -n "$DEV_CONTAINER_NAME" --hostname "$DEV_CONTAINER_NAME" "${dbx_flags[@]}" --yes; then
    ui_error "❌ Error: Failed to create development Distrobox environment."
    exit 1
  fi

  if [ "$runtime" = "podman" ] && [ -d "$isolated_home" ]; then
    podman unshare chown -R 0:0 "$isolated_home" 2>/dev/null || true
  fi

  if ! run_step_live "Initializing '$DEV_CONTAINER_NAME' container & CLI integration (first boot takes ~15-45s)..." \
    distrobox enter "$DEV_CONTAINER_NAME" -- true; then
    ui_error "❌ Error: Failed to initialize development Distrobox container."
    exit 1
  fi

  if [ "$runtime" = "podman" ] && [ -d "$isolated_home" ]; then
    podman unshare chown -R 0:0 "$isolated_home" 2>/dev/null || true
  fi
  apply_keyring_configuration "$isolated_home"

  if ! install_toolchain_in_box "$DEV_CONTAINER_NAME" "$isolated_home"; then
    exit 1
  fi

  rm -f "$HOME/.config/agy-box/.setup_done"

  run_step_live "Configuring host shell integration & completions..." setup_shell_integration
  echo "✓ Host shell integration ready"

  post_install_ready "$DEV_CONTAINER_NAME" "$enter_after_install" false 6080 true
}

is_vdi_running() {
  local name=$1
  local runtime
  runtime=$(get_runtime 2>/dev/null || echo "podman")
  "$runtime" ps --format '{{.Names}}' 2>/dev/null | grep -qxF "$name" || return 1
  "$runtime" exec --user 0 "$name" pgrep -f '[X]vfb' >/dev/null 2>&1 || return 1
  "$runtime" exec --user 0 "$name" pgrep -f '[x]11vnc' >/dev/null 2>&1 || return 1
  "$runtime" exec --user 0 "$name" pgrep -f '[w]ebsockify.*novnc' >/dev/null 2>&1
}

vdi_ws_ready() {
  local p="$1" hdr
  curl -fsS --max-time 2 "http://127.0.0.1:${p}/vnc.html" >/dev/null 2>&1 || return 1
  hdr=$(curl -sSi --max-time 1 -H "Connection: Upgrade" -H "Upgrade: websocket" -H "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==" -H "Sec-WebSocket-Version: 13" "http://127.0.0.1:${p}/websockify" 2>/dev/null || true)
  [[ "$hdr" == *"101 Switching Protocols"* ]]
}

stop_vdi_session() {
  local name=$1
  local runtime
  runtime=$(get_runtime 2>/dev/null || echo "podman")
  "$runtime" exec --user 0 "$name" sh -c 'pkill -TERM -f "[a]gy-vdi|[w]ebsockify|[x]11vnc|[i]cewm-session|[X]vfb" 2>/dev/null || true; sleep 0.5; pkill -KILL -f "[w]ebsockify|[x]11vnc|[X]vfb" 2>/dev/null || true; rm -f /tmp/.X*-lock /tmp/.X11-unix/X*' 2>/dev/null || true
  if ! is_vdi_running "$name"; then
    ui_ok "✓ VDI session for '$name' stopped cleanly."
  else
    ui_warn "⚠️  Some VDI processes for '$name' may still be running."
  fi
}

vdi_control_panel() {
  local target_name=$1
  local vdi_port=$2
  local mgr
  mgr=$(get_box_manager "$target_name")
  local runtime
  runtime=$(get_runtime 2>/dev/null || echo "podman")
  local url="http://127.0.0.1:${vdi_port}/vnc.html?autoconnect=true&resize=scale&path=websockify"
  while true; do
    echo ""
    if is_vdi_running "$target_name"; then
      echo -e "${GREEN}🟢 VDI Active:${NC} $url"
    else
      echo -e "${RED}🔴 VDI Stopped${NC}"
    fi
    local options=(
      "🌐 Open VDI in Browser"
      "📜 View VDI Log"
      "⏹️  End VDI Session"
      "📌 Keep Running in Background & Return to Menu"
    )
    local choice
    if command -v gum >/dev/null 2>&1; then
      choice=$(gum choose --header "VDI Session Management ($target_name):" "${options[@]}")
    else
      echo "1) Open VDI in Browser"
      echo "2) View VDI Log"
      echo "3) End VDI Session"
      echo "4) Keep Running in Background & Return to Menu"
      read -r -p "Choice [1-4]: " opt
      case "$opt" in
        1) choice="🌐 Open VDI in Browser" ;;
        2) choice="📜 View VDI Log" ;;
        3) choice="⏹️  End VDI Session" ;;
        *) choice="📌 Keep Running in Background & Return to Menu" ;;
      esac
    fi
    case "$choice" in
      "🌐 Open VDI in Browser")
        if command -v xdg-open >/dev/null 2>&1 && [ -n "${DISPLAY:-${WAYLAND_DISPLAY:-}}" ]; then
          xdg-open "$url" >/dev/null 2>&1 || true
        else
          echo "Open in browser: $url"
        fi
        ;;
      "📜 View VDI Log")
        echo -e "${CYAN}=== VDI Log for '$target_name' ===${NC}"
        if [ "$mgr" = "distrobox" ] && [ -f "/tmp/agy-vdi-${target_name}.log" ]; then
          cat "/tmp/agy-vdi-${target_name}.log"
        else
          "$runtime" exec --user 0 "$target_name" cat /tmp/agy-vdi.log 2>/dev/null || echo "(no log found)"
        fi
        echo -e "${CYAN}=================================${NC}"
        ;;
      "⏹️  End VDI Session")
        stop_vdi_session "$target_name"
        break
        ;;
      *)
        break
        ;;
    esac
  done
}

cmd_desktop() {
  load_config
  local target_name="$CONTAINER_NAME"
  local vdi_args=()
  local stop_action=false
  local status_action=false
  local detach=false
  local custom_port=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --stop)
        stop_action=true
        shift
        ;;
      --status)
        status_action=true
        shift
        ;;
      -d|--detach)
        detach=true
        shift
        ;;
      dev)
        target_name="$DEV_CONTAINER_NAME"
        shift
        ;;
      prod)
        target_name="$CONTAINER_NAME"
        shift
        ;;
      -p|--port)
        custom_port="$2"
        vdi_args+=("-p" "$2")
        shift 2
        ;;
      -r|--resolution)
        vdi_args+=("-r" "$2")
        shift 2
        ;;
      -*)
        vdi_args+=("$1")
        shift
        ;;
      *)
        if [ "$target_name" = "$CONTAINER_NAME" ]; then
          target_name="$1"
        else
          vdi_args+=("$1")
        fi
        shift
        ;;
    esac
  done

  if ! check_container_exists "$target_name" && check_container_exists "agy-box-$target_name"; then
    target_name="agy-box-$target_name"
  fi

  if ! check_container_exists "$target_name"; then
    ui_error "Environment '$target_name' does not exist. Please install or build it first."
    exit 1
  fi

  local vdi_port=6080
  if [ -n "$custom_port" ]; then
    vdi_port="$custom_port"
  elif [ "$target_name" != "$CONTAINER_NAME" ]; then
    vdi_port=$((6080 + $(calculate_box_port_offset "$target_name")))
  fi

  if [ "$stop_action" = "true" ]; then
    stop_vdi_session "$target_name"
    return 0
  fi

  if [ "$status_action" = "true" ]; then
    if is_vdi_running "$target_name"; then
      echo "🟢 VDI is running for '$target_name' on port $vdi_port"
      echo "URL: http://127.0.0.1:${vdi_port}/vnc.html?autoconnect=true&resize=scale&path=websockify"
    else
      echo "⚪ VDI is stopped for '$target_name'"
    fi
    return 0
  fi

  local isolated_home
  isolated_home=$(get_box_home "$target_name")
  local runtime
  runtime=$(get_runtime 2>/dev/null || echo "podman")
  local mgr
  mgr=$(get_box_manager "$target_name")

  local already_active=false
  if is_vdi_running "$target_name" && vdi_ws_ready "$vdi_port"; then
    already_active=true
  fi

  if [ "$already_active" = "true" ]; then
    ui_ok "VDI session for '$target_name' is already active on port $vdi_port."
  else
    "$runtime" exec --user 0 "$target_name" sh -c 'pkill -KILL -f "[a]gy-vdi|[w]ebsockify|[x]11vnc|[X]vfb" 2>/dev/null || true; rm -f /tmp/.X*-lock /tmp/.X11-unix/X*' 2>/dev/null || true

    local clean_vdi_args=()
    for ((i=0; i<${#vdi_args[@]}; i++)); do
      if [ "${vdi_args[i]}" = "-p" ] || [ "${vdi_args[i]}" = "--port" ]; then
        i=$((i + 1))
      else
        clean_vdi_args+=("${vdi_args[i]}")
      fi
    done

    if [ "$mgr" = "distrobox" ]; then
      ensure_distrobox_ready "$target_name" || return 1

      if [ "$runtime" = "podman" ] && [ -d "$isolated_home" ]; then
        podman unshare chown -R 0:0 "$isolated_home" 2>/dev/null || true
      fi
      apply_keyring_configuration "$isolated_home"

      if [ -z "$custom_port" ]; then
        while ss -tlnH 2>/dev/null | awk '{print $4}' | grep -Eq "(^|:)${vdi_port}$"; do
          ui_warn "Port $vdi_port is already in use on host; trying port $((vdi_port + 1))..."
          vdi_port=$((vdi_port + 1))
        done
      fi

      local env_flags=(-e HOME="$isolated_home" -e USER="$(id -un 2>/dev/null || echo "${USER:-}")" -e DISTROBOX_HOST_HOME="$HOME" -e AGY_KEYRING_MODE="${AGY_KEYRING_MODE:-host}")
      if [ "${AGY_KEYRING_MODE:-host}" != "isolated" ]; then
        [ -n "${XDG_RUNTIME_DIR:-}" ] && env_flags+=(-e XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR")
        [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] && env_flags+=(-e DBUS_SESSION_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS")
        [ -n "${GNOME_KEYRING_CONTROL:-}" ] && env_flags+=(-e GNOME_KEYRING_CONTROL="$GNOME_KEYRING_CONTROL")
        if [ -n "${SSH_AUTH_SOCK:-}" ]; then
          if [ -e /run/ssh-agent ] || "$runtime" exec "$target_name" test -e /run/ssh-agent 2>/dev/null; then
            env_flags+=(-e SSH_AUTH_SOCK="/run/ssh-agent")
          else
            env_flags+=(-e SSH_AUTH_SOCK="$SSH_AUTH_SOCK")
          fi
        fi
      fi

      echo -e "Starting VDI Virtual Desktop inside ${CYAN}$target_name${NC} (Workstation)..."
      "$runtime" exec -d --user "$(id -u):$(id -g)" "${env_flags[@]}" -w "$isolated_home" "$target_name" sh -c 'exec /usr/local/bin/agy-vdi "$@" >/tmp/agy-vdi.log 2>&1' _ -p "$vdi_port" "${clean_vdi_args[@]}"
    else
      apply_keyring_configuration "$isolated_home"
      if [ "$runtime" = "podman" ] && [ -d "$isolated_home" ]; then
        podman unshare chown -R 9000:9000 "$isolated_home" 2>/dev/null || true
      fi
      if ! "$runtime" ps --format '{{.Names}}' 2>/dev/null | grep -qxF "$target_name"; then
        run_step "Starting container '$target_name'..." "$runtime" start "$target_name"
      fi
      echo -e "Starting VDI Virtual Desktop inside ${CYAN}$target_name${NC} (Sandbox)..."
      "$runtime" exec -d -u agyuser -w /home/agyuser "$target_name" sh -c 'exec /usr/local/bin/agy-vdi "$@" >/tmp/agy-vdi.log 2>&1' _ -p 6080 "${clean_vdi_args[@]}"
    fi

    local vdi_ready=false
    local start_time
    start_time=$(date +%s)
    local vdi_timeout="${AGY_VDI_TIMEOUT:-20}"
    while true; do
      if is_vdi_running "$target_name"; then
        if [ -n "${BATS_VERSION:-}" ] || [ -n "${BATS_TEST_FILENAME:-}" ] || vdi_ws_ready "$vdi_port"; then
          vdi_ready=true
          break
        fi
      fi
      local now
      now=$(date +%s)
      if [ $((now - start_time)) -ge "$vdi_timeout" ]; then
        break
      fi
      sleep 1
    done

    if [ "$vdi_ready" != "true" ]; then
      ui_error "❌ Error: VDI failed to start:"
      "$runtime" exec --user 0 "$target_name" cat /tmp/agy-vdi.log 2>/dev/null >&2 || true
      return 1
    fi
  fi

  local desktop_url="http://127.0.0.1:${vdi_port}/vnc.html?autoconnect=true&resize=scale&path=websockify"
  echo -e "VDI Desktop is accessible at: ${GREEN}${desktop_url}${NC}"

  if [ "$detach" = "true" ] || [ ! -t 0 ] || [ ! -t 1 ]; then
    return 0
  fi

  if command -v xdg-open >/dev/null 2>&1 && [ -n "${DISPLAY:-${WAYLAND_DISPLAY:-}}" ]; then
    xdg-open "$desktop_url" >/dev/null 2>&1 || true
  fi

  vdi_control_panel "$target_name" "$vdi_port"
}

cmd_enter() {
  load_config
  local target_name="$CONTAINER_NAME"
  local enter_args=()

  if [[ $# -gt 0 ]]; then
    case "$1" in
      --)
        target_name="$CONTAINER_NAME"
        enter_args=("${@:2}")
        ;;
      dev)
        target_name="$DEV_CONTAINER_NAME"
        enter_args=("${@:2}")
        ;;
      prod)
        target_name="$CONTAINER_NAME"
        enter_args=("${@:2}")
        ;;
      *)
        target_name="$1"
        enter_args=("${@:2}")
        ;;
    esac
  fi

  if ! check_container_exists "$target_name" && check_container_exists "agy-box-$target_name"; then
    target_name="agy-box-$target_name"
  fi

  if ! check_container_exists "$target_name"; then
    ui_error "Environment '$target_name' does not exist. Available environments:"
    local all_boxes
    all_boxes=$(get_all_agy_boxes)
    if [ -n "$all_boxes" ]; then
      echo "$all_boxes" >&2
    else
      echo "  (none installed)" >&2
    fi
    exit 1
  fi

  local isolated_home
  isolated_home=$(get_box_home "$target_name")
  local runtime
  runtime=$(get_runtime)
  local mgr
  mgr=$(get_box_manager "$target_name")

  if [ "$mgr" = "distrobox" ]; then
    ensure_distrobox_ready "$target_name" || return 1
    if [ "$runtime" = "podman" ] && [ -d "$isolated_home" ]; then
      podman unshare chown -R 0:0 "$isolated_home" 2>/dev/null || true
    fi
    apply_keyring_configuration "$isolated_home"
    if [ ${#enter_args[@]} -gt 0 ] && [ "${enter_args[0]}" != "--" ] && [[ "${enter_args[0]}" != -* ]]; then
      enter_args=("--" "${enter_args[@]}")
    fi
    if [ ${#enter_args[@]} -eq 0 ] || [ -t 1 ]; then
      echo -e "Entering ${CYAN}$target_name${NC} (Workstation)..."
    fi
    if [ ${#enter_args[@]} -gt 0 ]; then
      distrobox enter "$target_name" "${enter_args[@]}"
    else
      distrobox enter "$target_name"
    fi
  else
    apply_keyring_configuration "$isolated_home"
    if [ "$runtime" = "podman" ] && [ -d "$isolated_home" ]; then
      podman unshare chown -R 9000:9000 "$isolated_home" 2>/dev/null || true
    fi
    if ! "$runtime" ps --format '{{.Names}}' 2>/dev/null | grep -qxF "$target_name"; then
      run_step "Starting container '$target_name'..." "$runtime" start "$target_name"
    fi
    if [ ${#enter_args[@]} -gt 0 ] && [ "${enter_args[0]}" = "--" ]; then
      enter_args=("${enter_args[@]:1}")
    fi
    if [ ${#enter_args[@]} -eq 0 ] || [ -t 1 ]; then
      echo -e "Entering ${CYAN}$target_name${NC} (Sandbox)..."
    fi
    if [ ${#enter_args[@]} -gt 0 ]; then
      if [ -t 0 ]; then
        "$runtime" exec -it -u agyuser -w /home/agyuser "$target_name" "${enter_args[@]}"
      else
        "$runtime" exec -u agyuser -w /home/agyuser "$target_name" "${enter_args[@]}"
      fi
    else
      "$runtime" exec -it -u agyuser -w /home/agyuser "$target_name" /bin/bash
    fi
  fi
}

cmd_update_toolchain() {
  local target_name="$CONTAINER_NAME"
  if [[ $# -gt 0 ]]; then
    case "$1" in
      dev)  target_name="$DEV_CONTAINER_NAME" ;;
      prod) target_name="$CONTAINER_NAME" ;;
      *)    target_name="$1" ;;
    esac
  fi

  if ! check_container_exists "$target_name" && check_container_exists "agy-box-$target_name"; then
    target_name="agy-box-$target_name"
  fi

  if ! check_container_exists "$target_name"; then
    ui_error "Environment '$target_name' does not exist. Please install or build it first."
    exit 1
  fi

  local isolated_home
  isolated_home=$(get_box_home "$target_name")
  local runtime
  runtime=$(get_runtime)
  local mgr
  mgr=$(get_box_manager "$target_name")

  if [ "$mgr" = "distrobox" ]; then
    ensure_distrobox_ready "$target_name" || return 1
    if [ "$runtime" = "podman" ] && [ -d "$isolated_home" ]; then
      podman unshare chown -R 0:0 "$isolated_home" 2>/dev/null || true
    fi
    apply_keyring_configuration "$isolated_home"

    if ! install_toolchain_in_box "$target_name" "$isolated_home"; then
      exit 1
    fi
  else
    apply_keyring_configuration "$isolated_home"
    if [ "$runtime" = "podman" ] && [ -d "$isolated_home" ]; then
      podman unshare chown -R 9000:9000 "$isolated_home" 2>/dev/null || true
    fi
    if ! "$runtime" ps --format '{{.Names}}' 2>/dev/null | grep -qxF "$target_name"; then
      run_step "Starting container '$target_name'..." "$runtime" start "$target_name"
    fi
    if ! run_step "Installing/updating Antigravity toolchain inside '$target_name'..." \
      "$runtime" exec -u agyuser -w /home/agyuser "$target_name" "$TOOLCHAIN_INSTALLER"; then
      ui_error "❌ Error: Failed to install/update the Antigravity toolchain inside '$target_name'."
      exit 1
    fi
  fi
  ui_ok "✓ Antigravity toolchain installed/updated in '$target_name'."
}

cmd_update() {
  load_config
  local target="prod"
  local update_toolchain=false
  local update_ides=false
  local update_packages=false
  local check_only=false
  local flags_specified=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      prod) target="prod"; shift ;;
      dev)  target="dev"; shift ;;
      --all|-a)
        update_toolchain=true
        update_ides=true
        update_packages=true
        flags_specified=true
        shift
        ;;
      --toolchain|-t)
        update_toolchain=true
        flags_specified=true
        shift
        ;;
      --ides|-i)
        update_ides=true
        flags_specified=true
        shift
        ;;
      --packages|-p)
        update_packages=true
        flags_specified=true
        shift
        ;;
      --check|-c)
        check_only=true
        flags_specified=true
        shift
        ;;
      -*)
        ui_error "Unknown option: $1"
        echo "Usage: agy-box-manager update [name|prod|dev] [--all|--toolchain|--ides|--packages|--check]"
        return 1
        ;;
      *)
        target="$1"
        shift
        ;;
    esac
  done

  if [ "$flags_specified" = "false" ]; then
    update_toolchain=true
    update_ides=true
    update_packages=true
  fi

  local target_container="$CONTAINER_NAME"
  if [ "$target" = "dev" ]; then
    target_container="$DEV_CONTAINER_NAME"
  elif [ "$target" = "prod" ]; then
    target_container="$CONTAINER_NAME"
  else
    target_container="$target"
    if ! check_container_exists "$target_container" && check_container_exists "agy-box-$target_container"; then
      target_container="agy-box-$target_container"
    fi
  fi

  if [ "$check_only" = "true" ]; then
    echo "🔍 Checking status and component versions for '$target_container'..."
    cmd_check
    return 0
  fi

  if ! check_container_exists "$target_container"; then
    ui_error "❌ Error: Container '$target_container' does not exist."
    echo "Run 'agy-box-manager install' (or 'agy-box-manager dev') first."
    return 1
  fi

  local isolated_home
  isolated_home=$(get_box_home "$target_container")
  local runtime
  runtime=$(detect_runtime)
  local mgr
  mgr=$(get_box_manager "$target_container")
  if [ "$mgr" = "distrobox" ]; then
    ensure_distrobox_ready "$target_container" || return 1
    if [ "$runtime" = "podman" ] && [ -d "$isolated_home" ]; then
      podman unshare chown -R 0:0 "$isolated_home" 2>/dev/null || true
    fi
  elif [ "$runtime" = "podman" ] && [ -d "$isolated_home" ]; then
    podman unshare chown -R 9000:9000 "$isolated_home" 2>/dev/null || true
  fi
  if [ "$mgr" != "distrobox" ] && ! "$runtime" ps --format '{{.Names}}' 2>/dev/null | grep -qxF "$target_container"; then
    run_step "Starting stopped container '$target_container'..." "$runtime" start "$target_container" >/dev/null
  fi

  ui_ok "🚀 Updating environment '$target_container'..."

  if [ "$update_toolchain" = "true" ]; then
    echo -e "\n${CYAN}==> Updating Antigravity Toolchain...${NC}"
    cmd_update_toolchain "$target_container"
  fi

  if [ "$update_ides" = "true" ]; then
    echo -e "\n${CYAN}==> Updating IDE Extensions...${NC}"
    if [ "$mgr" = "distrobox" ]; then
      if "$runtime" exec --user "$(id -u):$(id -g)" -e HOME="$isolated_home" -e USER="$(id -un 2>/dev/null || echo "$USER")" -w "$isolated_home" "$target_container" command -v code &>/dev/null; then
        run_step "Updating VS Code Antigravity extension..." "$runtime" exec --user "$(id -u):$(id -g)" -e HOME="$isolated_home" -e USER="$(id -un 2>/dev/null || echo "$USER")" -w "$isolated_home" "$target_container" code --install-extension Google.google-antigravity --force || ui_warn "! Could not update VS Code extension"
      fi
    else
      if "$runtime" exec -u agyuser -w /home/agyuser "$target_container" sh -c "command -v code" &>/dev/null; then
        run_step "Updating VS Code Antigravity extension..." "$runtime" exec -u agyuser -w /home/agyuser "$target_container" code --install-extension Google.google-antigravity --force || ui_warn "! Could not update VS Code extension"
      fi
    fi
    local zed_settings="$isolated_home/.config/zed/settings.json"
    if [ -f "$zed_settings" ]; then
      if ! grep -q "auto_install_extensions" "$zed_settings"; then
        echo '{"auto_install_extensions": {"antigravity": true}}' > "$zed_settings"
      fi
      ui_ok "✓ Zed auto-install extension configuration verified."
    fi
  fi

  if [ "$update_packages" = "true" ]; then
    echo -e "\n${CYAN}==> Updating Container OS Packages & IDEs...${NC}"
    run_step "Updating apt packages..." "$runtime" exec --user 0 "$target_container" sh -c "DEBIAN_FRONTEND=noninteractive apt-get update && apt-get upgrade -y" || true
    ui_ok "✓ Container packages upgraded."
  fi

  ui_ok "\n✓ Update completed successfully for '$target_container'!"
}

cmd_wizard() {
  local force_defaults=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --defaults|-d)
        force_defaults=true
        shift
        ;;
      *)
        shift
        ;;
    esac
  done

  local config_file
  config_file=$(get_config_file)
  local config_dir
  config_dir=$(get_config_dir)

  if [ "$force_defaults" = "true" ] || [ ! -t 0 ] || ! command -v gum >/dev/null 2>&1; then
    init_defaults "false"
    load_config
    apply_keyring_configuration
    ui_ok "✓ First-run setup completed with defaults saved to $config_file"
    return 0
  fi

  clear
  show_compact_banner
  gum style --foreground 212 --border rounded --padding "0 2" --margin "1 0" \
    "🧙 AGY Box First-Run Setup Wizard" \
    "Configure your container runtime, keyring isolation, IDE, and preferences." \
    "Default values are pre-selected for the best zero-friction experience."

  echo -e "\n${CYAN}1. Select Container Engine:${NC}"
  local runtime_choice
  runtime_choice=$(gum choose --header "Select your preferred container engine:" \
    "podman (Recommended - Rootless & Secure)" \
    "docker (Standard Docker Engine)")
  local selected_runtime="podman"
  if [[ "$runtime_choice" =~ docker ]]; then
    selected_runtime="docker"
  fi

  echo -e "\n${CYAN}2. Select Primary Workspace Mode ('agy-box'):${NC}"
  local primary_choice
  primary_choice=$(gum choose --header "Select mode for your primary daily driver workspace:" \
    "distrobox (Workstation - Integrated with host desktop, Wayland & SSO) [Recommended]" \
    "podman (Sandbox - Completely isolated container, pristine environment)")
  local selected_primary="distrobox"
  if [[ "$primary_choice" =~ podman ]]; then
    selected_primary="podman"
  fi

  echo -e "\n${CYAN}3. Select Named Boxes Policy ('test1', 'dev', etc.):${NC}"
  local named_choice
  named_choice=$(gum choose --header "Select default mode for secondary/named test environments:" \
    "podman (Isolated Sandbox - Clean room, air-gapped credentials) [Recommended]" \
    "distrobox (Integrated Workstation - Share host desktop integrations)")
  local selected_named="podman"
  if [[ "$named_choice" =~ distrobox ]]; then
    selected_named="distrobox"
  fi

  echo -e "\n${CYAN}4. Select Keyring Security Mode for Workstations:${NC}"
  local keyring_choice
  keyring_choice=$(gum choose --header "Choose how authentication credentials are stored in workstation mode:" \
    "host (Seamless single sign-on via Host D-Bus Secret Service)" \
    "isolated (Air-gapped credentials via container-local EncryptedKeyring)")
  local selected_keyring="host"
  if [[ "$keyring_choice" =~ isolated ]]; then
    selected_keyring="isolated"
  fi

  echo -e "\n${CYAN}5. Select Default Preferred Editor:${NC}"
  local ide_choice
  ide_choice=$(gum choose --header "Choose the primary IDE to open with 'agy enter' / desktop:" \
    "code (Visual Studio Code pre-baked with Antigravity extension)" \
    "zed (Zed Editor pre-baked with Antigravity extension)" \
    "jetbrains (JetBrains IntelliJ / PyCharm on-demand installer)" \
    "none (Pure terminal / CLI workflow)")
  local selected_ide="code"
  if [[ "$ide_choice" =~ zed ]]; then
    selected_ide="zed"
  elif [[ "$ide_choice" =~ jetbrains ]]; then
    selected_ide="jetbrains"
  elif [[ "$ide_choice" =~ none ]]; then
    selected_ide="none"
  fi

  echo -e "\n${CYAN}6. Host Profile Seeding:${NC}"
  local seed_choice
  seed_choice=$(gum choose --header "Mount host ~/.gitconfig, ~/.ssh, and ~/.config/gcloud?" \
    "false (Clean isolated sandbox - recommended for privacy)" \
    "true (Seed credentials and configs from host read-only)")
  local selected_seeding="false"
  if [[ "$seed_choice" =~ true ]]; then
    selected_seeding="true"
  fi

  echo ""
  gum style --border rounded --padding "1 2" --border-foreground 39 \
    "Configuration Summary:" \
    "  • Container Engine: $selected_runtime" \
    "  • Primary Mode:     $selected_primary" \
    "  • Named Box Policy: $selected_named" \
    "  • Keyring Mode:     $selected_keyring" \
    "  • Preferred IDE:    $selected_ide" \
    "  • Profile Seeding:  $selected_seeding" \
    "  • Config File:      $config_file"

  if gum confirm "Save these settings and initialize agy-box?"; then
    mkdir -p "$config_dir"
    write_config_file "$config_file" "$selected_runtime" "$selected_primary" "$selected_named" "$selected_keyring" "$selected_ide" "$selected_seeding"
    load_config
    apply_keyring_configuration
    ui_ok "✓ Settings saved successfully to $config_file"
  else
    ui_warn "! Setup wizard cancelled. Existing settings were not changed."
  fi
}

cmd_check() {
  load_config
  local os_name
  os_name=$(get_os_name)
  local kernel_arch
  kernel_arch=$(uname -m 2>/dev/null || echo "unknown")
  local runtime
  runtime=$(detect_runtime)

  local runtime_ver="Unknown"
  local runtime_rootless="Unknown"
  if [ "$runtime" = "podman" ] && command -v podman >/dev/null 2>&1; then
    runtime_ver=$(podman --version 2>/dev/null | awk '{print $3}' || echo "installed")
    if podman info 2>/dev/null | grep -qi "rootless: true"; then
      runtime_rootless="Rootless"
    else
      runtime_rootless="Rootful"
    fi
  elif [ "$runtime" = "docker" ] && command -v docker >/dev/null 2>&1; then
    runtime_ver=$(docker --version 2>/dev/null | awk '{print $3}' | tr -d ',' || echo "installed")
    if docker info 2>/dev/null | grep -qi "rootless"; then
      runtime_rootless="Rootless"
    else
      runtime_rootless="Rootful"
    fi
  fi

  local dbx_ver="Missing"
  if command -v distrobox >/dev/null 2>&1; then
    dbx_ver=$(distrobox --version 2>/dev/null | awk '{print $2}' || echo "Installed")
  fi

  local official_status="Not Installed" dev_status="Not Installed"
  if check_container_exists "$CONTAINER_NAME"; then
    is_container_running "$CONTAINER_NAME" "$runtime" && official_status="Running" || official_status="Stopped"
  fi
  if check_container_exists "$DEV_CONTAINER_NAME"; then
    is_container_running "$DEV_CONTAINER_NAME" "$runtime" && dev_status="Running" || dev_status="Stopped"
  fi

  local active_box="" box_running=false
  if [ "$official_status" = "Running" ]; then
    active_box="$CONTAINER_NAME"; box_running=true
  elif [ "$dev_status" = "Running" ]; then
    active_box="$DEV_CONTAINER_NAME"; box_running=true
  elif [ "$official_status" = "Stopped" ]; then
    active_box="$CONTAINER_NAME"
  elif [ "$dev_status" = "Stopped" ]; then
    active_box="$DEV_CONTAINER_NAME"
  else
    local b
    while IFS= read -r b; do
      if [ -n "$b" ] && is_container_running "$b" "$runtime"; then
        active_box="$b"; box_running=true; break
      fi
    done < <(get_all_agy_boxes)
  fi

  local isolated_home
  isolated_home=$(get_box_home "${active_box:-$CONTAINER_NAME}")
  local agy_ver="Not Installed"
  local agy_bin="$isolated_home/.local/bin/agy"
  if [ -x "$HOME/.local/bin/agy" ]; then
    agy_ver=$("$HOME/.local/bin/agy" --version 2>/dev/null || echo "Available (host shim)")
  elif [ -x "$agy_bin" ]; then
    agy_ver=$("$agy_bin" --version 2>/dev/null || echo "Available (in box)")
  fi

  local python_ver="N/A"
  local node_ver="N/A"
  local gcloud_ver="N/A"
  local gh_ver="N/A"
  local code_ver="N/A"
  local code_ext="N/A"
  local zed_ver="N/A"
  local zed_ext="N/A"
  local jetbrains_status="Installer Available (agy-install-ide)"

  local active_mgr=""
  if [ -n "$active_box" ] && [ "$box_running" = "true" ]; then
    active_mgr=$(get_box_manager "$active_box")
    local exec_cmd=()
    if [ "$active_mgr" = "distrobox" ]; then
      exec_cmd=(distrobox enter "$active_box" --)
    else
      exec_cmd=("$runtime" exec -u agyuser -w /home/agyuser "$active_box")
    fi
    if [ "$agy_ver" = "Not Installed" ]; then
      local box_agy_ver
      box_agy_ver=$("${exec_cmd[@]}" agy --version 2>/dev/null | head -n 1 || true)
      if [ -n "$box_agy_ver" ]; then
        agy_ver="$box_agy_ver"
      fi
    fi
    python_ver=$("${exec_cmd[@]}" python3 --version 2>/dev/null | awk '{print $2}' || echo "N/A")
    node_ver=$("${exec_cmd[@]}" node --version 2>/dev/null || echo "N/A")
    gcloud_ver=$("${exec_cmd[@]}" gcloud --version 2>/dev/null | head -n 1 | awk '{print $4}' || echo "N/A")
    gh_ver=$("${exec_cmd[@]}" gh --version 2>/dev/null | head -n 1 | awk '{print $3}' || echo "N/A")
    code_ver=$("${exec_cmd[@]}" code --version 2>/dev/null | head -n 1 || echo "N/A")
    if "${exec_cmd[@]}" code --list-extensions 2>/dev/null | grep -qi "antigravity"; then
      code_ext="Installed (Google.google-antigravity)"
    else
      code_ext="Not Installed"
    fi
    zed_ver=$("${exec_cmd[@]}" zed --version 2>/dev/null | awk '{print $2}' || echo "N/A")
  elif [ -n "$active_box" ]; then
    if [ -x "$isolated_home/.local/bin/agy" ]; then
      agy_ver="Installed (Container stopped)"
    fi
    if [ -f "$isolated_home/.config/zed/settings.json" ]; then
      zed_ext="Configured"
    fi
  fi

  if [ -f "$isolated_home/.config/zed/settings.json" ] && grep -q "antigravity" "$isolated_home/.config/zed/settings.json" 2>/dev/null; then
    zed_ext="Auto-Install Enabled"
  fi

  if [ -d "$isolated_home/.local/share/JetBrains" ]; then
    jetbrains_status="Installed in ~/.local/share/JetBrains"
  fi

  local keyring_mode="${AGY_KEYRING_MODE:-host}"
  local keyring_backend="Host SecretService"
  if [ "$keyring_mode" = "isolated" ]; then
    keyring_backend="EncryptedKeyring (Air-gapped file)"
  fi

  local gcloud_auth="Unauthenticated"
  if [ -d "$isolated_home/.config/gcloud/credentials.db" ] || [ -f "$isolated_home/.config/gcloud/application_default_credentials.json" ] || [ -d "$HOME/.config/gcloud" ]; then
    gcloud_auth="Configured"
  fi

  local gh_auth="Not Logged In"
  if [ -n "$active_box" ] && [ "$box_running" = "true" ]; then
    if [ "$active_mgr" = "distrobox" ]; then
      if distrobox enter "$active_box" -- gh auth status &>/dev/null; then
        gh_auth="Logged In"
      fi
    else
      if "$runtime" exec -u agyuser -w /home/agyuser "$active_box" gh auth status &>/dev/null; then
        gh_auth="Logged In"
      fi
    fi
  elif [ -f "$isolated_home/.config/gh/hosts.yml" ] || [ -f "$HOME/.config/gh/hosts.yml" ]; then
    gh_auth="Configured"
  fi

  local agy_auth="Not Initialized (Runs on first agy launch)"
  if [ -d "$isolated_home/.gemini" ]; then
    agy_auth="Initialized (~/.gemini present)"
  fi

  local config_file
  config_file=$(get_config_file)

  cat <<EOF
${CYAN}======================================================================${NC}
${WHITE}               🚀 AGY Box Component & Status Inspector                ${NC}
${CYAN}======================================================================${NC}

${BLUE}[ Host Environment ]${NC}
  Host OS:             $os_name ($kernel_arch)
  Container Engine:    $runtime ($runtime_ver, $runtime_rootless)
  Distrobox:           $dbx_ver
  Config File:         $config_file
  Keyring Mode:        $keyring_mode
  Default IDE:         ${AGY_DEFAULT_IDE:-code}
  Profile Seeding:     ${AGY_PROFILE_SEEDING:-false}

${BLUE}[ Container Workspaces ]${NC}
  agy-box (Official):  $official_status
  agy-box-dev (Dev):   $dev_status

${BLUE}[ Antigravity Toolchain ]${NC}
  agy CLI:             $agy_ver
  Python Runtime:      $python_ver
  Node.js:             $node_ver
  Google Cloud SDK:    $gcloud_ver
  GitHub CLI:          $gh_ver

${BLUE}[ IDE Integrations ]${NC}
  VS Code:             $code_ver (Extension: $code_ext)
  Zed Editor:          $zed_ver (Extension: $zed_ext)
  JetBrains:           $jetbrains_status

${BLUE}[ Keyring & Authentication ]${NC}
  Keyring Backend:     $keyring_backend
  Google Cloud:        $gcloud_auth
  GitHub CLI:          $gh_auth
  Antigravity Auth:    $agy_auth
${CYAN}======================================================================${NC}

EOF
  return 0
}

cmd_backup() {
  load_config
  local dest=${1:-""}
  local timestamp
  timestamp=$(date +%Y%m%d-%H%M%S)

  if [ -z "$dest" ]; then
    dest="$PWD/agy-box-backup-${timestamp}.tar.gz"
  elif [ -d "$dest" ]; then
    dest="${dest%/}/agy-box-backup-${timestamp}.tar.gz"
  fi

  local backup_items=()

  if [ -f "$HOME/.config/agy-box/config.env" ]; then
    backup_items+=(".config/agy-box/config.env")
  fi
  if [ -f "$HOME/.config/agy-box/limits.conf" ]; then
    backup_items+=(".config/agy-box/limits.conf")
  fi

  local candidate_items=(
    ".config/agy-box/home/.gemini"
    ".config/agy-box/home/.config/Antigravity"
    ".config/agy-box/home/.config/Antigravity-box"
    ".config/agy-box/home/.config/antigravity"
    ".config/agy-box/home/.config/zed"
    ".config/agy-box/home/.config/Code"
    ".config/agy-box/home/.config/environment.d"
    ".config/agy-box/home/.config/python_keyring"
    ".config/agy-box/home/.local/share/keyrings"
  )

  for item in "${candidate_items[@]}"; do
    if [ -e "$HOME/$item" ]; then
      backup_items+=("$item")
    fi
  done

  if [ ${#backup_items[@]} -eq 0 ]; then
    ui_warn "! No agy-box configuration or workspace state found to back up."
    return 1
  fi

  echo "📦 Backing up agy-box configuration and workspace state..."
  for item in "${backup_items[@]}"; do
    echo "   + ~/$item"
  done

  mkdir -p "$(dirname "$dest")"
  tar -czf "$dest" -C "$HOME" "${backup_items[@]}"

  local size
  size=$(du -h "$dest" 2>/dev/null | awk '{print $1}' || echo "unknown")
  ui_ok "✓ Backup archive created successfully!"
  echo "   Location: $dest ($size)"
}

cmd_restore() {
  load_config
  local archive=""
  local auto_yes=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -y|--yes)
        auto_yes=true
        shift
        ;;
      *)
        if [ -z "$archive" ]; then
          archive="$1"
        fi
        shift
        ;;
    esac
  done

  if [ -z "$archive" ]; then
    ui_error "❌ Error: Backup archive path required."
    echo "Usage: agy-box-manager restore <path-to-archive.tar.gz> [-y]"
    return 1
  fi

  if [ ! -f "$archive" ]; then
    ui_error "❌ Error: Backup file not found: $archive"
    return 1
  fi

  if ! tar -tzf "$archive" >/dev/null 2>&1; then
    ui_error "❌ Error: Invalid or corrupted tar.gz archive: $archive"
    return 1
  fi

  if [ "$auto_yes" != "true" ] && command -v gum >/dev/null 2>&1 && [ -t 0 ]; then
    echo -e "${YELLOW}Warning: Restoring will overwrite existing settings and credentials.${NC}"
    if ! gum confirm "Are you sure you want to restore from $archive?"; then
      ui_warn "! Restore cancelled."
      return 0
    fi
  fi

  echo "🔄 Restoring configuration and state from $archive..."
  tar -xzf "$archive" -C "$HOME"

  local isolated_home="$HOME/.config/agy-box/home"
  local runtime
  runtime=$(detect_runtime)
  if [ "$runtime" = "podman" ] && [ -d "$isolated_home" ]; then
    podman unshare chown -R 0:0 "$isolated_home" 2>/dev/null || true
  fi

  load_config
  apply_keyring_configuration

  ui_ok "✓ Settings and workspace state restored successfully!"
}

cmd_clean() {
  local target_name="$CONTAINER_NAME"
  local purge_home=false
  local keep_home=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --purge|-p)
        purge_home=true
        shift
        ;;
      --keep|-k)
        keep_home=true
        shift
        ;;
      -y|--yes)
        shift
        ;;
      dev)
        target_name="$DEV_CONTAINER_NAME"
        shift
        ;;
      prod)
        target_name="$CONTAINER_NAME"
        shift
        ;;
      -*)
        ui_error "Unknown option: $1"
        echo "Usage: agy-box-manager clean [name|dev|prod] [--purge|-p] [--keep|-k] [-y|--yes]" >&2
        return 1
        ;;
      *)
        target_name="$1"
        shift
        ;;
    esac
  done

  if ! check_container_exists "$target_name" && check_container_exists "agy-box-$target_name"; then
    target_name="agy-box-$target_name"
  fi

  local box_home
  box_home=$(get_box_home "$target_name")
  if [ ! -d "$box_home" ] && [ -d "$(get_box_home "agy-box-$target_name")" ]; then
    target_name="agy-box-$target_name"
    box_home=$(get_box_home "$target_name")
  fi
  local container_found=false

  if check_container_exists "$target_name"; then
    container_found=true
    unexport_agy_cli "$target_name"
    local mgr
    mgr=$(get_box_manager "$target_name")
    if [ "$mgr" = "distrobox" ]; then
      run_step "Removing Distrobox environment: $target_name..." distrobox rm --yes "$target_name"
    else
      local runtime
      runtime=$(get_runtime)
      run_step "Removing $runtime container: $target_name..." "$runtime" rm -f "$target_name"
    fi
    ui_ok "✓ Removed container $target_name"
  fi

  if [ "$target_name" != "$CONTAINER_NAME" ] && [ -d "$box_home" ]; then
    if [ "$purge_home" = "true" ]; then
      purge_box_home "$box_home"
      ui_ok "✓ Purged isolated home directory: $box_home"
    elif [ "$keep_home" = "true" ]; then
      ui_warn "ℹ️  Isolated home preserved at: $box_home"
    elif [ -t 0 ] && command -v gum >/dev/null 2>&1; then
      echo ""
      gum style --foreground 214 "Data Retention Choice for '$target_name':"
      local clean_action
      clean_action=$(gum choose --header "What should happen to the isolated home directory ($box_home)?" \
        "Purge all data (Clean slate - delete all files)" \
        "Keep data intact (Preserve workspace state & configs)")
      case "$clean_action" in
        "Purge"*)
          purge_box_home "$box_home"
          ui_ok "✓ Purged isolated home directory: $box_home"
          ;;
        "Keep"*)
          ui_warn "ℹ️  Isolated home preserved at: $box_home"
          ;;
      esac
    elif [ -t 0 ]; then
      echo -e "${YELLOW}What should happen to the isolated home directory ($box_home)?${NC}"
      echo "1) Purge all data (Clean slate)"
      echo "2) Keep data intact"
      read -r -p "Select [1 or 2]: " choice
      if [ "$choice" = "1" ]; then
        purge_box_home "$box_home"
        ui_ok "✓ Purged isolated home directory: $box_home"
      else
        ui_warn "ℹ️  Isolated home preserved at: $box_home"
      fi
    else
      ui_error "❌ Error: Non-interactive clean requires an explicit choice. Pass --purge to delete container data or --keep to preserve it."
      exit 1
    fi
  elif [ "$container_found" = "false" ]; then
    ui_warn "! Warning: Neither container '$target_name' nor data directory '$box_home' exists."
  fi
}

cmd_status() {
  echo ""
  if command -v gum >/dev/null 2>&1; then
    gum style --foreground 212 --border normal --padding "0 1" "AGY Box Environments Status"
  else
    echo -e "${MAGENTA}=== AGY Box Environments Status ===${NC}"
  fi

  local runtime
  runtime=$(get_runtime 2>/dev/null || echo "podman")

  local all_boxes=()
  while IFS= read -r b; do
    [ -n "$b" ] && all_boxes+=("$b")
  done < <(get_all_agy_boxes)

  if [ ${#all_boxes[@]} -gt 0 ]; then
    echo -e "\n${CYAN}Active & Installed Environments:${NC}"
    printf "  %-22s %-12s %-12s %-10s %s\n" "NAME" "ENGINE" "STATUS" "VDI PORT" "HOME PATH"
    printf "  %-22s %-12s %-12s %-10s %s\n" "----" "------" "------" "--------" "---------"

    for b in "${all_boxes[@]}"; do
      local mgr
      mgr=$(get_box_manager "$b")
      local status="stopped"
      is_container_running "$b" "$runtime" && status="running"

      local vdi_port="6080"
      if [ "$b" != "$CONTAINER_NAME" ]; then
        local port_offset
        port_offset=$(calculate_box_port_offset "$b")
        vdi_port=$((6080 + port_offset))
      fi

      local h
      h=$(get_box_home "$b")
      printf "  %-22s %-12s %-12s %-10s %s\n" "$b" "$mgr" "$status" "$vdi_port" "$h"
    done
  else
    if command -v gum >/dev/null 2>&1; then
      gum style --foreground 214 "No AGY Boxes found."
    else
      echo "No AGY Boxes found."
    fi
  fi

  local homes_dir="$HOME/.config/agy-box/homes"
  local orphaned_homes=()
  if [ -d "$homes_dir" ]; then
    for d in "$homes_dir"/*; do
      if [ -d "$d" ]; then
        local b_name
        b_name=$(basename "$d")
        if ! check_container_exists "$b_name" && ! check_container_exists "agy-box-$b_name"; then
          orphaned_homes+=("$b_name")
        fi
      fi
    done
  fi

  if [ ${#orphaned_homes[@]} -gt 0 ]; then
    echo -e "\n${YELLOW}Preserved Data Directories (No Active Container):${NC}"
    printf "  %-22s %-10s %s\n" "BOX NAME" "SIZE" "PATH"
    printf "  %-22s %-10s %s\n" "--------" "----" "----"
    for ob in "${orphaned_homes[@]}"; do
      local d="$homes_dir/$ob"
      local sz
      sz=$(du -sh "$d" 2>/dev/null | cut -f1 || echo "N/A")
      printf "  %-22s %-10s %s\n" "$ob" "$sz" "$d"
    done
    echo -e "\n${DIM}Tip: Run 'just agy-clean <name> --purge' or use the TUI menu to remove preserved data.${NC}"
  fi
  echo ""
}

cmd_install_global() {
  local target_dir="$HOME/.local/bin"
  local target_file="$target_dir/agy-box-manager"

  if command -v gum >/dev/null 2>&1 && [ -t 1 ] && [ -t 0 ] && [ "${AGY_NONINTERACTIVE:-0}" != "1" ]; then
    gum spin --spinner dot --title "Installing globally to $target_dir..." -- sleep 1
  else
    echo "==> Installing globally to $target_dir..."
  fi
  mkdir -p "$target_dir"

  local self_name="${0##*/}"
  case "$self_name" in
    bash|-bash|sh|-sh)
      curl -fsSL "$REMOTE_SCRIPT_URL" -o "$target_file"
      ;;
    *)
      if [ -f "$0" ]; then
        if [ ! "$0" -ef "$target_file" ]; then
          cp "$0" "$target_file"
        fi
      else
        curl -fsSL "$REMOTE_SCRIPT_URL" -o "$target_file"
      fi
      ;;
  esac

  chmod +x "$target_file"

  if command -v gum >/dev/null 2>&1; then
    gum style --foreground 46 --margin "1 0" "✓ Installed globally! You can now run 'agy-box-manager' from anywhere."
  else
    ui_ok "✓ Installed globally! You can now run 'agy-box-manager' from anywhere."
  fi

  if command -v ujust &> /dev/null; then
    if command -v gum >/dev/null 2>&1; then
      gum style --foreground 39 "🟦 Universal Blue detected: $target_dir is in your PATH by default."
    else
      echo -e "${CYAN}🟦 Universal Blue detected: $target_dir is in your PATH by default.${NC}"
    fi
  else
    ui_warn "Make sure $target_dir is added to your \$PATH variable."
  fi

  setup_shell_integration
}

cmd_uninstall_global() {
  local target_file="$HOME/.local/bin/agy-box-manager"
  local auto_yes=false
  if [ "${1:-}" = "-y" ] || [ "${1:-}" = "--yes" ]; then
    auto_yes=true
  fi

  local confirmed=false
  if [ "$auto_yes" = "true" ]; then
    confirmed=true
  elif command -v gum >/dev/null 2>&1 && [ -t 0 ]; then
    if gum confirm "Are you sure you want to remove the global CLI installation?"; then
      confirmed=true
    fi
  elif [ -t 0 ]; then
    local uninstall_choice=""
    read -r -p "Are you sure you want to remove the global CLI installation? [y/N] " uninstall_choice
    if [[ "$uninstall_choice" =~ ^[Yy]$ ]]; then
      confirmed=true
    fi
  else
    confirmed=true
  fi

  if [ "$confirmed" = "true" ]; then
    run_step "Removing globally installed CLI..." rm -f "$target_file"

    rm -f "$HOME/.local/share/bash-completion/completions/agy-box-manager"
    rm -f "$HOME/.local/share/bash-completion/completions/agy"
    rm -f "$HOME/.zfunc/_agy-box-manager"
    rm -f "$HOME/.zfunc/_agy"
    rm -f "$HOME/.config/fish/completions/agy-box-manager.fish"
    rm -f "$HOME/.config/fish/completions/agy.fish"
    rm -f "$HOME/.config/agy-box-manager/.completions_installed"

    rm -f "$HOME/.config/agy-box/shell_integration.sh"
    rm -f "$HOME/.config/agy-box/justfile"
    rm -f "$HOME/.config/fish/functions/just.fish"
    rm -f "$HOME/.config/fish/functions/ujust.fish"

    if command -v python3 >/dev/null 2>&1 && { [ -f "$HOME/.bashrc" ] || [ -f "$HOME/.zshrc" ]; }; then
      # shellcheck disable=SC2016
      python3 -c '
import os
for rc in ("~/.bashrc", "~/.zshrc"):
    p = os.path.expanduser(rc)
    if os.path.exists(p):
        with open(p) as f: c = f.read()
        for b in ("if [ -f \"$HOME/.config/agy-box/shell_integration.sh\" ]; then\n    . \"$HOME/.config/agy-box/shell_integration.sh\"\nfi\n", "if [ -f \"$HOME/.config/agy-box/shell_integration.sh\" ]; then\n  . \"$HOME/.config/agy-box/shell_integration.sh\"\nfi\n", "fpath=(~/.zfunc $fpath)\n"): c = c.replace(b, "")
        with open(p, "w") as f: f.write(c)
'
    fi

    if command -v gum >/dev/null 2>&1; then
      gum style --foreground 46 --margin "1 0" "✓ Removed globally installed CLI, auto-completions, and shell integrations."
    else
      ui_ok "✓ Removed globally installed CLI, auto-completions, and shell integrations."
    fi
  else
    ui_warn "Skipping uninstall."
  fi
}

