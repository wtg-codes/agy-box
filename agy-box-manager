    echo "  test                Run the local integration test suite"
    echo ""
}

# Allow scripts/test-box.sh to source this file and reuse the functions above
# (same code path as the real install) without running the CLI. `return` only
# succeeds when sourced; direct execution and `curl ... | bash` fall through.
if (return 0 2>/dev/null); then
    return 0
fi

# --- Main Logic ---
setup_completions

case "${1:-}" in
    wizard)           check_deps "optional"; cmd_wizard "${@:2}" ;;
    check)            check_deps "optional"; cmd_check "${@:2}" ;;
    update)           check_deps "optional"; cmd_update "${@:2}" ;;
    backup)           check_deps "optional"; cmd_backup "${@:2}" ;;
    restore)          check_deps "optional"; cmd_restore "${@:2}" ;;
    install)          check_deps "quiet"; cmd_install_official "${@:2}" ;;
    dev)              check_deps "quiet"; cmd_build_dev "${@:2}" ;;
    enter)            check_deps "quiet"; if [ "${2:-}" = "dev" ]; then cmd_enter dev; else cmd_enter prod; fi ;;
    desktop)          check_deps "quiet"; if [ "${2:-}" = "dev" ]; then cmd_desktop dev; else cmd_desktop prod; fi ;;
    clean)            check_deps "quiet"; if [ "${2:-}" = "dev" ]; then cmd_clean "$DEV_CONTAINER_NAME"; else cmd_clean "$CONTAINER_NAME"; fi ;;
    update-toolchain) check_deps "quiet"; if [ "${2:-}" = "dev" ]; then cmd_update_toolchain dev; else cmd_update_toolchain prod; fi ;;
    status)           check_deps "optional"; cmd_status ;;
    ports)            check_deps "quiet"; cmd_ports ;;
    doctor)           check_deps "optional"; cmd_doctor ;;
    install-global)   check_deps "optional"; cmd_install_global ;;
    uninstall-global) check_deps "optional"; cmd_uninstall_global ;;
    autocomplete)     cmd_autocomplete "${2:-bash}" ;;
    test)             check_deps "quiet"; if [ -f "scripts/test-box.sh" ]; then ./scripts/test-box.sh; else echo -e "${RED}Test script not found. Please run this command inside the repository.${NC}"; exit 1; fi ;;
    version|--version|-v) echo "agy-box-manager version $VERSION"; exit 0 ;;
    help|--help|-h)   show_help ;;
    "")               cmd_interactive ;;
    *)                if command -v gum >/dev/null 2>&1; then gum style --foreground 196 "Unknown command: $1"; else echo -e "${RED}Unknown command: $1${NC}"; fi; echo ""; show_help; exit 1 ;;
esac
