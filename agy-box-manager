#!/bin/bash
# agy-box-manager - A modern CLI for managing the agy-box Distrobox environment

set -euo pipefail

# --- Configuration ---
VERSION="2.1.0"
IMAGE_NAME="ghcr.io/wtg-codes/agy-box:latest"
DEV_IMAGE_NAME="agy-box:dev"
CONTAINER_NAME="agy-box"
DEV_CONTAINER_NAME="agy-box-dev"
REMOTE_SCRIPT_URL="https://raw.githubusercontent.com/wtg-codes/agy-box/main/agy-box-manager"

# --- Colors for ASCII Art ---
RED=$'\e[0;31m'
BLUE=$'\e[0;34m'
CYAN=$'\e[0;36m'
WHITE=$'\e[1;37m'
NC=$'\e[0m' # No Color

# --- Helper Functions ---
get_os_name() {
    if [ -f /etc/os-release ]; then
        # shellcheck disable=SC1091
        . /etc/os-release
        echo "${PRETTY_NAME:-Linux}"
    else
        echo "Linux"
    fi
}

# --- Dependency Management ---
install_gum() {
    echo -e "${CYAN}Gum is required for the UI but is not installed.${NC}"
    # When piped via curl, read needs to be forced to /dev/tty
    exec < /dev/tty
    read -r -p "Would you like to attempt to install it now? (y/N): " choice
    if [[ "$choice" =~ ^[Yy]$ ]]; then
        if command -v brew &> /dev/null; then
            echo "Installing via Homebrew (Recommended for immutable systems)..."
            brew install gum
        elif command -v apt-get &> /dev/null; then
            echo "Installing via APT (Debian/Ubuntu)..."
            sudo mkdir -p /etc/apt/keyrings
            curl -fsSL https://repo.charm.sh/apt/gpg.key | sudo gpg --dearmor -o /etc/apt/keyrings/charm.gpg
            echo "deb [signed-by=/etc/apt/keyrings/charm.gpg] https://repo.charm.sh/apt/ * *" | sudo tee /etc/apt/sources.list.d/charm.list
            sudo apt update && sudo apt install -y gum
        elif command -v dnf &> /dev/null; then
            echo "Installing via DNF (Fedora/RHEL)..."
            echo '[charm]
name=Charm
baseurl=https://repo.charm.sh/yum/
enabled=1
gpgcheck=1
gpgkey=https://repo.charm.sh/yum/gpg.key' | sudo tee /etc/yum.repos.d/charm.repo
            sudo dnf install -y gum
        elif command -v pacman &> /dev/null; then
            echo "Installing via Pacman (Arch/Manjaro)..."
            sudo pacman -S --noconfirm gum
        elif command -v zypper &> /dev/null; then
            echo "Installing via Zypper (openSUSE)..."
            echo '[charm]
name=Charm
baseurl=https://repo.charm.sh/yum/
enabled=1
gpgcheck=1
gpgkey=https://repo.charm.sh/yum/gpg.key' | sudo tee /etc/zypp/repos.d/charm.repo
            sudo zypper install -y gum
        else
            echo -e "${RED}Could not detect supported package manager (brew, apt, dnf, pacman, zypper).${NC}"
            echo "Please install manually: https://github.com/charmbracelet/gum#installation"
            exit 1
        fi
    else
        echo "Gum is required to run this script interactively. Exiting."
        exit 1
    fi
}

check_deps() {
    local mode=${1:-}
    if ! command -v gum &> /dev/null; then
        install_gum
    fi

    if [ "$mode" = "menu" ]; then
        return 0
    fi

    local missing=0
    if ! command -v distrobox &> /dev/null; then
        echo -e "${RED}✗ Error: distrobox is not installed on the host system.${NC}" >&2
        missing=1
    fi
    if ! command -v podman &> /dev/null && ! command -v docker &> /dev/null; then
        echo -e "${RED}✗ Error: Neither podman nor docker is installed on the host system.${NC}" >&2
        missing=1
    fi
    if [ $missing -eq 1 ]; then
        echo -e "\n${CYAN}Would you like to try installing the missing container dependencies now?${NC}"
        exec < /dev/tty
        if gum confirm "Install missing dependencies?"; then
            if command -v apt-get &> /dev/null; then
                sudo apt update && sudo apt install -y podman distrobox
            elif command -v dnf &> /dev/null; then
                sudo dnf install -y podman distrobox
            elif command -v pacman &> /dev/null; then
                sudo pacman -S --noconfirm podman distrobox
            elif command -v zypper &> /dev/null; then
                sudo zypper install -y podman distrobox
            elif command -v brew &> /dev/null; then
                brew install podman distrobox
            else
                echo -e "${RED}Could not detect a supported package manager. Please install manually.${NC}"
                exit 1
            fi

            # Re-check dependencies
            if ! command -v distrobox &> /dev/null || (! command -v podman &> /dev/null && ! command -v docker &> /dev/null); then
                echo -e "${RED}Dependencies still missing after installation attempt. Please install manually.${NC}"
                exit 1
            else
                echo -e "${CYAN}Dependencies installed successfully!${NC}"
            fi
        else
            echo -e "\nPlease install the missing container dependencies and try again."
            exit 1
        fi
    fi

}

get_runtime() {
    if command -v podman &> /dev/null; then echo "podman"; else echo "docker"; fi
}

check_container_exists() {
    local name=$1
    if distrobox list --no-color | grep -qw "$name"; then return 0; else return 1; fi
}

setup_completions() {
    # Bash Auto-Completions
    local bash_comp_dir="$HOME/.local/share/bash-completion/completions"
    mkdir -p "$bash_comp_dir"
    cat << 'EOF_COMP' > "$bash_comp_dir/agy-box-manager"
_agy_box_manager() {
    local cur opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    opts="install dev enter clean status install-global uninstall-global test"
    COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
    return 0
}
complete -F _agy_box_manager agy-box-manager
EOF_COMP

    # Zsh Auto-Completions
    local zsh_comp_dir="$HOME/.zfunc"
    mkdir -p "$zsh_comp_dir"
    cat << 'EOF_COMP' > "$zsh_comp_dir/_agy-box-manager"
#compdef agy-box-manager
local -a commands
commands=(
    'install:Pull official image'
    'dev:Build dev image'
    'enter:Enter workspace'
    'clean:Remove workspace'
    'status:Show status'
    'install-global:Install globally'
    'uninstall-global:Remove global install'
    'test:Run local integration tests'
)
_describe 'command' commands
EOF_COMP
    if [ -f "$HOME/.zshrc" ] && ! grep -q "fpath=(~/.zfunc \$fpath)" "$HOME/.zshrc"; then
        # shellcheck disable=SC2016
        echo -e '\n# Added by agy-box-manager\nfpath=(~/.zfunc \$fpath)' >> "$HOME/.zshrc"
    fi
}

# --- Core Commands ---
cmd_install_official() {
    if check_container_exists "$CONTAINER_NAME"; then
        if gum confirm "Container '$CONTAINER_NAME' already exists. Recreate it?"; then
            cmd_clean "$CONTAINER_NAME"
        else
            gum style --foreground 212 "Skipping creation."
            return
        fi
    fi

    gum style --foreground 39 "🚀 Pulling official image and creating Distrobox environment..."
    distrobox create -i "$IMAGE_NAME" -n "$CONTAINER_NAME"
    gum style --foreground 46 --margin "1 0" "✓ Created successfully! Run 'agy-box-manager enter' to start."
}

cmd_build_dev() {
    if [ ! -f "Containerfile" ]; then
        gum style --foreground 196 "✗ Error: Containerfile not found in current directory. Please clone the repository first to build from source."
        exit 1
    fi

    if check_container_exists "$DEV_CONTAINER_NAME"; then
        if gum confirm "Container '$DEV_CONTAINER_NAME' already exists. Recreate it?"; then
            cmd_clean "$DEV_CONTAINER_NAME"
        else
            gum style --foreground 212 "Skipping build."
            return
        fi
    fi

    local runtime
    runtime=$(get_runtime)

    gum style --foreground 39 "🛠️  Building development image with $runtime (this may take a while)..."
    "$runtime" build -t "$DEV_IMAGE_NAME" -f Containerfile .

    gum style --foreground 39 "📦 Creating development Distrobox environment..."
    distrobox create -i "$DEV_IMAGE_NAME" -n "$DEV_CONTAINER_NAME"

    gum style --foreground 46 --margin "1 0" "✓ Dev environment ready! Run 'agy-box-manager enter dev' to start."
}

cmd_desktop() {
    local env_type=${1:-prod}
    local target_name=$CONTAINER_NAME
    [ "$env_type" = "dev" ] && target_name=$DEV_CONTAINER_NAME

    if ! check_container_exists "$target_name"; then
        gum style --foreground 196 "Environment '$target_name' does not exist. Please install or build it first."
        exit 1
    fi

    echo -e "Starting VDI Virtual Desktop inside ${CYAN}$target_name${NC}..."
    distrobox enter "$target_name" -- /usr/local/bin/agy-vdi
}

cmd_enter() {
    local env_type=${1:-prod}
    local target_name=$CONTAINER_NAME
    [ "$env_type" = "dev" ] && target_name=$DEV_CONTAINER_NAME

    if ! check_container_exists "$target_name"; then
        gum style --foreground 196 "Environment '$target_name' does not exist. Please install or build it first."
        exit 1
    fi

    echo -e "Entering ${CYAN}$target_name${NC}..."
    distrobox enter "$target_name"
}

cmd_clean() {
    local target_name=${1:-$CONTAINER_NAME}
    if check_container_exists "$target_name"; then
        gum spin --spinner dot --title "Removing environment: $target_name..." -- distrobox rm --yes "$target_name"
        gum style --foreground 46 "✓ Removed $target_name"
    else
        gum style --foreground 214 "! Warning: $target_name does not exist."
    fi
}

cmd_status() {
    echo ""
    gum style --foreground 212 --border normal --padding "0 1" "Distrobox Status"
    distrobox list | grep -E "NAME|$CONTAINER_NAME|$DEV_CONTAINER_NAME" || gum style --foreground 214 "No AGY Boxes found."
    echo ""
}

cmd_install_global() {
    local target_dir="$HOME/.local/bin"
    local target_file="$target_dir/agy-box-manager"

    gum spin --spinner dot --title "Installing globally to $target_dir..." -- sleep 1
    mkdir -p "$target_dir"

    # Check if executed locally or via curl pipe
    if [ -f "$0" ] && [[ "$0" != *"bash"* ]] && [[ "$0" != *"sh"* ]]; then
        cp "$0" "$target_file"
    else
        # If curled directly to bash, download from remote URL
        curl -fsSL "$REMOTE_SCRIPT_URL" -o "$target_file"
    fi

    chmod +x "$target_file"

    gum style --foreground 46 --margin "1 0" "✓ Installed globally! You can now run 'agy-box-manager' from anywhere."

    if command -v ujust &> /dev/null; then
        gum style --foreground 39 "🟦 Universal Blue detected: $target_dir is in your PATH by default."
    else
        gum style --foreground 214 "Make sure $target_dir is added to your \$PATH variable."
    fi
}

cmd_uninstall_global() {
    local target_file="$HOME/.local/bin/agy-box-manager"

    if gum confirm "Are you sure you want to remove the global CLI installation?"; then
        gum spin --spinner dot --title "Removing globally installed CLI..." -- rm -f "$target_file"

        # Clean up auto-completions
        rm -f "$HOME/.local/share/bash-completion/completions/agy-box-manager"
        rm -f "$HOME/.zfunc/_agy-box-manager"
        rm -f "$HOME/.config/agy-box-manager/.completions_installed"

        gum style --foreground 46 --margin "1 0" "✓ Removed globally installed CLI and auto-completions."
    else
        gum style --foreground 212 "Skipping uninstall."
    fi
}

# shellcheck disable=SC2059
show_banner() {
    clear
    printf "${CYAN}         .  * .  . * * .        .${NC}\n"
    printf "${CYAN}      * .       * .         * .${NC}\n"
    printf "${WHITE}         /\\ ${CYAN}   .       .            .${NC}\n"
    printf "${WHITE}        /==\\${CYAN}       * *${NC}\n"
    printf "${WHITE}       /    \\${CYAN}    * .       .    .      *${NC}\n"
    printf "${WHITE}      /      \\${CYAN}                  .          .${NC}\n"
    printf "${WHITE}     |   /\\   |${BLUE}%s${NC}\n"  '    ___   ______  __  __      ____   ____  _  __'
    printf "${WHITE}     |  |==|  |${BLUE}%s${NC}\n"  '   /   | / ____/ / / / /     / __ ) / __ \| |/ /'
    printf "${WHITE}     |  |  |  |${BLUE}%s${NC}\n"  '  / /| |/ / __  / /_/ /     / __  |/ / / /|   / '
    printf "${WHITE}    /| /____\\ |\\${BLUE}%s${NC}\n" ' / ___ / /_/ /  \__, /     / /_/ // /_/ //   |  '
    printf "${WHITE}   / | |    | | \\${BLUE}%s${NC}\n" '/_/  |_\____/  /____/     /_____/ \____//_/|_|  '
    printf "${WHITE}  /__|_|____|_|__\\${NC}\n"
    printf "${RED}      /\\/\\/\\/\\ ${NC}\n"
    printf "${RED}      ####  #### ${NC}\n"
    printf "${CYAN}    *          *    .          *${NC}\n"

    gum style \
        --foreground 212 --border-foreground 212 --border rounded \
        --align center --width 50 --margin "1 2" --padding "0 2" \
        "🚀 AGY Box Manager v${VERSION} 🧑‍🚀" \
        "Antigravity 2.0 Developer Sandbox"
}

show_system_status() {
    local os_name
    os_name=$(get_os_name)

    local podman_status="❌ Podman: Missing"
    local docker_status="❌ Docker: Missing"
    local distrobox_status="❌ Distrobox: Missing"

    if command -v podman &> /dev/null; then podman_status="✅ Podman: Installed"; fi
    if command -v docker &> /dev/null; then docker_status="✅ Docker: Installed"; fi
    if command -v distrobox &> /dev/null; then distrobox_status="✅ Distrobox: Installed"; fi

    local official_status="🚀 Official: Not Installed"
    local dev_status="🛠️  Dev Env: Not Installed"
    local source_status="📁 Source: Missing"

    if check_container_exists "$CONTAINER_NAME"; then official_status="🚀 Official: Ready"; fi
    if check_container_exists "$DEV_CONTAINER_NAME"; then dev_status="🛠️  Dev Env: Ready"; fi
    if [ -f "Containerfile" ]; then source_status="📁 Source: Ready"; fi

    # Left Card: Host Environment
    local left_text
    left_text=$(printf "🖥️  Host OS: %s\n\n%s\n%s\n%s" "$os_name" "$podman_status" "$docker_status" "$distrobox_status")
    local left_card
    left_card=$(gum style --border rounded --border-foreground 39 --padding "1 2" --margin "0 1" --width 28 "$left_text")

    # Right Card: Workspace Status
    local right_text
    right_text=$(printf "📦 Workspaces\n\n%s\n%s\n%s" "$official_status" "$dev_status" "$source_status")
    local right_card
    right_card=$(gum style --border rounded --border-foreground 212 --padding "1 2" --margin "0 1" --width 28 "$right_text")

    # Join horizontally
    gum join --horizontal "$left_card" "$right_card"
}

cmd_check_dependencies() {
    local missing=0
    if ! command -v distrobox &> /dev/null; then
        echo -e "${RED}✗ Error: distrobox is not installed on the host system.${NC}" >&2
        missing=1
    fi
    if ! command -v podman &> /dev/null && ! command -v docker &> /dev/null; then
        echo -e "${RED}✗ Error: Neither podman nor docker is installed on the host system.${NC}" >&2
        missing=1
    fi
    if [ "$missing" -eq 0 ]; then
        gum style --foreground 46 --margin "1 0" "✓ All dependencies (distrobox, podman/docker) are satisfied."
    else
        echo -e "\n${CYAN}Would you like to try installing the missing container dependencies now?${NC}"
        exec < /dev/tty
        if gum confirm "Install missing dependencies?"; then
            if command -v apt-get &> /dev/null; then
                sudo apt update && sudo apt install -y podman distrobox
            elif command -v dnf &> /dev/null; then
                sudo dnf install -y podman distrobox
            elif command -v pacman &> /dev/null; then
                sudo pacman -S --noconfirm podman distrobox
            elif command -v zypper &> /dev/null; then
                sudo zypper install -y podman distrobox
            elif command -v brew &> /dev/null; then
                brew install podman distrobox
            else
                echo -e "${RED}Could not detect a supported package manager. Please install manually.${NC}"
            fi
        else
            echo -e "\nPlease install the missing container dependencies manually."
        fi
    fi
    read -n 1 -s -r -p "Press any key to continue..."
}

show_compact_status() {
    local official_status="❌ Not Installed"
    local dev_status="❌ Not Installed"

    if check_container_exists "$CONTAINER_NAME"; then
        if distrobox list --no-color | grep -w "$CONTAINER_NAME" | grep -qi "running"; then
            official_status="🟢 Running"
        else
            official_status="💤 Installed"
        fi
    fi

    if check_container_exists "$DEV_CONTAINER_NAME"; then
        if distrobox list --no-color | grep -w "$DEV_CONTAINER_NAME" | grep -qi "running"; then
            dev_status="🟢 Running"
        else
            dev_status="💤 Installed"
        fi
    fi

    gum style --border rounded --border-foreground 39 --padding "0 2" --margin "0 2" --align center --width 50 \
        "Official: $official_status  |  Dev: $dev_status"
}

choose_option() {
    gum choose --cursor="➜ " --cursor.foreground="212" --selected.foreground="212" --item.foreground="250" "$@"
}

cmd_interactive() {
    # 1. Splash Screen Flow (Instant rendering)
    clear
    show_banner
    check_deps "menu"
    echo ""

    local splash_choice
    splash_choice=$(choose_option "🚀 Enter Main Menu" "📊 View Host System Info & Dependencies" "❌ Exit")

    case "$splash_choice" in
        "📊 View Host System Info & Dependencies")
            clear
            show_banner
            # Show a brief spinner to indicate loading
            gum spin --spinner dot --title "Analyzing system dependencies and status..." -- sleep 0.5
            check_deps "menu"
            show_system_status
            echo ""
            read -n 1 -s -r -p "Press any key to continue to Main Menu..."
            ;;
        "❌ Exit")
            gum style --foreground 212 "Goodbye!"
            exit 0
            ;;
    esac

    while true; do
        clear
        show_banner
        show_compact_status
        echo ""

        local main_options=(
            "🚪 Workspaces (Enter/VDI Desktop) >"
            "🛠️  Manage Environments >"
            "⚙️  System Tools >"
            "❌ Exit"
        )

        local choice
        choice=$(choose_option "${main_options[@]}")

        case "$choice" in
            "🚪 Workspaces (Enter/VDI Desktop) >")
                while true; do
                    clear
                    show_banner
                    show_compact_status
                    echo ""

                    local workspace_options=()
                    if check_container_exists "$CONTAINER_NAME"; then
                        workspace_options+=("🚪 Enter Official Workspace")
                        workspace_options+=("🖥️  Start VDI Web Desktop (Official)")
                    fi
                    if check_container_exists "$DEV_CONTAINER_NAME"; then
                        workspace_options+=("💻 Enter Dev Workspace")
                        workspace_options+=("🖥️  Start VDI Web Desktop (Dev)")
                    fi

                    workspace_options+=("🔙 Back to Main Menu")

                    local sub_choice
                    sub_choice=$(choose_option "${workspace_options[@]}")

                    case "$sub_choice" in
                        "🚪 Enter Official Workspace")
                            cmd_enter prod
                            echo ""
                            read -n 1 -s -r -p "Press any key to continue..."
                            ;;
                        "🖥️  Start VDI Web Desktop (Official)")
                            cmd_desktop prod
                            echo ""
                            read -n 1 -s -r -p "Press any key to continue..."
                            ;;
                        "💻 Enter Dev Workspace")
                            cmd_enter dev
                            echo ""
                            read -n 1 -s -r -p "Press any key to continue..."
                            ;;
                        "🖥️  Start VDI Web Desktop (Dev)")
                            cmd_desktop dev
                            echo ""
                            read -n 1 -s -r -p "Press any key to continue..."
                            ;;
                        "🔙 Back to Main Menu")
                            break
                            ;;
                    esac
                done
                ;;

            "🛠️  Manage Environments >")
                while true; do
                    clear
                    show_banner
                    show_compact_status
                    echo ""

                    local manage_options=()
                    if check_container_exists "$CONTAINER_NAME"; then
                        manage_options+=("♻️  Update/Recreate Official Workspace")
                        manage_options+=("🗑️  Remove Official Workspace")
                    else
                        manage_options+=("🚀 Install Official Workspace (Pull from GHCR)")
                    fi

                    if check_container_exists "$DEV_CONTAINER_NAME"; then
                        manage_options+=("♻️  Rebuild Dev Workspace")
                        manage_options+=("🗑️  Remove Dev Workspace")
                    else
                        if [ -f "Containerfile" ]; then
                            manage_options+=("🛠️  Build Dev Workspace (From local source)")
                        fi
                    fi

                    manage_options+=("🔙 Back to Main Menu")

                    local sub_choice
                    sub_choice=$(choose_option "${manage_options[@]}")

                    case "$sub_choice" in
                        "🚀 Install Official Workspace (Pull from GHCR)"|"♻️  Update/Recreate Official Workspace")
                            cmd_install_official
                            echo ""
                            read -n 1 -s -r -p "Press any key to continue..."
                            ;;
                        "🛠️  Build Dev Workspace (From local source)"|"♻️  Rebuild Dev Workspace")
                            cmd_build_dev
                            echo ""
                            read -n 1 -s -r -p "Press any key to continue..."
                            ;;
                        "🗑️  Remove Official Workspace")
                            cmd_clean "$CONTAINER_NAME"
                            echo ""
                            read -n 1 -s -r -p "Press any key to continue..."
                            ;;
                        "🗑️  Remove Dev Workspace")
                            cmd_clean "$DEV_CONTAINER_NAME"
                            echo ""
                            read -n 1 -s -r -p "Press any key to continue..."
                            ;;
                        "🔙 Back to Main Menu")
                            break
                            ;;
                    esac
                done
                ;;

            "⚙️  System Tools >")
                while true; do
                    clear
                    show_banner
                    show_compact_status
                    echo ""

                    local tools_options=()
                    tools_options+=("📊 Show Distrobox List")
                    tools_options+=("📦 Check Package Dependencies")

                    if [ -f "$HOME/.local/bin/agy-box-manager" ]; then
                        tools_options+=("🔥 Uninstall CLI Globally")
                    else
                        tools_options+=("🌍 Install CLI Globally (~/.local/bin)")
                    fi

                    tools_options+=("🔙 Back to Main Menu")

                    local sub_choice
                    sub_choice=$(choose_option "${tools_options[@]}")

                    case "$sub_choice" in
                        "📊 Show Distrobox List")
                            cmd_status
                            read -n 1 -s -r -p "Press any key to continue..."
                            ;;
                        "📦 Check Package Dependencies")
                            cmd_check_dependencies
                            ;;
                        "🌍 Install CLI Globally (~/.local/bin)")
                            cmd_install_global
                            echo ""
                            read -n 1 -s -r -p "Press any key to continue..."
                            ;;
                        "🔥 Uninstall CLI Globally")
                            cmd_uninstall_global
                            echo ""
                            read -n 1 -s -r -p "Press any key to continue..."
                            ;;
                        "🔙 Back to Main Menu")
                            break
                            ;;
                    esac
                done
                ;;

            "❌ Exit")
                gum style --foreground 212 "Goodbye!"
                exit 0
                ;;
        esac
    done
}

show_help() {
    show_banner
    echo -e "Usage: $0 [command]"
    echo ""
    echo "Commands:"
    echo "  (none)              Launch the interactive UI"
    echo "  install             Pull the official image and create the environment"
    echo "  dev                 Build the image from local source and create dev environment"
    echo "  enter               Enter the official environment"
    echo "  enter dev           Enter the development environment"
    echo "  desktop             Launch VDI Web Desktop inside official environment"
    echo "  desktop dev         Launch VDI Web Desktop inside development environment"
    echo "  status              List AGY Box environments"
    echo "  clean               Remove the official environment"
    echo "  clean dev           Remove the development environment"
    echo "  install-global      Copy the CLI to ~/.local/bin for system-wide access"
    echo "  uninstall-global    Remove the globally installed CLI and auto-completions"
    echo "  test                Run the local integration test suite"
    echo ""
}

# --- Main Logic ---
setup_completions

case "${1:-}" in
    install)          check_deps "quiet"; cmd_install_official ;;
    dev)              check_deps "quiet"; cmd_build_dev ;;
    enter)            check_deps "quiet"; if [ "${2:-}" = "dev" ]; then cmd_enter dev; else cmd_enter prod; fi ;;
    desktop)          check_deps "quiet"; if [ "${2:-}" = "dev" ]; then cmd_desktop dev; else cmd_desktop prod; fi ;;
    clean)            check_deps "quiet"; if [ "${2:-}" = "dev" ]; then cmd_clean "$DEV_CONTAINER_NAME"; else cmd_clean "$CONTAINER_NAME"; fi ;;
    status)           check_deps "quiet"; cmd_status ;;
    install-global)   check_deps "quiet"; cmd_install_global ;;
    uninstall-global) check_deps "quiet"; cmd_uninstall_global ;;
    test)             check_deps "quiet"; if [ -f "scripts/test-box.sh" ]; then ./scripts/test-box.sh; else gum style --foreground 196 "Test script not found. Please run this command inside the repository."; exit 1; fi ;;
    version|--version|-v) echo "agy-box-manager version $VERSION"; exit 0 ;;
    help|--help|-h)   show_help ;;
    "")               cmd_interactive ;;
    *)                gum style --foreground 196 "Unknown command: $1"; echo ""; show_help; exit 1 ;;
esac
