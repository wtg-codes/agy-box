# --- Git Repo Detection & Provisioning ---
detect_repo_git_ref() {
  local br
  br=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "dev")
  if [ "$br" = "HEAD" ]; then
    local t
    t=$(git describe --tags --exact-match HEAD 2>/dev/null || true)
    [ -n "$t" ] && br="$t" || br="detached"
  fi
  echo "${br//[[:space:]]/_}"
}

detect_repo_channel() {
  local ref="$1" exp="${2:-}"
  if [ "$exp" = "dev" ] || [ "$exp" = "stable" ]; then
    echo "$exp"
  elif [ "$ref" = "main" ] || [[ "$ref" =~ ^v[0-9] ]]; then
    echo "stable"
  else
    echo "dev"
  fi
}

post_install_ready() {
  local target="$1" enter="$2" auto_yes="${3:-false}" vdi_port="${4:-6080}" channel="${5:-stable}" mode="${6:-sandbox}"
  echo ""
  cmd_status
  local desktop_cmd="agy-box-manager desktop $target"
  [ "$vdi_port" != "6080" ] && desktop_cmd="agy-box-manager desktop $target -p $vdi_port"
  local msg="🚀 Environment '$target' [$channel · $mode] is running and ready!\n\nNext Steps:\n  • Enter Shell:  agy-box-manager enter $target\n  • Desktop VDI:  $desktop_cmd\n  • View Logs:    agy-box-manager logs $target\n  • View Status:  agy-box-manager status\n  • Clean Up:     agy-box-manager clean $target"
  echo ""
  if command -v gum >/dev/null 2>&1; then
    gum style --border rounded --padding "0 2" --border-foreground 46 "$msg"
  else
    echo -e "${GREEN}${msg}${NC}\n"
  fi
  if [ "$enter" = "true" ]; then
    cmd_enter "$target"
  elif [ "$enter" != "false" ] && [ "$auto_yes" != "true" ] && [ -t 0 ]; then
    echo ""
    local should=false
    if command -v gum >/dev/null 2>&1; then
      gum confirm "🚀 Enter '$target' environment now?" && should=true
    else
      read -r -p "🚀 Enter '$target' environment now? [Y/n] " c
      [[ -z "$c" || "$c" =~ ^[Yy]$ ]] && should=true
    fi
    [ "$should" = "true" ] && cmd_enter "$target"
  fi
}

reject_rename_error() {
  ui_error "❌ Error: Boxes cannot be renamed once created. Create a new box with 'agy-box-manager install' or remove an existing box with 'agy-box-manager clean'."
  exit 1
}

cmd_install_official() {
  load_config
  local systemd=false
  local explicit_name=""
  local target_image="$IMAGE_NAME"
  local custom_home=""
  local auto_yes=false
  local enter_after_install=""
  local custom_mode=""
  local custom_engine=""
  local channel="stable"
  local branch=""
  local seed_ssh=false
  local seed_git=false
  local seed_gcloud=false
  local fresh_home=false
  local reuse_home=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --rename)
        reject_rename_error
        ;;
      -n|--name)
        explicit_name="$2"
        shift 2
        ;;
      -i|--image)
        target_image="$2"
        shift 2
        ;;
      --home)
        custom_home="$2"
        shift 2
        ;;
      --mode|-m)
        custom_mode="$2"
        shift 2
        ;;
      --engine)
        custom_engine="$2"
        shift 2
        ;;
      --channel)
        channel="$2"
        shift 2
        ;;
      --branch)
        branch="$2"
        shift 2
        ;;
      --seed-ssh)
        seed_ssh=true
        shift
        ;;
      --seed-git)
        seed_git=true
        shift
        ;;
      --seed-gcloud)
        seed_gcloud=true
        shift
        ;;
      --fresh|--clean-home)
        fresh_home=true
        shift
        ;;
      --reuse-home)
        reuse_home=true
        shift
        ;;
      -s|--systemd)
        systemd=true
        shift
        ;;
      -y|--yes)
        auto_yes=true
        shift
        ;;
      --new)
        shift
        ;;
      --enter)
        enter_after_install=true
        shift
        ;;
      --no-enter)
        enter_after_install=false
        shift
        ;;
      *)
        if [[ "$1" != -* ]] && [ -z "$explicit_name" ]; then
          explicit_name="$1"
        fi
        shift
        ;;
    esac
  done

  [ "$channel" = "prod" ] && channel="stable"
  if [ "$channel" != "stable" ] && [ "$channel" != "dev" ]; then
    ui_error "❌ Error: Invalid channel '$channel' (expected 'stable' or 'dev')."
    exit 1
  fi
  if [ -z "$branch" ]; then
    [ "$channel" = "dev" ] && branch="dev" || branch="release"
  fi
  branch="${branch//[[:space:]]/_}"

  local name_prefix="$BOX_PREFIX"
  [ "$channel" = "dev" ] && name_prefix="$DEV_BOX_PREFIX"

  local target_name
  if [ -n "$explicit_name" ]; then
    target_name="$explicit_name"
  else
    target_name=$(generate_box_name "$name_prefix")
  fi

  set_box_log_context "$target_name"

  local runtime
  if [ -n "$custom_engine" ] && [ "$custom_engine" != "distrobox" ]; then
    runtime="$custom_engine"
  else
    runtime=$(get_runtime)
  fi

  if check_container_exists "$target_name"; then
    if [ "$auto_yes" = "true" ]; then
      cmd_clean "$target_name" --purge -y
      set_box_log_context "$target_name"
    elif [ -t 0 ] && command -v gum >/dev/null 2>&1; then
      echo ""
      gum style --foreground 214 "⚠️  Container '$target_name' already exists!"
      local candidate
      candidate=$(generate_box_name "$name_prefix")
      local collision_action
      collision_action=$(gum choose --header "How would you like to proceed?" \
        "🔄 Update apps & OS inside '$target_name'" \
        "➕ Create new box '$candidate' instead" \
        "Cancel")
      case "$collision_action" in
        "🔄 Update"*)
          cmd_update "$target_name" --all
          return 0
          ;;
        "➕ Create"*)
          target_name="$candidate"
          set_box_log_context "$target_name"
          ui_ok "Creating new box: $target_name"
          ;;
        *)
          ui_warn "Installation cancelled."
          return 0
          ;;
      esac
    else
      ui_error "❌ Error: Container '$target_name' already exists (boxes cannot be renamed; run 'agy-box-manager install' without --name to create a new box, or 'agy-box-manager update $target_name')."
      exit 1
    fi
  fi

  local isolated_home
  if [ -n "$custom_home" ]; then
    isolated_home="$custom_home"
  else
    isolated_home=$(get_box_home "$target_name")
  fi

  if [ -d "$isolated_home" ] && [ -n "$(ls -A "$isolated_home" 2>/dev/null)" ]; then
    if [ "$fresh_home" = "true" ] || [ "$auto_yes" = "true" ]; then
      purge_box_home "$isolated_home"
      mkdir -p "$isolated_home"
      ui_ok "Wiped existing home directory for fresh start: $isolated_home"
    elif [ "$reuse_home" = "true" ]; then
      ui_ok "Reusing existing home directory: $isolated_home"
    elif [ -t 0 ] && command -v gum >/dev/null 2>&1; then
      echo ""
      gum style --foreground 214 "⚠️  Existing data directory found at: $isolated_home"
      local home_action
      home_action=$(gum choose --header "How would you like to handle existing data?" \
        "Fresh Start / Wipe (Pristine clean slate - Recommended)" \
        "Reuse Data (Attach to existing home directory files)" \
        "Cancel")
      case "$home_action" in
        "Fresh Start"*)
          purge_box_home "$isolated_home"
          mkdir -p "$isolated_home"
          ui_ok "Wiped existing home directory: $isolated_home"
          ;;
        "Reuse Data"*)
          ui_ok "Preserving and reusing existing home directory: $isolated_home"
          ;;
        *)
          ui_warn "Installation cancelled."
          return 0
          ;;
      esac
    else
      ui_error "❌ Error: Existing data directory found at $isolated_home. Pass --fresh to wipe or --reuse-home to reuse."
      exit 1
    fi
  else
    mkdir -p "$isolated_home"
  fi

  local mode=""
  local explicit_workstation=false
  if [ -n "$custom_mode" ]; then
    mode="$custom_mode"
    if [ "$custom_mode" = "workstation" ] || [ "$custom_mode" = "distrobox" ]; then
      mode="workstation"
      explicit_workstation=true
    else
      mode="sandbox"
    fi
  elif [ -n "$custom_engine" ]; then
    if [ "$custom_engine" = "distrobox" ]; then
      mode="workstation"
      explicit_workstation=true
    else
      mode="sandbox"
    fi
  else
    mode="${AGY_DEFAULT_MODE:-sandbox}"
  fi

  if [ "$mode" = "workstation" ]; then
    if [ "$explicit_workstation" = "true" ]; then
      require_distrobox
    elif ! command -v distrobox >/dev/null 2>&1; then
      ui_warn "⚠️  distrobox is not installed on the host; falling back to sandbox mode."
      mode="sandbox"
    fi
  fi

  write_box_meta "$isolated_home" "$target_name" "$channel" "$branch" "$mode" "$target_image"

  local cpu_limit="" memory_limit=""
  load_resource_limits

  local port_offset vdi_port
  port_offset=$(calculate_box_port_offset "$target_name")
  vdi_port=$((6080 + port_offset))

  if [ "$mode" = "sandbox" ]; then
    if [[ "$target_image" == localhost/* ]] && "$runtime" image inspect "$target_image" >/dev/null 2>&1; then
      log_write "[$(log_ts)] [CMD] $runtime image inspect $target_image"
      log_write "[$(log_ts)] [EXIT rc=0 elapsed=0s] $runtime image inspect $target_image"
      if [ -t 1 ]; then
        echo -e "${WHITE}==> [1/4] Using local container image '$target_image'...${NC}"
        echo -e "${GREEN}✓ [1/4] Using local container image '$target_image'... (0s)${NC}"
      else
        echo "==> [1/4] Using local container image '$target_image'..."
        echo "✓ [1/4] Using local container image '$target_image'... (0s)"
      fi
    elif ! run_step_live "[1/4] Pulling container image '$target_image'..." "$runtime" pull "$target_image"; then
      ui_error "❌ Error: Failed to pull container image."
      exit 1
    fi

    if [ "$runtime" = "podman" ]; then
      run_logged_silent podman unshare chown -R 9000:9000 "$isolated_home" || true
    fi

    local run_flags=(
      "-d"
      "--name" "$target_name"
      "--hostname" "$target_name"
      "--label" "manager=agy-box-${runtime}"
      "--label" "agy-box.managed=true"
      "--label" "agy-box.channel=${channel}"
      "--label" "agy-box.branch=${branch}"
      "--label" "agy-box.mode=sandbox"
      "-p" "${vdi_port}:6080"
    )

    if [ "$runtime" = "podman" ]; then
      run_flags+=("-v" "$isolated_home:/home/agyuser:Z")
    else
      run_flags+=("-v" "$isolated_home:/home/agyuser" "-e" "PUID=$(id -u)" "-e" "PGID=$(id -g)")
    fi

    if [ "$seed_ssh" = "true" ] || [ "${AGY_PROFILE_SEEDING:-false}" = "true" ]; then
      [ -d "$HOME/.ssh" ] && run_flags+=("-v" "$HOME/.ssh:/home/agyuser/.ssh:ro")
    fi
    if [ "$seed_git" = "true" ] || [ "${AGY_PROFILE_SEEDING:-false}" = "true" ]; then
      [ -f "$HOME/.gitconfig" ] && run_flags+=("-v" "$HOME/.gitconfig:/home/agyuser/.gitconfig:ro")
    fi
    if [ "$seed_gcloud" = "true" ] || [ "${AGY_PROFILE_SEEDING:-false}" = "true" ]; then
      [ -d "$HOME/.config/gcloud" ] && run_flags+=("-v" "$HOME/.config/gcloud:/home/agyuser/.config/gcloud:ro")
    fi

    [[ -n "$cpu_limit" ]] && run_flags+=("--cpus=$cpu_limit")
    [[ -n "$memory_limit" ]] && run_flags+=("-m" "$memory_limit")
    if command -v nvidia-smi &>/dev/null && { [ -e /dev/nvidiactl ] || [ -e /dev/nvhost-ctrl ] || [ -e /dev/nvidia0 ]; }; then
      run_flags+=("--gpus" "all")
    fi

    if ! run_step_live "[2/4] Creating $mode environment '$target_name'..." \
      "$runtime" run "${run_flags[@]}" "$target_image" sleep infinity; then
      ui_error "❌ Error: Failed to create sandbox container."
      exit 1
    fi

    if ! run_step_live "[3/4] Verifying sandbox container '$target_name' (VDI port $vdi_port)..." \
      "$runtime" ps -f "name=^${target_name}$"; then
      ui_error "❌ Error: Sandbox container '$target_name' is not running."
      exit 1
    fi
  else
    local dbx_flags=(
      "--home" "$isolated_home"
      "--additional-flags" "--label agy-box.managed=true --label agy-box.channel=${channel} --label agy-box.branch=${branch} --label agy-box.mode=workstation"
    )

    if [ "${AGY_PROFILE_SEEDING:-false}" = "true" ] || [ "$seed_ssh" = "true" ] || [ "$seed_git" = "true" ] || [ "$seed_gcloud" = "true" ]; then
      if [ "${AGY_PROFILE_SEEDING:-false}" = "true" ] || [ "$seed_ssh" = "true" ]; then
        [ -d "$HOME/.ssh" ] && dbx_flags+=("--volume" "$HOME/.ssh:$isolated_home/.ssh:ro")
      fi
      if [ "${AGY_PROFILE_SEEDING:-false}" = "true" ] || [ "$seed_gcloud" = "true" ]; then
        [ -d "$HOME/.config/gcloud" ] && dbx_flags+=("--volume" "$HOME/.config/gcloud:$isolated_home/.config/gcloud:ro")
      fi
      if [ "${AGY_PROFILE_SEEDING:-false}" = "true" ] || [ "$seed_git" = "true" ]; then
        [ -f "$HOME/.gitconfig" ] && dbx_flags+=("--volume" "$HOME/.gitconfig:$isolated_home/.gitconfig:ro")
      fi
    fi

    if [ "${AGY_KEYRING_MODE:-host}" = "isolated" ]; then
      dbx_flags+=("--additional-flags" "--unsetenv=DBUS_SESSION_BUS_ADDRESS")
    fi
    if [ "$runtime" = "docker" ]; then
      dbx_flags+=("--additional-flags" "--user $(id -u):$(id -g)")
    fi
    if [[ -n "${SSH_AUTH_SOCK:-}" && -S "$SSH_AUTH_SOCK" ]]; then
      dbx_flags+=("--additional-flags" "-v $SSH_AUTH_SOCK:/run/ssh-agent -e SSH_AUTH_SOCK=/run/ssh-agent")
    fi
    [ "$systemd" = "true" ] && dbx_flags+=("--init")
    [[ -n "$cpu_limit" ]] && dbx_flags+=("--additional-flags" "--cpus=$cpu_limit")
    [[ -n "$memory_limit" ]] && dbx_flags+=("--additional-flags" "-m $memory_limit")
    if command -v nvidia-smi &>/dev/null && { [ -e /dev/nvidiactl ] || [ -e /dev/nvhost-ctrl ] || [ -e /dev/nvidia0 ]; }; then
      dbx_flags+=("--nvidia")
    fi

    if [[ "$target_image" == localhost/* ]] && "$runtime" image inspect "$target_image" >/dev/null 2>&1; then
      log_write "[$(log_ts)] [CMD] $runtime image inspect $target_image"
      log_write "[$(log_ts)] [EXIT rc=0 elapsed=0s] $runtime image inspect $target_image"
      if [ -t 1 ]; then
        echo -e "${WHITE}==> [1/4] Using local container image '$target_image'...${NC}"
        echo -e "${GREEN}✓ [1/4] Using local container image '$target_image'... (0s)${NC}"
      else
        echo "==> [1/4] Using local container image '$target_image'..."
        echo "✓ [1/4] Using local container image '$target_image'... (0s)"
      fi
    elif ! run_step_live "[1/4] Pulling container image '$target_image'..." "$runtime" pull "$target_image"; then
      ui_error "❌ Error: Failed to pull container image."
      exit 1
    fi

    if ! run_step_live "[2/4] Creating $mode environment '$target_name'..." \
      distrobox create -i "$target_image" -n "$target_name" --hostname "$target_name" "${dbx_flags[@]}" --yes; then
      ui_error "❌ Error: Failed to create Distrobox environment."
      exit 1
    fi

    if [ "$runtime" = "podman" ] && [ -d "$isolated_home" ]; then
      run_logged_silent podman unshare chown -R 0:0 "$isolated_home" || true
    fi

    if ! run_step_live "[3/4] Initializing '$target_name' container & CLI integration (first boot takes ~15-45s)..." \
      distrobox enter "$target_name" -- true; then
      ui_error "❌ Error: Failed to initialize Distrobox container '$target_name'."
      exit 1
    fi

    if [ "$runtime" = "podman" ] && [ -d "$isolated_home" ]; then
      run_logged_silent podman unshare chown -R 0:0 "$isolated_home" || true
    fi

    install_toolchain_in_box "$target_name" || true
  fi

  run_step_live "[4/4] Configuring CLI autocompletions..." setup_completions

  post_install_ready "$target_name" "$enter_after_install" "$auto_yes" "$vdi_port" "$channel" "$mode"
}

cmd_build_dev() {
  load_config
  local explicit_name="" explicit_channel="" custom_engine=""
  local fwd_args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --rename)
        reject_rename_error
        ;;
      -n|--name)
        explicit_name="$2"
        shift 2
        ;;
      --channel)
        explicit_channel="$2"
        shift 2
        ;;
      --mode|-m)
        fwd_args+=("--mode" "$2")
        shift 2
        ;;
      --engine)
        custom_engine="$2"
        fwd_args+=("--engine" "$2")
        shift 2
        ;;
      -s|--systemd|-y|--yes|--enter|--no-enter|--fresh|--reuse-home)
        fwd_args+=("$1")
        shift
        ;;
      *)
        if [[ "$1" != -* ]] && [ -z "$explicit_name" ]; then
          explicit_name="$1"
        fi
        shift
        ;;
    esac
  done

  if [ ! -f "Containerfile" ]; then
    ui_error "✗ Error: Containerfile not found in current directory. Please clone the repository first to build from source."
    exit 1
  fi

  local git_branch channel
  git_branch=$(detect_repo_git_ref)
  channel=$(detect_repo_channel "$git_branch" "$explicit_channel")

  local name_prefix="$BOX_PREFIX"
  [ "$channel" = "dev" ] && name_prefix="$DEV_BOX_PREFIX"

  local target_name
  if [ -n "$explicit_name" ]; then
    target_name="$explicit_name"
  else
    target_name=$(generate_box_name "$name_prefix")
  fi

  set_box_log_context "$target_name"

  local runtime
  if [ -n "$custom_engine" ] && [ "$custom_engine" != "distrobox" ]; then
    runtime="$custom_engine"
  else
    runtime=$(get_runtime)
  fi

  local build_image="localhost/agy-box:${channel}"
  if ! run_step_live "Building $channel image '$build_image' from branch '$git_branch' with $runtime..." \
    "$runtime" build -t "$build_image" -f Containerfile .; then
    ui_error "❌ Error: Failed to build container image."
    exit 1
  fi

  cmd_install_official --name "$target_name" --image "$build_image" --channel "$channel" --branch "$git_branch" "${fwd_args[@]}"
}

# --- VDI Desktop Management ---
is_vdi_running() {
  local name=$1
  local runtime
  runtime=$(get_runtime 2>/dev/null || echo "podman")
  "$runtime" ps --format '{{.Names}}' 2>/dev/null | grep -qxF "$name" || return 1
  "$runtime" exec --user 0 "$name" pgrep -f '[X]vfb' >/dev/null 2>&1 || return 1
  "$runtime" exec --user 0 "$name" pgrep -f '[x]11vnc' >/dev/null 2>&1 || return 1
  "$runtime" exec --user 0 "$name" pgrep -f '[w]ebsockify.*novnc' >/dev/null 2>&1
}

vdi_ws_ready() {
  local p="$1" hdr
  curl -fsS --max-time 2 "http://127.0.0.1:${p}/vnc.html" >/dev/null 2>&1 || return 1
  hdr=$(curl -sSi --max-time 1 -H "Connection: Upgrade" -H "Upgrade: websocket" -H "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==" -H "Sec-WebSocket-Version: 13" "http://127.0.0.1:${p}/websockify" 2>/dev/null || true)
  [[ "$hdr" == *"101 Switching Protocols"* ]]
}

stop_vdi_session() {
  local name=$1
  local runtime
  runtime=$(get_runtime 2>/dev/null || echo "podman")
  set_box_log_context "$name"
  run_logged_silent "$runtime" exec --user 0 "$name" sh -c 'pkill -TERM -f "[a]gy-vdi|[w]ebsockify|[x]11vnc|[i]cewm-session|[X]vfb" 2>/dev/null || true; sleep 0.5; pkill -KILL -f "[w]ebsockify|[x]11vnc|[X]vfb" 2>/dev/null || true; rm -f /tmp/.X*-lock /tmp/.X11-unix/X*' || true
  if ! is_vdi_running "$name"; then
    ui_ok "✓ VDI session for '$name' stopped cleanly."
  else
    ui_warn "⚠️  Some VDI processes for '$name' may still be running."
  fi
}

read_box_state_log() {
  local n="$1" f="$2"
  if [ -r "$f" ]; then
    tail -n "$n" "$f"
  elif command -v podman >/dev/null 2>&1 && podman unshare test -r "$f" 2>/dev/null; then
    podman unshare tail -n "$n" "$f" 2>/dev/null || true
  else
    return 1
  fi
}

vdi_control_panel() {
  local target_name=$1
  local vdi_port=$2
  local isolated_home runtime
  isolated_home=$(get_box_home "$target_name")
  runtime=$(get_runtime 2>/dev/null || echo "podman")
  local url="http://127.0.0.1:${vdi_port}/vnc.html?autoconnect=true&resize=scale&path=websockify"
  while true; do
    echo ""
    if is_vdi_running "$target_name"; then
      echo -e "${GREEN}🟢 VDI Active:${NC} $url"
    else
      echo -e "${RED}🔴 VDI Stopped${NC}"
    fi
    local options=(
      "🌐 Open VDI in Browser"
      "📜 View VDI Log"
      "⏹️  End VDI Session"
      "📌 Keep Running in Background & Return to Menu"
    )
    local choice
    if command -v gum >/dev/null 2>&1; then
      choice=$(gum choose --header "VDI Session Management ($target_name):" "${options[@]}")
    else
      echo "1) Open VDI in Browser"
      echo "2) View VDI Log"
      echo "3) End VDI Session"
      echo "4) Keep Running in Background & Return to Menu"
      read -r -p "Choice [1-4]: " opt
      case "$opt" in
        1) choice="🌐 Open VDI in Browser" ;;
        2) choice="📜 View VDI Log" ;;
        3) choice="⏹️  End VDI Session" ;;
        *) choice="📌 Keep Running in Background & Return to Menu" ;;
      esac
    fi
    case "$choice" in
      "🌐 Open VDI in Browser")
        if command -v xdg-open >/dev/null 2>&1 && [ -n "${DISPLAY:-${WAYLAND_DISPLAY:-}}" ]; then
          xdg-open "$url" >/dev/null 2>&1 || true
        else
          echo "Open in browser: $url"
        fi
        ;;
      "📜 View VDI Log")
        echo -e "${CYAN}=== VDI Log for '$target_name' ===${NC}"
        if ! read_box_state_log 120 "$isolated_home/.local/state/agy-box/vdi.log"; then
          "$runtime" exec --user 0 "$target_name" cat /tmp/agy-vdi.log 2>/dev/null || echo "(no log found)"
        fi
        echo -e "${CYAN}=================================${NC}"
        ;;
      "⏹️  End VDI Session")
        stop_vdi_session "$target_name"
        break
        ;;
      *)
        break
        ;;
    esac
  done
}

cmd_desktop() {
  load_config
  local selector=""
  local vdi_args=()
  local stop_action=false
  local status_action=false
  local detach=false
  local custom_port=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --stop)
        stop_action=true
        shift
        ;;
      --status)
        status_action=true
        shift
        ;;
      -d|--detach)
        detach=true
        shift
        ;;
      -p|--port)
        custom_port="$2"
        vdi_args+=("-p" "$2")
        shift 2
        ;;
      -r|--resolution)
        vdi_args+=("-r" "$2")
        shift 2
        ;;
      -*)
        vdi_args+=("$1")
        shift
        ;;
      *)
        if [ -z "$selector" ]; then
          selector="$1"
        else
          vdi_args+=("$1")
        fi
        shift
        ;;
    esac
  done

  local target_name
  target_name=$(resolve_target_box "$selector") || exit 1
  set_box_log_context "$target_name"

  local vdi_port=6080
  if [ -n "$custom_port" ]; then
    vdi_port="$custom_port"
  else
    vdi_port=$((6080 + $(calculate_box_port_offset "$target_name")))
  fi

  if [ "$stop_action" = "true" ]; then
    stop_vdi_session "$target_name"
    return 0
  fi

  if [ "$status_action" = "true" ]; then
    if is_vdi_running "$target_name"; then
      echo "🟢 VDI is running for '$target_name' on port $vdi_port"
      echo "URL: http://127.0.0.1:${vdi_port}/vnc.html?autoconnect=true&resize=scale&path=websockify"
    else
      echo "⚪ VDI is stopped for '$target_name'"
    fi
    return 0
  fi

  local isolated_home runtime mgr
  isolated_home=$(get_box_home "$target_name")
  runtime=$(get_runtime 2>/dev/null || echo "podman")
  mgr=$(get_box_manager "$target_name")

  local already_active=false
  if is_vdi_running "$target_name" && vdi_ws_ready "$vdi_port"; then
    already_active=true
  fi

  if [ "$already_active" = "true" ]; then
    ui_ok "VDI session for '$target_name' is already active on port $vdi_port."
  else
    run_logged_silent "$runtime" exec --user 0 "$target_name" sh -c 'pkill -KILL -f "[a]gy-vdi|[w]ebsockify|[x]11vnc|[X]vfb" 2>/dev/null || true; rm -f /tmp/.X*-lock /tmp/.X11-unix/X*' || true

    local clean_vdi_args=()
    for ((i=0; i<${#vdi_args[@]}; i++)); do
      if [ "${vdi_args[i]}" = "-p" ] || [ "${vdi_args[i]}" = "--port" ]; then
        i=$((i + 1))
      else
        clean_vdi_args+=("${vdi_args[i]}")
      fi
    done

    # shellcheck disable=SC2016
    local vdi_launch_cmd='mkdir -p "$HOME/.local/state/agy-box" && : >"$HOME/.local/state/agy-box/vdi.log" && ln -sf "$HOME/.local/state/agy-box/vdi.log" /tmp/agy-vdi.log && exec /usr/local/bin/agy-vdi "$@" >>"$HOME/.local/state/agy-box/vdi.log" 2>&1'

    if [ "$mgr" = "distrobox" ]; then
      ensure_distrobox_ready "$target_name" || return 1

      if [ "$runtime" = "podman" ] && [ -d "$isolated_home" ]; then
        run_logged_silent podman unshare chown -R 0:0 "$isolated_home" || true
      fi

      if [ -z "$custom_port" ]; then
        while ss -tlnH 2>/dev/null | awk '{print $4}' | grep -Eq "(^|:)${vdi_port}$"; do
          ui_warn "Port $vdi_port is already in use on host; trying port $((vdi_port + 1))..."
          vdi_port=$((vdi_port + 1))
        done
      fi

      local env_flags=(-e HOME="$isolated_home" -e USER="$(id -un 2>/dev/null || echo "${USER:-}")" -e DISTROBOX_HOST_HOME="$HOME" -e AGY_KEYRING_MODE="${AGY_KEYRING_MODE:-host}")
      if [ "${AGY_KEYRING_MODE:-host}" != "isolated" ]; then
        [ -n "${XDG_RUNTIME_DIR:-}" ] && env_flags+=(-e XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR")
        [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] && env_flags+=(-e DBUS_SESSION_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS")
        [ -n "${GNOME_KEYRING_CONTROL:-}" ] && env_flags+=(-e GNOME_KEYRING_CONTROL="$GNOME_KEYRING_CONTROL")
        if [ -n "${SSH_AUTH_SOCK:-}" ]; then
          if [ -e /run/ssh-agent ] || "$runtime" exec "$target_name" test -e /run/ssh-agent 2>/dev/null; then
            env_flags+=(-e SSH_AUTH_SOCK="/run/ssh-agent")
          else
            env_flags+=(-e SSH_AUTH_SOCK="$SSH_AUTH_SOCK")
          fi
        fi
      fi

      echo -e "Starting VDI Virtual Desktop inside ${CYAN}$target_name${NC} (Workstation)..."
      run_logged "$runtime" exec -d --user "$(id -u):$(id -g)" "${env_flags[@]}" -w "$isolated_home" "$target_name" sh -c "$vdi_launch_cmd" _ -p "$vdi_port" "${clean_vdi_args[@]}"
    else
      if [ "$runtime" = "podman" ] && [ -d "$isolated_home" ]; then
        run_logged_silent podman unshare chown -R 9000:9000 "$isolated_home" || true
      fi
      if ! "$runtime" ps --format '{{.Names}}' 2>/dev/null | grep -qxF "$target_name"; then
        run_step "Starting container '$target_name'..." "$runtime" start "$target_name"
      fi
      echo -e "Starting VDI Virtual Desktop inside ${CYAN}$target_name${NC} (Sandbox)..."
      run_logged "$runtime" exec -d -e HOME=/home/agyuser -u agyuser -w /home/agyuser "$target_name" sh -c "$vdi_launch_cmd" _ -p 6080 "${clean_vdi_args[@]}"
    fi

    local vdi_ready=false
    local start_time
    start_time=$(date +%s)
    local vdi_timeout="${AGY_VDI_TIMEOUT:-20}"
    while true; do
      if is_vdi_running "$target_name"; then
        if [ -n "${BATS_VERSION:-}" ] || [ -n "${BATS_TEST_FILENAME:-}" ] || vdi_ws_ready "$vdi_port"; then
          vdi_ready=true
          break
        fi
      fi
      local now
      now=$(date +%s)
      if [ $((now - start_time)) -ge "$vdi_timeout" ]; then
        break
      fi
      sleep 1
    done

    local elapsed_vdi=$(( $(date +%s) - start_time ))
    log_write "[$(log_ts)] [VDI] target=$target_name port=$vdi_port ready=$vdi_ready elapsed=${elapsed_vdi}s"

    if [ "$vdi_ready" != "true" ]; then
      ui_error "❌ Error: VDI failed to start:"
      if ! read_box_state_log 80 "$isolated_home/.local/state/agy-box/vdi.log" >&2; then
        "$runtime" exec --user 0 "$target_name" cat /tmp/agy-vdi.log 2>/dev/null >&2 || true
      fi
      print_diag_log_hint
      return 1
    fi
  fi

  local desktop_url="http://127.0.0.1:${vdi_port}/vnc.html?autoconnect=true&resize=scale&path=websockify"
  echo -e "VDI Desktop is accessible at: ${GREEN}${desktop_url}${NC}"

  if [ "$detach" = "true" ] || [ ! -t 0 ] || [ ! -t 1 ]; then
    return 0
  fi

  if command -v xdg-open >/dev/null 2>&1 && [ -n "${DISPLAY:-${WAYLAND_DISPLAY:-}}" ]; then
    xdg-open "$desktop_url" >/dev/null 2>&1 || true
  fi

  vdi_control_panel "$target_name" "$vdi_port"
}

# --- Enter, Update & Clean ---
cmd_enter() {
  load_config
  local selector=""
  local enter_args=()

  if [[ $# -gt 0 ]]; then
    if [ "$1" = "--" ]; then
      selector=""
      enter_args=("${@:2}")
    else
      selector="$1"
      enter_args=("${@:2}")
    fi
  fi

  local target_name
  target_name=$(resolve_target_box "$selector") || exit 1
  set_box_log_context "$target_name"

  local isolated_home runtime mgr
  isolated_home=$(get_box_home "$target_name")
  runtime=$(get_runtime)
  mgr=$(get_box_manager "$target_name")

  if [ "$mgr" = "distrobox" ]; then
    ensure_distrobox_ready "$target_name" || return 1
    if [ "$runtime" = "podman" ] && [ -d "$isolated_home" ]; then
      run_logged_silent podman unshare chown -R 0:0 "$isolated_home" || true
    fi
    if [ ${#enter_args[@]} -gt 0 ] && [ "${enter_args[0]}" != "--" ] && [[ "${enter_args[0]}" != -* ]]; then
      enter_args=("--" "${enter_args[@]}")
    fi
    if [ ${#enter_args[@]} -eq 0 ] || [ -t 1 ]; then
      echo -e "Entering ${CYAN}$target_name${NC} (Workstation)..."
    fi
    if [ ${#enter_args[@]} -gt 0 ]; then
      run_logged_tty distrobox enter "$target_name" "${enter_args[@]}"
    else
      run_logged_tty distrobox enter "$target_name"
    fi
  else
    if [ "$runtime" = "podman" ] && [ -d "$isolated_home" ]; then
      run_logged_silent podman unshare chown -R 9000:9000 "$isolated_home" || true
    fi
    if ! "$runtime" ps --format '{{.Names}}' 2>/dev/null | grep -qxF "$target_name"; then
      run_step "Starting container '$target_name'..." "$runtime" start "$target_name"
    fi
    if [ ${#enter_args[@]} -gt 0 ] && [ "${enter_args[0]}" = "--" ]; then
      enter_args=("${enter_args[@]:1}")
    fi
    if [ ${#enter_args[@]} -eq 0 ] || [ -t 1 ]; then
      echo -e "Entering ${CYAN}$target_name${NC} (Sandbox)..."
    fi
    if [ ${#enter_args[@]} -gt 0 ]; then
      if [ -t 0 ]; then
        run_logged_tty "$runtime" exec -it -u agyuser -w /home/agyuser "$target_name" "${enter_args[@]}"
      else
        run_logged_tty "$runtime" exec -u agyuser -w /home/agyuser "$target_name" "${enter_args[@]}"
      fi
    else
      run_logged_tty "$runtime" exec -it -u agyuser -w /home/agyuser "$target_name" /bin/bash
    fi
  fi
}

cmd_update_toolchain() {
  local selector="${1:-}"
  local target_name
  target_name=$(resolve_target_box "$selector") || exit 1
  set_box_log_context "$target_name"

  local isolated_home runtime mgr
  isolated_home=$(get_box_home "$target_name")
  runtime=$(get_runtime)
  mgr=$(get_box_manager "$target_name")

  if [ "$mgr" = "distrobox" ]; then
    ensure_distrobox_ready "$target_name" || return 1
    if [ "$runtime" = "podman" ] && [ -d "$isolated_home" ]; then
      run_logged_silent podman unshare chown -R 0:0 "$isolated_home" || true
    fi
    if ! run_step "Installing/updating Antigravity toolchain inside '$target_name'..." \
      distrobox enter "$target_name" -- "$TOOLCHAIN_INSTALLER"; then
      ui_error "❌ Error: Failed to install/update the Antigravity toolchain inside '$target_name'."
      exit 1
    fi
  else
    if [ "$runtime" = "podman" ] && [ -d "$isolated_home" ]; then
      run_logged_silent podman unshare chown -R 9000:9000 "$isolated_home" || true
    fi
    if ! "$runtime" ps --format '{{.Names}}' 2>/dev/null | grep -qxF "$target_name"; then
      run_step "Starting container '$target_name'..." "$runtime" start "$target_name"
    fi
    if ! run_step "Installing/updating Antigravity toolchain inside '$target_name'..." \
      "$runtime" exec -u agyuser -w /home/agyuser "$target_name" "$TOOLCHAIN_INSTALLER"; then
      ui_error "❌ Error: Failed to install/update the Antigravity toolchain inside '$target_name'."
      exit 1
    fi
  fi
  ui_ok "✓ Antigravity toolchain installed/updated in '$target_name'."
}

cmd_update() {
  load_config
  local selector=""
  local update_toolchain=false
  local update_ides=false
  local update_packages=false
  local check_only=false
  local flags_specified=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --rename)
        reject_rename_error
        ;;
      --all|-a)
        update_toolchain=true
        update_ides=true
        update_packages=true
        flags_specified=true
        shift
        ;;
      --toolchain|-t)
        update_toolchain=true
        flags_specified=true
        shift
        ;;
      --ides|-i)
        update_ides=true
        flags_specified=true
        shift
        ;;
      --packages|-p)
        update_packages=true
        flags_specified=true
        shift
        ;;
      --check|-c)
        check_only=true
        flags_specified=true
        shift
        ;;
      -*)
        ui_error "Unknown option: $1"
        echo "Usage: agy-box-manager update [name|stable|dev] [--all|--toolchain|--ides|--packages|--check]"
        return 1
        ;;
      *)
        selector="$1"
        shift
        ;;
    esac
  done

  if [ "$check_only" = "true" ]; then
    echo "🔍 Checking status and component versions..."
    cmd_doctor
    return 0
  fi

  if [ "$flags_specified" = "false" ]; then
    update_toolchain=true
    update_ides=true
    update_packages=true
  fi

  local target_container
  target_container=$(resolve_target_box "$selector") || return 1
  set_box_log_context "$target_container"

  local isolated_home runtime mgr
  isolated_home=$(get_box_home "$target_container")
  runtime=$(detect_runtime)
  mgr=$(get_box_manager "$target_container")

  if [ "$mgr" = "distrobox" ]; then
    ensure_distrobox_ready "$target_container" || return 1
    if [ "$runtime" = "podman" ] && [ -d "$isolated_home" ]; then
      run_logged_silent podman unshare chown -R 0:0 "$isolated_home" || true
    fi
  elif [ "$runtime" = "podman" ] && [ -d "$isolated_home" ]; then
    run_logged_silent podman unshare chown -R 9000:9000 "$isolated_home" || true
  fi
  if [ "$mgr" != "distrobox" ] && ! "$runtime" ps --format '{{.Names}}' 2>/dev/null | grep -qxF "$target_container"; then
    run_step "Starting stopped container '$target_container'..." "$runtime" start "$target_container"
  fi

  ui_ok "🚀 Updating environment '$target_container'..."

  if [ "$update_toolchain" = "true" ]; then
    echo -e "\n${CYAN}==> Updating Antigravity Toolchain...${NC}"
    cmd_update_toolchain "$target_container"
  fi

  if [ "$update_ides" = "true" ]; then
    echo -e "\n${CYAN}==> Updating IDE Extensions...${NC}"
    if [ "$mgr" = "distrobox" ]; then
      if "$runtime" exec --user "$(id -u):$(id -g)" -e HOME="$isolated_home" -e USER="$(id -un 2>/dev/null || echo "${USER:-}")" -w "$isolated_home" "$target_container" command -v code &>/dev/null; then
        run_step "Updating VS Code Antigravity extension..." "$runtime" exec --user "$(id -u):$(id -g)" -e HOME="$isolated_home" -e USER="$(id -un 2>/dev/null || echo "${USER:-}")" -w "$isolated_home" "$target_container" code --install-extension Google.google-antigravity --force || ui_warn "! Could not update VS Code extension"
      fi
    else
      if "$runtime" exec -u agyuser -w /home/agyuser "$target_container" sh -c "command -v code" &>/dev/null; then
        run_step "Updating VS Code Antigravity extension..." "$runtime" exec -u agyuser -w /home/agyuser "$target_container" code --install-extension Google.google-antigravity --force || ui_warn "! Could not update VS Code extension"
      fi
    fi
    local zed_settings="$isolated_home/.config/zed/settings.json"
    if [ -f "$zed_settings" ]; then
      if ! grep -q "auto_install_extensions" "$zed_settings" 2>/dev/null; then
        echo '{"auto_install_extensions": {"antigravity": true}}' > "$zed_settings" 2>/dev/null || true
      fi
      ui_ok "✓ Zed auto-install extension configuration verified."
    fi
  fi

  if [ "$update_packages" = "true" ]; then
    echo -e "\n${CYAN}==> Updating Container OS Packages & IDEs...${NC}"
    run_step "Updating apt packages..." "$runtime" exec --user 0 "$target_container" sh -c "DEBIAN_FRONTEND=noninteractive apt-get update && apt-get upgrade -y" || true
    ui_ok "✓ Container packages upgraded."
  fi

  ui_ok "\n✓ Update completed successfully for '$target_container'!"
}

_clean_single_box() {
  local target_name="$1" purge_home="$2" keep_home="$3" auto_yes="$4"
  set_box_log_context "$target_name"

  local box_home container_found=false
  box_home=$(get_box_home "$target_name")

  if check_container_exists "$target_name"; then
    container_found=true
    local mgr
    mgr=$(get_box_manager "$target_name")
    if [ "$mgr" = "distrobox" ]; then
      run_step "Removing Distrobox environment: $target_name..." distrobox rm --yes "$target_name"
    else
      local runtime
      runtime=$(get_runtime)
      run_step "Removing $runtime container: $target_name..." "$runtime" rm -f "$target_name"
    fi
    ui_ok "✓ Removed container $target_name"
  fi

  if [ -d "$box_home" ]; then
    if [ "$purge_home" = "true" ]; then
      purge_box_home "$box_home"
      ui_ok "✓ Purged isolated home directory: $box_home"
    elif [ "$keep_home" = "true" ] || [ "$auto_yes" = "true" ]; then
      ui_warn "ℹ️  Isolated home preserved at: $box_home"
    elif [ -t 0 ] && command -v gum >/dev/null 2>&1; then
      echo ""
      gum style --foreground 214 "Data Retention Choice for '$target_name':"
      local clean_action
      clean_action=$(gum choose --header "What should happen to the isolated home directory ($box_home)?" \
        "Purge all data (Clean slate - delete all files)" \
        "Keep data intact (Preserve workspace state & configs)")
      case "$clean_action" in
        "Purge"*)
          purge_box_home "$box_home"
          ui_ok "✓ Purged isolated home directory: $box_home"
          ;;
        *)
          ui_warn "ℹ️  Isolated home preserved at: $box_home"
          ;;
      esac
    elif [ -t 0 ]; then
      echo -e "${YELLOW}What should happen to the isolated home directory ($box_home)?${NC}"
      echo "1) Purge all data (Clean slate)"
      echo "2) Keep data intact"
      read -r -p "Select [1 or 2]: " choice
      if [ "$choice" = "1" ]; then
        purge_box_home "$box_home"
        ui_ok "✓ Purged isolated home directory: $box_home"
      else
        ui_warn "ℹ️  Isolated home preserved at: $box_home"
      fi
    else
      ui_error "❌ Error: Non-interactive clean requires an explicit choice. Pass --purge to delete container data or --keep to preserve it."
      exit 1
    fi
  elif [ "$container_found" = "false" ]; then
    ui_warn "! Warning: Neither container '$target_name' nor data directory '$box_home' exists."
  fi
}

cmd_clean() {
  local selector=""
  local clean_all=false
  local purge_home=false
  local keep_home=false
  local auto_yes=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all|-a)
        clean_all=true
        shift
        ;;
      --purge|-p)
        purge_home=true
        shift
        ;;
      --keep|-k)
        keep_home=true
        shift
        ;;
      -y|--yes)
        auto_yes=true
        shift
        ;;
      -*)
        ui_error "Unknown option: $1"
        echo "Usage: agy-box-manager clean [name|stable|dev|--all] [--purge|-p] [--keep|-k] [-y|--yes]" >&2
        return 1
        ;;
      *)
        selector="$1"
        shift
        ;;
    esac
  done

  if [ "$clean_all" = "true" ]; then
    local all_boxes=() b
    while IFS= read -r b; do
      [ -n "$b" ] && all_boxes+=("$b")
    done < <(get_all_agy_boxes)

    local homes_to_purge=()
    if [ "$purge_home" = "true" ]; then
      if [ -d "${HOME:-}/.config/agy-box/homes" ]; then
        local hd
        for hd in "$HOME/.config/agy-box/homes"/*; do
          [ -d "$hd" ] && homes_to_purge+=("$hd")
        done
      fi
      [ -d "${HOME:-}/.config/agy-box/home" ] && homes_to_purge+=("$HOME/.config/agy-box/home")
    fi

    if [ ${#all_boxes[@]} -eq 0 ] && [ ${#homes_to_purge[@]} -eq 0 ]; then
      ui_ok "✓ No AGY boxes found to clean."
      return 0
    fi

    for b in "${all_boxes[@]}"; do
      _clean_single_box "$b" "$purge_home" "$keep_home" "$auto_yes"
    done
    if [ "$purge_home" = "true" ]; then
      local pdir
      for pdir in "${homes_to_purge[@]}"; do
        if [ -d "$pdir" ]; then
          purge_box_home "$pdir"
          ui_ok "✓ Purged isolated home directory: $pdir"
        fi
      done
    fi
    set_box_log_context ""
    return 0
  fi

  local target_name=""
  if [ -z "$selector" ]; then
    local all_boxes=() b
    while IFS= read -r b; do
      [ -n "$b" ] && all_boxes+=("$b")
    done < <(get_all_agy_boxes)

    if [ ${#all_boxes[@]} -eq 0 ]; then
      ui_warn "ℹ️  No AGY boxes installed."
      return 0
    elif [ ${#all_boxes[@]} -eq 1 ]; then
      target_name="${all_boxes[0]}"
    elif [ -t 0 ] && [ "${AGY_NONINTERACTIVE:-0}" != "1" ] && command -v gum >/dev/null 2>&1; then
      local picked
      picked=$(choose_option --header "Select a box to remove:" "${all_boxes[@]}" "🗑️ Remove All Boxes" "🔙 Cancel")
      case "$picked" in
        "🗑️ Remove All Boxes")
          local fwd=()
          [ "$purge_home" = "true" ] && fwd+=("--purge")
          [ "$keep_home" = "true" ] && fwd+=("--keep")
          [ "$auto_yes" = "true" ] && fwd+=("-y")
          cmd_clean --all "${fwd[@]}"
          return $?
          ;;
        ""|"🔙 Cancel")
          return 0
          ;;
        *)
          target_name="$picked"
          ;;
      esac
    else
      ui_error "❌ Error: Multiple AGY boxes installed; specify a box name or pass '--all'."
      return 1
    fi
  elif [ "$selector" = "stable" ] || [ "$selector" = "prod" ] || [ "$selector" = "dev" ]; then
    target_name=$(resolve_target_box "$selector") || return 1
  else
    target_name="$selector"
    if ! check_container_exists "$target_name" && [ ! -d "$(get_box_home "$target_name")" ]; then
      if check_container_exists "agy-box-$target_name" || [ -d "$(get_box_home "agy-box-$target_name")" ]; then
        target_name="agy-box-$target_name"
      elif check_container_exists "agy-box-dev-$target_name" || [ -d "$(get_box_home "agy-box-dev-$target_name")" ]; then
        target_name="agy-box-dev-$target_name"
      fi
    fi
  fi

  _clean_single_box "$target_name" "$purge_home" "$keep_home" "$auto_yes"
  set_box_log_context ""
}

# --- Status, Doctor & Diagnostic Logs ---
cmd_status() {
  echo ""
  if command -v gum >/dev/null 2>&1; then
    gum style --foreground 212 --border normal --padding "0 1" "AGY Box Environments Status"
  else
    echo -e "${MAGENTA}=== AGY Box Environments Status ===${NC}"
  fi

  local runtime
  runtime=$(get_runtime 2>/dev/null || echo "podman")

  local all_boxes=()
  while IFS= read -r b; do
    [ -n "$b" ] && all_boxes+=("$b")
  done < <(get_all_agy_boxes)

  if [ ${#all_boxes[@]} -gt 0 ]; then
    echo -e "\n${CYAN}Managed Environments:${NC}"
    printf "  %-26s %-8s %-12s %-10s %-10s %s\n" "NAME" "CHANNEL" "MODE" "STATUS" "VDI PORT" "HOME PATH"
    printf "  %-26s %-8s %-12s %-10s %-10s %s\n" "----" "-------" "----" "------" "--------" "---------"

    for b in "${all_boxes[@]}"; do
      local ch md status="stopped" vdi_port h
      ch=$(get_box_channel "$b")
      md=$(get_box_mode "$b")
      is_container_running "$b" "$runtime" && status="running"
      vdi_port=$((6080 + $(calculate_box_port_offset "$b")))
      h=$(get_box_home "$b")
      printf "  %-26s %-8s %-12s %-10s %-10s %s\n" "$b" "$ch" "$md" "$status" "$vdi_port" "$h"
    done
  else
    if command -v gum >/dev/null 2>&1; then
      gum style --foreground 214 "No AGY Boxes found."
    else
      echo "No AGY Boxes found."
    fi
  fi

  local homes_dir="${HOME:-}/.config/agy-box/homes"
  local orphaned_homes=()
  if [ -d "$homes_dir" ]; then
    for d in "$homes_dir"/*; do
      if [ -d "$d" ]; then
        local b_name
        b_name=$(basename "$d")
        if ! check_container_exists "$b_name"; then
          orphaned_homes+=("$b_name")
        fi
      fi
    done
  fi

  if [ ${#orphaned_homes[@]} -gt 0 ]; then
    echo -e "\n${YELLOW}Preserved Data Directories (No Active Container):${NC}"
    printf "  %-26s %-10s %s\n" "BOX NAME" "SIZE" "PATH"
    printf "  %-26s %-10s %s\n" "--------" "----" "----"
    for ob in "${orphaned_homes[@]}"; do
      local d="$homes_dir/$ob"
      local sz
      sz=$(du -sh "$d" 2>/dev/null | cut -f1 || echo "N/A")
      printf "  %-26s %-10s %s\n" "$ob" "$sz" "$d"
    done
    echo -e "\n${DIM}Tip: Run 'agy-box-manager clean <name> --purge' to remove preserved data.${NC}"
  fi
  echo ""
}

cmd_doctor() {
  local box_selector="${1:-}"
  check_deps "optional"
  local os_name kernel_arch
  os_name=$(get_os_name)
  kernel_arch=$(uname -m 2>/dev/null || echo "unknown")

  echo -e "${CYAN}======================================================================${NC}"
  echo -e "${WHITE}                     AGY Box Doctor Diagnostics                       ${NC}"
  echo -e "${CYAN}======================================================================${NC}"

  local errors=0 warnings=0

  echo -n "  ~/.local/bin in PATH:      "
  if [[ ":$PATH:" == *":${HOME:-}/.local/bin:"* ]]; then
    echo -e "${GREEN}[OK]${NC}"
  else
    echo -e "${YELLOW}[WARN]${NC} (~/.local/bin not in PATH)"
    warnings=$((warnings + 1))
  fi

  echo -n "  ~/.config writable:        "
  mkdir -p "${HOME:-/tmp}/.config" 2>/dev/null || true
  if [ -w "${HOME:-/tmp}/.config" ]; then
    echo -e "${GREEN}[OK]${NC}"
  else
    echo -e "${RED}[ERROR]${NC} (~/.config is not writable)"
    errors=$((errors + 1))
  fi

  echo -n "  Container Engine:          "
  local detected_mgr runtime_ver="Unknown" runtime_rootless=""
  detected_mgr=$(detect_runtime 2>/dev/null || echo "")
  if [ -n "$detected_mgr" ] && ! command -v "$detected_mgr" >/dev/null 2>&1; then
    detected_mgr=""
  fi
  if [ -n "$detected_mgr" ]; then
    if [ "$detected_mgr" = "podman" ]; then
      runtime_ver=$(podman --version 2>/dev/null | awk '{print $3}' || echo "installed")
      podman info 2>/dev/null | grep -qi "rootless: true" && runtime_rootless="rootless" || runtime_rootless="rootful"
    else
      runtime_ver=$(docker --version 2>/dev/null | awk '{print $3}' | tr -d ',' || echo "installed")
      docker info 2>/dev/null | grep -qi "rootless" && runtime_rootless="rootless" || runtime_rootless="rootful"
    fi
    echo -e "${GREEN}[OK]${NC} ($detected_mgr $runtime_ver, $runtime_rootless)"
  else
    echo -e "${RED}[ERROR]${NC} (install podman or docker)"
    errors=$((errors + 1))
  fi

  echo -n "  Distrobox (optional):      "
  if command -v distrobox &>/dev/null; then
    local dbx_ver
    dbx_ver=$(distrobox --version 2>/dev/null | awk '{print $2}' || echo "installed")
    echo -e "${GREEN}[OK]${NC} ($dbx_ver — workstation mode available)"
  else
    echo -e "${CYAN}[INFO]${NC} (not installed — default sandbox mode ready)"
  fi

  echo "  Host OS:                   $os_name ($kernel_arch)"
  echo "  Default Mode:              ${AGY_DEFAULT_MODE:-sandbox}"
  echo "  Keyring Mode:              ${AGY_KEYRING_MODE:-host}"
  echo "  Log Directory:             $(get_log_dir)"

  echo -e "\n${BLUE}[ Managed Boxes ]${NC}"
  local all_boxes=() b
  while IFS= read -r b; do
    [ -n "$b" ] && all_boxes+=("$b")
  done < <(get_all_agy_boxes)

  if [ ${#all_boxes[@]} -eq 0 ]; then
    echo "  (none installed — run 'agy-box-manager install')"
  else
    for b in "${all_boxes[@]}"; do
      local st="stopped"
      [ -n "$detected_mgr" ] && is_container_running "$b" "$detected_mgr" && st="running"
      echo "  • $b [$(get_box_channel "$b") · $(get_box_mode "$b")]: $st ($(get_box_home "$b"))"
    done
  fi

  if [ -n "$box_selector" ] && [ -n "$detected_mgr" ]; then
    local target_box
    target_box=$(resolve_target_box "$box_selector") || return 1
    set_box_log_context "$target_box"
    echo -e "\n${BLUE}[ Container Health: $target_box ]${NC}"
    if [ "$(get_box_manager "$target_box")" = "distrobox" ]; then
      run_logged distrobox enter "$target_box" -- /usr/local/bin/agy-doctor || errors=$((errors + 1))
    else
      run_logged "$detected_mgr" exec -u agyuser -w /home/agyuser "$target_box" /usr/local/bin/agy-doctor || errors=$((errors + 1))
    fi
  fi

  echo -e "${CYAN}======================================================================${NC}"
  if [ "$errors" -gt 0 ]; then
    echo -e "${RED}Doctor detected $errors error(s) and $warnings warning(s).${NC}\n"
    return 1
  elif [ "$warnings" -gt 0 ]; then
    echo -e "${YELLOW}System is functional with $warnings warning(s).${NC}\n"
  else
    echo -e "${GREEN}System is healthy!${NC}\n"
  fi
  return 0
}

state_log_exists() {
  local f="$1"
  [ -f "$f" ] || { command -v podman >/dev/null 2>&1 && podman unshare test -f "$f" 2>/dev/null; }
}

cmd_logs() {
  init_logging
  local log_dir
  log_dir=$(get_log_dir)
  local lines=80 follow=false filter="" selector=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n|--lines)
        lines="$2"
        shift 2
        ;;
      -f|--follow)
        follow=true
        shift
        ;;
      --manager)
        filter="manager"
        shift
        ;;
      --vdi)
        filter="vdi"
        shift
        ;;
      --setup)
        filter="setup"
        shift
        ;;
      --doctor)
        filter="doctor"
        shift
        ;;
      --toolchain)
        filter="toolchain"
        shift
        ;;
      --entrypoint)
        filter="entrypoint"
        shift
        ;;
      --ide)
        filter="ide"
        shift
        ;;
      --all)
        filter="all"
        shift
        ;;
      -h|--help)
        echo "Usage: agy-box-manager logs [box|stable|dev] [-n|--lines N] [-f|--follow] [--vdi|--setup|--doctor|--toolchain|--entrypoint|--manager|--all]"
        return 0
        ;;
      -*)
        ui_error "Unknown option for logs: $1"
        return 1
        ;;
      *)
        selector="$1"
        shift
        ;;
    esac
  done

  local mlog="$log_dir/agy-box-manager.log"

  if [ "$filter" = "manager" ] || { [ -z "$selector" ] && [ -z "$filter" ]; }; then
    echo -e "${CYAN}=== Manager Diagnostic Log ($mlog) ===${NC}"
    if [ "$follow" = "true" ]; then
      touch "$mlog" 2>/dev/null || true
      exec tail -n "$lines" -f "$mlog"
    fi
    if [ -f "$mlog" ] && [ -s "$mlog" ]; then
      tail -n "$lines" "$mlog"
    else
      echo "(no manager log entries yet)"
    fi

    echo -e "\n${CYAN}=== Available Box & Container State Logs ===${NC}"
    local found_any=false bf
    for bf in "$log_dir"/*.log; do
      [ -f "$bf" ] || continue
      [ "$bf" = "$mlog" ] && continue
      local bname
      bname=$(basename "$bf" .log)
      echo "  • $bname (host): $bf"
      found_any=true
    done
    if [ -d "${HOME:-}/.config/agy-box/homes" ]; then
      local hd sf
      for hd in "$HOME/.config/agy-box/homes"/*; do
        [ -d "$hd" ] || continue
        local bn
        bn=$(basename "$hd")
        for sf in doctor setup-helper vdi toolchain entrypoint ide; do
          local sp="$hd/.local/state/agy-box/${sf}.log"
          if state_log_exists "$sp"; then
            echo "  • $bn ($sf): $sp"
            found_any=true
          fi
        done
      done
    fi
    [ "$found_any" = "false" ] && echo "  (no per-box logs yet)"
    return 0
  fi

  local target_box=""
  if [ -n "$selector" ]; then
    if [ "$selector" != "stable" ] && [ "$selector" != "prod" ] && [ "$selector" != "dev" ]; then
      if [ -f "$log_dir/${selector}.log" ] || [ -d "$(get_box_home "$selector")" ]; then
        target_box="$selector"
      elif [ -f "$log_dir/agy-box-${selector}.log" ] || [ -d "$(get_box_home "agy-box-$selector")" ]; then
        target_box="agy-box-$selector"
      elif [ -f "$log_dir/agy-box-dev-${selector}.log" ] || [ -d "$(get_box_home "agy-box-dev-$selector")" ]; then
        target_box="agy-box-dev-$selector"
      fi
    fi
    if [ -z "$target_box" ]; then
      target_box=$(resolve_target_box "$selector") || return 1
    fi
  elif [ "$filter" = "all" ]; then
    echo -e "${CYAN}=== Manager Diagnostic Log ($mlog) ===${NC}"
    [ -f "$mlog" ] && tail -n "$lines" "$mlog" || echo "(no manager log entries yet)"
    local all_b=() b
    while IFS= read -r b; do [ -n "$b" ] && all_b+=("$b"); done < <(get_all_agy_boxes)
    if [ ${#all_b[@]} -eq 1 ]; then
      target_box="${all_b[0]}"
    else
      for b in "${all_b[@]}"; do
        echo ""
        cmd_logs "$b" -n "$lines"
      done
      return 0
    fi
  else
    target_box=$(resolve_target_box "") || return 1
  fi

  local box_host_log="$log_dir/${target_box}.log"
  local state_dir
  state_dir="$(get_box_home "$target_box")/.local/state/agy-box"

  if [ -n "$filter" ] && [ "$filter" != "all" ]; then
    local target_file=""
    case "$filter" in
      vdi)        target_file="$state_dir/vdi.log" ;;
      setup)      state_log_exists "$state_dir/setup-helper.log" && target_file="$state_dir/setup-helper.log" || target_file="$state_dir/doctor.log" ;;
      doctor)     target_file="$state_dir/doctor.log" ;;
      toolchain)  target_file="$state_dir/toolchain.log" ;;
      entrypoint) target_file="$state_dir/entrypoint.log" ;;
      ide)        target_file="$state_dir/ide.log" ;;
    esac
    echo -e "${CYAN}=== $target_box ($filter) [$target_file] ===${NC}"
    if [ "$follow" = "true" ]; then
      if [ -r "$target_file" ] || [ ! -e "$target_file" ]; then
        mkdir -p "$(dirname "$target_file")" 2>/dev/null || true
        touch "$target_file" 2>/dev/null || true
        exec tail -n "$lines" -f "$target_file"
      elif command -v podman >/dev/null 2>&1; then
        exec podman unshare tail -n "$lines" -f "$target_file"
      fi
    fi
    if ! read_box_state_log "$lines" "$target_file"; then
      echo "(no $filter log entries found at $target_file)"
    fi
    return 0
  fi

  if [ "$follow" = "true" ]; then
    local follow_files=()
    [ -f "$box_host_log" ] && follow_files+=("$box_host_log")
    local sname
    for sname in doctor setup-helper vdi toolchain entrypoint ide; do
      [ -r "$state_dir/${sname}.log" ] && follow_files+=("$state_dir/${sname}.log")
    done
    if [ ${#follow_files[@]} -eq 0 ]; then
      touch "$box_host_log" 2>/dev/null || true
      follow_files+=("$box_host_log")
    fi
    exec tail -n "$lines" -f "${follow_files[@]}"
  fi

  local printed=false
  if [ -f "$box_host_log" ]; then
    echo -e "${CYAN}=== $target_box: Host Provisioning & Tool Log ($box_host_log) ===${NC}"
    tail -n "$lines" "$box_host_log"
    printed=true
  fi

  local sname
  for sname in doctor setup-helper vdi toolchain entrypoint ide; do
    local sp="$state_dir/${sname}.log"
    if state_log_exists "$sp"; then
      [ "$printed" = "true" ] && echo ""
      echo -e "${CYAN}=== $target_box: Container ${sname}.log ($sp) ===${NC}"
      read_box_state_log "$lines" "$sp" || true
      printed=true
    fi
  done

  if [ "$printed" = "false" ]; then
    echo "(no logs recorded yet for '$target_box')"
  fi
}

# --- Global CLI Install / Uninstall ---
cmd_install_global() {
  local target_dir="$HOME/.local/bin"
  local target_file="$target_dir/agy-box-manager"

  echo "==> Installing globally to $target_dir..."
  mkdir -p "$target_dir"

  local self_name="${0##*/}"
  case "$self_name" in
    bash|-bash|sh|-sh)
      curl -fsSL "$REMOTE_SCRIPT_URL" -o "$target_file"
      ;;
    *)
      if [ -f "$0" ]; then
        if [ ! "$0" -ef "$target_file" ]; then
          cp "$0" "$target_file"
        fi
      else
        curl -fsSL "$REMOTE_SCRIPT_URL" -o "$target_file"
      fi
      ;;
  esac

  chmod +x "$target_file"
  setup_completions
  ui_ok "✓ Installed globally to $target_file!"
  if [[ ":$PATH:" != *":$target_dir:"* ]]; then
    ui_warn "Make sure $target_dir is in your \$PATH."
  fi
}

cmd_uninstall_global() {
  local target_file="$HOME/.local/bin/agy-box-manager"
  local auto_yes=false
  if [ "${1:-}" = "-y" ] || [ "${1:-}" = "--yes" ]; then
    auto_yes=true
  fi

  local confirmed=false
  if [ "$auto_yes" = "true" ] || [ ! -t 0 ]; then
    confirmed=true
  elif command -v gum >/dev/null 2>&1; then
    gum confirm "Are you sure you want to remove the global CLI installation?" && confirmed=true
  else
    local uninstall_choice=""
    read -r -p "Are you sure you want to remove the global CLI installation? [y/N] " uninstall_choice
    [[ "$uninstall_choice" =~ ^[Yy]$ ]] && confirmed=true
  fi

  if [ "$confirmed" = "true" ]; then
    run_step "Removing globally installed CLI..." rm -f "$target_file"
    rm -f "$HOME/.local/share/bash-completion/completions/agy-box-manager"
    rm -f "$HOME/.zfunc/_agy-box-manager"
    rm -f "$HOME/.config/fish/completions/agy-box-manager.fish"
    rm -f "$HOME/.config/agy-box/shell_integration.sh" "$HOME/.config/agy-box/justfile"
    rm -f "$HOME/.config/fish/functions/ujust.fish" "$HOME/.config/fish/functions/just.fish"
    ui_ok "✓ Removed globally installed CLI and completions."
  else
    ui_warn "Skipping uninstall."
  fi
}

# --- Streamlined Interactive TUI ---
show_compact_banner() {
  clear
  if command -v gum >/dev/null 2>&1; then
    gum style --foreground 212 --border-foreground 212 --border rounded --align center --width 58 --margin "0 2" --padding "0 1" "🚀 AGY Box Manager v${VERSION}"
  else
    echo -e "${MAGENTA}=== 🚀 AGY Box Manager v${VERSION} ===${NC}\n"
  fi
}

show_compact_status() {
  local total=0 running=0 stable_n=0 dev_n=0 b
  local runtime
  runtime=$(get_runtime 2>/dev/null || echo "podman")

  while IFS= read -r b; do
    [ -z "$b" ] && continue
    total=$((total + 1))
    is_container_running "$b" "$runtime" && running=$((running + 1))
    if [ "$(get_box_channel "$b")" = "dev" ]; then
      dev_n=$((dev_n + 1))
    else
      stable_n=$((stable_n + 1))
    fi
  done < <(get_all_agy_boxes)

  local status_text="📦 Boxes: $total ($running running)  |  Stable: $stable_n  |  Dev: $dev_n"
  gum style --border rounded --border-foreground 39 --padding "0 2" --margin "0 2" --align center --width 58 \
    "$status_text"
}

prompt_workspace_mode() {
  local opt_sb="sandbox (Isolated Container - Fast boot & VDI) [Recommended]"
  local opt_ws="workstation (Distrobox - Native host Wayland windows & SSO)"
  local choice
  if [ "${AGY_DEFAULT_MODE:-sandbox}" = "workstation" ]; then
    choice=$(choose_option "$opt_ws" "$opt_sb")
  else
    choice=$(choose_option "$opt_sb" "$opt_ws")
  fi
  if [[ "$choice" == workstation* ]]; then
    echo "workstation"
  else
    echo "sandbox"
  fi
}

tui_create_stable_box() {
  clear
  show_compact_banner
  local new_name
  new_name=$(generate_box_name "$BOX_PREFIX")
  echo -e "${CYAN}📦 New Stable Box: ${GREEN}$new_name${CYAN} (permanent slug)${NC}\n"
  local chosen_mode
  chosen_mode=$(prompt_workspace_mode)
  cmd_install_official --name "$new_name" --mode "$chosen_mode"
}

tui_build_repo_box() {
  clear
  show_compact_banner
  local br ch prefix new_name
  br=$(detect_repo_git_ref)
  ch=$(detect_repo_channel "$br" "")
  prefix="$BOX_PREFIX"
  [ "$ch" = "dev" ] && prefix="$DEV_BOX_PREFIX"
  new_name=$(generate_box_name "$prefix")
  echo -e "${CYAN}🛠️  Build from Repo (${WHITE}${br}${CYAN} → ${GREEN}${ch}${CYAN}): ${GREEN}$new_name${NC}\n"
  local chosen_mode
  chosen_mode=$(prompt_workspace_mode)
  cmd_build_dev --name "$new_name" --channel "$ch" --mode "$chosen_mode"
}

cmd_interactive() {
  check_deps "menu"
  local menu_state="main"
  while true; do
    case "$menu_state" in
      "main")
        clear
        show_compact_banner
        show_compact_status

        local main_options=(
          "🚪 Workspaces (Enter / VDI Desktop) >"
          "🛠️  Manage Environments >"
          "⚙️  System Tools >"
          "❌ Exit"
        )
        local choice
        choice=$(choose_option "${main_options[@]}")
        case "$choice" in
          "🚪 Workspaces"*) menu_state="workspaces" ;;
          "🛠️  Manage"*)     menu_state="manage" ;;
          "⚙️  System"*)     menu_state="tools" ;;
          *)                gum style --foreground 212 "Goodbye!"; exit 0 ;;
        esac
        ;;

      "workspaces")
        clear
        show_compact_banner
        show_compact_status

        local workspace_options=() all_boxes=() b
        while IFS= read -r b; do
          [ -n "$b" ] && all_boxes+=("$b")
        done < <(get_all_agy_boxes)

        if [ ${#all_boxes[@]} -eq 0 ]; then
          workspace_options+=("➕ Create New Stable Box")
          if [ -f "Containerfile" ]; then
            workspace_options+=("🛠️  Build Box from Local Repo")
          fi
        else
          for b in "${all_boxes[@]}"; do
            local ch md
            ch=$(get_box_channel "$b")
            md=$(get_box_mode "$b")
            workspace_options+=("🚪 Enter $b [$ch · $md]")
            if is_vdi_running "$b"; then
              workspace_options+=("🟢 Manage VDI Web Desktop ($b)")
            else
              workspace_options+=("🖥️  Start VDI Web Desktop ($b)")
            fi
          done
        fi
        workspace_options+=("🔙 Back to Main Menu")

        local sub_choice
        sub_choice=$(choose_option "${workspace_options[@]}")
        case "$sub_choice" in
          "➕ Create New Stable Box")
            tui_create_stable_box
            pause_key
            ;;
          "🛠️  Build Box from Local Repo")
            tui_build_repo_box
            pause_key
            ;;
          "🚪 Enter "*)
            local rest="${sub_choice#🚪 Enter }"
            cmd_enter "${rest%% \[*}"
            pause_key
            ;;
          *"VDI Web Desktop ("*)
            local target="${sub_choice#*VDI Web Desktop (}"
            target="${target%)}"
            cmd_desktop "$target"
            ;;
          *)
            menu_state="main"
            ;;
        esac
        ;;

      "manage")
        clear
        show_compact_banner
        show_compact_status

        local manage_options=("➕ Create New Stable Box")
        if [ -f "Containerfile" ]; then
          local repo_br repo_ch
          repo_br=$(detect_repo_git_ref)
          repo_ch=$(detect_repo_channel "$repo_br" "")
          manage_options+=("🛠️  Build New Box from Repo ($repo_br → $repo_ch)")
        fi

        local existing_boxes=() b
        while IFS= read -r b; do
          [ -n "$b" ] && existing_boxes+=("$b")
        done < <(get_all_agy_boxes)

        if [ ${#existing_boxes[@]} -gt 0 ]; then
          manage_options+=("🔄 Update Box Apps & OS...")
          manage_options+=("🗑️  Remove Box...")
          manage_options+=("🗑️  Remove All Boxes...")
        fi
        manage_options+=("📁 Manage Preserved Box Data...")
        manage_options+=("🔙 Back to Main Menu")

        local sub_choice
        sub_choice=$(choose_option "${manage_options[@]}")
        case "$sub_choice" in
          "➕ Create New Stable Box")
            tui_create_stable_box
            pause_key
            menu_state="workspaces"
            ;;
          "🛠️  Build New Box from Repo"*)
            tui_build_repo_box
            pause_key
            menu_state="workspaces"
            ;;
          "🔄 Update Box Apps & OS...")
            clear
            show_compact_banner
            local target_box=""
            if [ ${#existing_boxes[@]} -eq 1 ]; then
              target_box="${existing_boxes[0]}"
            else
              target_box=$(choose_option "${existing_boxes[@]}" "🔙 Cancel")
            fi
            if [ -n "$target_box" ] && [ "$target_box" != "🔙 Cancel" ]; then
              local upd_choice
              upd_choice=$(choose_option \
                "🔄 Update Everything (Apps, Toolchain & OS Packages)" \
                "🧰 Update Apps & Antigravity Toolchain Only" \
                "🐧 Update Container OS Packages Only" \
                "🔙 Cancel")
              case "$upd_choice" in
                "🔄 Update Everything"*) cmd_update "$target_box" --all ;;
                "🧰 Update Apps"*)       cmd_update "$target_box" --toolchain --ides ;;
                "🐧 Update Container"*)  cmd_update "$target_box" --packages ;;
              esac
            fi
            pause_key
            ;;
          "🗑️  Remove Box...")
            clear
            show_compact_banner
            local box_to_remove=""
            if [ ${#existing_boxes[@]} -eq 1 ]; then
              box_to_remove="${existing_boxes[0]}"
            else
              box_to_remove=$(choose_option "${existing_boxes[@]}" "🔙 Cancel")
            fi
            if [ -n "$box_to_remove" ] && [ "$box_to_remove" != "🔙 Cancel" ]; then
              cmd_clean "$box_to_remove"
            fi
            pause_key
            ;;
          "🗑️  Remove All Boxes...")
            clear
            show_compact_banner
            local all_retention
            all_retention=$(choose_option \
              "Purge all containers & isolated home data" \
              "Remove all containers & keep isolated home data" \
              "🔙 Cancel")
            case "$all_retention" in
              "Purge all"*)
                gum confirm "Permanently delete ALL AGY boxes and their isolated home data?" && cmd_clean --all --purge -y
                ;;
              "Remove all"*)
                gum confirm "Remove ALL AGY box containers (keeping home directories)?" && cmd_clean --all --keep -y
                ;;
            esac
            pause_key
            ;;
          "📁 Manage Preserved Box Data...")
            clear
            show_compact_banner
            echo -e "${CYAN}Manage Preserved Box Data Directories${NC}\n"
            local homes_dir="$HOME/.config/agy-box/homes"
            local orphaned=()
            if [ -d "$homes_dir" ]; then
              for d in "$homes_dir"/*; do
                if [ -d "$d" ]; then
                  local b_name
                  b_name=$(basename "$d")
                  if ! check_container_exists "$b_name"; then
                    local sz
                    sz=$(du -sh "$d" 2>/dev/null | cut -f1 || echo "N/A")
                    orphaned+=("$b_name ($sz)")
                  fi
                fi
              done
            fi
            if [ ${#orphaned[@]} -gt 0 ]; then
              local selected_orphan
              selected_orphan=$(choose_option "${orphaned[@]}" "🗑️  Purge All Preserved Data" "🔙 Cancel")
              if [ "$selected_orphan" = "🗑️  Purge All Preserved Data" ]; then
                if gum confirm "Purge ALL preserved box data directories?"; then
                  for item in "${orphaned[@]}"; do
                    local dir_name="${item%% *}"
                    purge_box_home "${homes_dir:?}/${dir_name:?}"
                  done
                  ui_ok "✓ All preserved data directories purged."
                fi
              elif [ -n "$selected_orphan" ] && [ "$selected_orphan" != "🔙 Cancel" ]; then
                local dir_name="${selected_orphan%% *}"
                if gum confirm "Permanently delete $homes_dir/$dir_name?"; then
                  purge_box_home "${homes_dir:?}/${dir_name:?}"
                  ui_ok "✓ Removed $homes_dir/$dir_name"
                fi
              fi
            else
              gum style --foreground 214 "No preserved or orphaned box data directories found."
            fi
            pause_key
            ;;
          *)
            menu_state="main"
            ;;
        esac
        ;;

      "tools")
        clear
        show_compact_banner
        show_compact_status

        local tools_options=(
          "📋 View Diagnostic Logs"
          "🔍 Run Doctor Health Check"
          "📊 Show Box Status Table"
        )
        if [ -f "$HOME/.local/bin/agy-box-manager" ]; then
          tools_options+=("🔥 Uninstall CLI Globally")
        else
          tools_options+=("🌍 Install CLI Globally (~/.local/bin)")
        fi
        tools_options+=("🔙 Back to Main Menu")

        local sub_choice
        sub_choice=$(choose_option "${tools_options[@]}")
        case "$sub_choice" in
          "📋 View Diagnostic Logs")
            clear
            show_compact_banner
            local log_choices=("📜 Manager Log (agy-box-manager.log)")
            local b
            while IFS= read -r b; do
              [ -n "$b" ] && log_choices+=("📦 Box Logs: $b")
            done < <(get_all_agy_boxes)
            log_choices+=("🔙 Cancel")
            local lpick
            lpick=$(choose_option "${log_choices[@]}")
            case "$lpick" in
              "📜 Manager Log"*) cmd_logs --manager; pause_key ;;
              "📦 Box Logs: "*)  cmd_logs "${lpick#📦 Box Logs: }"; pause_key ;;
            esac
            ;;
          "🔍 Run Doctor Health Check")
            cmd_doctor
            pause_key
            ;;
          "📊 Show Box Status Table")
            cmd_status
            pause_key
            ;;
          "🌍 Install CLI Globally"*)
            cmd_install_global
            pause_key
            ;;
          "🔥 Uninstall CLI Globally")
            cmd_uninstall_global
            pause_key
            ;;
          *)
            menu_state="main"
            ;;
        esac
        ;;
    esac
  done
}

show_help() {
  show_compact_banner
  cat << EOF
Usage: $0 [command] [options]

Commands:
  (none)                    Launch interactive TUI
  install [opts]            Create a new stable box (-m sandbox|workstation, -i <img>, -n <name>, -y)
  dev [opts]                Build box from local repo (main -> stable, other branches -> dev)
  enter [box|stable|dev]    Enter box shell (auto-selects when 1 box is installed)
  desktop [box|stable|dev]  Launch VDI Web Desktop (-p <port>, -r <WxH>, -d, --stop, --status)
  logs [box] [opts]         View diagnostic logs (-n N, -f, --vdi, --setup, --doctor, --toolchain, --manager)
  status                    List all managed AGY Boxes, channels, ports, and homes
  doctor (alias: check)     Run host and container health diagnostics
  update [box|stable|dev]   Update toolchain, IDE extensions, and OS packages (--all, --check)
  clean [box|--all]         Remove box or all boxes (--purge, --keep, -y)
EOF
  echo "  update-toolchain [box]    Install/update Antigravity toolchain in container"
  cat << EOF
  install-global            Install agy-box-manager to ~/.local/bin
  uninstall-global          Remove globally installed agy-box-manager and completions
  autocomplete [sh]         Generate shell completions (bash, zsh, fish)
  test                      Run local integration test suite
  version                   Print agy-box-manager version
EOF
}

if (return 0 2>/dev/null); then
  return 0
fi

# --- Main CLI Dispatch ---
cmd="${1:-}"
if [ -z "$cmd" ] && [[ "${0:-}" =~ ^(-v|--version|version)$ ]]; then
  cmd="$0"
fi

case "$cmd" in
  check|doctor)     check_deps "optional"; cmd_doctor "${@:2}" ;;
  update)           check_deps "optional"; cmd_update "${@:2}" ;;
  install)          check_deps "quiet"; cmd_install_official "${@:2}" ;;
  dev)              check_deps "quiet"; cmd_build_dev "${@:2}" ;;
  enter)            check_deps "quiet"; cmd_enter "${@:2}" ;;
  desktop)          check_deps "quiet"; cmd_desktop "${@:2}" ;;
  logs)             cmd_logs "${@:2}" ;;
  clean)            check_deps "quiet"; cmd_clean "${@:2}" ;;
  update-toolchain) check_deps "quiet"; cmd_update_toolchain "${@:2}" ;;
  status)           check_deps "optional"; cmd_status ;;
  install-global)   check_deps "optional"; cmd_install_global ;;
  uninstall-global) check_deps "optional"; cmd_uninstall_global "${@:2}" ;;
  autocomplete)     cmd_autocomplete "${2:-bash}" ;;
  rename)           reject_rename_error ;;
  test)             check_deps "quiet"; if [ -f "scripts/test-box.sh" ]; then ./scripts/test-box.sh; else echo -e "${RED}Test script not found. Please run this command inside the repository.${NC}"; exit 1; fi ;;
  version|--version|-v) echo "agy-box-manager version $VERSION"; exit 0 ;;
  help|--help|-h)   show_help ;;
  "")               cmd_interactive ;;
  *)                ui_error "Unknown command: $1"; echo ""; show_help; exit 1 ;;
esac
