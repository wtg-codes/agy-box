#!/bin/bash

set -euo pipefail

# --- Configuration ---
VERSION="0.7.2"
IMAGE_NAME="ghcr.io/wtg-codes/agy-box:latest"
DEV_IMAGE_NAME="agy-box:dev"
CONTAINER_NAME="agy-box"
DEV_CONTAINER_NAME="agy-box-dev"
REMOTE_SCRIPT_URL="https://raw.githubusercontent.com/wtg-codes/agy-box/main/agy-box-manager"

# --- Colors for ASCII Art ---
RED=$'\e[0;31m'
GREEN=$'\e[0;32m'
YELLOW=$'\e[1;33m'
BLUE=$'\e[0;34m'
MAGENTA=$'\e[0;35m'
CYAN=$'\e[0;36m'
WHITE=$'\e[1;37m'
DIM=$'\e[2m'
NC=$'\e[0m' # No Color

ui_error() {
  if command -v gum &>/dev/null; then gum style --foreground 196 "$@" >&2; else printf '%s\n' "$@" >&2; fi
}
ui_warn() {
  if command -v gum &>/dev/null; then gum style --foreground 214 "$@"; else printf '%s\n' "$@"; fi
}
ui_ok() {
  if command -v gum &>/dev/null; then gum style --foreground 46 "$@"; else printf '%s\n' "$@"; fi
}

clear() {
  command clear 2>/dev/null || true
}

pause_key() {
  echo ""
  read -n 1 -s -r -p "Press any key to continue..."
}

# --- Configuration & Paths ---
get_config_dir() { echo "${HOME:-}/.config/agy-box"; }
get_config_file() { echo "${HOME:-}/.config/agy-box/config.env"; }
get_box_home() {
  local name=${1:-$CONTAINER_NAME}
  if [ "$name" = "$CONTAINER_NAME" ]; then
    echo "${HOME:-}/.config/agy-box/home"
  elif [ "$name" = "$DEV_CONTAINER_NAME" ]; then
    echo "${HOME:-}/.config/agy-box/home-dev"
  else
    echo "${HOME:-}/.config/agy-box/homes/$name"
  fi
}

load_resource_limits() {
  local conf="$HOME/.config/agy-box/limits.conf"
  cpu_limit=""
  memory_limit=""
  if [[ -f "$conf" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      line=$(echo "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/#.*//')
      [[ -z "$line" ]] && continue
      if [[ "$line" =~ ^CPU_LIMIT=(.*)$ ]]; then cpu_limit="${BASH_REMATCH[1]//[\"\']/}"; fi
      if [[ "$line" =~ ^MEMORY_LIMIT=(.*)$ ]]; then memory_limit="${BASH_REMATCH[1]//[\"\']/}"; fi
    done < "$conf"
  fi
}

write_config_file() {
  cat <<EOF > "$1"
# ==============================================================================
# agy-box User Configuration
# Generated by agy-box-manager wizard
# ==============================================================================
# Container runtime engine ("podman" or "docker")
AGY_CONTAINER_MANAGER="$2"
AGY_CONTAINER_ENGINE="$2"

# Engine mode for primary 'agy-box' ("distrobox" or "podman" or "docker")
AGY_PRIMARY_ENGINE="$3"

# Engine mode for named/secondary boxes ("podman" or "docker" or "distrobox")
AGY_NAMED_ENGINE="$4"

# Keyring credential security mode ("host" or "isolated")
#   host:     Shares host D-Bus Secret Service for seamless single sign-on
#   isolated: Uses encrypted container-local file keyring (air-gapped credentials)
AGY_KEYRING_MODE="$5"

# Antigravity agent authentication method ("oauth", "api-key", "service-account")
AGY_AUTH_METHOD="oauth"

# Default preferred editor inside container ("code", "zed", "jetbrains", "none")
AGY_DEFAULT_IDE="$6"

# Host profile seeding ("true" to mount ~/.gitconfig, ~/.ssh, ~/.config/gcloud; "false" for pristine isolation)
AGY_PROFILE_SEEDING="$7"

# Anonymous telemetry opt-in ("false" for privacy-first default)
AGY_TELEMETRY="false"
EOF
}

init_defaults() {
  local silent=${1:-false}
  if [ -z "${HOME:-}" ]; then
    return 0
  fi
  local config_dir
  config_dir=$(get_config_dir)
  local config_file
  config_file=$(get_config_file)
  mkdir -p "$config_dir"
  if [ -f "$config_file" ]; then
    return 0
  fi

  local default_runtime="podman"
  if [ -n "${DBX_CONTAINER_MANAGER:-}" ] && command -v "$DBX_CONTAINER_MANAGER" >/dev/null 2>&1; then
    default_runtime="$DBX_CONTAINER_MANAGER"
  elif command -v podman >/dev/null 2>&1; then
    default_runtime="podman"
  elif command -v docker >/dev/null 2>&1; then
    default_runtime="docker"
  fi

  write_config_file "$config_file" "$default_runtime" "distrobox" "podman" "host" "code" "false"

  if [ "$silent" != "silent" ] && [ "$silent" != "true" ]; then
    ui_ok "✓ Initialized default configuration at $config_file"
  fi
}

load_config() {
  if [ -z "${HOME:-}" ]; then
    return 0
  fi
  local config_file
  config_file=$(get_config_file)

  if [ ! -f "$config_file" ]; then
    init_defaults "silent"
  fi

  if [ -f "$config_file" ]; then
    while IFS='=' read -r key val || [ -n "$key" ]; do
      key=$(echo "$key" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
      [[ -z "$key" || "$key" =~ ^# ]] && continue
      val=$(echo "$val" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
      val="${val%\"}"
      val="${val#\"}"
      val="${val%\'}"
      val="${val#\'}"
      case "$key" in
        AGY_CONTAINER_MANAGER) AGY_CONTAINER_MANAGER="$val" ;;
        AGY_CONTAINER_ENGINE)  AGY_CONTAINER_ENGINE="$val" ;;
        AGY_PRIMARY_ENGINE)    AGY_PRIMARY_ENGINE="$val" ;;
        AGY_NAMED_ENGINE)      AGY_NAMED_ENGINE="$val" ;;
        AGY_KEYRING_MODE)      AGY_KEYRING_MODE="$val" ;;
        AGY_AUTH_METHOD)       AGY_AUTH_METHOD="$val" ;;
        AGY_DEFAULT_IDE)       AGY_DEFAULT_IDE="$val" ;;
        AGY_PROFILE_SEEDING)   AGY_PROFILE_SEEDING="$val" ;;
        AGY_TELEMETRY)         AGY_TELEMETRY="$val" ;;
      esac
    done < "$config_file"
  fi

  : "${AGY_CONTAINER_MANAGER:=podman}"
  : "${AGY_CONTAINER_ENGINE:=$AGY_CONTAINER_MANAGER}"
  : "${AGY_PRIMARY_ENGINE:=distrobox}"
  : "${AGY_NAMED_ENGINE:=podman}"
  : "${AGY_KEYRING_MODE:=host}"
  : "${AGY_AUTH_METHOD:=oauth}"
  : "${AGY_DEFAULT_IDE:=code}"
  : "${AGY_PROFILE_SEEDING:=false}"
  : "${AGY_TELEMETRY:=false}"

  if [ -z "${DBX_CONTAINER_MANAGER:-}" ] && [ -n "${AGY_CONTAINER_MANAGER:-}" ] && command -v "$AGY_CONTAINER_MANAGER" >/dev/null 2>&1; then
    export DBX_CONTAINER_MANAGER="$AGY_CONTAINER_MANAGER"
  fi
}

apply_keyring_configuration() {
  [ -z "${HOME:-}" ] && return 0
  local iso_home="${1:-$HOME/.config/agy-box/home}"
  local mode="${AGY_KEYRING_MODE:-host}"
  # shellcheck disable=SC2016
  local script='
    iso="$1"; mode="$2"
    mkdir -p "$iso/.config/python_keyring" "$iso/.config/environment.d" "$iso/.local/share/keyrings" || exit 1
    if [ "$mode" = "isolated" ]; then
      printf "[backend]\ndefault-keyring=keyrings.alt.file.EncryptedKeyring\n" > "$iso/.config/python_keyring/keyringrc.cfg" || exit 1
      printf "PYTHON_KEYRING_BACKEND=keyrings.alt.file.EncryptedKeyring\n" > "$iso/.config/environment.d/keyring.conf" || exit 1
    else
      rm -f "$iso/.config/python_keyring/keyringrc.cfg" "$iso/.config/environment.d/keyring.conf" || exit 1
    fi
  '
  if { [ ! -e "$iso_home" ] || [ -O "$iso_home" ]; } && { [ ! -e "$iso_home/.config" ] || [ -O "$iso_home/.config" ]; }; then
    if bash -c "$script" _ "$iso_home" "$mode" 2>/dev/null; then
      return 0
    fi
  fi
  if command -v podman >/dev/null 2>&1; then
    # shellcheck disable=SC2016
    podman unshare bash -c '
      iso="$1"; mode="$2"; s="$3"; ug="0:0"
      if [ "$(stat -c "%u:%g" "$iso" 2>/dev/null)" = "9000:9000" ] || [ "$(stat -c "%u:%g" "$iso/.config" 2>/dev/null)" = "9000:9000" ]; then
        ug="9000:9000"
      fi
      bash -c "$s" _ "$iso" "$mode"
      chown -R "$ug" "$iso/.config" "$iso/.local" 2>/dev/null || true
    ' _ "$iso_home" "$mode" "$script" 2>/dev/null || true
  fi
}

# --- Helper Functions ---
get_os_name() {
  if [ -f /etc/os-release ]; then
        # shellcheck disable=SC1091
    . /etc/os-release
    echo "${PRETTY_NAME:-Linux}"
  else
    echo "Linux"
  fi
}

probe_host_capabilities() {
  local mode=${1:-}
  load_config
  if [ -n "${DBX_CONTAINER_MANAGER:-}" ] && command -v "$DBX_CONTAINER_MANAGER" >/dev/null 2>&1; then
    export DBX_CONTAINER_MANAGER
  elif [ -n "${AGY_CONTAINER_MANAGER:-}" ] && command -v "$AGY_CONTAINER_MANAGER" >/dev/null 2>&1; then
    export DBX_CONTAINER_MANAGER="$AGY_CONTAINER_MANAGER"
  elif command -v podman >/dev/null 2>&1; then
    export DBX_CONTAINER_MANAGER="podman"
  elif command -v docker >/dev/null 2>&1; then
    export DBX_CONTAINER_MANAGER="docker"
  elif [ "$mode" != "menu" ] && [ "$mode" != "optional" ]; then
    if command -v gum >/dev/null 2>&1; then
      gum style --foreground 196 --border rounded --padding "0 2" --margin "1 0" \
        "❌ ERROR: No container runtime found!" \
        "Please install either Podman (Highly Recommended) or Docker."
    else
      echo -e "${RED}❌ ERROR: No container runtime found!${NC}\nPlease install either Podman (Highly Recommended) or Docker." >&2
    fi
    exit 1
  fi

  if [ "${DBX_CONTAINER_MANAGER:-}" = "docker" ] && [ "$mode" != "menu" ] && [ "$mode" != "optional" ]; then
    if ! docker info >/dev/null 2>&1; then
      if command -v gum >/dev/null 2>&1; then
        gum style --foreground 196 --border rounded --padding "0 2" --margin "1 0" \
          "❌ ERROR: Docker daemon is unreachable!" \
          "Please check if the Docker service is active, or add your user" \
          "to the 'docker' Unix group:" \
          "  sudo usermod -aG docker $USER" \
          "You may need to log out and log back in for changes to apply."
      else
        echo -e "${RED}❌ ERROR: Docker daemon is unreachable!${NC}\nPlease check if Docker service is active, or add your user to 'docker' group: sudo usermod -aG docker \$USER" >&2
      fi
    elif ! docker info 2>/dev/null | grep -q "rootless"; then
      if command -v gum >/dev/null 2>&1; then
        gum style --foreground 214 --border rounded --padding "0 2" --margin "1 0" \
          "⚠️ CAUTION: Rootful Docker detected!" \
          "Since standard Docker runs as a root daemon, files written to" \
          "your mounted home directory may be saved with root ownership." \
          "Consider setting up rootless Docker or installing Podman."
      else
        echo -e "${YELLOW}⚠️ CAUTION: Rootful Docker detected! Files written to mounted home may have root ownership.${NC}" >&2
      fi
    fi
  fi
}

# --- Dependency Management ---
install_gum() {
  [ -t 0 ] || return 0
  if command -v brew &>/dev/null; then
    echo -e "${CYAN}Gum is required for the interactive UI. Installing via Homebrew...${NC}"
    brew install gum && return 0
  fi
  echo -e "${RED}Gum is required for the interactive UI but is not installed.${NC}"
  echo "Install it from https://github.com/charmbracelet/gum#installation and re-run."
  echo "(Non-interactive subcommands such as 'install', 'enter' and 'status' work without it.)"
  exit 1
}

check_deps() {
  local mode=${1:-}
  if ! command -v gum &> /dev/null; then
    if [ "$mode" != "quiet" ] && [ "$mode" != "optional" ] && [ -t 0 ]; then
      install_gum
    fi
  fi

  probe_host_capabilities "$mode"

  if [ "$mode" = "menu" ] || [ "$mode" = "optional" ]; then
    return 0
  fi

  if ! command -v podman &> /dev/null && ! command -v docker &> /dev/null; then
    echo -e "${RED}✗ Error: Neither podman nor docker is installed on the host system.${NC}" >&2
    echo -e "${YELLOW}Please install podman (or docker) with your OS package manager, then retry.${NC}" >&2
    exit 1
  fi
}

require_distrobox() {
  if ! command -v distrobox &> /dev/null; then
    ui_error "✗ Error: distrobox is not installed on the host system (required for Workstation mode)."
    echo -e "${YELLOW}Please install distrobox with your OS package manager, or pass '--mode sandbox'.${NC}" >&2
    echo "Tip: Distrobox can be installed without root via:" >&2
    echo "  curl -s https://raw.githubusercontent.com/89luca89/distrobox/main/install | sh -s -- --prefix ~/.local" >&2
    exit 1
  fi
}

detect_runtime() {
  load_config
  if [ -n "${DBX_CONTAINER_MANAGER:-}" ] && command -v "$DBX_CONTAINER_MANAGER" >/dev/null 2>&1; then
    echo "$DBX_CONTAINER_MANAGER"
  elif [ -n "${AGY_CONTAINER_MANAGER:-}" ] && command -v "$AGY_CONTAINER_MANAGER" >/dev/null 2>&1; then
    echo "$AGY_CONTAINER_MANAGER"
  elif command -v podman >/dev/null 2>&1; then
    echo "podman"
  else
    echo "docker"
  fi
}

get_runtime() {
  detect_runtime
}

check_container_exists() {
  local name=$1
  local runtime
  runtime=$(get_runtime)
  if "$runtime" ps -a --format '{{.Names}}' 2>/dev/null | grep -qxF -- "$name"; then return 0; else return 1; fi
}

is_container_running() {
  local name=$1
  local runtime="${2:-$(get_runtime)}"
  if "$runtime" ps --format '{{.Names}}' 2>/dev/null | grep -qxF -- "$name"; then
    return 0
  fi
  if command -v distrobox >/dev/null 2>&1 && distrobox list --no-color 2>/dev/null | awk -F'|' -v n="$name" 'NR>1 {gsub(/^[ \t]+|[ \t]+$/, "", $2); if ($2 == n) print $3}' | grep -qi "running"; then
    return 0
  fi
  return 1
}

get_box_manager() {
  local target_name="$1"
  local runtime
  runtime=$(get_runtime 2>/dev/null || echo "podman")

  if check_container_exists "$target_name"; then
    local mgr=""
    if command -v "$runtime" >/dev/null 2>&1; then
      mgr=$("$runtime" inspect "$target_name" --format '{{index .Config.Labels "manager"}}' 2>/dev/null || true)
    fi
    if [ "$mgr" = "distrobox" ]; then
      echo "distrobox"
      return 0
    elif [ "$mgr" = "agy-box-podman" ] || [ "$mgr" = "agy-box-docker" ]; then
      echo "$runtime"
      return 0
    fi
    if command -v distrobox >/dev/null 2>&1 && distrobox list --no-color 2>/dev/null | awk -F'|' 'NR>1 {gsub(/^[ \t]+|[ \t]+$/, "", $2); print $2}' | grep -qxF "$target_name"; then
      echo "distrobox"
      return 0
    fi
    if [ -n "$mgr" ]; then
      echo "$mgr"
      return 0
    fi
    if command -v "$runtime" >/dev/null 2>&1; then
      local ep
      ep=$("$runtime" inspect "$target_name" --format '{{json .Config.Entrypoint}}' 2>/dev/null || true)
      if [[ "$ep" == *"/usr/bin/entrypoint"* ]]; then
        echo "distrobox"
        return 0
      elif [[ "$ep" == *"tini"* ]] || [[ "$ep" == *"entrypoint.sh"* ]]; then
        echo "$runtime"
        return 0
      fi
    fi
    echo "$runtime"
    return 0
  fi

  if [ "$target_name" = "$CONTAINER_NAME" ]; then
    echo "${AGY_PRIMARY_ENGINE:-distrobox}"
  else
    echo "${AGY_NAMED_ENGINE:-$runtime}"
  fi
}

ensure_distrobox_ready() {
  local name="$1"
  local runtime
  runtime=$(get_runtime 2>/dev/null || echo "podman")
  local current_user
  current_user=$(id -un 2>/dev/null || echo "${USER:-wtg}")

  local is_running
  is_running=$("$runtime" inspect -f '{{.State.Running}}' "$name" 2>/dev/null || echo "false")

  if [ "$is_running" != "true" ]; then
    if ! distrobox enter "$name" -- true; then
      ui_error "Failed to initialize Distrobox container '$name'."
      return 1
    fi
  else
    if ! "$runtime" exec --user 0 "$name" getent passwd "$current_user" >/dev/null 2>&1 || ! distrobox enter "$name" -- true >/dev/null 2>&1; then
      ui_warn "Distrobox container '$name' cannot be cleanly entered; restarting to complete initialization..."
      "$runtime" stop "$name" >/dev/null 2>&1 || true
      if ! distrobox enter "$name" -- true; then
        ui_error "Failed to re-initialize Distrobox container '$name'."
        return 1
      fi
      if ! "$runtime" exec --user 0 "$name" getent passwd "$current_user" >/dev/null 2>&1; then
        ui_error "User '$current_user' was not found in container '$name' /etc/passwd after retry."
        return 1
      fi
    fi
  fi
  return 0
}

generate_box_name() {
  local prefix="${1:-$CONTAINER_NAME}"
  local adjs=(golden cosmic lunar ember cobalt amber velvet crystal swift stellar misty crimson silver solar vivid alpine coral noble rapid bright sonic frosty radiant serene emerald copper azure cedar prism aurora zenith mystic)
  local nouns=(spark falcon forge beacon harbor comet canyon breeze summit orbit meadow lantern glacier atlas quartz nebula anchor river phoenix horizon timber zephyr vertex compass citadel cascade voyager foundry haven crest pulse spire)
  if [ -r /dev/urandom ]; then
    RANDOM=$(od -An -N2 -tu2 /dev/urandom 2>/dev/null | tr -d ' ' || echo "$RANDOM")
  fi
  local attempts=0
  while [ $attempts -lt 100 ]; do
    local adj="${adjs[$((RANDOM % ${#adjs[@]}))]}"
    local noun="${nouns[$((RANDOM % ${#nouns[@]}))]}"
    local candidate="${prefix}-${adj}-${noun}"
    if ! check_container_exists "$candidate" && [ ! -d "$(get_box_home "$candidate")" ]; then
      echo "$candidate"
      return 0
    fi
    attempts=$((attempts + 1))
  done
  echo "${prefix}-box-$RANDOM"
}

calculate_box_port_offset() {
  local target_name="$1"
  if [ "$target_name" = "$CONTAINER_NAME" ]; then
    echo 0
    return 0
  fi
  local runtime
  runtime=$(get_runtime 2>/dev/null || echo "podman")
  if command -v "$runtime" >/dev/null 2>&1 && check_container_exists "$target_name"; then
    local host_port=""
    host_port=$("$runtime" port "$target_name" 6080 2>/dev/null | head -n 1 | awk -F: '{print $NF}' || true)
    if [ -z "$host_port" ]; then
      # shellcheck disable=SC2016
      host_port=$("$runtime" inspect -f '{{range $p, $conf := .HostConfig.PortBindings}}{{if eq $p "6080/tcp"}}{{(index $conf 0).HostPort}}{{end}}{{end}}' "$target_name" 2>/dev/null || true)
    fi
    if [[ "$host_port" =~ ^[0-9]+$ ]] && [ "$host_port" -ge 6080 ]; then
      echo $((host_port - 6080))
      return 0
    fi
  fi

  local used_ports=()
  if command -v "$runtime" >/dev/null 2>&1; then
    while IFS= read -r p; do
      [[ "$p" =~ ^[0-9]+$ ]] && used_ports+=("$p")
    done < <("$runtime" ps -a --format '{{.Ports}}' 2>/dev/null | grep -oE '[0-9]+->6080' | cut -d- -f1 || true)
  fi
  while IFS= read -r p; do
    [[ "$p" =~ ^[0-9]+$ ]] && used_ports+=("$p")
  done < <(ss -tlnH 2>/dev/null | awk '{print $4}' | awk -F: '{print $NF}' || true)

  local offset=1
  while true; do
    local cand=$((6080 + offset))
    local in_use=false
    for up in "${used_ports[@]}"; do
      if [ "$up" -eq "$cand" ] 2>/dev/null; then
        in_use=true
        break
      fi
    done
    if [ "$in_use" = "false" ]; then
      echo "$offset"
      return 0
    fi
    offset=$((offset + 1))
  done
}

purge_box_home() {
  local target_dir="$1"
  [ -z "$target_dir" ] && return 0
  [ ! -d "$target_dir" ] && return 0

  if rm -rf "$target_dir" 2>/dev/null; then
    return 0
  fi

  local runtime
  runtime=$(get_runtime 2>/dev/null || echo "podman")
  if [ "$runtime" = "podman" ] && command -v podman >/dev/null 2>&1; then
    podman unshare rm -rf "$target_dir" 2>/dev/null || rm -rf "$target_dir"
  fi
}

get_all_agy_boxes() {
  local boxes=()
  if command -v distrobox >/dev/null 2>&1; then
    while IFS= read -r b; do
      [ -n "$b" ] && boxes+=("$b")
    done < <(distrobox list --no-color 2>/dev/null | awk -F'|' 'NR>1 {gsub(/^[ \t]+|[ \t]+$/, "", $2); gsub(/^[ \t]+|[ \t]+$/, "", $4); if ($2 ~ /^agy-box/ || $4 ~ /agy-box/) print $2}')
  fi
  local runtime
  runtime=$(get_runtime 2>/dev/null || echo "podman")
  if command -v "$runtime" >/dev/null 2>&1; then
    while IFS= read -r b; do
      [ -n "$b" ] && boxes+=("$b")
    done < <("$runtime" ps -a --format '{{.Names}}' 2>/dev/null | grep -E '^agy-box' || true)

    while IFS= read -r b; do
      [ -n "$b" ] && boxes+=("$b")
    done < <("$runtime" ps -a --filter "label=agy-box.mode=sandbox" --format '{{.Names}}' 2>/dev/null || true)

    while IFS= read -r b; do
      [ -n "$b" ] && boxes+=("$b")
    done < <("$runtime" ps -a --filter "label=manager=agy-box-${runtime}" --format '{{.Names}}' 2>/dev/null || true)
  fi
  if [ ${#boxes[@]} -eq 0 ]; then
    if check_container_exists "$CONTAINER_NAME"; then
      boxes+=("$CONTAINER_NAME")
    fi
    if check_container_exists "$DEV_CONTAINER_NAME"; then
      boxes+=("$DEV_CONTAINER_NAME")
    fi
  fi
  if [ ${#boxes[@]} -gt 0 ]; then
    printf "%s\n" "${boxes[@]}" | sort -u
  fi
}

# --- Antigravity toolchain (per-user, installed inside the box) ---
TOOLCHAIN_INSTALLER="agy-install-toolchain"

# run_step <title> <cmd...>: interactive -> gum spinner, output shown only on
run_step() {
  local title=$1
  shift
  local rc=0
  if command -v gum &>/dev/null && [ -t 1 ] && [ -t 0 ] && [ "${AGY_NONINTERACTIVE:-0}" != "1" ]; then
    local log_file
    log_file=$(mktemp)
        # shellcheck disable=SC2016
    gum spin --spinner dot --title "$title" -- bash -c 'log="$1"; shift; "$@" >"$log" 2>&1' _ "$log_file" "$@" || rc=$?
    if [ "$rc" -ne 0 ]; then cat "$log_file"; fi
    rm -f "$log_file"
  else
    echo "==> $title"
    "$@" || rc=$?
  fi
  return "$rc"
}

# run_step_live <title> <cmd...>:
run_step_live() {
  local title=$1
  shift
  local start_time=$SECONDS
  if [ -t 1 ]; then
    echo -e "${WHITE}==> ${title}${NC}"
  else
    echo "==> $title"
  fi
  local rc=0
  "$@" || rc=$?
  if [ "$rc" -ne 0 ]; then
    ui_error "❌ Failed: $title (exit code $rc)"
    return "$rc"
  fi
  local elapsed=$((SECONDS - start_time))
  if [ -t 1 ]; then
    echo -e "${GREEN}✓ ${title} (${elapsed}s)${NC}"
  else
    echo "✓ ${title} (${elapsed}s)"
  fi
  return 0
}

# update_toolchain_hint <container>: the command a user should run to retry.
update_toolchain_hint() {
  if [ "$1" = "$DEV_CONTAINER_NAME" ]; then
    echo "agy-box-manager update-toolchain dev"
  elif [ "$1" = "$CONTAINER_NAME" ]; then
    echo "agy-box-manager update-toolchain"
  else
    echo "distrobox enter $1 -- $TOOLCHAIN_INSTALLER"
  fi
}

# export_agy_cli <container> <box_home> [export_dir]
export_agy_cli() {
  local name=$1
  local box_home=$2
  local export_dir=${3:-"$HOME/.local/bin"}
  local src="/usr/local/bin/agy"
  if [ -n "$box_home" ] && [ -x "$box_home/.local/bin/agy" ]; then
    src="$box_home/.local/bin/agy"
  fi
  local dest="$export_dir/agy"

  if [ "$src" = "$dest" ]; then
    ui_warn "⚠️  Box home equals host home; '$src' is already on the host. Skipping export."
    return 0
  fi
  if [ -e "$dest" ] && ! grep -qs "distrobox_binary" "$dest"; then
    ui_warn "⚠️  '$dest' already exists and is not a distrobox export (host-native agy?). Leaving it untouched." \
      "   The box's CLI is still available inside the box, or via: distrobox enter $name -- $src"
    return 0
  fi
  if [ -e "$dest" ] && [ "$name" != "$CONTAINER_NAME" ] && ! grep -qsxF "# name: ${name}" "$dest"; then
    ui_warn "⚠️  '$dest' is already exported from primary '$CONTAINER_NAME'. Leaving it untouched." \
      "   The box's CLI is still available inside the box, or via: agy-box-manager enter $name"
    return 0
  fi
  if ! distrobox enter "$name" -- sh -c 'command -v distrobox-export' >/dev/null 2>&1; then
    ui_error "❌ Error: distrobox-export is not available inside '$name'; cannot export the agy CLI."
    return 1
  fi
  if ! run_step "Exporting toolchain CLI 'agy' to host ($export_dir)..." \
    distrobox enter "$name" -- distrobox-export --bin "$src" --export-path "$export_dir"; then
    ui_error "❌ Error: Failed to export toolchain CLI."
    return 1
  fi
  echo "✓ Exported 'agy' CLI shim"
}

# unexport_agy_cli <container> [export_dir]
unexport_agy_cli() {
  local name=$1
  local export_dir=${2:-"$HOME/.local/bin"}
  local dest="$export_dir/agy"
  if [ -f "$dest" ] && grep -qs "distrobox_binary" "$dest" && grep -qsxF "# name: ${name}" "$dest"; then
    rm -f "$dest"
    echo "Removed exported agy CLI shim ($dest)."
  fi
}

# install_toolchain_in_box <container> <box_home> [export_dir]
install_toolchain_in_box() {
  local name=$1
  local box_home=$2
  local export_dir=${3:-"$HOME/.local/bin"}
  if ! distrobox enter "$name" -- test -x /usr/local/bin/agy; then
    if ! run_step "Installing Antigravity toolchain into '$name' (~/.local; this can take a few minutes)..." \
      distrobox enter "$name" -- "$TOOLCHAIN_INSTALLER"; then
      ui_error "❌ Error: Failed to install the Antigravity toolchain inside '$name'." \
        "Retry with: $(update_toolchain_hint "$name")"
      return 1
    fi
  fi
  if ! export_agy_cli "$name" "$box_home" "$export_dir"; then
    ui_error "Retry with: $(update_toolchain_hint "$name")"
    return 1
  fi
}

