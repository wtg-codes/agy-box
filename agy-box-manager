    show_banner
    echo -e "Usage: $0 [command]"
    echo ""
    echo "Commands:"
    echo "  (none)              Launch the interactive UI"
    echo "  wizard [--defaults] Run the first-run configuration wizard"
    echo "  check               Inspect system, container workspaces, toolchain, IDEs & auth"
    echo "  update [prod|dev]   Update toolchain, IDE extensions, and container packages"
    echo "                      Options:"
    echo "                        --all             Update all components (default)"
    echo "                        --toolchain       Update Antigravity toolchain only"
    echo "                        --ides            Update IDE extensions only"
    echo "                        --packages        Upgrade container OS packages only"
    echo "                        --check           Check for updates without modifying"
    echo "  install             Pull the official image and create the environment"
    echo "                      Options:"
    echo "                        -s, --systemd     Enable user-mode systemd support"
    echo "  dev                 Build the image from local source and create dev environment"
    echo "                      Options:"
    echo "                        -s, --systemd     Enable user-mode systemd support"
    echo "  enter               Enter the official environment"
    echo "  enter dev           Enter the development environment"
    echo "  desktop             Launch VDI Web Desktop inside official environment"
    echo "  desktop dev         Launch VDI Web Desktop inside development environment"
    echo "  backup [file]       Back up settings and container state to tar.gz archive"
    echo "  restore <file> [-y] Restore settings and container state from archive"
    echo "  status              List AGY Box environments"
    echo "  ports               Show sandboxed port mappings"
    echo "  doctor              Run system diagnostics health check"
    echo "  clean               Remove the official environment"
    echo "  clean dev           Remove the development environment"
    echo "  update-toolchain    Install/update the Antigravity toolchain (legacy alias)"
    echo "  update-toolchain dev  Same, for the development environment"
