#!/bin/bash
# agy-box-manager - A modern CLI for managing the agy-box Distrobox environment

set -euo pipefail

# --- Configuration ---
VERSION="0.6.0"
IMAGE_NAME="ghcr.io/wtg-codes/agy-box:latest"
DEV_IMAGE_NAME="agy-box:dev"
CONTAINER_NAME="agy-box"
DEV_CONTAINER_NAME="agy-box-dev"
REMOTE_SCRIPT_URL="https://raw.githubusercontent.com/wtg-codes/agy-box/main/agy-box-manager"

# --- Colors for ASCII Art ---
RED=$'\e[0;31m'
GREEN=$'\e[0;32m'
YELLOW=$'\e[1;33m'
BLUE=$'\e[0;34m'
MAGENTA=$'\e[0;35m'
CYAN=$'\e[0;36m'
WHITE=$'\e[1;37m'
NC=$'\e[0m' # No Color

# ui_error/ui_warn/ui_ok: gum styling when available (tests run without gum).
ui_error() {
    if command -v gum &>/dev/null; then gum style --foreground 196 "$@" >&2; else printf '%s\n' "$@" >&2; fi
}
ui_warn() {
    if command -v gum &>/dev/null; then gum style --foreground 214 "$@"; else printf '%s\n' "$@"; fi
}
ui_ok() {
    if command -v gum &>/dev/null; then gum style --foreground 46 "$@"; else printf '%s\n' "$@"; fi
}

# --- Configuration & Paths ---
get_config_dir() { echo "${HOME:-}/.config/agy-box"; }
get_config_file() { echo "${HOME:-}/.config/agy-box/config.env"; }

init_defaults() {
    local silent=${1:-false}
    if [ -z "${HOME:-}" ]; then
        return 0
    fi
    local config_dir
    config_dir=$(get_config_dir)
    local config_file
    config_file=$(get_config_file)
    mkdir -p "$config_dir"
    if [ -f "$config_file" ]; then
        return 0
    fi

    local default_runtime="podman"
    if [ -n "${DBX_CONTAINER_MANAGER:-}" ] && command -v "$DBX_CONTAINER_MANAGER" >/dev/null 2>&1; then
        default_runtime="$DBX_CONTAINER_MANAGER"
    elif command -v podman >/dev/null 2>&1; then
        default_runtime="podman"
    elif command -v docker >/dev/null 2>&1; then
        default_runtime="docker"
    fi

    cat <<EOF > "$config_file"
# ==============================================================================
# agy-box User Configuration
# Generated by agy-box-manager wizard
# ==============================================================================
# Container runtime engine ("podman" or "docker")
AGY_CONTAINER_MANAGER="${default_runtime}"

# Keyring credential security mode ("host" or "isolated")
#   host:     Shares host D-Bus Secret Service for seamless single sign-on
#   isolated: Uses encrypted container-local file keyring (air-gapped credentials)
AGY_KEYRING_MODE="host"

# Antigravity agent authentication method ("oauth", "api-key", "service-account")
AGY_AUTH_METHOD="oauth"

# Default preferred editor inside container ("code", "zed", "jetbrains", "none")
AGY_DEFAULT_IDE="code"

# Host profile seeding ("true" to mount ~/.gitconfig, ~/.ssh, ~/.config/gcloud; "false" for pristine isolation)
AGY_PROFILE_SEEDING="false"

# Anonymous telemetry opt-in ("false" for privacy-first default)
AGY_TELEMETRY="false"
EOF

    if [ "$silent" != "silent" ] && [ "$silent" != "true" ]; then
        ui_ok "✓ Initialized default configuration at $config_file"
    fi
}

load_config() {
    if [ -z "${HOME:-}" ]; then
        return 0
    fi
    local config_file
    config_file=$(get_config_file)

    if [ ! -f "$config_file" ]; then
        init_defaults "silent"
    fi

    if [ -f "$config_file" ]; then
        while IFS='=' read -r key val || [ -n "$key" ]; do
            key=$(echo "$key" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
            [[ -z "$key" || "$key" =~ ^# ]] && continue
            val=$(echo "$val" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
            val="${val%\"}"
            val="${val#\"}"
            val="${val%\'}"
            val="${val#\'}"
            case "$key" in
                AGY_CONTAINER_MANAGER) AGY_CONTAINER_MANAGER="$val" ;;
                AGY_KEYRING_MODE)      AGY_KEYRING_MODE="$val" ;;
                AGY_AUTH_METHOD)       AGY_AUTH_METHOD="$val" ;;
                AGY_DEFAULT_IDE)       AGY_DEFAULT_IDE="$val" ;;
                AGY_PROFILE_SEEDING)   AGY_PROFILE_SEEDING="$val" ;;
                AGY_TELEMETRY)         AGY_TELEMETRY="$val" ;;
            esac
        done < "$config_file"
    fi

    : "${AGY_CONTAINER_MANAGER:=podman}"
    : "${AGY_KEYRING_MODE:=host}"
    : "${AGY_AUTH_METHOD:=oauth}"
    : "${AGY_DEFAULT_IDE:=code}"
    : "${AGY_PROFILE_SEEDING:=false}"
    : "${AGY_TELEMETRY:=false}"

    if [ -z "${DBX_CONTAINER_MANAGER:-}" ] && [ -n "${AGY_CONTAINER_MANAGER:-}" ] && command -v "$AGY_CONTAINER_MANAGER" >/dev/null 2>&1; then
        export DBX_CONTAINER_MANAGER="$AGY_CONTAINER_MANAGER"
    fi
}

apply_keyring_configuration() {
    if [ -z "${HOME:-}" ]; then
        return 0
    fi
    local iso_home="$HOME/.config/agy-box/home"
    mkdir -p "$iso_home/.config/python_keyring"
    mkdir -p "$iso_home/.config/environment.d"
    mkdir -p "$iso_home/.local/share/keyrings"

    if [ "${AGY_KEYRING_MODE:-host}" = "isolated" ]; then
        cat <<EOF > "$iso_home/.config/python_keyring/keyringrc.cfg"
[backend]
default-keyring=keyrings.alt.file.EncryptedKeyring
EOF
        cat <<EOF > "$iso_home/.config/environment.d/keyring.conf"
PYTHON_KEYRING_BACKEND=keyrings.alt.file.EncryptedKeyring
EOF
    else
        rm -f "$iso_home/.config/python_keyring/keyringrc.cfg"
        rm -f "$iso_home/.config/environment.d/keyring.conf"
    fi
}

# --- Helper Functions ---
get_os_name() {
    if [ -f /etc/os-release ]; then
        # shellcheck disable=SC1091
        . /etc/os-release
        echo "${PRETTY_NAME:-Linux}"
    else
        echo "Linux"
    fi
}

probe_host_capabilities() {
    local mode=${1:-}
    load_config
    if [ -n "${DBX_CONTAINER_MANAGER:-}" ] && command -v "$DBX_CONTAINER_MANAGER" >/dev/null 2>&1; then
        export DBX_CONTAINER_MANAGER
    elif [ -n "${AGY_CONTAINER_MANAGER:-}" ] && command -v "$AGY_CONTAINER_MANAGER" >/dev/null 2>&1; then
        export DBX_CONTAINER_MANAGER="$AGY_CONTAINER_MANAGER"
    elif command -v podman >/dev/null 2>&1; then
        export DBX_CONTAINER_MANAGER="podman"
    elif command -v docker >/dev/null 2>&1; then
        export DBX_CONTAINER_MANAGER="docker"
    elif [ "$mode" != "menu" ] && [ "$mode" != "optional" ]; then
        if command -v gum >/dev/null 2>&1; then
            gum style --foreground 196 --border rounded --padding "0 2" --margin "1 0" \
                "❌ ERROR: No container runtime found!" \
                "Please install either Podman (Highly Recommended) or Docker."
        else
            echo -e "${RED}❌ ERROR: No container runtime found!${NC}\nPlease install either Podman (Highly Recommended) or Docker." >&2
        fi
        exit 1
    fi

    if [ "${DBX_CONTAINER_MANAGER:-}" = "docker" ] && [ "$mode" != "menu" ] && [ "$mode" != "optional" ]; then
        # Check if Docker daemon is running and user has access
        if ! docker info >/dev/null 2>&1; then
            if command -v gum >/dev/null 2>&1; then
                gum style --foreground 196 --border rounded --padding "0 2" --margin "1 0" \
                    "❌ ERROR: Docker daemon is unreachable!" \
                    "Please check if the Docker service is active, or add your user" \
                    "to the 'docker' Unix group:" \
                    "  sudo usermod -aG docker $USER" \
                    "You may need to log out and log back in for changes to apply."
            else
                echo -e "${RED}❌ ERROR: Docker daemon is unreachable!${NC}\nPlease check if Docker service is active, or add your user to 'docker' group: sudo usermod -aG docker \$USER" >&2
            fi
        elif ! docker info 2>/dev/null | grep -q "rootless"; then
            if command -v gum >/dev/null 2>&1; then
                gum style --foreground 214 --border rounded --padding "0 2" --margin "1 0" \
                    "⚠️ CAUTION: Rootful Docker detected!" \
                    "Since standard Docker runs as a root daemon, files written to" \
                    "your mounted home directory may be saved with root ownership." \
                    "Consider setting up rootless Docker or installing Podman."
            else
                echo -e "${YELLOW}⚠️ CAUTION: Rootful Docker detected! Files written to mounted home may have root ownership.${NC}" >&2
            fi
        fi
    fi
}

# --- Dependency Management ---
install_gum() {
    if [ ! -t 0 ]; then
        return 0
    fi
    echo -e "${CYAN}Gum is required for the UI but is not installed.${NC}"
    # When piped via curl, read needs to be forced to /dev/tty if available
    if [ -e /dev/tty ]; then
        exec < /dev/tty 2>/dev/null || true
    fi
    read -r -p "Would you like to attempt to install it now? (y/N): " choice
    if [[ "$choice" =~ ^[Yy]$ ]]; then
        if command -v brew &> /dev/null; then
            echo "Installing via Homebrew (Recommended for immutable systems)..."
            brew install gum
        elif command -v apt-get &> /dev/null; then
            echo "Installing via APT (Debian/Ubuntu)..."
            sudo mkdir -p /etc/apt/keyrings
            curl -fsSL https://repo.charm.sh/apt/gpg.key | sudo gpg --dearmor -o /etc/apt/keyrings/charm.gpg
            echo "deb [signed-by=/etc/apt/keyrings/charm.gpg] https://repo.charm.sh/apt/ * *" | sudo tee /etc/apt/sources.list.d/charm.list
            sudo apt update && sudo apt install -y gum
        elif command -v dnf &> /dev/null; then
            echo "Installing via DNF (Fedora/RHEL)..."
            echo '[charm]
name=Charm
baseurl=https://repo.charm.sh/yum/
enabled=1
gpgcheck=1
gpgkey=https://repo.charm.sh/yum/gpg.key' | sudo tee /etc/yum.repos.d/charm.repo
            sudo dnf install -y gum
        elif command -v pacman &> /dev/null; then
            echo "Installing via Pacman (Arch/Manjaro)..."
            sudo pacman -S --noconfirm gum
        elif command -v zypper &> /dev/null; then
            echo "Installing via Zypper (openSUSE)..."
            echo '[charm]
name=Charm
baseurl=https://repo.charm.sh/yum/
enabled=1
gpgcheck=1
gpgkey=https://repo.charm.sh/yum/gpg.key' | sudo tee /etc/zypp/repos.d/charm.repo
            sudo zypper install -y gum
        else
            echo -e "${RED}Could not detect supported package manager (brew, apt, dnf, pacman, zypper).${NC}"
            echo "Please install manually: https://github.com/charmbracelet/gum#installation"
            exit 1
        fi
    else
        echo "Gum is required to run this script interactively. Exiting."
        exit 1
    fi
}

check_deps() {
    local mode=${1:-}
    if ! command -v gum &> /dev/null; then
        if [ "$mode" != "quiet" ] && [ "$mode" != "optional" ] && [ -t 0 ]; then
            install_gum
        fi
    fi

    # Initialize container engine binding
    probe_host_capabilities "$mode"

    if [ "$mode" = "menu" ] || [ "$mode" = "optional" ]; then
        return 0
    fi

    local missing=0
    if ! command -v distrobox &> /dev/null; then
        echo -e "${RED}✗ Error: distrobox is not installed on the host system.${NC}" >&2
        missing=1
    fi
    if ! command -v podman &> /dev/null && ! command -v docker &> /dev/null; then
        echo -e "${RED}✗ Error: Neither podman nor docker is installed on the host system.${NC}" >&2
        missing=1
    fi
    if [ $missing -eq 1 ]; then
        if [ "$mode" != "quiet" ] && [ -t 0 ] && [ -e /dev/tty ] && command -v gum &> /dev/null; then
            echo -e "\n${CYAN}Would you like to try installing the missing container dependencies now?${NC}"
            exec < /dev/tty 2>/dev/null || true
            if gum confirm "Install missing dependencies?"; then
                if command -v apt-get &> /dev/null; then
                    sudo apt update && sudo apt install -y podman distrobox
                elif command -v dnf &> /dev/null; then
                    sudo dnf install -y podman distrobox
                elif command -v pacman &> /dev/null; then
                    sudo pacman -S --noconfirm podman distrobox
                elif command -v zypper &> /dev/null; then
                    sudo zypper install -y podman distrobox
                elif command -v brew &> /dev/null; then
                    brew install podman distrobox
                else
                    echo -e "${RED}Could not detect a supported package manager. Please install manually.${NC}"
                    echo "Tip: You can install Distrobox without root via:"
                    echo "  curl -s https://raw.githubusercontent.com/89luca89/distrobox/main/install | sh -s -- --prefix ~/.local"
                    exit 1
                fi

                # Re-check dependencies
                if ! command -v distrobox &> /dev/null || (! command -v podman &> /dev/null && ! command -v docker &> /dev/null); then
                    echo -e "${RED}Dependencies still missing after installation attempt. Please install manually.${NC}"
                    echo "Tip: You can install Distrobox without root via:"
                    echo "  curl -s https://raw.githubusercontent.com/89luca89/distrobox/main/install | sh -s -- --prefix ~/.local"
                    exit 1
                else
                    echo -e "${CYAN}Dependencies installed successfully!${NC}"
                fi
            else
                echo -e "\nPlease install the missing container dependencies and try again."
                echo "Tip: You can install Distrobox without root via:"
                echo "  curl -s https://raw.githubusercontent.com/89luca89/distrobox/main/install | sh -s -- --prefix ~/.local"
                exit 1
            fi
        else
            echo -e "${YELLOW}Please install distrobox and podman/docker to proceed.${NC}" >&2
            echo "Tip: You can install Distrobox without root via:" >&2
            echo "  curl -s https://raw.githubusercontent.com/89luca89/distrobox/main/install | sh -s -- --prefix ~/.local" >&2
            exit 1
        fi
    fi
}

detect_runtime() {
    load_config
    if [ -n "${DBX_CONTAINER_MANAGER:-}" ] && command -v "$DBX_CONTAINER_MANAGER" >/dev/null 2>&1; then
        echo "$DBX_CONTAINER_MANAGER"
    elif [ -n "${AGY_CONTAINER_MANAGER:-}" ] && command -v "$AGY_CONTAINER_MANAGER" >/dev/null 2>&1; then
        echo "$AGY_CONTAINER_MANAGER"
    elif command -v podman >/dev/null 2>&1; then
        echo "podman"
    else
        echo "docker"
    fi
}

get_runtime() {
    detect_runtime
}

check_container_exists() {
    local name=$1
    local runtime
    runtime=$(get_runtime)
    if "$runtime" ps -a --format '{{.Names}}' 2>/dev/null | grep -qw "$name"; then return 0; else return 1; fi
}

# --- Antigravity toolchain (per-user, installed inside the box) ---
# The toolchain (Agent UI, IDE, agy CLI, SDK, ADK, Gemini CLI) is not baked into
# the image. The image ships the installer `agy-install-toolchain`, which installs
# into the box user's ~/.local. Boxes are created with an isolated --home, so the
# box's ~/.local/bin/agy lives under that isolated home dir, which distrobox mounts
# at the same absolute path on the host and in the box. Paths below are therefore
# always computed from the box home passed in, never from the host's $HOME.
# scripts/test-box.sh sources this file and calls these same functions in CI.
TOOLCHAIN_INSTALLER="agy-install-toolchain"


# run_step <title> <cmd...>: interactive -> gum spinner, output shown only on
# failure (existing install UX). Non-interactive (CI/tests) -> stream output.
run_step() {
    local title=$1
    shift
    local rc=0
    if command -v gum &>/dev/null && [ -t 1 ]; then
        local log_file
        log_file=$(mktemp)
        gum spin --spinner dot --title "$title" -- "$@" >"$log_file" 2>&1 || rc=$?
        if [ "$rc" -ne 0 ]; then cat "$log_file"; fi
        rm -f "$log_file"
    else
        echo "==> $title"
        "$@" || rc=$?
    fi
    return "$rc"
}

# update_toolchain_hint <container>: the command a user should run to retry.
update_toolchain_hint() {
    if [ "$1" = "$DEV_CONTAINER_NAME" ]; then
        echo "agy-box-manager update-toolchain dev"
    elif [ "$1" = "$CONTAINER_NAME" ]; then
        echo "agy-box-manager update-toolchain"
    else
        echo "distrobox enter $1 -- $TOOLCHAIN_INSTALLER"
    fi
}

# export_agy_cli <container> <box_home> [export_dir]
# Exports the box's /usr/local/bin/agy (or ~/.local/bin/agy) as a host shim in
# export_dir (default: the host's ~/.local/bin). Never overwrites a host `agy`
# that is not a distrobox shim.
export_agy_cli() {
    local name=$1
    local box_home=$2
    local export_dir=${3:-"$HOME/.local/bin"}
    local src="/usr/local/bin/agy"
    if [ -n "$box_home" ] && [ -x "$box_home/.local/bin/agy" ]; then
        src="$box_home/.local/bin/agy"
    fi
    local dest="$export_dir/agy"

    if [ "$src" = "$dest" ]; then
        # Box shares the host home: agy is already at the host path; exporting
        # would replace the real binary with a shim that calls itself.
        ui_warn "⚠️  Box home equals host home; '$src' is already on the host. Skipping export."
        return 0
    fi
    if [ -e "$dest" ] && ! grep -qs "distrobox_binary" "$dest"; then
        ui_warn "⚠️  '$dest' already exists and is not a distrobox export (host-native agy?). Leaving it untouched." \
            "   The box's CLI is still available inside the box, or via: distrobox enter $name -- $src"
        return 0
    fi
    if ! distrobox enter "$name" -- sh -c 'command -v distrobox-export' >/dev/null 2>&1; then
        ui_error "❌ Error: distrobox-export is not available inside '$name'; cannot export the agy CLI."
        return 1
    fi
    if ! run_step "Exporting toolchain CLI 'agy' to host ($export_dir)..." \
        distrobox enter "$name" -- distrobox-export --bin "$src" --export-path "$export_dir"; then
        ui_error "❌ Error: Failed to export toolchain CLI."
        return 1
    fi
}

# unexport_agy_cli <container> [export_dir]
# Removes the host agy shim if (and only if) it was exported from <container>.
# Done host-side so it works even if the box is broken or the toolchain missing.
unexport_agy_cli() {
    local name=$1
    local export_dir=${2:-"$HOME/.local/bin"}
    local dest="$export_dir/agy"
    if [ -f "$dest" ] && grep -qs "distrobox_binary" "$dest" && grep -qsxF "# name: ${name}" "$dest"; then
        rm -f "$dest"
        echo "Removed exported agy CLI shim ($dest)."
    fi
}

# install_toolchain_in_box <container> <box_home> [export_dir]
# Ensures the agy CLI is exported to the host. If the toolchain is pre-baked
# (/usr/local/bin/agy exists), exports immediately. Otherwise falls back to running
# the in-image installer.
install_toolchain_in_box() {
    local name=$1
    local box_home=$2
    local export_dir=${3:-"$HOME/.local/bin"}
    if ! distrobox enter "$name" -- test -x /usr/local/bin/agy 2>/dev/null; then
        if ! run_step "Installing Antigravity toolchain into '$name' (~/.local; this can take a few minutes)..." \
            distrobox enter "$name" -- "$TOOLCHAIN_INSTALLER"; then
            ui_error "❌ Error: Failed to install the Antigravity toolchain inside '$name'." \
                "Retry with: $(update_toolchain_hint "$name")"
            return 1
        fi
    fi
    if ! export_agy_cli "$name" "$box_home" "$export_dir"; then
        ui_error "Retry with: $(update_toolchain_hint "$name")"
        return 1
    fi
}

