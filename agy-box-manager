  gum choose --cursor="➜ " --cursor.foreground="212" --selected.foreground="212" --item.foreground="250" "$@"
}

cmd_interactive() {
  clear
  show_banner
  check_deps "menu"

  local splash_choice
  splash_choice=$(choose_option "🚀 Enter Main Menu" "🔍 Check System & Component Status" "📊 View Host System Info & Dependencies" "❌ Exit")

  case "$splash_choice" in
    "🔍 Check System & Component Status")
      clear
      show_compact_banner
      cmd_doctor
      echo ""
      pause_key
      ;;
    "📊 View Host System Info & Dependencies")
      clear
      show_compact_banner
      gum spin --spinner dot --title "Analyzing system dependencies and status..." -- sleep 0.5
      check_deps "quiet"
      show_system_status
      echo ""
      pause_key
      ;;
    "❌ Exit")
      gum style --foreground 212 "Goodbye!"
      exit 0
      ;;
  esac

  local menu_state="main"
  while true; do
    case "$menu_state" in
      "main")
        clear
        show_compact_banner
        show_compact_status

        local main_options=(
          "🚪 Workspaces (Enter/VDI Desktop) >"
          "🛠️  Manage Environments >"
          "⚙️  System Tools >"
          "❌ Exit"
        )

        local choice
        choice=$(choose_option "${main_options[@]}")

        case "$choice" in
          "🚪 Workspaces (Enter/VDI Desktop) >")
            menu_state="workspaces"
            ;;
          "🛠️  Manage Environments >")
            menu_state="manage"
            ;;
          "⚙️  System Tools >")
            menu_state="tools"
            ;;
          "❌ Exit")
            gum style --foreground 212 "Goodbye!"
            exit 0
            ;;
        esac
        ;;

      "workspaces")
        clear
        show_compact_banner
        show_compact_status

        local workspace_options=()
        local all_boxes=()
        while IFS= read -r b; do
          [ -n "$b" ] && all_boxes+=("$b")
        done < <(get_all_agy_boxes)
        [ ${#all_boxes[@]} -eq 0 ] && all_boxes=("$CONTAINER_NAME" "$DEV_CONTAINER_NAME")

        for b in "${all_boxes[@]}"; do
          if check_container_exists "$b"; then
            workspace_options+=("🚪 Enter $b")
            if is_vdi_running "$b"; then
              workspace_options+=("🟢 Manage / Stop VDI Web Desktop ($b)")
            else
              workspace_options+=("🖥️  Start VDI Web Desktop ($b)")
            fi
          fi
        done

        workspace_options+=("🔙 Back to Main Menu")
        local sub_choice
        sub_choice=$(choose_option "${workspace_options[@]}")

        case "$sub_choice" in
          "🚪 Enter "*)
            cmd_enter "${sub_choice#🚪 Enter }"
            pause_key
            ;;
          *"Web Desktop ("*)
            local target="${sub_choice#*Web Desktop (}"
            target="${target%)}"
            cmd_desktop "$target"
            ;;
          *)
            menu_state="main"
            ;;
        esac
        ;;

      "manage")
        clear
        show_compact_banner
        show_compact_status

        local manage_options=()
        local existing_boxes=()
        if check_container_exists "$CONTAINER_NAME"; then
          existing_boxes+=("$CONTAINER_NAME")
        else
          manage_options+=("🚀 Install Primary Workspace ($CONTAINER_NAME)")
        fi

        if check_container_exists "$DEV_CONTAINER_NAME"; then
          existing_boxes+=("$DEV_CONTAINER_NAME")
        elif [ -f "Containerfile" ]; then
          manage_options+=("🛠️  Build Dev Workspace (From local source)")
        fi

        local custom_boxes=()
        while IFS= read -r b; do
          if [ -n "$b" ] && [ "$b" != "$CONTAINER_NAME" ] && [ "$b" != "$DEV_CONTAINER_NAME" ]; then
            custom_boxes+=("$b")
            existing_boxes+=("$b")
          fi
        done < <(get_all_agy_boxes)

        if [ ${#existing_boxes[@]} -gt 0 ]; then
          manage_options+=("🔄 Update Box Apps & OS...")
        fi

        manage_options+=("➕ Create New Box")

        if check_container_exists "$CONTAINER_NAME"; then
          manage_options+=("🗑️  Remove Primary Workspace ($CONTAINER_NAME)")
        fi
        if check_container_exists "$DEV_CONTAINER_NAME"; then
          manage_options+=("🗑️  Remove Dev Workspace ($DEV_CONTAINER_NAME)")
        fi
        if [ ${#custom_boxes[@]} -gt 0 ]; then
          manage_options+=("🗑️  Remove Named Box...")
        fi

        manage_options+=("📁 Manage Preserved Box Data...")
        manage_options+=("🔙 Back to Main Menu")

        local sub_choice
        sub_choice=$(choose_option "${manage_options[@]}")

        case "$sub_choice" in
          "🚀 Install Primary Workspace"*)
            cmd_install_official
            pause_key
            menu_state="workspaces"
            ;;
          "🛠️  Build Dev Workspace"*)
            cmd_build_dev
            pause_key
            menu_state="workspaces"
            ;;
          "🔄 Update Box Apps & OS...")
            clear
            show_compact_banner
            local target_box="$CONTAINER_NAME"
            if [ ${#existing_boxes[@]} -gt 1 ]; then
              target_box=$(choose_option "${existing_boxes[@]}" "🔙 Cancel")
            elif [ ${#existing_boxes[@]} -eq 1 ]; then
              target_box="${existing_boxes[0]}"
            fi
            if [ -n "$target_box" ] && [ "$target_box" != "🔙 Cancel" ]; then
              local upd_choice
              upd_choice=$(choose_option \
                "🔄 Update Everything (Apps, Toolchain & OS Packages)" \
                "🧰 Update Apps & Antigravity Toolchain Only" \
                "🐧 Update Container OS Packages Only" \
                "🔙 Cancel")
              case "$upd_choice" in
                "🔄 Update Everything"*) cmd_update "$target_box" --all ;;
                "🧰 Update Apps"*) cmd_update "$target_box" --toolchain --ides ;;
                "🐧 Update Container"*) cmd_update "$target_box" --packages ;;
              esac
            fi
            pause_key
            ;;
          "➕ Create New Box")
            clear
            show_compact_banner
            local new_name
            new_name=$(generate_box_name "$CONTAINER_NAME")
            echo -e "${CYAN}📦 New Box: ${GREEN}$new_name${CYAN} (name is permanent once created)${NC}\n"
            local mode_choice
            mode_choice=$(choose_option \
              "sandbox (Isolated Sandbox - Clean room, air-gapped credentials) [Recommended]" \
              "workstation (Integrated Workstation - Host desktop & SSO)")
            local chosen_mode="sandbox"
            if [[ "$mode_choice" =~ workstation ]]; then
              chosen_mode="workstation"
            fi
            cmd_install_official --name "$new_name" --mode "$chosen_mode"
            pause_key
            menu_state="workspaces"
            ;;
          "🗑️  Remove Primary Workspace"*)
            cmd_clean "$CONTAINER_NAME"
            pause_key
            ;;
          "🗑️  Remove Dev Workspace"*)
            cmd_clean "$DEV_CONTAINER_NAME"
            pause_key
            ;;
          "📁 Manage Preserved Box Data...")
            clear
            show_compact_banner
            echo -e "${CYAN}Manage Preserved Box Data Directories${NC}\n"
            local homes_dir="$HOME/.config/agy-box/homes"
            local orphaned=()
            if [ -d "$homes_dir" ]; then
              for d in "$homes_dir"/*; do
                if [ -d "$d" ]; then
                  local b_name
                  b_name=$(basename "$d")
                  if ! check_container_exists "$b_name" && ! check_container_exists "agy-box-$b_name"; then
                    local sz
                    sz=$(du -sh "$d" 2>/dev/null | cut -f1 || echo "N/A")
                    orphaned+=("$b_name ($sz)")
                  fi
                fi
              done
            fi
            if [ ${#orphaned[@]} -gt 0 ]; then
              echo "Select a preserved data directory to purge:"
              local selected_orphan
              selected_orphan=$(choose_option "${orphaned[@]}" "🗑️  Purge All Preserved Data" "🔙 Cancel")
              if [ "$selected_orphan" = "🗑️  Purge All Preserved Data" ]; then
                if gum confirm "Are you sure you want to purge ALL preserved box data directories?"; then
                  for item in "${orphaned[@]}"; do
                    local dir_name="${item%% *}"
                    purge_box_home "${homes_dir:?}/${dir_name:?}"
                  done
                  ui_ok "✓ All preserved data directories purged."
                fi
              elif [ -n "$selected_orphan" ] && [ "$selected_orphan" != "🔙 Cancel" ]; then
                local dir_name="${selected_orphan%% *}"
                if gum confirm "Permanently delete $homes_dir/$dir_name?"; then
                  purge_box_home "${homes_dir:?}/${dir_name:?}"
                  ui_ok "✓ Removed $homes_dir/$dir_name"
                fi
              fi
            else
              gum style --foreground 214 "No preserved or orphaned box data directories found."
            fi
            pause_key
            ;;
          "🗑️  Remove Named Box...")
            clear
            show_compact_banner
            echo -e "${CYAN}Select a Named AGY Box to Remove:${NC}\n"
            local box_to_remove
            box_to_remove=$(choose_option "${custom_boxes[@]}" "🔙 Cancel")
            if [ -n "$box_to_remove" ] && [ "$box_to_remove" != "🔙 Cancel" ]; then
              cmd_clean "$box_to_remove"
            fi
            pause_key
            ;;
          "🔙 Back to Main Menu")
            menu_state="main"
            ;;
        esac
        ;;

      "tools")
        clear
        show_compact_banner
        show_compact_status

        local tools_options=()
        tools_options+=("🧙 Run First-Run Setup Wizard")
        tools_options+=("🔍 Check System & Component Status")
        tools_options+=("🔄 Update Environment & Toolchain")
        tools_options+=("💾 Backup Settings & Workspace State")
        tools_options+=("📥 Restore Settings from Backup")
        tools_options+=("📊 Show Distrobox List")
        tools_options+=("🔌 Show Port Mappings")

        if [ -f "$HOME/.local/bin/agy-box-manager" ]; then
          tools_options+=("🔥 Uninstall CLI Globally")
        else
          tools_options+=("🌍 Install CLI Globally (~/.local/bin)")
        fi

        tools_options+=("🔙 Back to Main Menu")

        local sub_choice
        sub_choice=$(choose_option "${tools_options[@]}")

        case "$sub_choice" in
          "🧙 Run First-Run Setup Wizard")
            cmd_wizard
            pause_key
            ;;
          "🔍 Check System & Component Status")
            cmd_doctor
            pause_key
            ;;
          "🔄 Update Environment & Toolchain")
            cmd_update prod --all
            pause_key
            ;;
          "💾 Backup Settings & Workspace State")
            cmd_backup
            pause_key
            ;;
          "📥 Restore Settings from Backup")
            echo -n "Enter path to backup archive (.tar.gz): "
            read -r restore_path
            if [ -n "$restore_path" ]; then
              cmd_restore "$restore_path"
            fi
            pause_key
            ;;
          "📊 Show Distrobox List")
            cmd_status
            read -n 1 -s -r -p "Press any key to continue..."
            ;;
          "🔌 Show Port Mappings")
            cmd_ports
            read -n 1 -s -r -p "Press any key to continue..."
            ;;
          "🌍 Install CLI Globally (~/.local/bin)")
            cmd_install_global
            pause_key
            ;;
          "🔥 Uninstall CLI Globally")
            cmd_uninstall_global
            pause_key
            ;;
          "🔙 Back to Main Menu")
            menu_state="main"
            ;;
        esac
        ;;
    esac
  done
}

show_help() {
  show_banner
  cat << EOF
Usage: $0 [command]

Commands:
  (none)                    Launch interactive UI
  wizard [--defaults]       Run first-run configuration wizard
  update [name|prod|dev]    Update toolchain, IDE extensions, container packages
  install [opts]            Pull official image and create environment (-n, -i, --home, -s, -y)
  dev [opts]                Build dev image from local source (-s, --enter, --no-enter)
  enter [name|dev|prod]     Enter environment (default: agy-box)
  desktop [name|dev|prod]   Launch VDI Web Desktop (-p, -r, -d, --stop, --status)
  backup [file]             Back up settings and container state to tar.gz
  restore <file> [-y]       Restore settings and container state from archive
  status                    List all AGY Box environments and homes
  ports                     Show sandboxed port mappings
  doctor (alias: check)     Health checks and environment inventory
  clean [name|dev|prod]     Remove environment (-p, --purge)
EOF
  echo "  update-toolchain [name]   Install/update Antigravity toolchain in container"
  cat << EOF
  install-global            Copy CLI to ~/.local/bin for system-wide access
  uninstall-global          Remove globally installed CLI and completions
  autocomplete [sh]         Generate shell autocompletions (bash, zsh, fish)
  test                      Run local integration test suite
EOF
}

if (return 0 2>/dev/null); then
  return 0
fi

# --- Main Logic ---
setup_completions

cmd="${1:-}"
if [ -z "$cmd" ] && [[ "${0:-}" =~ ^(-v|--version|version)$ ]]; then
 cmd="$0"
fi

case "$cmd" in
  wizard)           check_deps "optional"; cmd_wizard "${@:2}" ;;
  check|doctor)     check_deps "optional"; cmd_doctor ;;
  update)           check_deps "optional"; cmd_update "${@:2}" ;;
  backup)           check_deps "optional"; cmd_backup "${@:2}" ;;
  restore)          check_deps "optional"; cmd_restore "${@:2}" ;;
  install)          check_deps "quiet"; cmd_install_official "${@:2}" ;;
  dev)              check_deps "quiet"; cmd_build_dev "${@:2}" ;;
  enter)            check_deps "quiet"; cmd_enter "${@:2}" ;;
  desktop)          check_deps "quiet"; cmd_desktop "${@:2}" ;;
  clean)            check_deps "quiet"; cmd_clean "${@:2}" ;;
  update-toolchain) check_deps "quiet"; cmd_update_toolchain "${@:2}" ;;
  status)           check_deps "optional"; cmd_status ;;
  ports)            check_deps "quiet"; cmd_ports ;;
  install-global)   check_deps "optional"; cmd_install_global ;;
  uninstall-global) check_deps "optional"; cmd_uninstall_global "${@:2}" ;;
  autocomplete)     cmd_autocomplete "${2:-bash}" ;;
  test)             check_deps "quiet"; if [ -f "scripts/test-box.sh" ]; then ./scripts/test-box.sh; else echo -e "${RED}Test script not found. Please run this command inside the repository.${NC}"; exit 1; fi ;;
  version|--version|-v) echo "agy-box-manager version $VERSION"; exit 0 ;;
  help|--help|-h)   show_help ;;
  "")               cmd_interactive ;;
  *)                if command -v gum >/dev/null 2>&1; then gum style --foreground 196 "Unknown command: $1"; else echo -e "${RED}Unknown command: $1${NC}"; fi; echo ""; show_help; exit 1 ;;
esac
