}

run_step() {
  local title=$1
  shift
  local start_s=$SECONDS rc=0 cmd_str="$*"
  local LOG_TARGETS=()
  collect_log_targets
  log_write "[$(log_ts)] [CMD] $cmd_str"
  if command -v gum &>/dev/null && [ -t 1 ] && [ -t 0 ] && [ "${AGY_NONINTERACTIVE:-0}" != "1" ]; then
    local log_file
    log_file=$(mktemp)
    # shellcheck disable=SC2016
    gum spin --spinner dot --title "$title" -- bash -c 'log="$1"; shift; "$@" >"$log" 2>&1' _ "$log_file" "$@" || rc=$?
    if [ ${#LOG_TARGETS[@]} -gt 0 ] && [ -s "$log_file" ]; then
      tee -a "${LOG_TARGETS[@]}" < "$log_file" >/dev/null 2>&1 || true
    fi
    if [ "$rc" -ne 0 ]; then cat "$log_file"; fi
    rm -f "$log_file"
  else
    echo "==> $title"
    if [ ${#LOG_TARGETS[@]} -gt 0 ]; then
      local had_e=false
      [[ "$-" == *e* ]] && had_e=true
      set +e
      "$@" 2>&1 | tee -a "${LOG_TARGETS[@]}"
      rc=${PIPESTATUS[0]}
      $had_e && set -e
    else
      "$@" || rc=$?
    fi
  fi
  log_write "[$(log_ts)] [EXIT rc=$rc elapsed=$((SECONDS - start_s))s] $cmd_str"
  [ "$rc" -ne 0 ] && print_diag_log_hint
  return "$rc"
}

run_step_live() {
  local title=$1
  shift
  local start_time=$SECONDS rc=0 cmd_str="$*"
  if [ -t 1 ]; then
    echo -e "${WHITE}==> ${title}${NC}"
  else
    echo "==> $title"
  fi
  local LOG_TARGETS=()
  collect_log_targets
  log_write "[$(log_ts)] [CMD] $cmd_str"
  if [ ${#LOG_TARGETS[@]} -gt 0 ]; then
    local had_e=false
    [[ "$-" == *e* ]] && had_e=true
    set +e
    "$@" 2>&1 | tee -a "${LOG_TARGETS[@]}"
    rc=${PIPESTATUS[0]}
    $had_e && set -e
  else
    "$@" || rc=$?
  fi
  local elapsed=$((SECONDS - start_time))
  log_write "[$(log_ts)] [EXIT rc=$rc elapsed=${elapsed}s] $cmd_str"
  if [ "$rc" -ne 0 ]; then
    ui_error "❌ Failed: $title (exit code $rc)"
    print_diag_log_hint
    return "$rc"
  fi
  if [ -t 1 ]; then
    echo -e "${GREEN}✓ ${title} (${elapsed}s)${NC}"
  else
    echo "✓ ${title} (${elapsed}s)"
  fi
  return 0
}

update_toolchain_hint() {
  if [ "$1" = "agy-box-dev" ]; then
    echo "agy-box-manager update-toolchain dev"
  elif [ "$1" = "agy-box" ]; then
    echo "agy-box-manager update-toolchain"
  else
    echo "agy-box-manager update-toolchain $1"
  fi
}

install_toolchain_in_box() {
  local name=$1
  if ! distrobox enter "$name" -- test -x /usr/local/bin/agy; then
    if ! run_step "Installing Antigravity toolchain into '$name' (~/.local; this can take a few minutes)..." \
      distrobox enter "$name" -- "$TOOLCHAIN_INSTALLER"; then
      ui_error "❌ Error: Failed to install the Antigravity toolchain inside '$name'." \
        "Retry with: $(update_toolchain_hint "$name")"
      return 1
    fi
  fi
  return 0
}

