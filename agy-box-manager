#!/bin/bash

set -euo pipefail

# --- Configuration ---
VERSION="0.8.0"
IMAGE_NAME="ghcr.io/wtg-codes/agy-box:latest"
BOX_PREFIX="agy-box"
DEV_BOX_PREFIX="agy-box-dev"
REMOTE_SCRIPT_URL="https://raw.githubusercontent.com/wtg-codes/agy-box/main/agy-box-manager"

# --- Colors ---
RED=$'\e[0;31m'
GREEN=$'\e[0;32m'
YELLOW=$'\e[1;33m'
BLUE=$'\e[0;34m'
MAGENTA=$'\e[0;35m'
CYAN=$'\e[0;36m'
WHITE=$'\e[1;37m'
DIM=$'\e[2m'
NC=$'\e[0m'

ui_error() {
  if command -v gum &>/dev/null; then gum style --foreground 196 "$@" >&2; else printf '%s\n' "$@" >&2; fi
}
ui_warn() {
  if command -v gum &>/dev/null; then gum style --foreground 214 "$@"; else printf '%s\n' "$@"; fi
}
ui_ok() {
  if command -v gum &>/dev/null; then gum style --foreground 46 "$@"; else printf '%s\n' "$@"; fi
}

clear() {
  command clear 2>/dev/null || true
}

pause_key() {
  echo ""
  read -n 1 -s -r -p "Press any key to continue..."
}

# --- Paths, Metadata & Structured Logging ---
get_config_dir() { echo "${HOME:-}/.config/agy-box"; }
get_config_file() { echo "${HOME:-}/.config/agy-box/config.env"; }
get_log_dir() {
  if [ -n "${AGY_LOG_DIR:-}" ]; then
    echo "$AGY_LOG_DIR"
  elif [ -n "${HOME:-}" ]; then
    echo "$HOME/.config/agy-box/logs"
  fi
}

CURRENT_BOX_LOG="${CURRENT_BOX_LOG:-}"
CURRENT_BOX_NAME="${CURRENT_BOX_NAME:-}"

init_logging() {
  local d
  d=$(get_log_dir)
  [ -z "$d" ] && return 0
  mkdir -p "$d" 2>/dev/null || return 0
  chmod 0700 "$d" 2>/dev/null || true
  local mlog="$d/agy-box-manager.log"
  if [ -f "$mlog" ]; then
    local sz
    sz=$(wc -c < "$mlog" 2>/dev/null || echo 0)
    if [ "${sz:-0}" -gt 5242880 ]; then
      mv -f "$mlog" "${mlog}.1" 2>/dev/null || true
    fi
  fi
}

set_box_log_context() {
  CURRENT_BOX_NAME="${1:-}"
  local d
  d=$(get_log_dir)
  if [ -n "$CURRENT_BOX_NAME" ] && [ -n "$d" ]; then
    init_logging
    CURRENT_BOX_LOG="$d/${CURRENT_BOX_NAME}.log"
  else
    CURRENT_BOX_LOG=""
  fi
}

log_ts() { date -u +"%Y-%m-%dT%H:%M:%SZ"; }

collect_log_targets() {
  LOG_TARGETS=()
  init_logging
  local d
  d=$(get_log_dir)
  [ -z "$d" ] && return 0
  local mlog="$d/agy-box-manager.log"
  if touch "$mlog" 2>/dev/null; then
    LOG_TARGETS+=("$mlog")
  fi
  if [ -n "${CURRENT_BOX_LOG:-}" ] && [ "$CURRENT_BOX_LOG" != "$mlog" ] && touch "$CURRENT_BOX_LOG" 2>/dev/null; then
    LOG_TARGETS+=("$CURRENT_BOX_LOG")
  fi
}

log_write() {
  local LOG_TARGETS=()
  collect_log_targets
  [ ${#LOG_TARGETS[@]} -eq 0 ] && return 0
  printf '%s\n' "$*" | tee -a "${LOG_TARGETS[@]}" >/dev/null 2>&1 || true
}

active_log_path() {
  if [ -n "${CURRENT_BOX_LOG:-}" ]; then
    echo "$CURRENT_BOX_LOG"
  else
    local d
    d=$(get_log_dir)
    [ -n "$d" ] && echo "$d/agy-box-manager.log"
  fi
}

print_diag_log_hint() {
  local p
  p=$(active_log_path)
  [ -z "$p" ] && return 0
  echo "📋 Diagnostic log: $p (run: agy-box-manager logs${CURRENT_BOX_NAME:+ $CURRENT_BOX_NAME})" >&2
}

get_box_home() {
  local name="${1:-}"
  if [ "$name" = "agy-box" ] && [ -d "${HOME:-}/.config/agy-box/home" ]; then
    echo "${HOME:-}/.config/agy-box/home"
  else
    echo "${HOME:-}/.config/agy-box/homes/$name"
  fi
}

write_box_meta() {
  local iso_home="$1" name="$2" channel="$3" branch="$4" mode="$5" image="$6"
  local created content
  created=$(log_ts)
  content=$(printf 'AGY_BOX_NAME="%s"\nAGY_BOX_CHANNEL="%s"\nAGY_BOX_BRANCH="%s"\nAGY_BOX_MODE="%s"\nAGY_BOX_IMAGE="%s"\nAGY_BOX_CREATED="%s"\n' \
    "$name" "$channel" "$branch" "$mode" "$image" "$created")
  if printf '%s' "$content" > "$iso_home/.agy-box-meta" 2>/dev/null; then
    return 0
  fi
  if command -v podman >/dev/null 2>&1; then
    podman unshare bash -c 'printf "%s" "$2" > "$1/.agy-box-meta"' _ "$iso_home" "$content" 2>/dev/null || true
  fi
}

read_box_meta_field() {
  local box="$1" key="$2" h
  h=$(get_box_home "$box")
  if [ -r "$h/.agy-box-meta" ]; then
    sed -n "s/^${key}=\"\(.*\)\"$/\1/p" "$h/.agy-box-meta" 2>/dev/null | head -n1
  elif command -v podman >/dev/null 2>&1 && podman unshare test -r "$h/.agy-box-meta" 2>/dev/null; then
    podman unshare sed -n "s/^${key}=\"\(.*\)\"$/\1/p" "$h/.agy-box-meta" 2>/dev/null | head -n1 || true
  fi
}

load_resource_limits() {
  local conf="${HOME:-}/.config/agy-box/limits.conf"
  cpu_limit=""
  memory_limit=""
  if [[ -f "$conf" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      line=$(echo "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/#.*//')
      [[ -z "$line" ]] && continue
      if [[ "$line" =~ ^CPU_LIMIT=(.*)$ ]]; then cpu_limit="${BASH_REMATCH[1]//[\"\']/}"; fi
      if [[ "$line" =~ ^MEMORY_LIMIT=(.*)$ ]]; then memory_limit="${BASH_REMATCH[1]//[\"\']/}"; fi
    done < "$conf"
  fi
}

write_config_file() {
  cat <<EOF > "$1"
# ==============================================================================
# agy-box User Configuration
# ==============================================================================
# Container runtime engine ("podman" or "docker")
AGY_CONTAINER_MANAGER="$2"
AGY_CONTAINER_ENGINE="$2"

# Default workspace mode for new boxes ("sandbox" or "workstation")
AGY_DEFAULT_MODE="$3"

# Keyring credential mode for workstation boxes ("host" or "isolated")
AGY_KEYRING_MODE="$4"

# Default preferred editor inside container ("code", "zed", "none")
AGY_DEFAULT_IDE="$5"

# Host profile seeding ("true" to mount ~/.gitconfig, ~/.ssh, ~/.config/gcloud read-only)
AGY_PROFILE_SEEDING="$6"

# Anonymous telemetry opt-in ("false" for privacy-first default)
AGY_TELEMETRY="false"
EOF
}

init_defaults() {
  local silent=${1:-false}
  [ -z "${HOME:-}" ] && return 0
  local config_dir config_file
  config_dir=$(get_config_dir)
  config_file=$(get_config_file)
  mkdir -p "$config_dir"
  [ -f "$config_file" ] && return 0

  local default_runtime="podman"
  if [ -n "${DBX_CONTAINER_MANAGER:-}" ] && command -v "$DBX_CONTAINER_MANAGER" >/dev/null 2>&1; then
    default_runtime="$DBX_CONTAINER_MANAGER"
  elif command -v podman >/dev/null 2>&1; then
    default_runtime="podman"
  elif command -v docker >/dev/null 2>&1; then
    default_runtime="docker"
  fi

  write_config_file "$config_file" "$default_runtime" "sandbox" "host" "code" "false"

  if [ "$silent" != "silent" ] && [ "$silent" != "true" ]; then
    ui_ok "✓ Initialized default configuration at $config_file"
  fi
}

load_config() {
  [ -z "${HOME:-}" ] && return 0
  local config_file cfg_mode="" legacy_primary=""
  config_file=$(get_config_file)

  if [ ! -f "$config_file" ]; then
    init_defaults "silent"
  fi

  if [ -f "$config_file" ]; then
    while IFS='=' read -r key val || [ -n "$key" ]; do
      key=$(echo "$key" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
      [[ -z "$key" || "$key" =~ ^# ]] && continue
      val=$(echo "$val" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
      val="${val%\"}"
      val="${val#\"}"
      val="${val%\'}"
      val="${val#\'}"
      case "$key" in
        AGY_CONTAINER_MANAGER) AGY_CONTAINER_MANAGER="$val" ;;
        AGY_CONTAINER_ENGINE)  AGY_CONTAINER_ENGINE="$val" ;;
        AGY_DEFAULT_MODE)      cfg_mode="$val"; AGY_DEFAULT_MODE="$val" ;;
        AGY_PRIMARY_ENGINE)    legacy_primary="$val" ;;
        AGY_KEYRING_MODE)      AGY_KEYRING_MODE="$val" ;;
        AGY_AUTH_METHOD)       AGY_AUTH_METHOD="$val" ;;
        AGY_DEFAULT_IDE)       AGY_DEFAULT_IDE="$val" ;;
        AGY_PROFILE_SEEDING)   AGY_PROFILE_SEEDING="$val" ;;
        AGY_TELEMETRY)         AGY_TELEMETRY="$val" ;;
      esac
    done < "$config_file"
  fi

  if [ -z "$cfg_mode" ] && [ -z "${AGY_DEFAULT_MODE:-}" ] && [ -n "$legacy_primary" ]; then
    case "$legacy_primary" in
      distrobox|workstation) AGY_DEFAULT_MODE="workstation" ;;
      podman|docker|sandbox) AGY_DEFAULT_MODE="sandbox" ;;
    esac
  fi
  case "${AGY_DEFAULT_MODE:-sandbox}" in
    distrobox|workstation) AGY_DEFAULT_MODE="workstation" ;;
    podman|docker|sandbox) AGY_DEFAULT_MODE="sandbox" ;;
    *)                     AGY_DEFAULT_MODE="sandbox" ;;
  esac

  : "${AGY_CONTAINER_MANAGER:=podman}"
  : "${AGY_CONTAINER_ENGINE:=$AGY_CONTAINER_MANAGER}"
  : "${AGY_KEYRING_MODE:=host}"
  : "${AGY_AUTH_METHOD:=oauth}"
  : "${AGY_DEFAULT_IDE:=code}"
  : "${AGY_PROFILE_SEEDING:=false}"
  : "${AGY_TELEMETRY:=false}"

  if [ -z "${DBX_CONTAINER_MANAGER:-}" ] && [ -n "${AGY_CONTAINER_MANAGER:-}" ] && command -v "$AGY_CONTAINER_MANAGER" >/dev/null 2>&1; then
    export DBX_CONTAINER_MANAGER="$AGY_CONTAINER_MANAGER"
  fi
}

# --- Host & Runtime Helpers ---
get_os_name() {
  if [ -f /etc/os-release ]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    echo "${PRETTY_NAME:-Linux}"
  else
    echo "Linux"
  fi
}

probe_host_capabilities() {
  local mode=${1:-}
  load_config
  if [ -n "${DBX_CONTAINER_MANAGER:-}" ] && command -v "$DBX_CONTAINER_MANAGER" >/dev/null 2>&1; then
    export DBX_CONTAINER_MANAGER
  elif [ -n "${AGY_CONTAINER_MANAGER:-}" ] && command -v "$AGY_CONTAINER_MANAGER" >/dev/null 2>&1; then
    export DBX_CONTAINER_MANAGER="$AGY_CONTAINER_MANAGER"
  elif command -v podman >/dev/null 2>&1; then
    export DBX_CONTAINER_MANAGER="podman"
  elif command -v docker >/dev/null 2>&1; then
    export DBX_CONTAINER_MANAGER="docker"
  elif [ "$mode" != "menu" ] && [ "$mode" != "optional" ]; then
    ui_error "❌ ERROR: No container runtime found! Please install Podman (Recommended) or Docker."
    exit 1
  fi

  if [ "${DBX_CONTAINER_MANAGER:-}" = "docker" ] && [ "$mode" != "menu" ] && [ "$mode" != "optional" ]; then
    if ! docker info >/dev/null 2>&1; then
      ui_error "❌ ERROR: Docker daemon is unreachable! Check that Docker is running or add your user to the 'docker' group."
    elif ! docker info 2>/dev/null | grep -q "rootless"; then
      ui_warn "⚠️ CAUTION: Rootful Docker detected. Consider rootless Podman or rootless Docker."
    fi
  fi
}

install_gum() {
  [ -t 0 ] || return 0
  if command -v brew &>/dev/null; then
    echo -e "${CYAN}Gum is required for the interactive UI. Installing via Homebrew...${NC}"
    brew install gum && return 0
  fi
  echo -e "${RED}Gum is required for the interactive UI but is not installed.${NC}"
  echo "Install it from https://github.com/charmbracelet/gum#installation and re-run."
  echo "(CLI subcommands such as 'install', 'enter', 'desktop', 'status', and 'logs' work without it.)"
  exit 1
}

check_deps() {
  local mode=${1:-}
  if ! command -v gum &>/dev/null; then
    if [ "$mode" != "quiet" ] && [ "$mode" != "optional" ] && [ -t 0 ]; then
      install_gum
    fi
  fi

  probe_host_capabilities "$mode"

  if [ "$mode" = "menu" ] || [ "$mode" = "optional" ]; then
    return 0
  fi

  if ! command -v podman &>/dev/null && ! command -v docker &>/dev/null; then
    ui_error "✗ Error: Neither podman nor docker is installed on the host system."
    exit 1
  fi
}

require_distrobox() {
  if ! command -v distrobox &>/dev/null; then
    ui_error "✗ Error: distrobox is not installed on the host system (required only for '--mode workstation')."
    echo -e "${YELLOW}Omit '--mode workstation' to use the default Sandbox mode, or install distrobox:${NC}" >&2
    echo "  curl -s https://raw.githubusercontent.com/89luca89/distrobox/main/install | sh -s -- --prefix ~/.local" >&2
    exit 1
  fi
}

detect_runtime() {
  load_config
  if [ -n "${DBX_CONTAINER_MANAGER:-}" ] && command -v "$DBX_CONTAINER_MANAGER" >/dev/null 2>&1; then
    echo "$DBX_CONTAINER_MANAGER"
  elif [ -n "${AGY_CONTAINER_MANAGER:-}" ] && command -v "$AGY_CONTAINER_MANAGER" >/dev/null 2>&1; then
    echo "$AGY_CONTAINER_MANAGER"
  elif command -v podman >/dev/null 2>&1; then
    echo "podman"
  else
    echo "docker"
  fi
}

get_runtime() {
  detect_runtime
}

check_container_exists() {
  local name=$1
  local runtime
  runtime=$(get_runtime)
  if "$runtime" ps -a --format '{{.Names}}' 2>/dev/null | grep -qxF -- "$name"; then return 0; else return 1; fi
}

is_container_running() {
  local name=$1
  local runtime="${2:-$(get_runtime)}"
  if "$runtime" ps --format '{{.Names}}' 2>/dev/null | grep -qxF -- "$name"; then
    return 0
  fi
  if command -v distrobox >/dev/null 2>&1 && distrobox list --no-color 2>/dev/null | awk -F'|' -v n="$name" 'NR>1 {gsub(/^[ \t]+|[ \t]+$/, "", $2); if ($2 == n) print $3}' | grep -qi "running"; then
    return 0
  fi
  return 1
}

get_box_manager() {
  local target_name="$1"
  local runtime
  runtime=$(get_runtime 2>/dev/null || echo "podman")

  if check_container_exists "$target_name"; then
    local mgr=""
    if command -v "$runtime" >/dev/null 2>&1; then
      mgr=$("$runtime" inspect "$target_name" --format '{{index .Config.Labels "manager"}}' 2>/dev/null || true)
    fi
    if [ "$mgr" = "distrobox" ]; then
      echo "distrobox"
      return 0
    elif [ "$mgr" = "agy-box-podman" ] || [ "$mgr" = "agy-box-docker" ]; then
      echo "$runtime"
      return 0
    fi
    if command -v distrobox >/dev/null 2>&1 && distrobox list --no-color 2>/dev/null | awk -F'|' 'NR>1 {gsub(/^[ \t]+|[ \t]+$/, "", $2); print $2}' | grep -qxF "$target_name"; then
      echo "distrobox"
      return 0
    fi
    if [ -n "$mgr" ]; then
      echo "$mgr"
      return 0
    fi
    if command -v "$runtime" >/dev/null 2>&1; then
      local ep
      ep=$("$runtime" inspect "$target_name" --format '{{json .Config.Entrypoint}}' 2>/dev/null || true)
      if [[ "$ep" == *"/usr/bin/entrypoint"* ]]; then
        echo "distrobox"
        return 0
      elif [[ "$ep" == *"tini"* ]] || [[ "$ep" == *"entrypoint.sh"* ]]; then
        echo "$runtime"
        return 0
      fi
    fi
    echo "$runtime"
    return 0
  fi

  if [ "${AGY_DEFAULT_MODE:-sandbox}" = "workstation" ]; then
    echo "distrobox"
  else
    echo "$runtime"
  fi
}

get_box_channel() {
  local box="$1" val="" runtime
  val=$(read_box_meta_field "$box" "AGY_BOX_CHANNEL")
  if [ "$val" = "dev" ] || [ "$val" = "stable" ]; then
    echo "$val"
    return 0
  fi
  runtime=$(get_runtime 2>/dev/null || echo "podman")
  if command -v "$runtime" >/dev/null 2>&1 && check_container_exists "$box"; then
    val=$("$runtime" inspect "$box" --format '{{index .Config.Labels "agy-box.channel"}}' 2>/dev/null || true)
    if [ "$val" = "dev" ] || [ "$val" = "stable" ]; then
      echo "$val"
      return 0
    fi
  fi
  if [[ "$box" == agy-box-dev* ]]; then
    echo "dev"
  else
    echo "stable"
  fi
}

get_box_branch() {
  local box="$1" val="" runtime
  val=$(read_box_meta_field "$box" "AGY_BOX_BRANCH")
  if [ -n "$val" ]; then
    echo "$val"
    return 0
  fi
  runtime=$(get_runtime 2>/dev/null || echo "podman")
  if command -v "$runtime" >/dev/null 2>&1 && check_container_exists "$box"; then
    val=$("$runtime" inspect "$box" --format '{{index .Config.Labels "agy-box.branch"}}' 2>/dev/null || true)
    if [ -n "$val" ] && [ "$val" != "<no value>" ]; then
      echo "$val"
      return 0
    fi
  fi
  if [ "$(get_box_channel "$box")" = "dev" ]; then
    echo "dev"
  else
    echo "release"
  fi
}

get_box_mode() {
  local box="$1" val=""
  val=$(read_box_meta_field "$box" "AGY_BOX_MODE")
  if [ "$val" = "workstation" ] || [ "$val" = "sandbox" ]; then
    echo "$val"
    return 0
  fi
  if [ "$(get_box_manager "$box")" = "distrobox" ]; then
    echo "workstation"
  else
    echo "sandbox"
  fi
}

ensure_distrobox_ready() {
  local name="$1"
  local runtime
  runtime=$(get_runtime 2>/dev/null || echo "podman")
  local current_user
  current_user=$(id -un 2>/dev/null || echo "${USER:-wtg}")

  local is_running
  is_running=$("$runtime" inspect -f '{{.State.Running}}' "$name" 2>/dev/null || echo "false")

  if [ "$is_running" != "true" ]; then
    if ! run_logged distrobox enter "$name" -- true; then
      ui_error "Failed to initialize Distrobox container '$name'."
      return 1
    fi
  else
    if ! "$runtime" exec --user 0 "$name" getent passwd "$current_user" >/dev/null 2>&1 || ! distrobox enter "$name" -- true >/dev/null 2>&1; then
      ui_warn "Distrobox container '$name' cannot be cleanly entered; restarting to complete initialization..."
      run_logged_silent "$runtime" stop "$name" || true
      if ! run_logged distrobox enter "$name" -- true; then
        ui_error "Failed to re-initialize Distrobox container '$name'."
        return 1
      fi
      if ! "$runtime" exec --user 0 "$name" getent passwd "$current_user" >/dev/null 2>&1; then
        ui_error "User '$current_user' was not found in container '$name' /etc/passwd after retry."
        return 1
      fi
    fi
  fi
  return 0
}

generate_box_name() {
  local prefix="${1:-$BOX_PREFIX}"
  local adjs=(golden cosmic lunar ember cobalt amber velvet crystal swift stellar misty crimson silver solar vivid alpine coral noble rapid bright sonic frosty radiant serene emerald copper azure cedar prism aurora zenith mystic)
  local nouns=(spark falcon forge beacon harbor comet canyon breeze summit orbit meadow lantern glacier atlas quartz nebula anchor river phoenix horizon timber zephyr vertex compass citadel cascade voyager foundry haven crest pulse spire)
  if [ -r /dev/urandom ]; then
    RANDOM=$(od -An -N2 -tu2 /dev/urandom 2>/dev/null | tr -d ' ' || echo "$RANDOM")
  fi
  local attempts=0
  while [ $attempts -lt 100 ]; do
    local adj="${adjs[$((RANDOM % ${#adjs[@]}))]}"
    local noun="${nouns[$((RANDOM % ${#nouns[@]}))]}"
    local candidate="${prefix}-${adj}-${noun}"
    if ! check_container_exists "$candidate" && [ ! -d "$(get_box_home "$candidate")" ]; then
      echo "$candidate"
      return 0
    fi
    attempts=$((attempts + 1))
  done
  echo "${prefix}-box-$RANDOM"
}

calculate_box_port_offset() {
  local target_name="$1"
  local runtime
  runtime=$(get_runtime 2>/dev/null || echo "podman")
  if command -v "$runtime" >/dev/null 2>&1 && check_container_exists "$target_name"; then
    local host_port=""
    host_port=$("$runtime" port "$target_name" 6080 2>/dev/null | head -n 1 | awk -F: '{print $NF}' || true)
    if [ -z "$host_port" ]; then
      # shellcheck disable=SC2016
      host_port=$("$runtime" inspect -f '{{range $p, $conf := .HostConfig.PortBindings}}{{if eq $p "6080/tcp"}}{{(index $conf 0).HostPort}}{{end}}{{end}}' "$target_name" 2>/dev/null || true)
    fi
    if [[ "$host_port" =~ ^[0-9]+$ ]] && [ "$host_port" -ge 6080 ]; then
      echo $((host_port - 6080))
      return 0
    fi
  fi

  local used_ports=()
  if command -v "$runtime" >/dev/null 2>&1; then
    while IFS= read -r p; do
      [[ "$p" =~ ^[0-9]+$ ]] && used_ports+=("$p")
    done < <("$runtime" ps -a --format '{{.Ports}}' 2>/dev/null | grep -oE '[0-9]+->6080' | cut -d- -f1 || true)
  fi
  while IFS= read -r p; do
    [[ "$p" =~ ^[0-9]+$ ]] && used_ports+=("$p")
  done < <(ss -tlnH 2>/dev/null | awk '{print $4}' | awk -F: '{print $NF}' || true)

  local offset=0
  while true; do
    local cand=$((6080 + offset))
    local in_use=false
    for up in "${used_ports[@]}"; do
      if [ "$up" -eq "$cand" ] 2>/dev/null; then
        in_use=true
        break
      fi
    done
    if [ "$in_use" = "false" ]; then
      echo "$offset"
      return 0
    fi
    offset=$((offset + 1))
  done
}

purge_box_home() {
  local target_dir="$1"
  [ -z "$target_dir" ] && return 0
  [ ! -d "$target_dir" ] && return 0

  if rm -rf "$target_dir" 2>/dev/null; then
    return 0
  fi

  local runtime
  runtime=$(get_runtime 2>/dev/null || echo "podman")
  if [ "$runtime" = "podman" ] && command -v podman >/dev/null 2>&1; then
    run_logged_silent podman unshare rm -rf "$target_dir" || rm -rf "$target_dir"
  fi
}

get_all_agy_boxes() {
  local boxes=()
  if command -v distrobox >/dev/null 2>&1; then
    while IFS= read -r b; do
      [ -n "$b" ] && boxes+=("$b")
    done < <(distrobox list --no-color 2>/dev/null | awk -F'|' 'NR>1 {gsub(/^[ \t]+|[ \t]+$/, "", $2); gsub(/^[ \t]+|[ \t]+$/, "", $4); if ($2 ~ /^agy-box/ || $4 ~ /agy-box/) print $2}')
  fi
  local runtime
  runtime=$(get_runtime 2>/dev/null || echo "podman")
  if command -v "$runtime" >/dev/null 2>&1; then
    while IFS= read -r b; do
      [ -n "$b" ] && boxes+=("$b")
    done < <("$runtime" ps -a --format '{{.Names}}' 2>/dev/null | grep -E '^agy-box' || true)

    while IFS= read -r b; do
      [ -n "$b" ] && boxes+=("$b")
    done < <("$runtime" ps -a --filter "label=agy-box.managed=true" --format '{{.Names}}' 2>/dev/null || true)

    while IFS= read -r b; do
      [ -n "$b" ] && boxes+=("$b")
    done < <("$runtime" ps -a --filter "label=agy-box.mode=sandbox" --format '{{.Names}}' 2>/dev/null || true)

    while IFS= read -r b; do
      [ -n "$b" ] && boxes+=("$b")
    done < <("$runtime" ps -a --filter "label=manager=agy-box-${runtime}" --format '{{.Names}}' 2>/dev/null || true)
  fi
  if [ ${#boxes[@]} -gt 0 ]; then
    printf "%s\n" "${boxes[@]}" | sort -u
  fi
}

choose_option() {
  gum choose --cursor="➜ " --cursor.foreground="212" --selected.foreground="212" --item.foreground="250" "$@"
}

resolve_target_box() {
  local selector="${1:-}"
  local all_boxes=() b
  while IFS= read -r b; do
    [ -n "$b" ] && all_boxes+=("$b")
  done < <(get_all_agy_boxes)

  if [ -z "$selector" ]; then
    if [ ${#all_boxes[@]} -eq 0 ]; then
      ui_error "No AGY boxes installed. Run 'agy-box-manager install' to create one."
      return 1
    elif [ ${#all_boxes[@]} -eq 1 ]; then
      echo "${all_boxes[0]}"
      return 0
    elif [ -t 0 ] && [ "${AGY_NONINTERACTIVE:-0}" != "1" ] && command -v gum >/dev/null 2>&1; then
      local chosen
      chosen=$(choose_option --header "Select an AGY Box:" "${all_boxes[@]}")
      [ -n "$chosen" ] && { echo "$chosen"; return 0; }
      return 1
    else
      ui_error "Multiple AGY boxes installed; specify a box name or channel (stable|dev):"
      printf '  • %s\n' "${all_boxes[@]}" >&2
      return 1
    fi
  fi

  if [ "$selector" = "stable" ] || [ "$selector" = "prod" ] || [ "$selector" = "dev" ]; then
    local want="$selector"
    [ "$want" = "prod" ] && want="stable"
    local matched=()
    for b in "${all_boxes[@]}"; do
      if [ "$(get_box_channel "$b")" = "$want" ]; then
        matched+=("$b")
      fi
    done
    if [ ${#matched[@]} -eq 0 ]; then
      ui_error "No '$want' channel AGY boxes installed."
      [ ${#all_boxes[@]} -gt 0 ] && printf '  Installed: %s\n' "${all_boxes[*]}" >&2
      return 1
    elif [ ${#matched[@]} -eq 1 ]; then
      echo "${matched[0]}"
      return 0
    elif [ -t 0 ] && [ "${AGY_NONINTERACTIVE:-0}" != "1" ] && command -v gum >/dev/null 2>&1; then
      local chosen_ch
      chosen_ch=$(choose_option --header "Select a '$want' box:" "${matched[@]}")
      [ -n "$chosen_ch" ] && { echo "$chosen_ch"; return 0; }
      return 1
    else
      ui_error "Multiple '$want' channel boxes installed; specify a box name:"
      printf '  • %s\n' "${matched[@]}" >&2
      return 1
    fi
  fi

  if check_container_exists "$selector"; then
    echo "$selector"
    return 0
  elif check_container_exists "agy-box-$selector"; then
    echo "agy-box-$selector"
    return 0
  elif check_container_exists "agy-box-dev-$selector"; then
    echo "agy-box-dev-$selector"
    return 0
  fi

  ui_error "Environment '$selector' does not exist. Available environments:"
  if [ ${#all_boxes[@]} -gt 0 ]; then
    printf '  %s\n' "${all_boxes[@]}" >&2
  else
    echo "  (none installed)" >&2
  fi
  return 1
}

# --- Logged Command Runners & Toolchain ---
TOOLCHAIN_INSTALLER="agy-install-toolchain"

run_logged_silent() {
  local start_s=$SECONDS rc=0 cmd_str="$*"
  local LOG_TARGETS=()
  collect_log_targets
  log_write "[$(log_ts)] [CMD] $cmd_str"
  if [ ${#LOG_TARGETS[@]} -gt 0 ]; then
    local had_e=false
    [[ "$-" == *e* ]] && had_e=true
    set +e
    "$@" 2>&1 | tee -a "${LOG_TARGETS[@]}" >/dev/null
    rc=${PIPESTATUS[0]}
    $had_e && set -e
  else
    "$@" >/dev/null 2>&1 || rc=$?
  fi
  log_write "[$(log_ts)] [EXIT rc=$rc elapsed=$((SECONDS - start_s))s] $cmd_str"
  return "$rc"
}

run_logged_tty() {
  local start_s=$SECONDS rc=0 cmd_str="$*"
  log_write "[$(log_ts)] [CMD] $cmd_str"
  "$@" || rc=$?
  log_write "[$(log_ts)] [EXIT rc=$rc elapsed=$((SECONDS - start_s))s] $cmd_str"
  [ "$rc" -ne 0 ] && print_diag_log_hint
  return "$rc"
}

