cmd_doctor() {
    # Ensure dependencies and host capabilities are probed
    check_deps "quiet"

    echo -e "${CYAN}==================================================${NC}"
    echo -e "${CYAN}             AGY Box Doctor Diagnostics           ${NC}"
    echo -e "${CYAN}==================================================${NC}"

    local errors=0
    local warnings=0

    # 1. Path Check
    echo -n "Checking if ~/.local/bin is in PATH... "
    if [[ ":$PATH:" == *":$HOME/.local/bin:"* ]]; then
        echo -e "${GREEN}[OK]${NC}"
    else
        echo -e "${YELLOW}[WARN]${NC}"
        echo -e "  -> ~/.local/bin is not in your PATH. Exported commands may not be directly accessible."
        warnings=$((warnings + 1))
    fi

    # 2. DNS / Internet Check
    echo -n "Checking DNS resolution and internet connectivity... "
    if curl -s --connect-timeout 3 https://www.google.com &>/dev/null; then
        echo -e "${GREEN}[OK]${NC}"
    else
        echo -e "${RED}[ERROR]${NC}"
        echo -e "  -> Failed to connect to Google. Check your internet connection and DNS settings."
        errors=$((errors + 1))
    fi

    # 3. Mount and Directory Permissions
    echo -n "Checking ~/.config write permissions... "
    if [ -w "$HOME/.config" ]; then
        echo -e "${GREEN}[OK]${NC}"
    else
        echo -e "${RED}[ERROR]${NC}"
        echo -e "  -> ~/.config directory is not writable."
        errors=$((errors + 1))
    fi

    echo -n "Checking ~/.local/bin write permissions... "
    if [ -d "$HOME/.local/bin" ] && [ ! -w "$HOME/.local/bin" ]; then
        echo -e "${RED}[ERROR]${NC}"
        echo -e "  -> ~/.local/bin directory exists but is not writable."
        errors=$((errors + 1))
    else
        echo -e "${GREEN}[OK]${NC}"
    fi

    # 4. Container engine check
    echo -n "Checking container manager runtime... "
    if [ -n "${DBX_CONTAINER_MANAGER:-}" ]; then
        echo -e "${GREEN}[OK] ($DBX_CONTAINER_MANAGER)${NC}"
    else
        echo -e "${RED}[ERROR]${NC}"
        echo -e "  -> No container manager detected."
        errors=$((errors + 1))
    fi

    # 5. Distrobox check
    echo -n "Checking distrobox installation... "
    if command -v distrobox &>/dev/null; then
        echo -e "${GREEN}[OK]${NC}"
    else
        echo -e "${RED}[ERROR]${NC}"
        echo -e "  -> distrobox command not found on host."
        errors=$((errors + 1))
    fi

    # Summary
    echo -e "\n${CYAN}--------------------------------------------------${NC}"
    if [ "$errors" -eq 0 ] && [ "$warnings" -eq 0 ]; then
        echo -e "${GREEN}System is healthy! No issues detected.${NC}"
    elif [ "$errors" -eq 0 ]; then
        echo -e "${YELLOW}System is functional but has $warnings warning(s).${NC}"
    else
        echo -e "${RED}System has $errors error(s) and $warnings warning(s). Actions required!${NC}"
    fi
    echo -e "${CYAN}--------------------------------------------------${NC}\n"

    if [ "$errors" -gt 0 ]; then
        return 1
    fi
    return 0
}

cmd_ports() {
    # Ensure dependencies and host capabilities are probed
    check_deps "quiet"
    
    if [ -z "${DBX_CONTAINER_MANAGER:-}" ]; then
        gum style --foreground 196 "❌ Error: Container manager not detected."
        return 1
    fi
    
    echo -e "${CYAN}==================================================${NC}"
    echo -e "${CYAN}        Sandboxed Port Forwarding Dashboard       ${NC}"
    echo -e "${CYAN}==================================================${NC}"
    
    for container in "$CONTAINER_NAME" "$DEV_CONTAINER_NAME"; do
        echo -e "\n${BLUE}Container: $container${NC}"
        if check_container_exists "$container"; then
            local port_out
            port_out=$("$DBX_CONTAINER_MANAGER" port "$container" 2>/dev/null || true)
            if [ -n "$port_out" ]; then
                echo -e "  ${GREEN}CONTAINER PORT${NC}   ➔   ${GREEN}HOST MAPPING${NC}"
                echo -e "  --------------------------------------------------"
                while read -r line; do
                    if [ -n "$line" ]; then
                        local c_port host_map
                        c_port=$(echo "$line" | awk -F ' -> ' '{print $1}')
                        host_map=$(echo "$line" | awk -F ' -> ' '{print $2}')
                        if [ -z "$host_map" ]; then
                            echo "  $line"
                        else
                            printf "  %-16s ➔   %s\n" "$c_port" "$host_map"
                        fi
                    fi
                done <<< "$port_out"
            else
                echo -e "  ${YELLOW}No active port mappings (all ports are sandboxed inside container).${NC}"
            fi
        else
            echo -e "  ${RED}Container does not exist (not installed).${NC}"
        fi
    done
    echo ""
}

cmd_check_dependencies() {
    local missing=0
    if ! command -v distrobox &> /dev/null; then
        echo -e "${RED}✗ Error: distrobox is not installed on the host system.${NC}" >&2
        missing=1
    fi
    if ! command -v podman &> /dev/null && ! command -v docker &> /dev/null; then
        echo -e "${RED}✗ Error: Neither podman nor docker is installed on the host system.${NC}" >&2
        missing=1
    fi
    if [ "$missing" -eq 0 ]; then
        gum style --foreground 46 --margin "1 0" "✓ All dependencies (distrobox, podman/docker) are satisfied."
    else
        echo -e "\n${CYAN}Would you like to try installing the missing container dependencies now?${NC}"
        exec < /dev/tty
        if gum confirm "Install missing dependencies?"; then
            if command -v apt-get &> /dev/null; then
                sudo apt update && sudo apt install -y podman distrobox
            elif command -v dnf &> /dev/null; then
                sudo dnf install -y podman distrobox
            elif command -v pacman &> /dev/null; then
                sudo pacman -S --noconfirm podman distrobox
            elif command -v zypper &> /dev/null; then
                sudo zypper install -y podman distrobox
            elif command -v brew &> /dev/null; then
                brew install podman distrobox
            else
                echo -e "${RED}Could not detect a supported package manager. Please install manually.${NC}"
            fi
        else
            echo -e "\nPlease install the missing container dependencies manually."
        fi
    fi
    read -n 1 -s -r -p "Press any key to continue..."
}

show_compact_status() {
    local official_status="❌ Not Installed"
    local dev_status="❌ Not Installed"

    if check_container_exists "$CONTAINER_NAME"; then
        if distrobox list --no-color | grep -w "$CONTAINER_NAME" | grep -qi "running"; then
            official_status="🟢 Running"
        else
            official_status="💤 Installed"
        fi
    fi

    if check_container_exists "$DEV_CONTAINER_NAME"; then
        if distrobox list --no-color | grep -w "$DEV_CONTAINER_NAME" | grep -qi "running"; then
            dev_status="🟢 Running"
        else
            dev_status="💤 Installed"
        fi
    fi

    gum style --border rounded --border-foreground 39 --padding "0 2" --margin "0 2" --align center --width 50 \
        "Official: $official_status  |  Dev: $dev_status"
}

choose_option() {
    gum choose --cursor="➜ " --cursor.foreground="212" --selected.foreground="212" --item.foreground="250" "$@"
}

cmd_interactive() {
    # 1. Splash Screen Flow (Instant rendering)
    clear
    show_banner
    check_deps "menu"

    local splash_choice
    splash_choice=$(choose_option "🚀 Enter Main Menu" "🔍 Check System & Component Status" "📊 View Host System Info & Dependencies" "❌ Exit")

    case "$splash_choice" in
        "🔍 Check System & Component Status")
            clear
            show_compact_banner
            cmd_check
            echo ""
            read -n 1 -s -r -p "Press any key to continue to Main Menu..."
            ;;
        "📊 View Host System Info & Dependencies")
            clear
            show_compact_banner
            # Show a brief spinner to indicate loading
            gum spin --spinner dot --title "Analyzing system dependencies and status..." -- sleep 0.5
            check_deps "quiet"
            show_system_status
            echo ""
            read -n 1 -s -r -p "Press any key to continue to Main Menu..."
            ;;
        "❌ Exit")
            gum style --foreground 212 "Goodbye!"
            exit 0
            ;;
    esac

    local menu_state="main"
    while true; do
        case "$menu_state" in
            "main")
                clear
                show_compact_banner
                show_compact_status

                local main_options=(
                    "🚪 Workspaces (Enter/VDI Desktop) >"
                    "🛠️  Manage Environments >"
                    "⚙️  System Tools >"
                    "❌ Exit"
                )

                local choice
                choice=$(choose_option "${main_options[@]}")

                case "$choice" in
                    "🚪 Workspaces (Enter/VDI Desktop) >")
                        menu_state="workspaces"
                        ;;
                    "🛠️  Manage Environments >")
                        menu_state="manage"
                        ;;
                    "⚙️  System Tools >")
                        menu_state="tools"
                        ;;
                    "❌ Exit")
                        gum style --foreground 212 "Goodbye!"
                        exit 0
                        ;;
                esac
                ;;

            "workspaces")
                clear
                show_compact_banner
                show_compact_status

                local workspace_options=()
                if check_container_exists "$CONTAINER_NAME"; then
                    workspace_options+=("🚪 Enter Official Workspace")
                    workspace_options+=("🖥️  Start VDI Web Desktop (Official)")
                fi
                if check_container_exists "$DEV_CONTAINER_NAME"; then
                    workspace_options+=("💻 Enter Dev Workspace")
                    workspace_options+=("🖥️  Start VDI Web Desktop (Dev)")
                    workspace_options+=("🌐 Launch Local Web Dashboard (agy-local-ui)")
                fi

                workspace_options+=("🔙 Back to Main Menu")

                local sub_choice
                sub_choice=$(choose_option "${workspace_options[@]}")

                case "$sub_choice" in
                    "🚪 Enter Official Workspace")
                        cmd_enter prod
                        echo ""
                        read -n 1 -s -r -p "Press any key to continue..."
                        ;;
                    "🖥️  Start VDI Web Desktop (Official)")
                        cmd_desktop prod
                        echo ""
                        read -n 1 -s -r -p "Press any key to continue..."
                        ;;
                    "💻 Enter Dev Workspace")
                        cmd_enter dev
                        echo ""
                        read -n 1 -s -r -p "Press any key to continue..."
                        ;;
                    "🖥️  Start VDI Web Desktop (Dev)")
                        cmd_desktop dev
                        echo ""
                        read -n 1 -s -r -p "Press any key to continue..."
                        ;;
                    "🌐 Launch Local Web Dashboard (agy-local-ui)")
                        gum style --foreground 212 "🚀 Launching Local Web Dashboard via agy-box..."
                        distrobox enter "$CONTAINER_NAME" -- just agy-local-ui &
                        echo ""
                        read -n 1 -s -r -p "Press any key to continue..."
                        ;;
                    "🔙 Back to Main Menu")
                        menu_state="main"
                        ;;
                esac
                ;;

            "manage")
                clear
                show_compact_banner
                show_compact_status

                local manage_options=()

                # Official workspace options — always visible
                if check_container_exists "$CONTAINER_NAME"; then
                    manage_options+=("♻️  Update/Recreate Official Workspace")
                    manage_options+=("🔄 Update Antigravity Toolchain (Official)")
                    manage_options+=("🗑️  Remove Official Workspace")
                else
                    manage_options+=("🚀 Install Official Workspace (Pull from GHCR)")
                fi

                # Dev workspace options — always visible
                if check_container_exists "$DEV_CONTAINER_NAME"; then
                    manage_options+=("♻️  Rebuild Dev Workspace")
                    manage_options+=("🔄 Update Antigravity Toolchain (Dev)")
                    manage_options+=("🗑️  Remove Dev Workspace")
                elif [ -f "Containerfile" ]; then
                    manage_options+=("🛠️  Build Dev Workspace (From local source)")
                else
                    manage_options+=("🛠️  Build Dev Workspace (Requires Containerfile in CWD)")
                fi

                manage_options+=("🔙 Back to Main Menu")

                local sub_choice
                sub_choice=$(choose_option "${manage_options[@]}")

                case "$sub_choice" in
                    "🚀 Install Official Workspace (Pull from GHCR)"|"♻️  Update/Recreate Official Workspace")
                        cmd_install_official
                        echo ""
                        read -n 1 -s -r -p "Press any key to continue..."
                        menu_state="workspaces"
                        ;;
                    "🛠️  Build Dev Workspace (From local source)"|"♻️  Rebuild Dev Workspace")
                        cmd_build_dev
                        echo ""
                        read -n 1 -s -r -p "Press any key to continue..."
                        menu_state="workspaces"
                        ;;
                    "🔄 Update Antigravity Toolchain (Official)")
                        cmd_update_toolchain prod
                        echo ""
                        read -n 1 -s -r -p "Press any key to continue..."
                        ;;
                    "🔄 Update Antigravity Toolchain (Dev)")
                        cmd_update_toolchain dev
                        echo ""
                        read -n 1 -s -r -p "Press any key to continue..."
                        ;;
                    "🗑️  Remove Official Workspace")
                        cmd_clean "$CONTAINER_NAME"
                        echo ""
                        read -n 1 -s -r -p "Press any key to continue..."
                        ;;
                    "🗑️  Remove Dev Workspace")
                        cmd_clean "$DEV_CONTAINER_NAME"
                        echo ""
                        read -n 1 -s -r -p "Press any key to continue..."
                        ;;
                    "🛠️  Build Dev Workspace (Requires Containerfile in CWD)")
                        gum style --foreground 214 "⚠️  No Containerfile found in the current directory."
                        echo -e "To build a dev workspace, run this command from the agy-box repo root:"
                        echo -e "  cd /path/to/agy-box && agy-box-manager"
                        echo ""
                        read -n 1 -s -r -p "Press any key to continue..."
                        ;;
                    "🔙 Back to Main Menu")
                        menu_state="main"
                        ;;
                esac
                ;;

            "tools")
                clear
                show_compact_banner
                show_compact_status

                local tools_options=()
                tools_options+=("🧙 Run First-Run Setup Wizard")
                tools_options+=("🔍 Check System & Component Status")
                tools_options+=("🔄 Update Environment & Toolchain")
                tools_options+=("💾 Backup Settings & Workspace State")
                tools_options+=("📥 Restore Settings from Backup")
                tools_options+=("📊 Show Distrobox List")
                tools_options+=("🔌 Show Port Mappings")
                tools_options+=("🩺 Run Doctor Diagnostics")
                tools_options+=("📦 Check Package Dependencies")

                if [ -f "$HOME/.local/bin/agy-box-manager" ]; then
                    tools_options+=("🔥 Uninstall CLI Globally")
                else
                    tools_options+=("🌍 Install CLI Globally (~/.local/bin)")
                fi

                tools_options+=("🔙 Back to Main Menu")

                local sub_choice
                sub_choice=$(choose_option "${tools_options[@]}")

                case "$sub_choice" in
                    "🧙 Run First-Run Setup Wizard")
                        cmd_wizard
                        echo ""
                        read -n 1 -s -r -p "Press any key to continue..."
                        ;;
                    "🔍 Check System & Component Status")
                        cmd_check
                        echo ""
                        read -n 1 -s -r -p "Press any key to continue..."
                        ;;
                    "🔄 Update Environment & Toolchain")
                        cmd_update prod --all
                        echo ""
                        read -n 1 -s -r -p "Press any key to continue..."
                        ;;
                    "💾 Backup Settings & Workspace State")
                        cmd_backup
                        echo ""
                        read -n 1 -s -r -p "Press any key to continue..."
                        ;;
                    "📥 Restore Settings from Backup")
                        echo -n "Enter path to backup archive (.tar.gz): "
                        read -r restore_path
                        if [ -n "$restore_path" ]; then
                            cmd_restore "$restore_path"
                        fi
                        echo ""
                        read -n 1 -s -r -p "Press any key to continue..."
                        ;;
                    "📊 Show Distrobox List")
                        cmd_status
                        read -n 1 -s -r -p "Press any key to continue..."
                        ;;
                    "🔌 Show Port Mappings")
                        cmd_ports
                        read -n 1 -s -r -p "Press any key to continue..."
                        ;;
                    "🩺 Run Doctor Diagnostics")
                        cmd_doctor
                        read -n 1 -s -r -p "Press any key to continue..."
                        ;;
                    "📦 Check Package Dependencies")
                        cmd_check_dependencies
                        ;;
                    "🌍 Install CLI Globally (~/.local/bin)")
                        cmd_install_global
                        echo ""
                        read -n 1 -s -r -p "Press any key to continue..."
                        ;;
                    "🔥 Uninstall CLI Globally")
                        cmd_uninstall_global
                        echo ""
                        read -n 1 -s -r -p "Press any key to continue..."
                        ;;
                    "🔙 Back to Main Menu")
                        menu_state="main"
                        ;;
                esac
                ;;
        esac
    done
}

