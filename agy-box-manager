      echo -e '\n# Added by agy-box-manager\nif [ -f "$HOME/.config/agy-box/shell_integration.sh" ]; then\n    . "$HOME/.config/agy-box/shell_integration.sh"\nfi' >> "$HOME/.bashrc"
