ensure_justfile_copied() {
    local target_dir="$HOME/.config/agy-box"
    local target_file="$target_dir/justfile"
    mkdir -p "$target_dir"

    # Find the current directory of the script if running locally
    local script_dir
    script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

    if [ -f "$script_dir/justfile" ]; then
        cp "$script_dir/justfile" "$target_file"
    else
        # If not running locally, download it
        local remote_justfile_url="https://raw.githubusercontent.com/wtg-codes/agy-box/main/justfile"
        curl -fsSL "$remote_justfile_url" -o "$target_file" 2>/dev/null || true
    fi
}

# shellcheck disable=SC2016
setup_shell_integration() {
    local config_dir="$HOME/.config/agy-box"
    mkdir -p "$config_dir"
    
    # Ensure justfile is copied/updated
    ensure_justfile_copied

    # Write the bash/zsh shell integration script
    cat << 'EOF' > "$config_dir/shell_integration.sh"
# --- Added by agy-box-manager: just/ujust integration ---
