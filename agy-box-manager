    if check_container_exists "$DEV_CONTAINER_NAME"; then dev_status="🛠️  Dev Env: Ready"; fi
    if [ -f "Containerfile" ]; then source_status="📁 Source: Ready"; fi

    # Left Card: Host Environment
    local left_text
    left_text=$(printf "🖥️  Host OS: %s\n\n%s\n%s\n%s" "$os_name" "$podman_status" "$docker_status" "$distrobox_status")
