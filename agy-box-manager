cmd_update() {
    load_config
    local target="prod"
    local update_toolchain=false
    local update_ides=false
    local update_packages=false
    local check_only=false
    local flags_specified=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            prod) target="prod"; shift ;;
            dev)  target="dev"; shift ;;
            --all|-a)
                update_toolchain=true
                update_ides=true
                update_packages=true
                flags_specified=true
                shift
                ;;
            --toolchain|-t)
                update_toolchain=true
                flags_specified=true
                shift
                ;;
            --ides|-i)
                update_ides=true
                flags_specified=true
                shift
                ;;
            --packages|-p)
                update_packages=true
                flags_specified=true
                shift
                ;;
            --check|-c)
                check_only=true
                flags_specified=true
                shift
                ;;
            *)
                ui_error "Unknown option: $1"
                echo "Usage: agy-box-manager update [prod|dev] [--all|--toolchain|--ides|--packages|--check]"
                return 1
                ;;
        esac
    done

    # Default to --all if no specific action flag was given
    if [ "$flags_specified" = "false" ]; then
        update_toolchain=true
        update_ides=true
        update_packages=true
    fi

    local target_container="$CONTAINER_NAME"
    if [ "$target" = "dev" ]; then
        target_container="$DEV_CONTAINER_NAME"
    fi

    if [ "$check_only" = "true" ]; then
        echo "🔍 Checking status and component versions for '$target_container'..."
        cmd_check
        return 0
    fi

    if ! check_container_exists "$target_container"; then
        ui_error "❌ Error: Container '$target_container' does not exist."
        echo "Run 'agy-box-manager install' (or 'agy-box-manager dev') first."
        return 1
    fi

    local isolated_home="$HOME/.config/agy-box/home"
    local runtime
    runtime=$(detect_runtime)
    if [ "$runtime" = "podman" ] && [ -d "$isolated_home" ]; then
        podman unshare chown -R 0:0 "$isolated_home" 2>/dev/null || true
    fi

    ui_ok "🚀 Updating environment '$target_container'..."

    # 1. Toolchain update
    if [ "$update_toolchain" = "true" ]; then
        echo -e "\n${CYAN}==> Updating Antigravity Toolchain...${NC}"
        cmd_update_toolchain "$target"
    fi

    # 2. IDE extensions update
    if [ "$update_ides" = "true" ]; then
        echo -e "\n${CYAN}==> Updating IDE Extensions...${NC}"
        if distrobox enter "$target_container" -- command -v code &>/dev/null; then
            run_step "Updating VS Code Antigravity extension..." distrobox enter "$target_container" -- code --install-extension Google.antigravity --force || ui_warn "! Could not update VS Code extension"
        fi
        local zed_settings="$isolated_home/.config/zed/settings.json"
        if [ -f "$zed_settings" ]; then
            if ! grep -q "auto_install_extensions" "$zed_settings"; then
                echo '{"auto_install_extensions": {"antigravity": true}}' > "$zed_settings"
            fi
            ui_ok "✓ Zed auto-install extension configuration verified."
        fi
    fi

    # 3. Packages update
    if [ "$update_packages" = "true" ]; then
        echo -e "\n${CYAN}==> Updating Container OS Packages & IDEs...${NC}"
        run_step "Updating apt package lists..." distrobox enter "$target_container" -- sudo apt-get update || true
        run_step "Upgrading core packages (Google Chrome, VS Code)..." distrobox enter "$target_container" -- sudo apt-get --only-upgrade install -y google-chrome-stable code 2>/dev/null || true
        ui_ok "✓ Container packages upgraded."
    fi

    ui_ok "\n✓ Update completed successfully for '$target_container'!"
}

