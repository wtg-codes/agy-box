# --- Core Commands ---
cmd_install_official() {
    load_config
    apply_keyring_configuration
    local systemd=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -s|--systemd)
                systemd=true
                shift
                ;;
            *)
                shift
                ;;
        esac
    done

    local runtime
    runtime=$(get_runtime)

    if check_container_exists "$CONTAINER_NAME"; then
        if gum confirm "Container '$CONTAINER_NAME' already exists. Recreate it?"; then
            cmd_clean "$CONTAINER_NAME"
        else
            gum style --foreground 212 "Skipping creation."
            return
        fi
    fi

    local dbx_flags=()
    local isolated_home="$HOME/.config/agy-box/home"
    mkdir -p "$isolated_home"
    dbx_flags+=("--home" "$isolated_home")

    if [ "${AGY_PROFILE_SEEDING:-false}" = "true" ]; then
        if [ -d "$HOME/.ssh" ]; then
            dbx_flags+=("--volume" "$HOME/.ssh:$isolated_home/.ssh:ro")
        fi
        if [ -d "$HOME/.config/gcloud" ]; then
            dbx_flags+=("--volume" "$HOME/.config/gcloud:$isolated_home/.config/gcloud:ro")
        fi
        if [ -f "$HOME/.gitconfig" ]; then
            dbx_flags+=("--volume" "$HOME/.gitconfig:$isolated_home/.gitconfig:ro")
        fi
    fi

    if [ "${AGY_KEYRING_MODE:-host}" = "isolated" ]; then
        dbx_flags+=("--additional-flags" "--unsetenv=DBUS_SESSION_BUS_ADDRESS")
    fi

    if [ "$runtime" = "docker" ]; then
        dbx_flags+=("--additional-flags" "--user $(id -u):$(id -g)")
    fi
    if [[ -n "${SSH_AUTH_SOCK:-}" && -S "$SSH_AUTH_SOCK" ]]; then
        dbx_flags+=("--additional-flags" "-v $SSH_AUTH_SOCK:/run/ssh-agent -e SSH_AUTH_SOCK=/run/ssh-agent")
    fi
    if [ "$systemd" = "true" ]; then
        dbx_flags+=("--init")
    fi

    # Resource limits
    local limits_conf="$HOME/.config/agy-box/limits.conf"
    local cpu_limit=""
    local memory_limit=""
    if [[ -f "$limits_conf" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            line=$(echo "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/#.*//')
            [[ -z "$line" ]] && continue
            if [[ "$line" =~ ^CPU_LIMIT=(.*)$ ]]; then
                cpu_limit="${BASH_REMATCH[1]}"
                cpu_limit="${cpu_limit%\"}"
                cpu_limit="${cpu_limit#\"}"
                cpu_limit="${cpu_limit%\'}"
                cpu_limit="${cpu_limit#\'}"
            elif [[ "$line" =~ ^MEMORY_LIMIT=(.*)$ ]]; then
                memory_limit="${BASH_REMATCH[1]}"
                memory_limit="${memory_limit%\"}"
                memory_limit="${memory_limit#\"}"
                memory_limit="${memory_limit%\'}"
                memory_limit="${memory_limit#\'}"
            fi
        done < "$limits_conf"
    fi
    if [[ -n "$cpu_limit" ]]; then
        dbx_flags+=("--additional-flags" "--cpus=$cpu_limit")
    fi
    if [[ -n "$memory_limit" ]]; then
        dbx_flags+=("--additional-flags" "-m $memory_limit")
    fi
    if command -v nvidia-smi &>/dev/null && { [ -e /dev/nvidiactl ] || [ -e /dev/nvhost-ctrl ] || [ -e /dev/nvidia0 ]; }; then
        dbx_flags+=("--nvidia")
    fi

    local log_file
    log_file=$(mktemp)

    if ! gum spin --spinner dot --title "Pulling official container image from GHCR..." -- "$runtime" pull "$IMAGE_NAME" >"$log_file" 2>&1; then
        cat "$log_file"
        rm -f "$log_file"
        gum style --foreground 196 "❌ Error: Failed to pull official container image."
        exit 1
    fi

    if ! gum spin --spinner dot --title "Creating Distrobox environment '$CONTAINER_NAME'..." -- distrobox create -i "$IMAGE_NAME" -n "$CONTAINER_NAME" --hostname "$CONTAINER_NAME" "${dbx_flags[@]}" --yes >"$log_file" 2>&1; then
        cat "$log_file"
        rm -f "$log_file"
        gum style --foreground 196 "❌ Error: Failed to create Distrobox environment."
        exit 1
    fi
    rm -f "$log_file"

    local isolated_home="$HOME/.config/agy-box/home"
    local runtime
    runtime=$(get_runtime)
    if [ "$runtime" = "podman" ] && [ -d "$isolated_home" ]; then
        podman unshare chown -R 0:0 "$isolated_home" 2>/dev/null || true
    fi

    # Install the Antigravity toolchain into the box user's ~/.local (it is not
    # baked into the image), then export the agy CLI to the host ~/.local/bin.
    if ! install_toolchain_in_box "$CONTAINER_NAME" "$isolated_home"; then
        exit 1
    fi

    # Clear setup_done flag so the setup helper runs on first interactive entry
    rm -f "$HOME/.config/agy-box/.setup_done"

    # Set up ujust/just integration by default
    setup_shell_integration

    gum style --foreground 46 --margin "1 0" "✓ Created successfully! Run 'agy-box-manager enter' to launch."
}

